api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_EMPMD1_GT0"><skos:prefLabel xml:lang="de">Unternehmen stellen Beschäftigten tragbare Geräte mit mobiler Internetverbindung für geschäftliche Zwecke zur Verfügung (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Provide to the persons employed portable devices that allow a mobile connection to the internet for business use (as of 2014)</skos:prefLabel><skos:prefLabel xml:lang="fr">Met à la disposition des personnes occupées des appareils portables qui permettent une connexion mobile à l&apos;internet (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_EMPMD1_GT20"><skos:prefLabel xml:lang="de">Unternehmen stellen mehr als 20% ihrer Beschäftigten tragbare Geräte mit mobiler Internetverbindung für geschäftliche Zwecke zur Verfügung (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Provide more than 20% of persons employed with portable devices that allow a mobile connection to the internet for business use (from 2014 onwards)</skos:prefLabel><skos:prefLabel xml:lang="fr">Met à la disposition de plus de 20% de personnes occupées des appareils portables qui permettent une connexion mobile à l&apos;internet (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_EMPMD2_GT0"><skos:prefLabel xml:lang="de">Unternehmen stellen Beschäftigten tragbare Geräte für geschäftliche Zwecke zur Verfügung, die mobilen Internetzugang über ein Mobilfunknetz ermöglichen (ab 2018)</skos:prefLabel><skos:prefLabel xml:lang="en">Provide the employed persons with a portable device that allows internet connection via mobile telephone networks, for business purpose (as of 2018)</skos:prefLabel><skos:prefLabel xml:lang="fr">Met à disposition des personnes occupées des appareils portables permettant une connexion mobile à l&apos;internet à usage professionnel (à partir de 2018)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_EMPMD2_GT20"><skos:prefLabel xml:lang="de">Unternehmen stellen mehr als 20% der Beschäftigten tragbare Geräte für geschäftliche Zwecke zur Verfügung, die mobilen Internetzugang über ein Mobilfunknetz ermöglichen (ab 2018)</skos:prefLabel><skos:prefLabel xml:lang="en">Provide more than 20% of the employed persons with a portable device that allows internet connection via mobile telephone networks, for business purpose (from 2018 onwards)</skos:prefLabel><skos:prefLabel xml:lang="fr">Met à disposition de plus de 20% des personnes occupées des appareils portables permettant une connexion mobile à l&apos;internet à usage professionnel (à partir de 2018)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_PMD"><skos:prefLabel xml:lang="de">Unternehmen stellen Beschäftigten tragbare Geräte mit mobiler Internetverbindung zur Verfügung</skos:prefLabel><skos:prefLabel xml:lang="en">Provide to the persons employed portable devices that allow a mobile connection to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Met à disposition des personnes occupées des appareils portables qui permettent une connexion mobile à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_PMD_APP"><skos:prefLabel xml:lang="de">Mobile Internetverbindung zum Geschäftsgebrauch: für den Zugang auf firmeninterne Geschäftssoftware</skos:prefLabel><skos:prefLabel xml:lang="en">Mobile connection to the internet for business use to use dedicated business software applications</skos:prefLabel><skos:prefLabel xml:lang="fr">Connexion mobile pour usage professionnel: pour utiliser des applications professionnelles spécialisées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_PMD_DOC"><skos:prefLabel xml:lang="de">Mobile Internetverbindung zum Geschäftsgebrauch: für den Zugriff auf und Abänderung von Unternehmensdokumenten</skos:prefLabel><skos:prefLabel xml:lang="en">Mobile connection to the internet for business use to access and modify documents of the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Connexion mobile pour usage professionnel: pour accéder à des documents de l&apos;entreprise et les modifier</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_PMD_EM"><skos:prefLabel xml:lang="de">Mobile Internetverbindung zum Geschäftsgebrauch: für den Zugang zum unternehmenseigenen E-Mail-System</skos:prefLabel><skos:prefLabel xml:lang="en">Mobile connection to the internet for business use to access the enterprise&apos;s email system</skos:prefLabel><skos:prefLabel xml:lang="fr">Connexion mobile pour usage professionnel: pour accéder au système de courrier électronique de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_PMD_WEB"><skos:prefLabel xml:lang="de">Mobile Internetverbindung zum Geschäftsgebrauch: für den Zugang zu öffentlichen Informationen im Internet</skos:prefLabel><skos:prefLabel xml:lang="en">Mobile connection to the internet for business use to access publicly available information on the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Connexion mobile pour usage professionnel: pour accéder aux informations publiques sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IACC"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises with internet access</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_PMD"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die Beschäftigen tragbare Geräte mit mobiler Internetverbindung zur Verfügung stellen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises providing to persons employed portable devices that allow a mobile connection to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises fournissant aux personnes occupées des appareils portables pour une connexion mobile</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_PMD1"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die Beschäftigen tragbare Geräte mit mobiler Internetverbindung zur Verfügung stellen (ab 2016)</skos:prefLabel><skos:prefLabel xml:l