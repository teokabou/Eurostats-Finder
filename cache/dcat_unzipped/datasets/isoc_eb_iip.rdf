:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_BSANY"><skos:prefLabel xml:lang="de">Unternehmen, die Unternehmenssoftware nutzen (eine von ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using any business software (any of ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un logiciel d&apos;entreprise (parmi ERP, CRM, BI)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CRM"><skos:prefLabel xml:lang="de">Unternehmen, die Software-Lösungen wie Customer Relationship Management verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using software solutions like Customer Relationship Management (CRM)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des logiciels comme le GRC (la gestion de relation de client)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CRM1"><skos:prefLabel xml:lang="de">Unternehmen, die Software-Lösungen wie Customer Relationship Management verwenden (ab 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using Customer Relationship Management (CRM) software (as of 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un logiciel de gestion de la relation client (CRM) (à partir de 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CRMAN"><skos:prefLabel xml:lang="de">Unternehmen, die Customer Relationship Management zur Informationenanalyse über Kunden für Marketingzwecke verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using Customer Relationship Management to analyse information about clients for marketing purposes</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant GRC (gestion de relation de client) pour analyser des informations sur les clients à des fins de commercialisation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CRMSTR"><skos:prefLabel xml:lang="de">Unternehmen, die Customer Relationship Management zur Erfassung, Speicherung und Zurverfügungstellung von Kundeninformationen an andere Funktionsbereiche verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using Customer Relationship Management to capture, store and make available clients information to other business functions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant GRC (gestion de relation de client) pour capturer, stocker et mettre à disposition d&apos;autres fonctions internes des informations sur les clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_HI_BSANY"><skos:prefLabel xml:lang="de">Unternehmen mit hoher digitaler Intensität, die Unternehmenssoftware nutzen (eines von ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with high digital intensity index, which use any business software (any of ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à fort indice d&apos;intensité numérique, qui utilisent n&apos;importe quel logiciel métier (ERP, CRM, BI)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_LO_BSANY"><skos:prefLabel xml:lang="de">Unternehmen mit niedriger digitaler Intensität, die Unternehmenssoftware nutzen (eines von ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with low digital intensity index, which use any business software (any of ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à faible indice d&apos;intensité numérique, qui utilisent n&apos;importe quel logiciel métier (ERP, CRM, BI)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VHI_BSANY"><skos:prefLabel xml:lang="de">Unternehmen mit sehr hoher digitaler Intensität, die Unternehmenssoftware nutzen (eines von ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very high digital intensity index, which use any business software (any of ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à très haut indice d&apos;intensité numérique, qui utilisent n&apos;importe quel logiciel métier (ERP, CRM, BI)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VLO_BSANY"><skos:prefLabel xml:lang="de">Unternehmen mit sehr niedriger digitaler Intensität, die Unternehmenssoftware nutzen (eines von ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very low digital intensity index, which use any business software (any of ERP, CRM, BI)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à très faible indice d&apos;intensité numérique, qui utilisent n&apos;importe quel logiciel métier (ERP, CRM, BI)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ERP1"><skos:prefLabel xml:lang="de">Unternehmen, die ERP-Softwarepakete verwendet haben, um Informationen innerhalb der Sachabteilungen auszutauschen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises who have ERP software package to share information between different functional areas</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant le progiciel ERP pour partager des informations entre les différents pôles de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ERP1_SM1_ANY"><skos:prefLabel xml:lang="de">Unternehmen, die ERP-Softwarepakete verwenden und soziale Medien nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using ERP software and any social media</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un logiciel ERP et tout média social</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ERP_CRM_BI_SISC"><skos:prefLabel xml:lang="de">Unternehmen nutzen ERP- oder CRM- oder BI-Software, oder tauschen Daten zum Lieferkettenmanagement elektronisch mit Lieferanten oder Kunden aus</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using ERP or CRM or BI software, or share supply chain management information electronically with suppliers or customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un logiciel ERP ou CRM ou BI, ou partageant des informations de gestion de la chaîne d&apos;approvisionnement par voie électronique avec des fournisseurs ou des clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ITBI"><skos:prefLabel xml:lang="de">Unternehmen, die Software-Lösungen wie Business Intelligence (BI) verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using Business Intelligence (BI) software</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un logiciel de Business Intelligence (BI)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFAC"><skos:prefLabel xml:lang="de">Unternehmen, die RFID-Technologien zur Personenidentifizierung und Zugangskontrolle einsetzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using RFID technologies for person identification or access control</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la technologie RFID pour l&apos;identification des personnes ou le contrôle d&apos;accès</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFAC1"><skos:prefLabel xml:lang="de">Unternehmen, die RFID-Technologien zur Personenidentifizierung und Zugangskontrolle einsetzen (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using RFID technologies for person identification or access control (as of 2014)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la technologie RFID pour l&apos;identification des personnes ou le contrôle d&apos;accès (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFASPRI"><skos:prefLabel xml:lang="de">Unternehmen, die RFID-Technologien zur Produktkennzeichnung (z.B. Diebstahlsicherung, Schutz vor Fälschung) einsetzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using RFID technologies for after sales product identification</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la technologie RFID pour l&apos;identification de produits après vente</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFASPRI1"><skos:prefLabel xml:lang="de">Unternehmen, die RFID-Technologien zur Produktkennzeichnung (z.B. Diebstahlsicherung, Schutz vor Fälschung) einsetzen (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using RFID technologies for after sales product identification (as of 2014)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la technologie RFID pour l&apos;identification de produits après vente (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFID"><skos:prefLabel xml:lang="de">Unternehmen, die RFID (Radio frequency identification) Technologien einsetzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using Radio Frequency identification (RFID) technologies</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des technologies basées sur l&apos;identification par Radio Fréquence (RFID)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFID1"><skos:prefLabel xml:lang="de">Unternehmen, die RFID (Radio Frequency identification) Technologien einsetzen (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using Radio Frequency identification (RFID) technologies (as of 2014)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des technologies basées sur l&apos;identification par Radio Fréquence (RFID) (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFPSAS1"><skos:prefLabel xml:lang="de">Unternehmen, die RFID-Technologien zur Produktkennzeichnung oder als Bestandteil der Produktions- und Dienstleistungsabwicklung einsetzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using RFID technologies for after sales product identification or as part of the production and service delivery</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la technologie RFID pour l&apos;identification de produits après vente ou dans le processus de production ou de prestation de services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFPSDP"><skos:prefLabel xml:lang="de">Unternehmen, die RFID-Technologien als Bestandteil der Produktions- und Dienstleistungsabwicklung einsetzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using RFID technologies as part of production and service delivery process</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la technologie RFID dans le processus de production ou de prestation de services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RFPSDP1"><skos:prefLabel xml:lang="de">Unternehmen, die RFID-Technologien als Bestandteil der Produktions- und Dienstleistungsabwicklung einsetzen (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using RFID technologies as part of production and service delivery process (as of 2014)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la technologie RFID dans le processus de production ou de prestation de services (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SI1"><skos:prefLabel xml:lang="de">Unternehmen nutzen ERP- oder CRM-Software, oder tauschen Daten zum Lieferkettenmanagement elektronisch mit Lieferanten oder Kunden aus</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using ERP or CRM, or share supply chain management information electronically with suppliers or customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un logiciel ERP ou un CRM, ou partageant des informations de gestion de la chaîne d&apos;approvisionnement par voie électronique avec des fournisseurs ou des clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_RFID"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die RFID einsetzen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises using RFID</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage d&apos;entreprises utilisant RFID</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_RFID1"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die RFID einsetzen (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using RFID (as of 2014)</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage d&apos;entreprises utilisant RFID (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10530</st