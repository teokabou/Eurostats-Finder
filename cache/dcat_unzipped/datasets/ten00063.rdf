<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/ten00063"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-03-29</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dcat:keyword  xml:lang="de">Abfallkategorien</dcat:keyword><dcat:keyword  xml:lang="en">Waste categories</dcat:keyword><dcat:keyword  xml:lang="fr">Catégories de déchets</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Recycling rates for packaging waste</dct:title><dct:description xml:lang="en">&lt;p&gt;The indicator is defined as the share of recycled packaging waste in all generated packaging waste. Packaging waste covers wasted material that was used for the containment, protection, handling, delivery and presentation of goods, from raw materials to processed goods, from the producer to the user or the consumer, excluding production residues.&lt;br /&gt; The source data set &apos;Recycling rates of packaging waste for monitoring compliance with policy targets, by type of packaging (env_waspacr)&apos; includes for two types of waste material (plastic and wood) an &apos;adjusted recycling rate&apos;. That means the recycling rates adjusted for monitoring compliance with policy targets in accordance with Article 6 of Directive 94/62/EC and Article 6b(1) of Decision 2005/270. The relevant rates for those materials are:&lt;br /&gt; o Recycling rate of plastic packaging waste counts exclusively material that is recycled back into plastic (material recycling / generation).&lt;br /&gt; o Recycling rate of wooden packaging waste is calculated including repair (recycling + repair of wooden packaging waste / generation + repair of wooden packaging waste).&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Taux de recyclage des déchets d&apos;emballage</dct:title><dct:description xml:lang="fr">&lt;p&gt;L&amp;rsquo;indicateur est d&amp;eacute;fini comme la part des d&amp;eacute;chets d&amp;rsquo;emballages recycl&amp;eacute;s dans le total des d&amp;eacute;chets d&amp;rsquo;emballage. Les d&amp;eacute;chets d&amp;rsquo;emballage comprennent les d&amp;eacute;chets de mat&amp;eacute;riaux qui ont &amp;eacute;t&amp;eacute; utilis&amp;eacute;s pour le confinement, la protection, la manipulation, la livraison et la pr&amp;eacute;sentation de marchandises, des mati&amp;egrave;res premi&amp;egrave;res jusqu&amp;rsquo;au produits finis, du producteur jusqu&amp;rsquo;&amp;agrave; l&amp;rsquo;utilisateur ou le consommateur, en excluant les r&amp;eacute;sidus de production.&lt;br /&gt; Le jeu de donn&amp;eacute;es source &amp;lsquo;Taux de recyclage des d&amp;eacute;chets d&amp;rsquo;emballage pour le suivi de la conformit&amp;eacute; avec les objectifs politiques, par type d&apos;emballage (env_waspacr)&amp;rsquo; inclut pour deux types de d&amp;eacute;chets (plastique et bois) un &amp;lsquo;taux de recyclage ajust&amp;eacute;&amp;rsquo;. Cela signifie les taux de recyclage ajust&amp;eacute;s pour le suivi de la conformit&amp;eacute; avec les objectifs politiques en accord avec l&amp;rsquo;Article 6 de la Directive 94/62/CE et l&amp;rsquo;Article 6b(1) de la D&amp;eacute;cision 2005/270. Les taux correspondants pour ces mat&amp;eacute;riaux sont :&lt;br /&gt; o Taux de recyclage des d&amp;eacute;chets d&amp;rsquo;emballages plastiques compte exclusivement les mat&amp;eacute;riaux qui sont recycl&amp;eacute;s &amp;agrave; nouveau en mati&amp;egrave;re plastique (recyclage des mat&amp;eacute;riaux / production).&lt;br /&gt; o Taux de recyclage des d&amp;eacute;chets d&amp;rsquo;emballages en bois est calcul&amp;eacute; en incluant la r&amp;eacute;paration (recyclage + r&amp;eacute;paration des d&amp;eacute;chets d&amp;rsquo;emballages en bois / production + r&amp;eacute;paration des d&amp;eacute;chets d&amp;rsquo;emballages en bois).&lt;/p&gt;</dct:description><dct:title xml:lang="de">Rate der stofflichen Verwertung von Verpackungsabfällen</dct:title><dct:description xml:lang="de">&lt;p&gt;Der Indikator ist definiert als Anteil des recycelten Verpackungsabfalls am gesamten Aufkommen von Verpackungsabfall. Verpackungsabfall beinhaltet Abfallmaterial das bei der Abpackung, dem Schutz, der Handhabung, Verteilung und Pr&amp;auml;sentation von Waren anf&amp;auml;llt, und bei der Verarbeitung von Rohmaterial zum Endprodukt, vom Hersteller zum Benutzer oder Verbraucher entsteht, ohne Produktionsr&amp;uuml;ckst&amp;auml;nde. &lt;br /&gt; Der Quelldatensatz &amp;bdquo;Recyclingraten von Verpackungsabf&amp;auml;llen zur &amp;Uuml;berwachung der Einhaltung der Richtlinienziele nach Verpackungsart (env_waspacr)&amp;ldquo; enth&amp;auml;lt f&amp;uuml;r zwei Arten von Abfallmaterialien (Kunststoff und Holz) eine &amp;bdquo;angepasste Recyclingrate&amp;ldquo;. Dies bedeutet, dass die Recyclingraten angepasst werden, um die Einhaltung der politischen Ziele gem&amp;auml;&amp;szlig; Artikel 6 der Richtlinie 94/62 / EG und Artikel 6b Absatz 1 des Beschlusses 2005/270 zu &amp;uuml;berwachen. Die entsprechenden Preise f&amp;uuml;r diese Materialien sind:&lt;br /&gt; o Die Recyclingrate von Kunststoffverpackungsabf&amp;auml;llen z&amp;auml;hlt ausschlie&amp;szlig;lich Material, das zu Kunststoff zur&amp;uuml;ckgef&amp;uuml;hrt wird (Materialrecycling / -erzeugung).&lt;br /&gt; o Die Recyclingrate von Holzverpackungsabf&amp;auml;llen wird einschlie&amp;szlig;lich Reparatur berechnet (Recycling + Reparatur von Holzverpackungsabf&amp;auml;llen / Erzeugung + Reparatur von Holzverpackungsabf&amp;auml;llen).&lt;/p&gt;</dct:description><dct:identifier>ten00063</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/ten00063"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LIE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:pr