<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/sdg_13_40"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-06-19</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Information</dcat:keyword><dcat:keyword  xml:lang="en">Statistical information</dcat:keyword><dcat:keyword  xml:lang="fr">Information statistique</dcat:keyword><dcat:keyword  xml:lang="de">Bestand oder Fluss</dcat:keyword><dcat:keyword  xml:lang="en">Stock or flow</dcat:keyword><dcat:keyword  xml:lang="fr">Stock ou flux</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Climate related economic losses</dct:title><dct:description xml:lang="en">&lt;p&gt;The indicator measures the economic losses from weather and climate-related events. In addition to the annual figures, a smoothed time-series based on 30-year averages is presented. In line with the climate normal period as defined by World Meteorological Organisation, these 30 years average figures reflect trends excluding the substantial climate variability on shorter time scales due to natural factors. The indicator is based on data from CATDAT of RiskLayer.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Pertes économiques provoquées par des situations climatiques extrêmes</dct:title><dct:description xml:lang="fr">&lt;p&gt;L’indicateur mesure les pertes économiques causées par les phénomènes météorologiques et climatiques. En plus des chiffres annuels, une série chronologique lissée basée sur des moyennes sur 30 ans est présentée. Conformément à la période normale du climat telle que définie par l’Organisation météorologique mondiale, ces chiffres moyens sur 30 ans reflètent des tendances en excluant l’importante variabilité climatique sur des échelles de temps plus courtes en raison de facteurs naturels. L’indicateur est basé sur les données de CATDAT de RiskLayer.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Wirtschaftliche Verluste durch Klimaextreme</dct:title><dct:description xml:lang="de">&lt;p&gt;Der Indikator misst die wirtschaftlichen Verluste aus Wetter- und Klimaereignissen. Zusätzlich zu den Jahreszahlen wird eine geglättete Zeitreihe auf der Grundlage von 30-Jahres-Durchschnitten vorgestellt. Im Einklang mit der von der Weltorganisation für Meteorologie definierten Klima-Normalperiode spiegeln diese Durchschnittswerte von 30 Jahren Trends wider, bei denen die erhebliche Klimavariabilität auf kürzeren Zeitskalen aufgrund natürlicher Faktoren ausgeschlossen ist. Der Indikator basiert auf Daten aus CATDAT von RiskLayer.&lt;/p&gt;</dct:description><dct:identifier>sdg_13_40</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_13_40"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spa