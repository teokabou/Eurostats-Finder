"/></v:Voice></v:hasTelephone><v:organisation-name>Eurostat, the statistical office of the European Union</v:organisation-name><v:hasURL><foaf:Document rdf:about="http://ec.europa.eu/eurostat/help/support"><foaf:topic rdf:resource="file:///usr/verticles/"/><schema:url>http://ec.europa.eu/eurostat/help/support</schema:url></foaf:Document></v:hasURL></v:Kind></dcat:contactPoint><adms:identifier xmlns:adms="http://www.w3.org/ns/adms#" xmlns:skos="http://www.w3.org/2004/02/skos/core.html" xmlns:dct="http://purl.org/dc/terms/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><adms:Identifier rdf:about="https://doi.org/10.2908/TGS00036"><skos:notation rdf:datatype="http://purl.org/spar/datacite/doi">10.2908/TGS00036</skos:notation><dct:creator rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/ESTAT"/><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-01-23</dct:issued></adms:Identifier></adms:identifier></dcat:Dataset></rdf:RDF>