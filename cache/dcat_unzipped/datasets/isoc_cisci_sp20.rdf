al><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1"><skos:prefLabel xml:lang="de">Personen, die ein Smartphone für private Zwecke verwendet haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals use a smartphone for private purposes (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un smartphone pour l&apos;usage privé (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_LST"><skos:prefLabel xml:lang="de">Personen, die bereits Informationen, Bilder, Dokumente oder andere Daten auf ihrem Smartphone durch einen Virus oder andere Schadsoftware verloren haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals already lost information, documents, pictures or other kind of data on their smartphone as a result of a virus or other hostile type of programs (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant perdu des informations, photos, documents ou autres données du smartphone à cause d&apos;un virus ou d&apos;un autre type de programme nuisible ou malveillant (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_RA"><skos:prefLabel xml:lang="de">Personen, die den Zugriff auf persönliche Daten eingeschränkt oder abgelehnt haben, wenn sie eine App auf dem Smartphone installiert oder verwendet haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals at least once restricted or refused access to personal data, when using or installing an app on the smartphone (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant, au moins une fois, limité ou interdit l&apos;accès à des données personnelles lors de l&apos;installation ou de l&apos;utilisation d&apos;applications sur le smartphone (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_RAKX"><skos:prefLabel xml:lang="de">Personen, die nicht wussten, dass es möglich ist, den Zugriff auf persönliche Daten einzuschränken oder abzulehnen, wenn sie eine App auf dem Smartphone installieren oder verwenden (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals didn&apos;t know it was possible to restrict or refuse access to personal data, when using or installing an app on the smartphone (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ne sachant pas qu&apos;il était possible de limiter ou interdire l&apos;accès à des données personnelles lors de l&apos;installation ou de l&apos;utilisation d&apos;applications sur le smartphone (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_RANA"><skos:prefLabel xml:lang="de">Personen, die nie den Zugriff auf persönliche Daten eingeschränkt oder abgelehnt haben, wenn sie eine App auf dem Smartphone installiert oder verwendet haben, weil sie Apps nicht verwenden (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals never restricted or refused access to personal data, when using or installing an app on the smartphone because don&apos;t use apps (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant jamais limité ou interdit l&apos;accès à des données personnelles lors de l&apos;installation ou de l&apos;utilisation d&apos;applications sur le smartphone, parce qu&apos;ils n&apos;utilisent pas d&apos;applications (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_RAX"><skos:prefLabel xml:lang="de">Personen, die nie den Zugriff auf persönliche Daten eingeschränkt oder abgelehnt haben, wenn sie eine App auf dem Smartphone installiert oder verwendet haben (3 Monate</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals never restricted or refused access to personal data, when using or installing an app on the smartphone (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant jamais limité ou interdit l&apos;accès à des données personnelles lors de l&apos;installation ou de l&apos;utilisation d&apos;applications sur le smartphone (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_SSA"><skos:prefLabel xml:lang="de">Das Smartphone verfügt über automatisch installierter oder mit dem Betriebssystem gelieferter Sicherheitssoftware (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Smartphone has some security system, installed automatically or provided with the operating system (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Le smartphone dispose de logiciels ou services de sécurité, installé automatiquement ou fourni par le système d&apos;exploitation (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_SSM"><skos:prefLabel xml:lang="de">Das Smartphone verfügt über Sicherheitssoftware, die von jemandem installiert oder abonniert wurde (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Smartphone has some security system, installed by somebody or subscribed to it (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Le smartphone dispose de logiciels ou services de sécurité, installé par un particulier ou via un abonnement (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_SSX"><skos:prefLabel xml:lang="de">Das Smartphone verfügt über keine Sicherheitssoftware (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Smartphone has no security system (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Le smartphone ne dispose pas de logiciels ou services de sécurité (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MPP1_SSZ"><skos:prefLabel xml:lang="de">Personen, die nicht wissen, ob ihr Smartphone über eine Sicherheitssoftware verfügt (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals don&apos;t know if their smartphone has some security system (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ne sachant pas si leur smartphone dispose de logiciels ou services de sécurité (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">59800</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-the