ut="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DA"><skos:prefLabel xml:lang="de">Unternehmen, in denen Datenanalysen für das Unternehmen von eigenen Beschäftigten oder von einem externen Dienstleister durchgeführt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Data analytics for the enterprise is performed by the enterprise&apos;s own employees or by an external provider</skos:prefLabel><skos:prefLabel xml:lang="fr">L&apos;analyse des données pour l&apos;entreprise est effectuée par ses propres employés ou par un prestataire externe</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DAEXT"><skos:prefLabel xml:lang="de">Unternehmen, in denen Datenanalysen für das Unternehmen von einem externen Unternehmen oder einer externen Organisation durchgeführt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where data analytics for the enterprise is performed by external enterprise or organisation</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont l&apos;analyse des données est effectuée par une entreprise ou une organisation externe</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DAOWN"><skos:prefLabel xml:lang="de">Unternehmen, in denen Datenanalysen für das Unternehmen von eigenen Beschäftigten durchgeführt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where data analytics for the enterprise is performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises où l&apos;analyse des données pour l&apos;entreprise est effectuée par ses propres employés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASANY"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus beliebigen Datenquellen durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from any source</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur des données provenant de n&apos;importe quelle source</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASANY2"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus mindestens einer der folgenden Datenquellen durch: E_DASWEB, E_DASLOC, E_DASSDS, E_DASGOV und E_DASSAT</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from any source among E_DASWEB, E_DASLOC, E_DASSDS, E_DASGOV and E_DASSAT</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur des données provenant de n&apos;importe quelle source parmi E_DASWEB, E_DASLOC, E_DASSDS, E_DASGOV et E_DASSAT</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASANY_ADS"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus beliebigen Datenquellen durch und bezahlen für Werbung im Internet</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from any source and pay to advertise on the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur des données provenant de n&apos;importe quelle source et paient pour faire de la publicité sur Internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASCRM"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Kundendaten wie Kaufgewohnheiten, Standort, Präferenzen, Kundenbewertungen, Suchanfragen durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data about customers, e.g. purchasing information, location, preferences, customer reviews, searches</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données relatives aux clients, par ex. informations d&apos;achat, localisation, préférences, avis clients, recherches</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASERP"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus Transaktionsaufzeichnungen wie Verkaufsangaben, Zahlungsaufzeichnungen durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from transaction records such as sale details, payments records</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données des enregistrements de transaction tels que les détails de vente, les enregistrements de paiement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASGE3"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus mindestens drei Datenquellen durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from at least three sources</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur des données provenant d&apos;au moins trois sources</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASGOV"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von frei zugänglichen Daten staatlicher Stellen durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on government authorities’ open data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données en libre accès des autorités gouvernementales</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASLOC"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Standortdaten aus der Nutzung von tragbaren Geräten oder Fahrzeugen durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on location data from the use of portable devices or vehicles</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données de localisation à partir de l&apos;utilisation d&apos;appareils portables ou de véhicules</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASLOC_BUY"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Standortdaten aus der Nutzung von tragbaren Geräten durch und haben Daten oder den Zugang zu diesen gekauft</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on location data from the use of portable devices and purchased (access to) any data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données de localisation à partir de l&apos;utilisation d&apos;appareils portables et ont acheté (l&apos;accès à) des données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASLOC_SELL"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Standortdaten aus der Nutzung von tragbaren Geräten durch und verkaufen unternehmenseigene Daten oder den Zugang zu diesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on location data from the use of portable devices and sell (access to) its own data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données de localisation provenant de l&apos;utilisation d&apos;appareils portables et vendent (l&apos;accès à) leurs propres données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASSAT"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Satellitendaten durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on satellite data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données satellitaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASSDS"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus smarten Geräten oder Sensoren durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from smart devices or sensors</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données provenant d&apos;appareils intelligents ou de capteurs</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASSDS_BUY"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus smarten Geräten oder Sensoren durch und haben Daten oder den Zugang zu diesen gekauft</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from smart devices or sensors and purchased (access to) any data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données provenant d&apos;appareils intelligents ou de capteurs et ont acheté (l&apos;accès à) des données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASSDS_SELL"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus smarten Geräten oder Sensoren durch und verkaufen unternehmenseigene Daten oder den Zugang zu diesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from smart devices or sensors and sell (access to) its own data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données provenant d&apos;appareils intelligents ou de capteurs et vendent (l&apos;accès à) leurs propres données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASSM"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus sozialen Medien, auch aus den eigenen Profilen des Unternehmens, in sozialen Medien durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from social media including from enterprises&apos; own social media profiles</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données des médias sociaux, y compris à partir de leurs propres profils de médias sociaux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASSM_BUY"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus sozialen Medien durch und haben Daten oder den Zugang zu diesen gekauft</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from social media and purchased (access to) any data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données des médias sociaux et ont acheté (l&apos;accès à) des données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASSM_SELL"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Daten aus sozialen Medien durch und verkaufen unternehmenseigene Daten oder den Zugang zu diesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on data from social media and sell (access to) its own data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données des médias sociaux et vendent (l&apos;accès à) leurs propres données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASWEB"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Webdaten durch</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on web data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données Web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASWEB_BUY"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Webdaten durch und haben Daten oder den Zugang zu diesen gekauft</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on web data and purchased (access to) any data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données Web et ont acheté (l&apos;accès à) des données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DASWEB_SELL"><skos:prefLabel xml:lang="de">Unternehmen führen Datenanalysen von Webdaten durch und verkaufen unternehmenseigene Daten oder den Zugang zu diesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics on web data and sell (access to) its own data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données sur les données Web et vendent (l&apos;accès à) leurs propres données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DBUY"><skos:prefLabel xml:lang="de">Unternehmen haben Daten gekauft oder den Zugang zu diesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises purchased (access to) any data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises ont acheté (l&apos;accès à) des données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_HI_DA"><skos:prefLabel xml:lang="de">Unternehmen mit hoher digitaler Intensität, die Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with high digital intensity index, which perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à indice d&apos;intensité numérique élevé, qui effectuent des analyses de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_HI_DASANY"><skos:prefLabel xml:lang="de">Unternehmen mit hoher digitaler Intensität, die Datenanalysen von Daten aus jeglichen Datenquellen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with high digital intensity index, which perform data analytics on data from any source</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises avec un indice d&apos;intensité numérique élevé, qui effectuent des analyses de données sur des données provenant de n&apos;importe quelle source</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_LO_DA"><skos:prefLabel xml:lang="de">Unternehmen mit niedriger digitaler Intensität, die Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with low digital intensity index, which perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à faible indice d&apos;intensité numérique, qui effectuent des analyses de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_LO_DASANY"><skos:prefLabel xml:lang="de">Unternehmen mit niedriger digitaler Intensität, die Datenanalysen von Daten aus jeglichen Datenquellen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with low digital intensity index, which perform data analytics on data from any source</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à faible indice d&apos;intensité numérique, qui effectuent des analyses de données sur des données provenant de n&apos;importe quelle source</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VHI_DA"><skos:prefLabel xml:lang="de">Unternehmen mit sehr hoher digitaler Intensität, die Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very high digital intensity index, which perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à très haut indice d&apos;intensité numérique, qui effectuent des analyses de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VHI_DASANY"><skos:prefLabel xml:lang="de">Unternehmen mit sehr hoher digitaler Intensität, die Datenanalysen von Daten aus jeglichen Datenquellen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very high digital intensity index, which perform data analytics on data from any source</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises avec un indice d&apos;intensité numérique très élevé, qui effectuent des analyses de données sur des données provenant de n&apos;importe quelle source</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VLO_DA"><skos:prefLabel xml:lang="de">Unternehmen mit sehr niedriger digitaler Intensität, die Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very low digital intensity index, which perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à très faible indice d&apos;intensité numérique, qui effectuent des analyses de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VLO_DASANY"><skos:prefLabel xml:lang="de">Unternehmen mit sehr niedriger digitaler Intensität, die Datenanalysen von Daten aus jeglichen Datenquellen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very low digital intensity index, which perform data analytics on data from any source</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises avec un indice d&apos;intensité numérique très faible, qui effectuent des analyses de données sur des données provenant de n&apos;importe quelle source</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DSELL"><skos:prefLabel xml:lang="de">Unternehmen verkaufen unternehmenseigene Daten oder den Zugang zu diesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises sell (access to) any of its own data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises vendent (l&apos;accès à) leurs propres données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DSELLX"><skos:prefLabel xml:lang="de">Unternehmen verkaufen keine unternehmenseigenen Daten oder den Zugang zu diesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises don&apos;t sell (access to) any of its own data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises ne vendent (l&apos;accès à) aucune de leurs propres données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_DAOWN"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Datenanalysen von eigenen Beschäftigten durchgeführt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises which performed Data Analytics by the enterprise&apos;s own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises où l&apos;analyse des données pour l&apos;entreprise est effectuée par leurs propres employés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">98520</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http:/