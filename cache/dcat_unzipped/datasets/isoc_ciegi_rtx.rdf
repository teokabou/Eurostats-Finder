<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_ciegi_rtx"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-12-18</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Reasons for not submitting completed forms to public authorities&apos; websites</dct:title><dct:description xml:lang="en">Reasons for not submitting completed forms to public authorities&apos; websites</dct:description><dct:title xml:lang="fr">Raisons pour ne pas renvoyer des formulaires remplis aux sites web des pouvoirs publics</dct:title><dct:description xml:lang="fr">Raisons pour ne pas renvoyer des formulaires remplis aux sites web des pouvoirs publics</dct:description><dct:title xml:lang="de">Gründe, warum ausgefüllte Formulare nicht an Websites öffentlicher Stellen übermittelt wurden</dct:title><dct:description xml:lang="de">Gründe, warum ausgefüllte Formulare nicht an Websites öffentlicher Stellen übermittelt wurden</dct:description><dct:identifier>isoc_ciegi_rtx</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ciegi_rtx"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_DEL"><skos:prefLabel xml:lang="de">Übermittlung durch eine andere Person erfolgt (z.B. Berater, Steuerberater, Verwandte, usw.)</skos:prefLabel><skos:prefLabel xml:lang="en">Another person did it on behalf of the individual (e.g. consultant, tax advisor, relative, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Une autre personne l&apos;a fait à la place du particulier (un consultant, un conseiller fiscal, un parent ou un proche)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_IRM"><skos:prefLabel xml:lang="de">Direkte Reaktion vermisst</skos:prefLabel><skos:prefLabel xml:lang="en">Immediate response is missing</skos:prefLabel><skos:prefLabel xml:lang="fr">La réponse immédiate manque</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_NAP"><skos:prefLabel xml:lang="de">Personen, die keine behördlichen Formulare einreichen mussten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals did not have to submit official forms at all</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas eu besoin de renvoyer des formulaires officiels</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_NAPX"><skos:prefLabel xml:lang="de">Personen, die keine behördlichen Formulare eingereicht haben, obwohl sie solche einreichen hätten müssen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using internet for sending filled forms to public authorities although they had to submit official forms</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé l&apos;internet pour renvoyer des formulaires remplis aux pouvoirs publics bien qu&apos;ils avaient des formulaires officiels à renvoyer</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_NAP_CX"><skos:prefLabel xml:lang="de">Personen, die öffentliche Stellen nicht kontaktiert haben (weder über deren Website noch anders) oder die ausgefüllte Formulare nicht über Internet eingereicht haben, weil sie gar keine behördlichen Formulare einreichen mussten (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have not contacted public authorities via their websites or any other method or have not used internet for sending them filled forms, because they did not have to submit official forms at all (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas contacté des pouvoirs publics via leur site Web ou par un autre moyen ou qui n&apos;ont pas utilisé l&apos;internet pour renvoyer des formulaires remplis parce qu&apos;ils n&apos;avaient pas de formulaires à renvoyer du tout (derniers 12 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_OTH"><skos:prefLabel xml:lang="de">Andere Gründe (als nap, sna, pcm, irm, tpap, skl, sec, vrq, sign, del) warum keine behördlichen Formulare eingereicht wurden</skos:prefLabel><skos:prefLabel xml:lang="en">Other reasons (than nap, sna, pcm, irm, tpap, skl, sec, vrq, sign, del)</skos:prefLabel><skos:prefLabel xml:lang="fr">D&apos;autres raisons (que nap, sna, pcm, irm, tpap, skl, sec, vrq, sign, del)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_PCM"><skos:prefLabel xml:lang="de">Der persönliche Kontakt fehlt, persönliche Vorsprache bevorzugt</skos:prefLabel><skos:prefLabel xml:lang="en">Personal contact is missing, prefer visits</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers préférant aller sur place, pour avoir un contact personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_SEC"><skos:prefLabel xml:lang="de">Bedenken bezüglich Schutz und Sicherheit der persönlichen Daten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals&apos; concerns about protection and security of personal data</skos:prefLabel><skos:prefLabel xml:lang="fr">Préoccupations quant à la protection et à la sécurité des données personnelles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_SIGN"><skos:prefLabel xml:lang="de">Fehlen von oder Probleme mit elektronischer Unterschrift oder elektronischem id/Zertifikat</skos:prefLabel><skos:prefLabel xml:lang="en">Lack of or problems with electronic signature or electronic id/certificate</skos:prefLabel><skos:prefLabel xml:lang="fr">Absence ou difficulté de signature électronique ou de certificat d&apos;identification électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_SKL"><skos:prefLabel xml:lang="de">Fehlende Kenntnis oder fehlendes Wissen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals&apos; lack of skills or knowledge</skos:prefLabel><skos:prefLabel xml:lang="fr">Manque de connaissances ou de compétences</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_SNA"><skos:prefLabel xml:lang="de">Es waren keine derartigen Websites verfügbar</skos:prefLabel><skos:prefLabel xml:lang="en">There was no such website service available</skos:prefLabel><skos:prefLabel xml:lang="fr">Il n&apos;y a pas de service adapté disponible sur le site Web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_TPAP"><skos:prefLabel xml:lang="de">Mehr Vertrauen bei der Übermittlung in Papierform</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals trust submitting by paper more</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers se fiant davantage à l&apos;envoi sur papier</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RTX_VRQ"><skos:prefLabel xml:lang="de">Die entsprechenden Dienste erfordern ohnehin die persönliche Vorsprache oder Übermittlung in Papierform</skos:prefLabel><skos:prefLabel xml:lang="en">The relevant services will require personal visits or paper submission anyway</skos:prefLabel><skos:prefLabel xml:lang="fr">La procédure administrative impose de toutes façons de se rendre en personne à l&apos;administration ou de remettre des documents sur papier</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVTAX1X_AUT"><skos:prefLabel xml:lang="de">Internetnutzung: hat keine Online-Steuererklärung abgegeben - wurde automatisch gemacht (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not submit online tax declaration - was done automatically (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pas de dépôt de déclaration de taxe en ligne - soumission automatique (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVTAX1X_DEL"><skos:prefLabel xml:lang="de">Internetnutzung: hat keine Online-Steuererklärung abgegeben - da von anderer Person gemacht (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not submit online tax declaration - because someone else did it (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pas de dépôt de déclaration de taxe en ligne - soumission faite par une tierce personne (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVTAX1X_OTH"><skos:prefLabel xml:lang="de">Internetnutzung: hat keine Online-Steuererklärung abgegeben - aus anderen Gründen (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not submit online tax declaration - because of other reasons (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pas de dépôt de déclaration de taxe en ligne - autres raisons (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVTAX1X_PF"><skos:prefLabel xml:lang="de">Internetnutzung: hat keine Online-Steuererklärung abgegeben - wurde auf Papier abgegeben (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not submit online tax declaration - did it on paper (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pas de dépôt de déclaration de taxe en ligne - soumission faite sur un formulaire papier (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVEID"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - wegen fehlender elektronischer Signatur (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - because of lack of electronic signature (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucune demande de document officiel ni de réclamation introduite - ne dispose pas de signature électronique (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVLS"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - wegen mangelnder Fähigkeiten oder Kenntnisse (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - because of lack of skills or knowledge (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucune demande de document officiel ni de réclamation introduite - en raison d&apos;un manque de compétences ou de connaissances (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVNAP"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - weil es keinen solchen Online-Dienst gab (letzte 12 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - because there was no such online service available (in the last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucun document officiel demandé ni soumis aucune requête - car un tel service enligne n&apos;était pas disponible (dans les 12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVNN"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - da nicht nötig (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - because no need (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucune demande de document officiel ni de réclamation introduite - aucune nécessité (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVNNX"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - obwohl nötig gewesen wäre (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - although needed to (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucune demande de document officiel ni de réclamation introduite - malgré le besoin de le faire (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVOP"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - da von anderer Person gemacht (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - because other person did it (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucune demande de document officiel ni de réclamation introduite - demande introduite par une tierce personne (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVOTH"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - aus anderen Gründen (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - because of other reasons (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucune demande de document officiel ni de réclamation introduite - pour d&apos;autres raisons (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IRGOVSEC"><skos:prefLabel xml:lang="de">Internet-Nutzung: hat kein offizielles Dokument angefordert oder einen Antrag gestellt - wegen Sicherheitsbedenken (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request any official document or made any claim - because of concerns about security (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: aucune demande de document officiel ni de réclamation introduite - pour des préoccupations liées à la sécurité (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IGRTX"><skos:prefLabel xml:lang="de">Prozent der Personen, die das Internet nutzten aber nicht zum Einreichen ausgefüllter Formulare</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have used internet but not for sending filled forms to public authorities</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisé l&apos;internet mais pas pour renvoyer des formulaires remplis aux pouvoirs publics</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IGRTX_NAPX"><skos:prefLabel xml:lang="de">Prozent der Personen, die das Internet nutzten aber nicht zum Einreichen ausgefüllter Formulare obwohl sie solche einreichen hätten müssen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have used internet but not for sending filled forms to public authorities although they had to</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisé l&apos;internet mais pas pour renvoyer des formulaires remplis bien qu&apos;ils avaient des formulaires officiels à renvoyer</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">276006</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ciegi_rtx"><dct:type rdf:resource="http://publications.europa.eu/resourc