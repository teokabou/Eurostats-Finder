<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tag00001"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-01-22</dct:issued><dcat:keyword  xml:lang="de">Landwirtschaftliche Fläche</dcat:keyword><dcat:keyword  xml:lang="en">Agricultural area</dcat:keyword><dcat:keyword  xml:lang="fr">Superficie agricole</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Eurofarm Indikatoren</dcat:keyword><dcat:keyword  xml:lang="en">Eurofarm indicators</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateurs Eurofarm</dcat:keyword><dcat:keyword  xml:lang="de">Rechtsform der Betriebe</dcat:keyword><dcat:keyword  xml:lang="en">Legal type of the holding</dcat:keyword><dcat:keyword  xml:lang="fr">Statut juridique de l&apos;exploitation</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Agricultural holdings by agricultural area</dct:title><dct:description xml:lang="en">&lt;p&gt;Total number of agricultural holdings according to the size of&amp;nbsp;the agricultural area (arable land, kitchen gardens, permanent grassland and permanent crops and other land, expressed in ha). Information is based on censuses and sample surveys.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Exploitations agricoles par superficie agricole</dct:title><dct:description xml:lang="fr">&lt;p&gt;Nombre total d&apos;exploitations agricoles par taille de la superficie agricole utilisée (terres arables, jardins potagers, prairies permanentes, cultures permanentes et autres superficies, en ha). Information basée sur recensements et enquêtes par sondage.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Landwirtschaftliche Betriebe nach landwirtschaftlich genutzter Fläche</dct:title><dct:description xml:lang="de">&lt;p&gt;Gesamtzahl der landwirtschaftlichen Betriebe nach der Größe der landwirtschaftlich genutzten Fläche des Betriebs (Ackerland, Haus- und Nutzgärten, Dauergrünland und Dauerkulturen sowie sonstige Flächen). Die Angaben basieren auf Zählungen und Stichprobenerhebungen.&lt;/p&gt;</dct:description><dct:identifier>tag00001</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tag00001"/><dct:spatial><dct:Location rdf:about="http://