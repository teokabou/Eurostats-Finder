<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/inn_cis9_env"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-01-17</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Innovationsindikator</dcat:keyword><dcat:keyword  xml:lang="en">Innovation indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur l&apos;innovation</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</dcat:keyword><dcat:keyword  xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</dcat:keyword><dcat:keyword  xml:lang="en">Size classes in number of employees</dcat:keyword><dcat:keyword  xml:lang="fr">Classes de taille en nombre de salariés</dcat:keyword><dcat:keyword  xml:lang="de">Gliederung nach Innovationsart</dcat:keyword><dcat:keyword  xml:lang="en">Breakdown by type of innovator</dcat:keyword><dcat:keyword  xml:lang="fr">Ventilation par type d&apos;innovateur</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Environmental benefits due to innovation in the enterprises by NACE Rev. 2 activity and size class (2014)</dct:title><dct:description xml:lang="en">Environmental benefits due to innovation in the enterprises by NACE Rev. 2 activity and size class (2014)</dct:description><dct:title xml:lang="fr">Avantages pour l&apos;environnement obtenus grâce à l&apos;innovation dans les entreprises par activité de la NACE Rév. 2 et classe de taille (2014)</dct:title><dct:description xml:lang="fr">Avantages pour l&apos;environnement obtenus grâce à l&apos;innovation dans les entreprises par activité de la NACE Rév. 2 et classe de taille (2014)</dct:description><dct:title xml:lang="de">Ökologische Vorteile durch Innovation in Unternehmen nach NACE Rev. 2 Tätigkeit und Größenklasse (2014)</dct:title><dct:description xml:lang="de">Ökologische Vorteile durch Innovation in Unternehmen nach NACE Rev. 2 Tätigkeit und Größenklasse (2014)</dct:description><dct:identifier>inn_cis9_env</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/inn_cis9_env"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN" > <skos:prefLabel xml:lang="de">Innovationsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Innovation indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;innovation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZECLAS" > <skos:prefLabel xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre de salariés</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/TYPE_INN" > <skos:prefLabel xml:lang="de">Gliederung nach Innovationsart</skos:prefLabel><skos:prefLabel xml:lang="en">Breakdown by type of innovator</skos:prefLabel><skos:prefLabel xml:lang="fr">Ventilation par type d&apos;innovateur</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOALL"><skos:prefLabel xml:lang="de">Unternehmen, die eine Innovation mit ökologischen Vorteilen (für das Unternehmen oder den Endverwender) eingeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced an innovation with environmental benefits (obtained within the enterprise or by the end user)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation présentant des avantages pour l&apos;environnement (au niveau de l&apos;entreprise ou de l&apos;utilisateur final)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOENO"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation den Energieverbrauch oder CO2-Fußabdruck im Unternehmen verringert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that reduced energy use or CO2 &apos;footprint&apos; within the enterprises by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant réduit, en innovant, leur propre consommation d&apos;énergie ou empreinte CO2</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOENU"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation den Energieverbrauch oder CO2-Fußabdruck beim Verbrauch oder bei der Nutzung einer Ware bzw. Dienstleistung durch den Endverwender verringert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that reduced energy use or CO2 &apos;footprint&apos; during the consumption or use of a good or service by the end user, by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant réduit, en innovant, la consommation d&apos;énergie ou l&apos;empreinte CO2 de la consommation ou de l&apos;utilisation d&apos;un bien ou d&apos;un service par l&apos;utilisateur final</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOEXT"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation die Lebensdauer von Produkten durch nachhaltigere Produkte verlängert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that extended product life through more durable products, by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant allongé, en innovant, la durée de vie de leurs produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOINENT"><skos:prefLabel xml:lang="de">Unternehmen, die eine Innovation mit ökologischen Vorteilen für das Unternehmen eingeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced an innovation with environmental benefits obtained within the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation présentant des avantages pour l&apos;environnement au niveau de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOMAT"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation ihren Material- oder Wasserverbrauch je Produktionseinheit im Unternehmen verringert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that reduced material or water use per unit of output within the enterprises by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant diminué, en innovant, l&apos;emploi de matériaux ou d&apos;eau par unité de production au niveau de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOMKT"><skos:prefLabel xml:lang="de">Unternehmen mit ökologischen Vorteilen durch Marketinginnovation</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with environmental benefits due to marketing innovation</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation en matière de commercialisation présentant des avantages pour l&apos;environnement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOPOL"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation die Luft- und Wasserverschmutzung sowie die Lärm- und Bodenbelastung im Unternehmen verringert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that reduced air, water, noise or soil pollution within the enterprises by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant diminué, en innovant, les nuisances sonores ou la pollution de l&apos;air, de l&apos;eau ou des sols au niveau de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOPOS"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation die Luft- und Wasserverschmutzung sowie die Lärm- und Bodenbelastung beim Verbrauch oder bei der Nutzung einer Ware bzw. Dienstleistung durch den Endverwender verringert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that reduced air, water, noise or soil pollution during the consumption or use of a good or service by the end user, by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant réduit, en innovant, les nuisances sonores ou la pollution de l&apos;air, de l&apos;eau ou des sols de la consommation ou de l&apos;utilisation d&apos;un bien ou d&apos;un service par l&apos;utilisateur final</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOPRC"><skos:prefLabel xml:lang="de">Unternehmen mit ökologischen Vorteilen durch Prozessinnovation</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with environmental benefits due to process innovation</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation de procédé présentant des avantages pour l&apos;environnement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOPRD"><skos:prefLabel xml:lang="de">Unternehmen mit ökologischen Vorteilen durch Produktinnovation</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with environmental benefits due to product innovation</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation de produit présentant des avantages pour l&apos;environnement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOREA"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation die Wiederverwertung eines Produkts nach der Nutzung durch den Endverwender vereinfacht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that facilitated recycling of product after use by the end user, by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant facilité, en innovant, le recyclage du produit après utilisation par l&apos;utilisateur final</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOREC"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation Abfall, Wasser oder Material zum Eigenverbrauch oder Verkauf im Unternehmen wiederverwertet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that recycled waste, water, or materials for own use or sale within the enterprises by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant recyclé, en innovant, les déchets, l&apos;eau ou les matières au niveau de l&apos;entreprise, pour les réutiliser ou les revendre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOREP"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation einen Teil des fossilen Brennstoffs im Unternehmen durch erneuerbare Energiequellen ersetzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that replaced a share of fossil energy with renewable energy sources within the enterprises by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant remplacé, en innovant, une partie de l&apos;énergie fossile au moyen de sources d&apos;énergie renouvelable au niveau de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECORG"><skos:prefLabel xml:lang="de">Unternehmen mit ökologischen Vorteilen durch Organisationsinnovation</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with environmental benefits due to organisation innovation</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation en matière d&apos;organisation présentant des avantages pour l&apos;environnement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOSUB"><skos:prefLabel xml:lang="de">Unternehmen, die durch Innovation einen Teil des Materials durch weniger umweltschädliche oder gefährliche Stoffe im Unternehmen ersetzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that replaced a share of materials with less polluting or hazardous substitutes within the enterprises by innovating</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant remplacé, en innovant, une partie des matériaux par des substituts moins polluants ou moins dangereux au niveau de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ECOUSER"><skos:prefLabel xml:lang="de">Unternehmen, die eine Innovation mit ökologischen Vorteilen für den Endverwender eingeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced an innovation with environmental benefits obtained by the end user</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation présentant des avantages pour l&apos;environnement au niveau de l&apos;utilisateur final</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=NR"><skos:prefLabel xml:lang="de">Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Number</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC"><skos:prefLabel xml:lang="de">Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">91615</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-04-23</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/inn_cis9_env"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEB