<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tipsna70"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-11-11</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Volkswirtschaftliche Gesamtrechnungen Indikator (ESVG 2010)</dcat:keyword><dcat:keyword  xml:lang="en">National accounts indicator (ESA 2010)</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur des comptes nationaux (SEC 2010)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Labour productivity per hour worked - annual data</dct:title><dct:description xml:lang="en">The labour productivity is the ratio of gross domestic product at current price (nominal) to total hours worked by employees and self-employed (domestic concept). The GDP per hour worked gives an indication of how much economic production activity can be attributed to each hour worked in the economy. Input data are obtained from the official national accounts&apos; country data, through ESA 2010 transmission programme. The MIP auxiliary indicator is expressed as 1-year percentage change. In the table, values are also expressed as index (2015=100).</dct:description><dct:title xml:lang="fr">Productivité réelle de la main-d&apos;oeuvre par heure travaillée - données annuelles</dct:title><dct:description xml:lang="fr">La productivité du travail correspond au ratio entre le produit intérieur brut (PIB) aux prix courants (nominal) et le total des heures travaillées par les salariés et les travailleurs indépendants (concept domestique). Le PIB par heure travaillée donne une indication de la quantité d&apos;activité de production économique attribuable à chaque heure travaillée dans l&apos;économie. Les données d&apos;entrée proviennent des comptes nationaux officiels des pays, transmises dans le cadre du programme ESA 2010. L’indicateur auxiliaire de la PDM est exprimé en variation en pourcentage sur un an. Dans le tableau, les valeurs sont également exprimées sous forme d’indice (2015=100).</dct:description><dct:title xml:lang="de">Reale Arbeitsproduktivität pro geleistete Arbeitsstunde - jährliche Daten</dct:title><dct:description xml:lang="de">Die Arbeitsproduktivität ist das Verhältnis des Bruttoinlandsprodukts zu laufenden Preisen (nominal) zur Gesamtzahl der von Arbeitnehmern und Selbstständigen geleisteten Arbeitsstunden (Inlandskonzept). Das BIP pro geleisteter Arbeitsstunde gibt Aufschluss darüber, wie viel wirtschaftliche Produktionstätigkeit auf jede in der Volkswirtschaft geleistete Stunde entfällt. Die Eingangsdaten stammen aus den offiziellen nationalen Volkswirtschaftlichen Gesamtrechnungen der Länder im Rahmen des Übermittlungsprogramms gemäß ESVG 2010. Der VMU-Hilfsindikator wird als prozentuale Veränderung gegenüber dem Vorjahr ausgedrückt. In der Tabelle werden die Werte auch als Index (2015=100) dargestellt.</dct:description><dct:identifier>tipsna70</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tipsna70"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><stat:dim