<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_iiot_use"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-26</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Internet of Things - use</dct:title><dct:description xml:lang="en">Internet of Things - use</dct:description><dct:title xml:lang="fr">Internet des objets - utilisation</dct:title><dct:description xml:lang="fr">Internet des objets - utilisation</dct:description><dct:title xml:lang="de">Internet der Dinge - Verwendung</dct:title><dct:description xml:lang="de">Internet der Dinge - Verwendung</dct:description><dct:identifier>isoc_iiot_use</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_iiot_use"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DCAR"><skos:prefLabel xml:lang="de">Personen haben einen Pkw mit eingebauter drahtloser Internetverbindung verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a car with built-in wireless internet connection (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une voiture avec connexion internet sans fil intégrée (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DCAR2"><skos:prefLabel xml:lang="de">Personen nutzten ein Auto mit eingebauter Internetverbindung (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a car with built-in wireless internet connection (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une voiture connectée à internet sans fil intégrée (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DCS"><skos:prefLabel xml:lang="de">Personen haben eine Smart-Watch, Fitness-Armband, Sicherheits-Tracker, mit dem Internet verbundene Brille oder Kopfhörer, Accessoires, Kleidung oder Schuhe verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a smart watch, a fitness band, connected goggles or headsets, safety-trackers, internet-connected accessories, internet-connected clothes or shoes (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une montre intelligente, un bracelet de fitness, de lunettes ou d’un casque d’écoute, de traceurs de sécurité, d’accessoires, de vêtements ou de chaussures tous connectés à l’internet (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DCS2"><skos:prefLabel xml:lang="de">Personen nutzten ein Wearable mit Internetanschluss (z.B. intelligente Uhr, Fitnessband, vernetzte Brille oder Headset, Sicherheitstracker, Zubehör, Kleidung, Schuhe) (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected wearable (e.g. smart watch, fitness band, connected goggles or headsets, safety-trackers, accessories, clothes, shoes) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé les appareils portables suivants connectés à internet: une montre intelligente, une bande de fitness ou un casque, un moniteur de sécurité, des accesoires, des vêtements ou des chassures (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DEM"><skos:prefLabel xml:lang="de">Personen haben ein mit dem Internet verbundenes Thermostat, Stromzähler, Beleuchtung, oder andere mit dem Internet verbundene Lösungen für das Energiemanagement ihres Hauses/ihrer Wohnung verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used internet-connected thermostat, utility meters, lights, plug-ins or other internet-connected solutions for energy management for their home (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un thermostat, un compteur, de lampes ou de modules d’extension connectés à l’internet ou d’autres solutions connectées à l’internet, afin de gérer l’énergie au domicile (jusqu’en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DEM2"><skos:prefLabel xml:lang="de">Personen haben ein mit dem Internet verbundenes Energiemanagementsystem für Zuhause (z.B. Thermostat, Stromzähler, Beleuchtung) genutzt (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected home energy management system (e.g. thermostat, utility meters, lights) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un système de gestion de l&apos;énergie connecté à internet (tel qu&apos;un thermostat, un compteur d&apos;énergie, les ampoules)(3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DHA"><skos:prefLabel xml:lang="de">Personen haben mit dem Internet verbundene Haushaltsgeräte wie Saugroboter, Kühlschränke, Öfen und Kaffeemaschinen verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used internet-connected home appliances such as robot vacuums, fridges, ovens, coffee machines (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé des appareils domestiques connectés à l’internet, comme des aspirateurs robotisés, réfrigérateurs, fours ou machines à café (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DHA2"><skos:prefLabel xml:lang="de">Personen haben ein mit dem Internet verbundenes Haushaltsgerät (z.B. Staubsaugerroboter, Kühlschrank, Ofen, Kaffeemaschine) genutzt (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected home appliance (e.g. robot vacuums, fridge, oven, coffee machine) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un appareil domestique connectés à internet (tel qu&apos;un robot aspirateur, un réfrigérateur, un four, une machine à café)(3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DHE"><skos:prefLabel xml:lang="de">Personen haben mit dem Internet verbundene Geräte zur Überwachung von Blutdruck, Blutzucker, Körpergewicht oder andere verbundene Geräte aus dem Bereich Gesundheit/medizinische Vorsorge verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used internet-connected devices for monitoring blood pressure, sugar level, body weight or other internet-connected devices for health and medical care (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé des dispositifs connectés à l’internet pour surveiller la tension artérielle, le taux de sucre ou le poids corporel ou d’autres dispositifs connectés à l’internet dans le domaine de la santé et des soins médicaux (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DHE2"><skos:prefLabel xml:lang="de">Personen nutzten ein mit dem Internet verbundenes Gerät für Gesundheit oder medizinische Versorgung (z.B. zur Überwachung von Blutdruck, Zuckerspiegel, Körpergewicht) (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected device for health and medical care (e.g. for monitoring blood pressure, sugar level, body weight) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé les appareils connectés à internet pour des soins médicaux et de santé (exemple: pour surveiller la pression artérielle, le taux de sucre, le poids corporel)(3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DOM2"><skos:prefLabel xml:lang="de">Personen haben eine mit dem Internet verbundene Hausanlage (für Energiemanagement, Sicherheit, Haushaltsgeräte, oder einen virtuellen Assistenten) genutzt (letzte 3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected home system (for energy management, security/safety, appliances, or virtual assistant) (last 3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un système connectés à internet (pour la gestion de l&apos;énergie, la sécurité/surêté, des appareils, ou un assistant virtuel) (3 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DSEC"><skos:prefLabel xml:lang="de">Personen haben eine mit dem Internet verbundene Hausalarmanlage, Rauchmelder, Überwachungskameras, Türschlösser oder andere vernetzte Sicherheitslösungen für ihr Haus/ihre Wohnung verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used internet-connected home alarm system, smoke detector, security cameras, door locks or other internet-connected security/safety solutions for their home (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un système d’alarme résidentiel, un détecteur de fumée, de caméras de sécurité ou de serrures connectés à l’internet, ou d’autres solutions de sécurité ou de sûreté connectées à l’internet pour le domicile (jusqu’en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DSEC2"><skos:prefLabel xml:lang="de">Personen haben ein mit dem Internet verbundenes Haussicherheitssystem (z.B. Alarmanlage, Rauchmelder, Sicherheitskameras, Türschlösser) genutzt (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected home security/safety system (e.g. home alarm system, smoke detector, security cameras, door locks) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un système de sécurité/surêté connecté à internet (tel une alarme, un détecteur de fumée, une caméras de sécurité, des sérures de porte)(3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DTOY"><skos:prefLabel xml:lang="de">Personen haben mit dem Internet verbundenes Spielzeug, z. B. Roboterspielzeug (einschließlich Lernspielzeug) oder intelligente Puppen verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used toys connected to the internet, such as robot toys (including educational) or dolls (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé des jouets connectés à l’internet, tels que des jouets robots (y compris à des fins éducatives) ou des poupées (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DTOY2"><skos:prefLabel xml:lang="de">Personen nutzten ein Spielzeug mit Internetanschluss (z.B. Roboterspielzeug, Drohnen, Puppen) (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected toy (e.g. robot toys, drones, dolls) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un jouet connecté à internet (exemple: les robots (même éducatifs), drones ou des poupées)(3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DVA"><skos:prefLabel xml:lang="de">Personen haben einen virtuellen Assistenten in Form eines intelligenten Lautsprechers oder einer App verwendet (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a virtual assistant in the form of a smart speaker or of an app (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé des assistants virtuels sous forme d&apos;une enceinte intelligente ou d&apos;une application (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DVA2"><skos:prefLabel xml:lang="de">Personen haben einen mit dem Internet verbundenen virtuellen Assistenten in Form eines intelligenten Lautsprechers oder einer App verwendet (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected virtual assistant in the form of a smart speaker or of an app (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un assistant virtuel connecté à internet sous la forme d’une enceinte intelligente ou d’une application (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DX"><skos:prefLabel xml:lang="de">Personen haben keine der mit dem Internet verbundenen Systeme verwendet (I_IOT_DEM, I_IOT_DSEC, I_IOT_DHA, I_IOT_DVA) (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have not used any of the internet-connected devices or systems (I_IOT_DEM, I_IOT_DSEC, I_IOT_DHA, I_IOT_DVA) (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé d&apos;appareil ou système connecté à l&apos;internet (I_IOT_DEM, I_IOT_DSEC, I_IOT_DHA, I_IOT_DVA) (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_DX2"><skos:prefLabel xml:lang="de">Personen haben keine mit dem Internet verbundenen Hausanlagen oder virtuelle Assistenten genutzt (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals didn&apos;t use any internet-connected home systems or virtual assistants (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé un système ou un assistant virtuel connecté à internet (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUANY"><skos:prefLabel xml:lang="de">Personen haben das Internet auf einem Smart TV, Spielekonsole, Heim-Audio-System oder Smart Speakern genutzt (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used the internet on an internet-connected TV, game console, home audio system, smart speakers (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet sur une télévision, une console de jeu, un système audio ou des enceintes intelligentes connectés à l’internet au domicile (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUANY2"><skos:prefLabel xml:lang="de">Personen nutzten zu Hause ein Home-Entertainment-System mit Internetanschluss (z.B. Fernseher, Spielkonsole, Audiosystem, intelligente Lautsprecher) (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected home entertainment solution (e.g An internet-connected TV, game console, home audio system, smart speakers) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utiliséun ensemble d&apos;équipement de récréation connecté à internet: télévision, console de jeu, système audio domestique, haut-parleurs intelligents (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUGC"><skos:prefLabel xml:lang="de">Personen haben das Internet auf einer mit dem Internet verbundenen Spielekonsole genutzt (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used the internet on an internet-connected game console (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet sur une console de jeu connectée à l’internet au domicile (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUGC2"><skos:prefLabel xml:lang="de">Personen nutzten zu Hause eine Spielkonsole mit Internetanschluss (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected game console (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une console de jeu connectée à l’internet (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUHA"><skos:prefLabel xml:lang="de">Personen haben das Internet auf einem Heim-Audio-System, intelligenten Lautsprecher (Smart Speakers) genutzt (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used the internet on an internet-connected home audio system, smart speakers (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet sur un système audio domestique ou des enceintes intelligentes connectés à l’internet au domicile (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUHA2"><skos:prefLabel xml:lang="de">Personen nutzten zu Hause ein Audiosystem oder intelligente Lautsprecher mit Internetanschluss (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected home audio system or smart speakers (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé un système audio à domicile connecté à l’internet, haut-parleurs intelligents (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUTV"><skos:prefLabel xml:lang="de">Personen haben das Internet auf einem mit dem Internet verbundenen Fernsehgerät (Smart TV) genutzt (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used the internet on an internet-connected TV in their home for private purposes (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet sur une télévision connectée à l’internet au domicile (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_IUTV2"><skos:prefLabel xml:lang="de">Personen nutzten zu Hause einen Fernseher mit Internetanschluss (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used an internet-connected TV (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une télévision connectée à l’internet (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_USE"><skos:prefLabel xml:lang="de">IoT-Nutzung: zu privaten Zwecken (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">IoT use: for private purposes (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation de l&apos;internet des objets : à des fins privées (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_USE2"><skos:prefLabel xml:lang="de">Personen nutzten mit dem Internet verbundene Geräte (IoT) für private Zwecke (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used internet-connected devices (IoT) for private purposes (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé des appareils connectés à l’internet (Internet des Objets, IdO) (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">209717</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_iiot_use"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATE