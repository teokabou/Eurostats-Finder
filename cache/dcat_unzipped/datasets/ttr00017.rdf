cat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/ttr00017?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"><dct:title xml:lang="en">Download metadata in SDMX 2.1 format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/ttr00017?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/ttr00017?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/XML"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dcat:Distribution></dcat:distribution><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/web/user-guides/data-browser"><dct:title xml:lang="en">Eurostat - European statistics : online help</dct:title><dct:title xml:lang="fr">Eurostat - Statistiques européennes: aide en ligne</dct:title><dct:title xml:lang="de">Eurostat - Europäische Statistiken: Online Hilfe</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/ttr00017"/><dct:format rdf:resource="http://publications.europa.eu/res