ations.europa.eu/resource/authority/access-right/PUBLIC"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/sdg_12_10?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"><dct:title xml:lang="en">Download metadata in SDMX 2.1 format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/sdg_12_10?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/sdg_12_10?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/XML"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dcat:byteSize>6956</dcat:byteSize><spdx:checksum> <spdx:Checksum> <spdx:algorithm rdf:resource="http://spdx.org/rdf/terms#checksumAlgorithm_sha256"/><spdx:checksumValue>01cbef3170f616d2f5450da14b6d02f7891454dd9908b3a9a6c0d7de4e10bb42</spdx:checksumValue> </spdx:Checksum> </spdx:checksum></dcat:Distribution></dcat:distribution><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/web/user-guides/data-browser"><dct:title xml:lang="en">Eurostat - European statis