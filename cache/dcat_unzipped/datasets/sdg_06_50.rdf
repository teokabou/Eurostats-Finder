/codelist/ESTAT/UNIT?code=MG_L"><skos:prefLabel xml:lang="de">Milligramm pro Liter</skos:prefLabel><skos:prefLabel xml:lang="en">Milligrams per litre</skos:prefLabel><skos:prefLabel xml:lang="fr">Milligrammes par litre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-24</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2000-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_06_50"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/sdg_06_50</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/sdg_06_50_esmsip2.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_06_50"/><schema:url xml:lang="en"><![C