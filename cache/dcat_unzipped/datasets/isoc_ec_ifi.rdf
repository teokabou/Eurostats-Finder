qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFIN1"><skos:prefLabel xml:lang="de">Personen, die mindestens eine finanzbezogene Aktivität (von i_bfin_sh, i_bfin_in, i_bfin_cr) über das Internet getätigt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals carried out at least one of the financial activities (i_bfin_sh, i_bfin_in, i_bfin_cr) over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant effectué sur l&apos;internet au moins une des activités financières (i_bfin_sh, i_bfin_in, i_bfin_cr)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFIN_CR"><skos:prefLabel xml:lang="de">Personen, die ein Darlehen / einen Kredit von Banken oder anderen Finanzdienstleistern aufgenommen haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals took a loan or arranged credit from banks or other financial prividers over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant contracté ou modifié un prêt sur l&apos;internet auprès d&apos;une banque ou d&apos;une autre institution financière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFIN_IN"><skos:prefLabel xml:lang="de">Personen, die Versicherungsverträge über das Internet abgeschlossen oder verlängert haben, einschließlich solcher, die als Paket zusammen mit einer anderen Dienstleistung angeboten wurden (z.B. Reiseversicherung zusammen mit Flugticket)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals bought or renewed existing insurance policies, including those offered as a package together with another service (e.g. travel insurance offered together with a plane ticket) over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant contracté ou renouvelé une assurance sur l&apos;internet, y compris à l&apos;occasion de l&apos;achat d&apos;un autre service (assurance voyage proposée lors de l&apos;achat d&apos;un billet d&apos;avion)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFIN_SH"><skos:prefLabel xml:lang="de">Personen, die Aktien, Anleihen, Fonds oder andere Investitionsdienstleistungen über das Internet ge- oder verkauft haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals bought or sold shares, bonds, funds or other investment services over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant acheté ou vendu des actions, des obligations, des fonds ou tout autre service d&apos;investissement sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28048</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme>