Label><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_1_PMONO"><skos:prefLabel xml:lang="de">Nutzung eines Typs von sozialen Mediums nur zu einem Zweck (von Interaktion mit Kunden, Geschäftspartner, Rekrutieren oder den Austausch innerhalb des Unternehmens)</skos:prefLabel><skos:prefLabel xml:lang="en">Use only one type of social medium for only one purpose: interacting with customers, with business partners, recruiting or exchanging within the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un seul média social dans un seul but (parmi l&apos;interaction avec les clients, avec les partenaires commerciaux, le recrutement ou l&apos;échange au sein de l&apos;entreprise)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_1_PMULTI"><skos:prefLabel xml:lang="de">Nutzung eines Typs von sozialen Mediums zu mehr als einem Zweck (von Interaktion mit Kunden, Geschäftspartner, Rekrutieren oder den Austausch innerhalb des Unternehmens)</skos:prefLabel><skos:prefLabel xml:lang="en">Use only one type of social medium for more than one purpose: interacting with customers, with business partners, recruiting or exchanging within the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un seul média social dans plus d&apos;un but (parmi l&apos;interaction avec les clients, avec les partenaires commerciaux, le recrutement ou l&apos;échange au sein de l&apos;entreprise)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_GE2_PMONO"><skos:prefLabel xml:lang="de">Nutzung von 2 oder mehr sozialen Medien nur zu einem Zweck ( von Interaktion mit Kunden, Geschäftspartner, Rekrutieren oder den Austausch innerhalb des Unternehmens)</skos:prefLabel><skos:prefLabel xml:lang="en">Use two or more social media for only one purpose: interacting with customers, with business partners, recruiting or exchanging within the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant deux ou plusieurs médias sociaux dans un seul but (parmi l&apos;interaction avec les clients, avec les partenaires commerciaux, le recrutement ou l&apos;échange au sein de l&apos;entreprise)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_GE2_PMULTI"><skos:prefLabel xml:lang="de">Nutzung von 2 oder mehr sozialen Medien zu mehr als einem Zweck ( von Interaktion mit Kunden, Geschäftspartner, Rekrutieren oder den Austausch innerhalb des Unternehmens)</skos:prefLabel><skos:prefLabel xml:lang="en">Use two or more social media for more than one purpose: interacting with customers, with business partners, recruiting or exchanging within the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant deux ou plus médias sociaux dans plus d&apos;un but (parmi l&apos;interaction avec les clients, avec les partenaires commerciaux, le recrutement ou l&apos;échange au sein de l&apos;entreprise)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PADVERT"><skos:prefLabel xml:lang="de">Entwicklung des Unternehmensprofils oder Darstellung von Produkten</skos:prefLabel><skos:prefLabel xml:lang="en">Develop the enterprise&apos;s image or market products</skos:prefLabel><skos:prefLabel xml:lang="fr">Développer l&apos;image de l&apos;entreprise ou commercialiser des produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PANY"><skos:prefLabel xml:lang="de">Nutzung sozialer Medien für mindestens einen der folgenden Zwecke: sm_advert, sm_pcuqor, sm_pcudev, sm_pbpcoll, sm_prcr, sm_pexchvok</skos:prefLabel><skos:prefLabel xml:lang="en">Use social media for any purpose (of sm_advert, sm_pcuqor, sm_pcudev, sm_pbpcoll, sm_prcr, sm_pexchvok)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des médias sociaux dans au moins un des buts suivants: sm_advert, sm_pcuqor, sm_pcudev, sm_pbpcoll, sm_prcr, sm_pexchvok</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PBPCOLL"><skos:prefLabel xml:lang="de">Zusammenarbeit mit Geschäftspartnern (z. B. Anbieter, usw.) oder anderen Organisationen (z. B. Behörden, Nichtregierungsorganisationen usw.)</skos:prefLabel><skos:prefLabel xml:lang="en">Collaborate with business partners (e.g. suppliers, etc.) or other organisations (e.g. public authorities, non governmental organisations, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Collaborer avec des partenaires commerciaux (p.ex. des fournisseurs, etc.) ou d&apos;autres organismes (p. ex. des administrations, des ONG, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PBPCU"><skos:prefLabel xml:lang="de">Unternehmen, die soziale Medien mit Geschäftspartnern und Kunden nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using social media with business partners and customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les médias sociaux avec des partenaires commerciaux et des clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PBPNCU"><skos:prefLabel xml:lang="de">Unternehmen, die soziale Medien mit Geschäftspartnern, aber nicht mit Kunden nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using social media with business partners, but not with customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les médias sociaux avec des partenaires commerciaux, mais pas avec des clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PCU"><skos:prefLabel xml:lang="de">Unternehmen, die soziale Medien mit Kunden nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using social media with customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les médias sociaux avec leurs clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PCUDEV"><skos:prefLabel xml:lang="de">Einbeziehung der Kunden in die Entwicklungs- oder Innovationsmaßnahmen bezüglich Waren oder Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Involve customers in development or innovation of goods or services</skos:prefLabel><skos:prefLabel xml:lang="fr">Faire participer les clients au Développement ou à l&apos;amélioration des biens ou des services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PCUQOR"><skos:prefLabel xml:lang="de">Einholung oder Beantwortung von Fragen, Meinungen oder Bewertungen von Kunden</skos:prefLabel><skos:prefLabel xml:lang="en">Obtain or respond to customer opinions, reviews questions</skos:prefLabel><skos:prefLabel xml:lang="fr">Recueillir les avis, les critiques ou les questions des clients et y répondre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PCUQ_PNDEV"><skos:prefLabel xml:lang="de">Unternehmen, die soziale Medien nur mit Kunden nutzen (ohne Entwicklung und Innovation)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using social media only with customers (excluding development and innovation)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les médias sociaux uniquement avec des clients (hors développement et innovation)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PEXCHVOK"><skos:prefLabel xml:lang="de">Austausch von Ansichten, Meinungen und Wissen innerhalb des Unternehmens</skos:prefLabel><skos:prefLabel xml:lang="en">Exchange views, opinions or knowledge within the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Echanger des avis, des opinions ou de la connaissance au sein de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PEXCHVOKQ"><skos:prefLabel xml:lang="de">Unternehmen, die soziale Medien nur zum Austausch von Ansichten, Meinungen oder Wissen innerhalb des Unternehmens nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using social media only to exchange views, opinions or knowledge within the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les médias sociaux uniquement pour échanger des points de vue, des opinions ou des connaissances au sein de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SM_PRCR"><skos:prefLabel xml:lang="de">Einstellung von Mitarbeitern</skos:prefLabel><skos:prefLabel xml:lang="en">Recruit employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Recruter des salariés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBF3_SM_PMULTI"><skos:prefLabel xml:lang="de">Unternehmen, deren Website Online-Bestellung/Reservierung/Buchung und mindestens eine der folgenden Funktionen hat (webctm, webot, webacc, webper), und die soziale Medien für mehr als einen Zweck nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Website has online ordering, reservation or booking and at least one of: webacc, webctm, webot or webper and use social media for more than one purpose</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant un site web avec la possibilité de commande/réservation en ligne et au moins une des fonctionnalités parmi webacc, webctm, webot, webper et utilisant des médias sociaux dans plusieurs buts</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IACC"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises with internet access</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_SM"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die soziale Medien nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using social media</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant des médias sociaux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">109399</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cismpn2"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cismpn2</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.