</dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_04_31?format=tsv&amp;compressed=true"><dct:title xml:lang="en">Download dataset in TSV format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_04_31?format=tsv&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_04_31?format=tsv&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/TSV"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/tab-separated-values"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dcat:byteSize>2594</dcat:byteSize><spdx:checksum> <spdx:Checksum> <spdx:algorithm rdf:resource="http://spdx.org/rdf/terms#checksumAlgorithm_sha256"/><spdx:checksumValue>537498989830e9dae1a92f158850fd56416dbc2ddb4ae18e9a20720e08a18196</spdx:checksumValue> </spdx:Checksum> </spdx:checksum></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_04_31?format=SDMX-CSV&amp;compressed=true"><dct:title xml:lang="en">Download dataset in SDMX-CSV format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg