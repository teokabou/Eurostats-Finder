ce/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BANY_PP"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von Privatpersonen: physische Produkte, Haushalts- oder Transportdienste, Unterkunft gebucht</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from a private person: goods, household services, transport services or rented accommodation</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers: des articles, des services domestiques ou de transport, ou la location d’un hébergement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BANY_PP1"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von Privatpersonen: physische Produkte, Haushalts- oder Transportdienste, Unterkunft gebucht (ab 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from private persons: goods, household services, transport services or rented accommodation (as of 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers: des articles, des services domestiques ou de transport, ou la location d’un hébergement (à partir de 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BAPP"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): andere Apps wie z. B. Sprachlern-, Reise-, Wetter-Apps (außer kostenfreie) (bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): other apps (e.g. related to learning languages, travelling, weather) (excluding free apps) (until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">&quot;Commandes en ligne (3 mois): d’autres applications p. ex. pour l’apprentissage des langues, les voyages, la météo; à l’exclusion des applications gratuites (jusqu&apos;en 2023)&quot;</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BAPP2"><skos:prefLabel xml:lang="de">Personen hatten ein bezahltes Abo für eine andere App (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals having a paid subscription to other apps (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant un abonnement payant à d&apos;autres types d&apos;application (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBMC"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Fahrräder, Motorräder, Mopeds, Pkw oder andere Fahrzeuge und deren Ersatzteile</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): bicycles, mopeds, cars, or other vehicles or their spare parts</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des bicyclettes, des cyclomoteurs, des voitures ou d’autres véhicules et leurs pièces détachées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOK2"><skos:prefLabel xml:lang="de">Online-Käufe (3 Monate): E-Books oder Hörbücher als Download (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (last 3 months): e-books or audio books as downloads (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 derniers mois): livre électronique ou livre audio en téléchargement (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOKNLG"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Gedruckte Bücher, Zeitungen, Zeitschriften</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): printed books, magazines or newspapers</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des livres, magazines ou journaux imprimés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOKNLS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): E-Books, E-Zeitungen, E-Zeitschriften (bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): e-books, online-magazines or online-newspapers (until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des livres électroniques, des magazines en ligne ou des journaux en ligne (jusqu&apos;en 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOKNLS2"><skos:prefLabel xml:lang="de">Personen hatten ein bezahltes Abo für Online-Zeitungen, Nachrichtenseiten oder Magazine (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals having a paid subscription to online news sites, online newspapers (e-papers) or online magazines (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant un abonnement payant aux sites en ligne de journaux et aux magazines en lignes (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCBW"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Kosmetika, Schönheits- und Wellness-Produkte</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): cosmetics, beauty or wellness products</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des cosmétiques, des articles de beauté ou de bien-être</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCG"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Kinderspielzeug und Baby-Artikel</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): children toys or childcare items</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des jouets ou des articles de puériculture</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCLOT1"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Kleidung (inklusive Sportbekleidung), Schuhe oder Accessoires</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): clothes (including sport clothing), shoes or accessories</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des vêtements (y compris vêtements de sport), des chaussures ou des accessoires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCPH"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Reinigungsmittel und Körperpflegeprodukte</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): cleaning products or personal hygiene products</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des produits de nettoyage ou des produits d’hygiène corporelle</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): verschiedene online Dienste (I_BMUSS, I_BFLMS,I_BBOOKNLS, I_BGAMES) (bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): divers online services (I_BMUSS, I_BFLMS,I_BBOOKNLS, I_BGAMES) (until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des services en ligne (I_BMUSS, I_BFLMS,I_BBOOKNLS, I_BGAMES) (jusqu’en 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCS2"><skos:prefLabel xml:lang="de">Online-Käufe (letzte 3 Monate): Kulturelle Dienstleistungen (Musik, Filme, Bücher, Zeitungen, Zeitschriften, Spiele) (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (last 3 months): cultural services (music, films, books, newspapers, magazines, games) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): services culturels (musique, films, livres, journaux d&apos;information, magazines, jeux) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCTICK"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Eintrittskarten für kulturelle und andere Veranstaltungen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): tickets to cultural or other events</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des billets pour des manifestations culturelles et autres</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BEEQU1"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Unterhaltungselektronik, elektrische Haushaltsgeräte</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): consumer electronics or household appliances</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des appareils électroniques grand public ou des appareils électroménagers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFDR"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Lieferung von Restaurants, Fast-Food-Ketten, Catering-Diensten</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): deliveries from restaurants, fast-food chains, catering services</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des plats à livrer par des restaurants, chaînes de restauration rapides ou services de traiteur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFDS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Lebensmittel und Getränke aus Geschäften, Supermärkten oder von Anbietern von Mahlzeiten-Fertig-Sets</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): food or beverages from stores or from meal-kits providers</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): de la nourriture ou des boissons auprès de magasins ou de fournisseurs de kits de repas</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFLMG"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Filme oder Serien in Form von DVDs, Blu-rays oder anderem physischem Filmmaterial</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): films or series as DVDs, Blu-ray etc.</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des films ou des séries sous forme de DVD, Blu-ray, etc.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFLMS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Filme oder Serien von Streaming-Diensten oder als Downloads (bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): films or series as a streaming service or downloads (until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des films ou des séries sous forme de services de diffusion en continu ou de téléchargements (jusqu&apos;en 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFLMS2"><skos:prefLabel xml:lang="de">Personen hatten ein bezahltes Abo für einen Film-, Serien-, oder Sport-Streaming-Dienst (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals having a paid subscription to a films, series or sports streaming service (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant un abonnement payant de diffusion en continu de films, séries ou de sports (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFURN1"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Möbel, Heimzubehör oder Gartenartikel</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): furniture, home accessories or gardening products</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des meubles, des accessoires pour la maison ou d’articles de jardinage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BGAMES"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Computer- oder Videospiele online oder als Downloads für Smartphones, Tablets, Computer und Konsolen (bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): games online or as downloads for smartphones, tablets, computers or consoles (until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des jeux en ligne ou à télécharger pour téléphones intelligents, tablettes, ordinateurs ou consoles (jusqu&apos;en 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BGAMES2"><skos:prefLabel xml:lang="de">Online-Käufe (3 Monate): Spiele als Download (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (last 3 months): games as downloads (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 derniers mois): jeux en téléchargement (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BGAMSS"><skos:prefLabel xml:lang="de">Personen hatten ein bezahltes Abo für einen Spiele-Streaming-Dienst (letzte 3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals having a paid subscription to a gaming streaming service (last 3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant un abonnement payant de diffusion en continu de jeux (3 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BHARD1"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Computer, Tablets, Mobiltelefone und Zubehör</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): computers, tablets, mobile phones or accessories</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des ordinateurs, des tablettes, des téléphones mobiles ou des accessoires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BHHS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Haushaltsdienste (z. B. für Reinigung, Babysitting, Reparaturarbeiten, Gartenarbeit)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): household services (e.g. cleaning, babysitting, repair work, gardening)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des services domestiques (p. ex. nettoyage, garde d’enfants, travaux de réparation ou jardinage)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BHHS_PP"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von einer Privatperson: Haushaltsdienste</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from private persons: household services</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers: des services domestiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BHLFTS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Gesundheits-oder Fitness-Apps (außer kostenfreie) (bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): apps related to health or fitness (excluding free apps) (until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des applications liées à la santé ou à la forme physique (à l’exclusion des applications gratuites) (jusqu&apos;en 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BHLFTS2"><skos:prefLabel xml:lang="de">Personen hatten ein bezahltes Abo für eine Gesundheits- oder Fitness-App (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals having a paid subscription to an app related to health or fitness (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant un abonnement payant à une application liée à la santé ou la mise en forme (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BMED1"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Arzneimittel oder Nahrungsergänzungsmittel wie z. B. Vitaminpräparate</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): medicine or dietary supplements such as vitamins (online renewal of prescriptions is not included)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des médicaments ou des compléments alimentaires comme des vitamines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BMUFL"><skos:prefLabel xml:lang="de">Online-Käufe (in den letzten 3 Monaten): Musik als CDs, Vinyls, oder Filme oder Serien als DVDs, Blu-ray usw.</skos:prefLabel><skos:prefLabel xml:lang="en">Type of goods bought via a website or app for private use in the last 3 months: music as CDs, vinyls, films or series as DVDs, Blu-ray, etc.</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): de la musique tels que CDs, vinyles, ou des films ou séries tels DVDs, Blu-ray, etc.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BMUSG"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Musik in Form von CDs, Schallplatten oder anderen physischen Tonträgern</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): music as CDs, vinyls etc.</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): de la musique sous forme de CD, vinyles, etc.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BMUSS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Musik von Streaming-Diensten oder als Downloads (bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): music as a streaming service or downloads (until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): de la musique sous forme de services de diffusion en continu ou de téléchargements (jusqu&apos;en 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BMUSS2"><skos:prefLabel xml:lang="de">Personen hatten ein bezahltes Abo für einen Musik-Streaming-Dienst (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals having a paid subscription to a music streaming service (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant un abonnement payant de diffusion en continu de musique (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BOPG"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): andere physische Produkte</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): other physical goods</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): d’autres articles physiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BPG_ANY"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): jegliche physische Produkte (I_BCLOT1, I_BSPG, I_BCG, I_BFURN1, I_BMUSG, I_BFLMG, I_BBOOKNLG, I_BHARD1, I_BEEQU1, I_BMED1, I_BFDR, I_BFDS, I_BCBW, I_BCPH, I_BBMC, I_BOPG)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): any physical goods (I_BCLOT1, I_BSPG, I_BCG, I_BFURN1, I_BMUSG, I_BFLMG, I_BBOOKNLG, I_BHARD1, I_BEEQU1, I_BMED1, I_BFDR, I_BFDS, I_BCBW, I_BCPH, I_BBMC, I_BOPG)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des articles physiques (I_BCLOT1, I_BSPG, I_BCG, I_BFURN1, I_BMUSG, I_BFLMG, I_BBOOKNLG, I_BHARD1, I_BEEQU1, I_BMED1, I_BFDR, I_BFDS, I_BCBW, I_BCPH, I_BBMC, I_BOPG)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BPG_PP"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von anderen Privatpersonen: physische Produkte</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from private persons: any physical goods</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers: des articles physiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BRA"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von einem Unternehmen oder einer Privatperson: Unterkunft gebucht</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from an enterprises or a private person: rented accommodation</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers ou d&apos;entreprises: la location d’un hébergement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BRA_E"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von einem Unternehmen wie Hotel oder Reisebüro: Unterkunft gebucht</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from enterprises such as hotels or travel agencies: rented accommodation</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès d’entreprises telles que hôtels ou agences de voyages: la location d’un hébergement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BRA_PP"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von einer Privatperson: Unterkunft gebucht</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from a private person: rented accommodation</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers: la location d’un hébergement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSIMC"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Abonnements für Internet- oder Mobiltelefonverbindungen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): subscriptions to the internet or mobile phone connections</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des abonnements à l’internet ou des services de connexion à la téléphonie mobile</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSOFT2"><skos:prefLabel xml:lang="de">Online-Käufe (3 Monate): Software als Download (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (last 3 months): software as downloads (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 derniers mois): logiciel en téléchargement (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSOFTS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Computersoftware oder andere Software als Downloads (inklusive Upgrades)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): computer or other software as downloads including upgrades</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des logiciels pour ordinateurs ou d’autres logiciels à télécharger, y compris les mises à jour</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSPG"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Sportartikel (ausgenommen Sportbekleidung)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): sports goods (excluding sport clothing)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des articles de sport (à l’exclusion des vêtements de sport)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSTICK"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Eintrittskarten für Sportveranstaltungen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): tickets to sport events</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des billets pour des manifestations sportives</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSUTIL"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): Abonnements für Strom-, Wasser- oder Wärmeversorgung, Abfallentsorgung oder ähnliche Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): subscription to electricity, water or heating supply, waste disposal or similar services</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): des abonnements à des services de fourniture d’électricité, d’eau ou de chauffage, à des services d’élimination des déchets ou à des services similaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BTICK2"><skos:prefLabel xml:lang="de">Online-Käufe (3 Monate): Veranstaltungstickets (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (last 3 months): tickets to events (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 derniers mois): tickets pour spectacles (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BTPS"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von einem Unternehmen oder einer Privatperson: Transportdienste</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from a transport enterprise or a private person: transport service</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers ou d&apos;une entreprise de transport: des services de transport</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BTPS_E"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von einem Unternehmen: Transportdienste</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from a transport enterprise: transport service</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès d&apos;une entreprise de transport: des services de transport</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BTPS_PP"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate) von einer Privatperson: Transportdienste</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months) from a private person: transport service</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois) auprès de particuliers: des services de transport</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_BUY3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten 3 Monaten online Käufe getätigt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who purchased online in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant commandé en ligne au cours des 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">807879</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_ibgs"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_ibgs</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_ibgs"/><schema:url xml:lang="en