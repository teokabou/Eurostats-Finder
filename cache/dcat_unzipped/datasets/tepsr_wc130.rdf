fische Darstellungen sind ebenfalls verfügbar.</dct:title><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/tepsr_wc130/default/table"/><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/VISUALIZATION"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/tepsr_wc130?format=tsv&amp;compressed=true"><dct:title xml:lang="en">Download dataset in TSV format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/tepsr_wc130?format=tsv&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/tepsr_wc130?format=tsv&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/TSV"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/tab-separated-values"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat