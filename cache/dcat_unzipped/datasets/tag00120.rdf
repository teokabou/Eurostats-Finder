<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tag00120"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-09-19</dct:issued><dcat:keyword  xml:lang="de">Pflanzenbaumerkmale</dcat:keyword><dcat:keyword  xml:lang="en">Crops</dcat:keyword><dcat:keyword  xml:lang="fr">Cultures et productions végétales</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Produktionsstruktur</dcat:keyword><dcat:keyword  xml:lang="en">Structure of production</dcat:keyword><dcat:keyword  xml:lang="fr">Structure de production</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Permanent crops for human consumption by area</dct:title><dct:description xml:lang="en">&lt;p&gt;Production area of permanent crops intended for human consumption. It includes all fruit trees (in particular apples, pears and cherries), all citrus fruit trees, all nut trees, all berry plantations (except strawberries), all vineyards, all olive trees and all other permanent crops used for human consumption (e.g. tea, coffee or carobs).&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Cultures permanentes pour la consommation humaine par superficie</dct:title><dct:description xml:lang="fr">&lt;p&gt;Superficie de production de cultures permanentes destinées à la consommation humaine. Il comprend tous les arbres fruitiers (notamment les pommes, les poires et les cerises), tous les agrumes, tous les arbres à noix, toutes les plantations de baies (à l&apos;exception des fraises), toutes les vignes, tous les oliviers et toutes les autres cultures permanentes utilisées pour la consommation humaine (par exemple le thé, le café ou la carobe).&lt;/p&gt;</dct:description><dct:title xml:lang="de">Dauerkulturen zur menschlichen Ernährung nach Fläche</dct:title><dct:description xml:lang="de">&lt;p&gt;Produktionsfläche von Dauerkulturen zur menschlichen Ernährung. Dazu gehören alle Obstbäume (insbesondere Äpfel, Birnen und Kirschen), alle Zitrusfruchtbäume, alle Nussbäume, alle Strauchbeerenanlagen (außer Erdbeeren), alle Weinberge, alle Olivenbäume und alle anderen Dauerkulturen, die dem menschlichen Verzehr dienen (z. B. Tee, Kaffee oder Johannisbrot).&lt;/p&gt;</dct:description><dct:identifier>tag00120</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tag00120"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:s