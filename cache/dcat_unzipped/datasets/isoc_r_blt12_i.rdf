nitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_B3_12"><skos:prefLabel xml:lang="de">Letzter online Kauf: zwischen 3 und 12 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: between 3 and 12 months ago</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: au cours d&apos;une période remontant de 3 à 12 mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFEU"><skos:prefLabel xml:lang="de">Online Käufe: von Anbietern aus anderen EU-Staaten</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: from sellers from other EU countries</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne des biens ou services auprès des vendeurs d&apos;autres pays de l&apos;UE</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BHOLS"><skos:prefLabel xml:lang="de">Online Käufe: Reisen und Urlaubsunterkünfte</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: travel and holiday accommodation</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des voyages et des hébergements de vacances</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BLT12"><skos:prefLabel xml:lang="de">Letzter online Kauf: in den letzten 12 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: in the 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: au cours des 12 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BPG_EU"><skos:prefLabel xml:lang="de">Online Käufe (3 Monate): von Anbietern aus anderen EU-Staaten</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases (3 months): from sellers from other EU countries</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne (3 mois): auprès des vendeurs d&apos;autres pays de l&apos;UE</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BUMT12"><skos:prefLabel xml:lang="de">Letzter online Kauf: vor mehr als einem Jahr</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: more than a year ago</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: il y a plus d&apos;un an</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BUMT12X"><skos:prefLabel xml:lang="de">Letzter online Kauf: vor mehr als einem Jahr oder noch nie</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: more than a year ago or never</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: il y a plus d&apos;un an ou jamais</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BUY3"><skos:prefLabel xml:lang="de">Letzter online Kauf: in den letzten 3 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_BLT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr Waren oder Dienstleistungen für den privaten Gebrauch über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who ordered goods or services, over the internet, for private use, in the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant commandé des biens ou des services sur l&apos;internet pour leur usage privé au cours de l&apos;année précédente</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au 