g="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_B0"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet keine Probleme hatten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered no problems when making purchases over the Internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas rencontré de problèmes lors de leurs achats sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BARR1X"><skos:prefLabel xml:lang="de">Personen, die bei Käufen für private Zwecke über das Internet keine Probleme hatten (ab 2015)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who did not encounter problems when buying/ordering goods or services over the internet for private use (as of 2015)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas rencontré de problèmes lors de la commande de biens ou de services sur l&apos;internet à des fins privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BARR1Y"><skos:prefLabel xml:lang="de">Personen, die bei Käufen für private Zwecke über das Internet Probleme hatten (2016-2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered problems when buying/ordering goods or services over the internet for private use (2016-2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré des problèmes lors de la commande de bien ou de services sur l&apos;internet à des fins privées (2016-2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BARRX"><skos:prefLabel xml:lang="de">Personen, die bei Käufen für private Zwecke über das Internet keine Probleme hatten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who did not encounter problems when buying/ordering goods or services over the internet for private use</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas rencontré des problèmes lors de la commande de biens ou de services sur l&apos;internet à des fins privés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BARRY"><skos:prefLabel xml:lang="de">Personen, die bei Käufen für private Zwecke über das Internet Probleme hatten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered problems when buying/ordering goods or services over the internet for private use</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré des problèmes lors de la commande de biens ou de services sur l&apos;internet à des fins privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCOM"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Schwierigkeiten bei Reklamationen und Mängelbehebung</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Complaints and redress were difficult</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: réclamations et recours difficiles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCPR"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten (bis 2020): Lieferkosten oder Endpreis höher als angegeben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Delivery costs or final price higher than indicated</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet (jusqu&apos;en 2020): frais de livraison ou prix final supérieurs à ceux indiqués</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCR"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten (bis 2019): Schwierigkeiten bei Reklamationen und Mängelbehebung oder keine zufrieden stellende Antwort auf Reklamation erhalten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet (until 2019): Complaints and redress were difficult or no satisfactory response received after complaint</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet (jusqu&apos;en 2019): plaintes et réclamations difficiles et absence de réponse satisfaisante après une réclamation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BDAM"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Lieferung beschädigter Waren</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Damaged goods delivered</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: biens livrés endommagés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BDC"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Höhere Lieferkosten als angegeben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Delivery costs higher than indicated</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: frais de livraison supérieurs à ceux indiqués</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BDGL"><skos:prefLabel xml:lang="de">Personen, die bei Bestellungen/Käufen über das Internet folgende Probleme hatten (bis 2019): Schwierigkeiten beim Finden von Information bzgl Garantien und anderer Rechte</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when buying/ordering over the Internet (until 2019): difficulties finding information concerning guarantees, other legal rights</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré les problèmes suivant lors de la commande sur internet (jusqu&apos;en 2019): problèmes de trouver des informations sur la garantie et autres dispositions légales</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BDNS"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Ausländische Händler verkaufen nicht in das Land des Käufers  (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when buying/ordering over the internet: foreign retailer did not sell in my country  (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur l&apos;internet: le vendeur étranger ne vendait pas dans le pays de l&apos;acheteur (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFRA"><skos:prefLabel xml:lang="de">Personen, die bei Bestellungen/Käufen über das Internet folgende Probleme hatten (bis 2019): Opfer von Betrügereien</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when buying/ordering over the Internet (until 2019): problems with fraud</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré les problèmes suivant lors de la commande sur internet jusqu&apos;en 20220): problèmes de fraude</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BGUA"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Unsicherheit hinsichtlich der Garantien</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Difficulties concerning guarantees</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: problèmes concernant la garantie</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BOTH"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Anderes Problem</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Other</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: autre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BPRC"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Endpreis höher als angegeben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Final price higher than indicated</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: prix final supérieur à celui indiqué</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BRES"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Keine zufrieden stellende Antwort auf Reklamation erhalten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: No satisfactory response received after complaint</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: absence de réponse satisfaisante après une réclamation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSEC"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Unzureichende Zahlungssicherheit</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Lack of security of payments</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: sécurité de paiement insuffisante</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSPD"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten (bis 2020): Längere Lieferzeit als angegeben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet (until 2020): Speed of delivery longer than indicated</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet (jusqu&apos;en 2020): Délai de livraison plus long que celui indiqué</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BTFW"><skos:prefLabel xml:lang="de">Personen, die bei Bestellungen/Käufen über das Internet folgende Probleme hatten: technische Probleme (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when buying/ordering over the Internet: technical failure (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré les problèmes suivant lors de la commande sur internet: problèmes techniques (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BWD"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Lieferung falscher oder beschädigter Waren</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Wrong or damaged goods delivered</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: biens livrés erronés ou endommagés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BWDN"><skos:prefLabel xml:lang="de">Personen, die bei Bestellungen/Käufen über das Internet folgende Probleme hatten (bis 2019): falsche oder beschädigte Güter/Dienstleistungen geliefert</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when buying/ordering over the Internet (until 2019): wrong or damaged good/services delivered</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré les problèmes suivant lors de la commande sur internet (jusqu&apos;en 2019): livraison de biens ou services non commandés ou endommagés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BWRG"><skos:prefLabel xml:lang="de">Personen, die bei Käufen über das Internet folgendes Problem hatten: Falsche Waren geliefert</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered the following problem when making purchases over the Internet: Wrong goods delivered</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré le problème suivant lors de leurs achats sur internet: erreur dans les produits livrés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_BLT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr Waren oder Dienstleistungen für den privaten Gebrauch über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who ordered goods or services, over the internet, for private use, in the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant commandé des biens ou des services sur l&apos;internet pour leur usage privé au cours de l&apos;année précédente</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">174194</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" 