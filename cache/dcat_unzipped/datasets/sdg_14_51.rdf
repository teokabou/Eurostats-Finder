<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/sdg_14_51"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-15</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Meeresbecken</dcat:keyword><dcat:keyword  xml:lang="en">Sea basins</dcat:keyword><dcat:keyword  xml:lang="fr">Bassins maritimes</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Mean surface seawater acidity</dct:title><dct:description xml:lang="en">&lt;p&gt;This indicator shows the yearly mean concentration of hydrogen ions in surface seawater in the northeastern Atlantic and adjacent seas, expressed in nanomoles per litre (nmol/l). An increase in the concentration of hydrogen ions corresponds to a decline in pH value and an increase in seawater acidity. This trend is caused by an increase in atmospheric carbon dioxide (CO2) concentrations, which increases the uptake of CO2 by the ocean. The &lt;a href=&quot;https://resources.marine.copernicus.eu/product-detail/GLOBAL_OMI_HEALTH_carbon_ph_area_averaged/INFORMATION&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: windowtext;&quot;&gt;Copernicus Marine Service&lt;/a&gt; has reconstructed the trends in global ocean acidification from 1985 onwards.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Acidité moyenne de l’eau de mer de surf</dct:title><dct:description xml:lang="fr">&lt;p&gt;Cet indicateur montre la concentration annuelle moyenne des ions hydrogène dans l’eau de mer de surface dans l’Atlantique du Nord-Est et les mers adjacentes, exprimée en nanomoles par litre (nmol/l). Une augmentation de la concentration des ions hydrogène correspond à une diminution de valeur de pH et à une augmentation de l’acidité de l’eau de mer. Cette tendance est due à une augmentation des concentrations de dioxyde de carbone (CO2) dans l’atmosphère, qui augmente l’absorption de CO2 par les océans. Le Service marin de Copernicus a reconstruit les tendances de l’acidification mondiale des océans à partir de 1985.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Mittlerer Säuregehalt des Oberflächenmeereswassers</dct:title><dct:description xml:lang="de">&lt;p&gt;Dieser Indikator zeigt die jährliche mittlere Konzentration von Wasserstoffionen im Oberflächenmeereswasser des Nordostatlantiks und angrenzenden Meeren, ausgedrückt in Nanomol pro Liter (nmol/l). Ein Anstieg der Konzentration von Wasserstoffionen entspricht einem Rückgang des pH-Wertes und einem Anstieg des Säuregehaltes im Meerwasser. Dieser Trend ist auf einen Anstieg der Konzentrationen von Kohlendioxid (CO2) in der Atmosphäre zurückzuführen, welcher wiederum die Aufnahme von CO2 im Ozean erhöht. Der Copernicus Marine Service hat die Trends bei der weltweiten Übersäuerung der Ozeane ab 1985 rekonstruiert.&lt;/p&gt;</dct:description><dct:identifier>sdg_14_51</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_14_51"/><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SEABASIN" > <skos:prefLabel xml:lang="de">Meeresbecken</skos:prefLabel><skos:prefLabel xml:lang="en">Sea basins</skos:prefLabel><skos:prefLabel xml:lang="fr">Bassins maritimes</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=NMOL_L"><skos:prefLabel xml:lang="de">Nanomol pro Liter</skos:prefLabel><skos:prefLabel xml:lang="en">Nanomoles per litre</skos:prefLabel><skos:prefLabel xml:lang="fr">Nanomoles par litre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PH"><skos:prefLabel xml:lang="de">pH-Wert</skos:prefLabel><skos:prefLabel xml:lang="en">pH value</skos:prefLabel><skos:prefLabel xml:lang="fr">Valeur du pH</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-19</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1985-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_14_51"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/sdg_14_51</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/databrowser/view/sdg_14_51/default/table"><dct:title xml:lang="en">Table, graphs and map visualizations are also available.</dct:title><dct:title xml:lang="fr">Des visualisations sous forme de tableau, graphique et carte géographique sont aussi disponibles.</dct:title><dct:title xml:lang="de">Tabellen, Grafiken und geografische Darstellungen sind ebenfalls verfügbar.</dct:title><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/sdg_14_51/default/table"/><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/VISUALIZATION"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_14_51?format=tsv&amp;compressed=true"><dct:title xml:lang="en">Download dataset in TSV format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_14_51?format=tsv&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_14_51?format=tsv&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/TSV"/></dct:format><dcat:mediaType rdf:res