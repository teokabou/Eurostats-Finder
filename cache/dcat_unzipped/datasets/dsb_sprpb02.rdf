<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/dsb_sprpb02"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-04</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Geschlecht</dcat:keyword><dcat:keyword  xml:lang="en">Sex</dcat:keyword><dcat:keyword  xml:lang="fr">Sexe</dcat:keyword><dcat:keyword  xml:lang="de">Pensionstyp</dcat:keyword><dcat:keyword  xml:lang="en">Pension type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de pension</dcat:keyword><dcat:keyword  xml:lang="de">Mit Bedürftigkeitsprüfung</dcat:keyword><dcat:keyword  xml:lang="en">Means testing</dcat:keyword><dcat:keyword  xml:lang="fr">Sous condition de ressources</dcat:keyword><dcat:keyword  xml:lang="de">Systemkategorie</dcat:keyword><dcat:keyword  xml:lang="en">Category of schemes</dcat:keyword><dcat:keyword  xml:lang="fr">Catégorie de régimes</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Beneficiaries of disability pensions by sex</dct:title><dct:description xml:lang="en">&lt;p&gt;The data relate to the number of beneficiaries of disability pensions (disability pension or early retirement benefit due to reduced capacity to work) by sex at 31st December. The data source is the European system of integrated social protection statistics (ESSPROS).&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Bénéficiaires de pensions d’invalidité par sexe</dct:title><dct:description xml:lang="fr">&lt;p&gt;Les données concernent le nombre de bénéficiaires de pensions d’invalidité (pension d&apos;invalidité, préretraite pour cause de réduction de la capacité de travail) par sexe au 31 Décembre. La source des données est le système européen de statistiques intégrées de la protection sociale (Sespros).&lt;/p&gt;</dct:description><dct:title xml:lang="de">Leistungsempfänger von Invaliditätsrenten insgesamt nach Geschlecht</dct:title><dct:description xml:lang="de">&lt;p&gt;Die Daten beziehen sich auf die Zahl der Leistungsempfänger von Invaliditätsrenten (Invaliditätsrente, Vorruhestandsgeld bei geminderter Erwerbsfähigkeit) nach Geschlecht am 31. Dezember. Die Datenquelle ist das Europäische System integrierter Sozialschutzstatistiken (ESSOSS).&lt;/p&gt;</dct:description><dct:id