<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_cisci_pb"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-12-09</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Security related problems experienced when using the internet (2004-2019)</dct:title><dct:description xml:lang="en">Security related problems experienced when using the internet (2004-2019)</dct:description><dct:title xml:lang="fr">Problèmes de sécurité subis en utilisant l&apos;internet (2004-2019)</dct:title><dct:description xml:lang="fr">Problèmes de sécurité subis en utilisant l&apos;internet (2004-2019)</dct:description><dct:title xml:lang="de">Aufgetretene Sicherheitsprobleme bei der Internet-Nutzung (2004-2019)</dct:title><dct:description xml:lang="de">Aufgetretene Sicherheitsprobleme bei der Internet-Nutzung (2004-2019)</dct:description><dct:identifier>isoc_cisci_pb</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_pb"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SCPCHLD"><skos:prefLabel xml:lang="de">Starke Bedenken bezüglich sowie bereits erfolgter Zugriff von Kindern auf ungeeignete Internetseiten oder Internetkontakten zu gefährlichen Personen über einen Computer im Haushalt</skos:prefLabel><skos:prefLabel xml:lang="en">Strongly concerned about and experienced children accessing inappropriate web-sites or connecting with potentially dangerous persons from a computer within the household</skos:prefLabel><skos:prefLabel xml:lang="fr">Fortement préoccupé et ayant vécu l&apos;accès des enfants à des sites web pour adultes, ou leur mise en relation avec des personnes pouvant être dangereuses</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SCPFLPP"><skos:prefLabel xml:lang="de">Starke Bedenken bezüglich finanzieller Schäden sowie bereits erlittene finanzielle Schäden durch Phishing oder Pharming</skos:prefLabel><skos:prefLabel xml:lang="en">Strongly concerned about and experienced financial loss as a result of receiving fraudulent messages (&apos;phishing&apos;) or getting redirected to fake websites asking for personal information (&apos;pharming&apos;)</skos:prefLabel><skos:prefLabel xml:lang="fr">Fortement préoccupé et ayant subi une perte d&apos;argent suite à la réception de messages frauduleux (phishing) ou par redirection vers de faux sites web demandant des informations personnelles (pharming)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SCPFRD"><skos:prefLabel xml:lang="de">Starke Bedenken bezüglich sowie bereits erlittener finanzieller Schäden durch Missbrauch der Kredit- oder Geldkarte</skos:prefLabel><skos:prefLabel xml:lang="en">Strongly concerned about and experienced financial loss due to fraudulent payment (credit or debit) card use</skos:prefLabel><skos:prefLabel xml:lang="fr">Fortement préoccupé et ayant subi une perte d&apos;argent suite à une fraude à la carte bancaire</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SCPPIF"><skos:prefLabel xml:lang="de">Starke Bedenken bezüglich Missbrauch persönlicher Daten sowie bereits aufgetretener Missbrauch von über das Internet gesendeter Daten und/oder sonstiger Verletzungen der Privatsphäre (z.B. Missbrauch von Fotos, Videos, persönlicher Daten auf Gemeinschaftswebseiten)</skos:prefLabel><skos:prefLabel xml:lang="en">Strongly concerned about and experienced abuse of personal information sent on the internet and/or other privacy violations (e.g. abuse of pictures, videos, personal data uploaded on community websites)</skos:prefLabel><skos:prefLabel xml:lang="fr">Fortement préoccupé et ayant subi un abus concernant des informations personnelles envoyées sur l&apos;internet ou d&apos;autres violations de la vie privée (p. ex. abus de photos, vidéos, données personnelles chargées sur des sites appartenant à des communautés)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SCPSPM"><skos:prefLabel xml:lang="de">Starke Bedenken bezüglich unerwünschter E-Mails (Spams) sowie bereits erhaltene Spams</skos:prefLabel><skos:prefLabel xml:lang="en">Strongly concerned about and received unsolicited emails (&apos;Spam&apos;)</skos:prefLabel><skos:prefLabel xml:lang="fr">Fortement préoccupé et ayant reçu des emails non sollicités (spams)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SCPVIR"><skos:prefLabel xml:lang="de">Starke Bedenken bezüglich Infizierung von Computern sowie bereits aufgetretene Infizierung (z.B. Würmer oder Trojaner) mit resultierendem Daten- oder Zeitverlust</skos:prefLabel><skos:prefLabel xml:lang="en">Strongly concerned about and have caught a virus or other computer infection (e.g. worm or Trojan horse) resulting in loss of information or time</skos:prefLabel><skos:prefLabel xml:lang="fr">Fortement préoccupé et ayant attrapé un virus ou autre infection de l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SEC0"><skos:prefLabel xml:lang="de">Keine Sicherheitsprobleme aufgetreten</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced no security related problem</skos:prefLabel><skos:prefLabel xml:lang="fr">N&apos;ayant subi aucun problème de sécurité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SEC1"><skos:prefLabel xml:lang="de">Eine oder mehrere der folgenden 3 Sicherheitsprobleme sind aufgetreten: i_ secpif1, i_secflpp, i_secfrd1</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced any of the following security related problems: i_secpif1, i_secflpp, i_secfrd1</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi un des problèmes suivants: i_secpif1, i_secflpp, i_secfrd1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SEC2"><skos:prefLabel xml:lang="de">Eine oder mehrere der folgenden 4 Sicherheitsprobleme sind aufgetreten: i_secvir1, i_secpif1, i_secflpp, i_secfrd1</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced any of the following security related problems: i_secvir1, i_secpif1, i_secflpp, i_secfrd1</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi un des problèmes suivants: i_secvir1, i_secpif1, i_secflpp, i_secfrd1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY"><skos:prefLabel xml:lang="de">Eine oder mehrere der folgenden Sicherheitsprobleme sind aufgetreten: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI oder I_SECPHA</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced any of the following security related incidents: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI or I_SECPHA</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi un des incidents de sécurité suivants: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI or I_SECPHA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY4"><skos:prefLabel xml:lang="de">Eine oder mehrere der folgenden 4 Sicherheitsprobleme sind aufgetreten: i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced any of the following security related problems: i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi un des problèmes suivants: i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY4BUY"><skos:prefLabel xml:lang="de">Internetkäufe getätigt sowie von einem oder mehreren der folgenden 4 Sicherheitsproblemen betroffen: i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="en">Bought over the internet and experienced any of the following security related problem: i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant acheté sur l&apos;internet et subi des problèmes de sécurité suivants: i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY5"><skos:prefLabel xml:lang="de">Eine oder mehrere der folgenden 5 Sicherheitsprobleme sind aufgetreten: i_secvir1, i_secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced any of the following security related problems: i_secvir1, i_secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi un des problèmes suivants: i_secvir1, i_secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY6"><skos:prefLabel xml:lang="de">Eine oder mehrere der folgenden 6 Sicherheitsprobleme sind aufgetreten: i_secvir1, i_secspm, i_secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced any of the following security related problems: i_secvir1, i_secspm, i_secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi un des problèmes suivants: i_secvir1, i_secspm, i_secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY6BUY"><skos:prefLabel xml:lang="de">Internetkäufe getätigt sowie von einem oder mehreren der folgenden 6 Sicherheitsproblemen betroffen: i_secvir1, i_secspm, i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="en">Bought over the internet and experienced any of the following security related problems: i_secvir1, i_secspm, i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant acheté sur l&apos;internet et subi des problèmes de sécurité suivants: i_secvir1, i_secspm, i_ secpif1, i_secflpp, i_secfrd1, i_secchld</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY_BK"><skos:prefLabel xml:lang="de">Internetbanking in den letzten 3 Monaten verwendet und eine oder mehrere der folgenden Sicherheitsprobleme sind in den letzten 12 Monaten aufgetreten: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI oder I_SECPHA</skos:prefLabel><skos:prefLabel xml:lang="en">Done internet banking in the last 3 months and experienced in the last 12 months any of the security related incidents: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI or I_SECPHA</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé un service de banque en ligne au cours des trois derniers mois et ayant subi un des incidents de sécurité suivants: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI or I_SECPHA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECANY_BUY"><skos:prefLabel xml:lang="de">Internetkäufe getätigt sowie von einem oder mehreren der folgenden Sicherheitsproblemen betroffen: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI oder I_SECPHA</skos:prefLabel><skos:prefLabel xml:lang="en">Bought over the internet and experienced any of the security related incidents: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI or I_SECPHA</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant acheté sur l&apos;internet et subi un des incidents de sécurité suivants: I_SECFRD2, I_SECVIR1, I_SECMPI, I_SECSNH, I_SECOIT, I_SECPHI or I_SECPHA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECCHLD"><skos:prefLabel xml:lang="de">Zugriff von Kindern auf ungeeignete Internetseiten oder Internetkontakte von Kindern zu gefährlichen Personen über einen Computer im Haushalt</skos:prefLabel><skos:prefLabel xml:lang="en">Children accessing inappropriate web-sites or connecting with potentially dangerous persons from a computer within the household</skos:prefLabel><skos:prefLabel xml:lang="fr">L&apos;accès des enfants à des sites web pour adultes, ou leur mise en relation avec des personnes pouvant être dangereuses</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECCHLD1"><skos:prefLabel xml:lang="de">Zugriff von Kindern auf für Kinder ungeeignete Websites</skos:prefLabel><skos:prefLabel xml:lang="en">Children accessing inappropriate web-sites</skos:prefLabel><skos:prefLabel xml:lang="fr">Enfants accédant à des sites web inappropriés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECFL"><skos:prefLabel xml:lang="de">Finanzielle Schäden erlitten</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced financial loss</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi une perte d&apos;argent</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECFL2"><skos:prefLabel xml:lang="de">Finanzielle Verluste erlitten aufgrund von Identitätsdiebstahl, dem Empfang betrügerischer Nachrichten oder der Umleitung auf gefälschte Webseiten</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced financial loss resulting from identity theft, receiving fraudulent messages or being redirected to fake websites</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant subi une perte d&apos;argent à la suite d&apos;un vol d&apos;identité en ligne, de la réception de messages frauduleux ou du renvoi vers des sites internet falsifiés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECFLPP"><skos:prefLabel xml:lang="de">Finanzielle Schäden durch betrügerische E-Mails (Phishing) oder durch Umleitung auf gefälschte Internetseiten (Pharming)</skos:prefLabel><skos:prefLabel xml:lang="en">Financial loss as a result of receiving fraudulent messages (&apos;phishing&apos;) or getting redirected to fake websites asking for personal information (&apos;pharming&apos;)</skos:prefLabel><skos:prefLabel xml:lang="fr">Perte d&apos;argent suite à la réception de messages frauduleux (phishing) ou suite à la redirection vers de faux sites web demandant des informations personnelles (pharming)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECFRD1"><skos:prefLabel xml:lang="de">Finanzielle Schäden durch Missbrauch der Kredit- oder Geldkarte</skos:prefLabel><skos:prefLabel xml:lang="en">Financial loss due to fraudulent payment (credit or debit) card use</skos:prefLabel><skos:prefLabel xml:lang="fr">Perte d&apos;argent suite à une fraude à la carte bancaire</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECFRD2"><skos:prefLabel xml:lang="de">Missbrauch der Kredit- / Debit-Karte</skos:prefLabel><skos:prefLabel xml:lang="en">Fraudulent credit or debit card use</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation frauduleuse de cartes de crédit ou de débit</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECMPI"><skos:prefLabel xml:lang="de">Missbrauch persönlicher im Internet verfügbarer Daten, der zu Diskriminierung, Belästigung oder Mobbing geführt hat</skos:prefLabel><skos:prefLabel xml:lang="en">Misuse of personal information available on the Internet resulting in e.g. discrimination, harassment, bullying</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation abusive d&apos;informations personnelles disponibles sur internet, résultant en une forme de discrimination, d&apos;intimidation ou de harcèlement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECOIT"><skos:prefLabel xml:lang="de">Identitätsdiebstahl im Internet (Diebstahl der persönlichen Daten einer Person und Annahme von deren Identität, z. B. für Einkäufe unter deren Namen)</skos:prefLabel><skos:prefLabel xml:lang="en">Online identity theft (somebody stealing individuals&apos; personal data and impersonating individuals e.g. shopping under an individual&apos;s name)</skos:prefLabel><skos:prefLabel xml:lang="fr">Vol d&apos;identité en ligne (quelqu&apos;un vole les données personnelles de l&apos;individu et se fait passer pour lui, afin, par exemple, d&apos;effectuer des achats sous le nom de cet individu)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECPHA"><skos:prefLabel xml:lang="de">Umleitung auf gefälschte Webseiten mit der Aufforderung zur Angabe persönlicher Informationen (&apos;Pharming&apos;)</skos:prefLabel><skos:prefLabel xml:lang="en">Getting redirected to fake websites asking for personal information (&apos;pharming&apos;)</skos:prefLabel><skos:prefLabel xml:lang="fr">Renvoi vers des sites falsifiés qui demandent des informations personnelles (pharming)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECPHI"><skos:prefLabel xml:lang="de">Empfang betrügerischer Nachrichten (&apos;Phishing&apos;)</skos:prefLabel><skos:prefLabel xml:lang="en">Receiving fraudulent messages (&apos;phishing&apos;)</skos:prefLabel><skos:prefLabel xml:lang="fr">Réception de messages frauduleux (hameçonnage)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECPIF1"><skos:prefLabel xml:lang="de">Missbrauch persönlicher über das Internet gesendeter Daten und/oder sonstige Verletzungen der Privatsphäre (z.B. Missbrauch von Fotos, Videos, persönlicher Daten auf Gemeinschaftswebseiten)</skos:prefLabel><skos:prefLabel xml:lang="en">Abuse of personal information sent on the internet and/or other privacy violations (e.g. abuse of pictures, videos, personal data uploaded on community websites)</skos:prefLabel><skos:prefLabel xml:lang="fr">Abus concernant des informations personnelles envoyées sur l&apos;internet ou autre violation de la vie privée (p. ex. abus de photos, vidéos, données personnelles chargées sur des sites appartenant à des communautés)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECPIFSN"><skos:prefLabel xml:lang="de">Soziale Netzwerke verwendet sowie Missbrauch von persönliche über das Internet gesendeter Daten und/oder Verletzung der Privatsphäre aufgetreten</skos:prefLabel><skos:prefLabel xml:lang="en">Done social networking in the last 3 months and experienced in the last 12 months abuse of personal information sent on the internet and/or other privacy violations</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant participé dans un réseau social pendant les 3 derniers mois et subi un abus concernant des informations personnelles envoyées sur l&apos;internet ou d&apos;autres violations de la vie privée pendant les 12 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECSNH"><skos:prefLabel xml:lang="de">Das soziales Netzwerk oder E-Mail-Konto der Person wurde gehackt, und die Inhalte wurden ohne deren Wissen veröffentlicht / gepostet oder versandt</skos:prefLabel><skos:prefLabel xml:lang="en">Social network or e-mail account being hacked and content being posted or sent without individuals&apos; knowledge</skos:prefLabel><skos:prefLabel xml:lang="fr">Piratage du compte de réseau social ou de messagerie électronique de l&apos;individu et publication ou envoi du contenu à l&apos;insu de ce dernier</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECSPM"><skos:prefLabel xml:lang="de">Empfang unerwünschter E-Mails (Spam)</skos:prefLabel><skos:prefLabel xml:lang="en">Unsolicited emails sent to individual (&apos;Spam&apos;)</skos:prefLabel><skos:prefLabel xml:lang="fr">Reçu des emails non sollicités (spams)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECVIR1"><skos:prefLabel xml:lang="de">Verlust von Dokumenten, Bildern oder anderen Daten aufgrund eines Virus oder einer anderen Schadsoftware ( z. B. Wurm, Trojaner )</skos:prefLabel><skos:prefLabel xml:lang="en">Loss of documents, pictures or other data due to a virus or other computer infection (e.g. worm or Trojan horse)</skos:prefLabel><skos:prefLabel xml:lang="fr">Perte de documents, d&apos;images ou d&apos;autres données à cause d&apos;un virus ou d&apos;autres infections (telles que ver ou cheval de Troie)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_SECOITPP"><skos:prefLabel xml:lang="de">Prozent der Personen, bei denen Identitätsdiebstahl im Internet, Phishing oder Pharming aufgetreten ist</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have experienced online identity theft, phishing or pharming</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant subi un vol d&apos;identité en ligne, de l&apos;hameçonnage ou du pharming</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">187964</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_pb"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_pb</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm"><dct:title xml:lang="en">ESM