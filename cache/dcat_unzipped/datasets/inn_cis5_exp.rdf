rostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ROEK06"><skos:prefLabel xml:lang="de">Ausgaben für die Anschaffung von anderem externen Wissen im Jahr 2006</skos:prefLabel><skos:prefLabel xml:lang="en">Expenditure for acquisition of other external knowledge in 2006</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses pour l&apos;acquisition d&apos;autres connaissances externes en 2006</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ROEK_YES"><skos:prefLabel xml:lang="de">Unternehmen, die Wissen von außen erwerben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises, engaged in aquisition of other external knowledge</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises engagées dans l&apos;acquisition d&apos;autres connaissances externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ROTHE_YES"><skos:prefLabel xml:lang="de">Unternehmen, die andere Innovationstätigkeiten betreiben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises, engaged in other innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises engagées dans d&apos;autres activités liées à l&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=RRDEX06"><skos:prefLabel xml:lang="de">Ausweitung der außerbetrieblichen FuE im Jahr 2006</skos:prefLabel><skos:prefLabel xml:lang="en">Expenditure in extramural R&amp;D in 2006</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses de R&amp;D extra-muros en 2006</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/a