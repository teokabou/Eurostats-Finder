></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CEMF"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme des Fernzugriffs auf das E-Mail-System des Unternehmens vollständig auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in the remote access to the e-mail system of the enterprise which was fully due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation de l&apos;utilisation de l’accès à distance au système de courrier électronique de l’entreprise était entièrement due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CEMP"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme des Fernzugriffs auf das E-Mail-System des Unternehmens teilweise auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in the remote access to the e-mail system of the enterprise which was partly due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation de l&apos;utilisation de l’accès à distance au système de courrier électronique de l’entreprise était partiellement due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CEMX"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme des Fernzugriffs auf das E-Mail-System des Unternehmens keineswegs auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in the remote access to the e-mail system of the enterprise which was not at all due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation de l&apos;utilisation de l’accès à distance au système de courrier électronique de l’entreprise n&apos;était pas due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CRAF"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme des Fernzugriffs auf andere IKT-Systeme des Unternehmens, mit Ausnahme von E-Mails, vollständig auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in the remote access to the ICT systems of the enterprise other than e-mail which was fully due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation de l&apos;utilisation de l’accès à distance aux systèmes informatiques de l’entreprise autres que le courrier électronique était entièrement due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CRAP"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme des Fernzugriffs auf andere IKT-Systeme des Unternehmens, mit Ausnahme von E-Mails, teilweise auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in the remote access to the ICT systems of the enterprise other than e-mail which was partly due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation de l&apos;utilisation de l’accès à distance aux systèmes informatiques de l’entreprise autres que le courrier électronique était partiellement due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CRAX"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme von dem Fernzugriff auf andere IKT-Systeme des Unternehmens, mit Ausnahme von E-Mails, keineswegs auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase of the percentage of persons employed having remote access to the ICT systems of the enterprise other than e-mail and which was not at all due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation de l&apos;utilisation de l’accès à distance aux systèmes informatiques de l’entreprise autres que le courrier électronique n&apos;était pas due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CRMF"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme in der Zahl der vom Unternehmen abgehaltenen virtuellen Sitzungen vollständig auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in number of remote meetings conducted by the enterprise which was fully due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation du nombre de réunions à distance organisées par l’entreprise était entièrement due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CRMP"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme in der Zahl der vom Unternehmen abgehaltenen virtuellen Sitzungen teilweise auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in number of remote meetings conducted by the enterprise which was partly due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation du nombre de réunions à distance organisées par l’entreprise était partiellement due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_CRMX"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Zunahme in der Zahl der vom Unternehmen abgehaltenen virtuellen Sitzungen keineswegs auf die Covid-19-Pandemie zurückzuführen war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with an increase in number of remote meetings conducted by the enterprise which was not at all due to the Covid-19 pandemic</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises, dont l&apos;augmentation du nombre de réunions à distance organisées par l’entreprise n&apos;était pas due à la pandémie de Covid-19</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IEM"><skos:prefLabel xml:lang="de">Im Jahr 2020 hat das Unternehmen den Prozentsatz der Beschäftigten mit Fernzugriff auf das E-Mail-System des Unternehmens erhöht</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, enterprises have increased the percentage of persons employed having remote access to its e-mail system</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, l’entreprise a augmenté le pourcentage de salariés ayant un accès à distance au système de courrier électronique de l’entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IEMX"><skos:prefLabel xml:lang="de">Im Jahr 2020 hat das Unternehmen den Prozentsatz der Beschäftigten mit Fernzugriff auf das E-Mail-System des Unternehmens nicht erhöht</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, the enterprise has not increased the percentage of persons employed having remote access to its e-mail system</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, l’entreprise n&apos;a pas augmenté le pourcentage de salariés ayant un accès à distance au système de courrier électronique de l’entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IESI"><skos:prefLabel xml:lang="de">Im Jahr 2020 begannen oder verstärkten die Unternehmen  aufgrund der Covid-19-Pandemie ihre Bemühungen, Waren oder Dienstleistungen über das Internet zu verkaufen</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, due to the Covid-19 pandemic, the enterprise started or increased efforts to sell goods or services via internet</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, en raison de la pandémie de Covid-19, l&apos;entreprise a démarré ou augmenté la vente de biens ou de services par internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IESIX"><skos:prefLabel xml:lang="de">Im Jahr 2020 haben die Unternehmen aufgrund der Covid-19-Pandemie nicht begonnen oder ihre Bemühungen verstärkt, Waren oder Dienstleistungen über das Internet zu verkaufen</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, due to the Covid-19 pandemic, the enterprise did not start or increase efforts to sell goods or services via internet</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, en raison de la pandémie de Covid-19, l&apos;entreprise n&apos;a pas démarré ou augmenté la vente de biens ou de services par internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IRA"><skos:prefLabel xml:lang="de">Im Jahr 2020 hat das Unternehmen den Prozentsatz der Beschäftigten mit Fernzugriff auf andere IKT-Systeme des Unternehmens (außer E-Mail) erhöht</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, enterprises have increased the percentage of persons employed having remote access to the ICT systems of the enterprise other than e-mail</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, l’entreprise a augmenté le pourcentage de salariés ayant un accès à distance aux systèmes informatiques de l’entreprise autres que le courrier électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IRAX"><skos:prefLabel xml:lang="de">Im Jahr 2020 hat das Unternehmen den Prozentsatz der Beschäftigten mit Fernzugriff auf andere IKT-Systeme des Unternehmens (außer E-Mail) nicht erhöht</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, the enterprise has not increased the percentage of persons employed having remote access to the ICT systems of the enterprise other than e-mail</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, l’entreprise n&apos;a pas augmenté le pourcentage de salariés ayant un accès à distance aux systèmes informatiques de l’entreprise autres que le courrier électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IRM"><skos:prefLabel xml:lang="de">Im Jahr 2020 hat das Unternehmen die Zahl der vom Unternehmen virtuell veranstalteten Sitzungen erhöht (z.B. über Skype, Zoom, MS Teams usw.)</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, enterprises have increased the number of remote meetings conducted by the enterprise (e.g. via Skype, Zoom, MS Teams, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, l’entreprise a augmenté le nombre de réunions à distance organisées par l’entreprise (p.ex. via Skype, Zoom, MS Teams, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CVD_IRMX"><skos:prefLabel xml:lang="de">Im Jahr 2020 hat das Unternehmen die Zahl der vom Unternehmen virtuell veranstalteten Sitzungen nicht erhöht (z.B. über Skype, Zoom, MS Teams usw.)</skos:prefLabel><skos:prefLabel xml:lang="en">During 2020, the enterprise has not increased the number of remote meetings conducted by the enterprise (e.g. via Skype, Zoom, MS Teams, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">En 2020, l’entreprise n&apos;a pas augmenté le nombre de réunions à distance organisées par l’entreprise (p.ex. via Skype, Zoom, MS Teams, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CVD_IEM"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die den Anteil der Beschäftigen mit Fernzugriff auf ihr E-Mail-System erhöht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which increased the percentage of persons employed having remote access to their e-mail system</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant augmenté le pourcentage de personnes occupées ayant un accès à distance à leur système de courrier électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CVD_IRA"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die den Anteil der Beschäftigen mit Fernzugriff auf andere IKT-Systeme des Unternehmens (außer E-Mails) erhöht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which increased the percentage of persons employed having remote access their ICT systems other than e-mail</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant augmenté le pourcentage depersonnes occupées ayant un accès à distance aux systèmes informatiques de l’entreprise autres que le courrier électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CVD_IRM"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die die Zahl vom virtuell veranstalteten Sitzungen erhöht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which increased the number of their remote meetings</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant augmenté le nombre de leurs réunions à distance</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">49717</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-12</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_e_cvdn2"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_e_cvdn2</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_e_cvdn2"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resour