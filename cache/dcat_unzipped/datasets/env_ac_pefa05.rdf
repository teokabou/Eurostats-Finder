issemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA" > <skos:prefLabel xml:lang="de">Indikatoren der physischen Energieflusskonten</skos:prefLabel><skos:prefLabel xml:lang="en">Physical energy flow accounts indicators</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateurs des flux physiques d&apos;énergie</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=ADJ_SD"><skos:prefLabel xml:lang="de">Andere Anpassungen und statistische Abweichungen</skos:prefLabel><skos:prefLabel xml:lang="en">Other adjustments and statistical differences</skos:prefLabel><skos:prefLabel xml:lang="fr">Autres ajustements et écarts statistiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=ADJ_SD_DUXGIC"><skos:prefLabel xml:lang="de">Andere Anpassungen und statistische Abweichungen -  darunter solche Energieflüsse, die im Energieverbrauch von gebietsansässigen Einheiten enthalten und gleichzeitig vom Bruttoinlandsenergieverbrauch ausgeschlossen sind</skos:prefLabel><skos:prefLabel xml:lang="en">Other adjustments and statistical differences - energy flows included in energy use by resident units (net domestic energy use) while excluded in gross inland energy consumption</skos:prefLabel><skos:prefLabel xml:lang="fr">Autres ajustements et  écarts statistiques - flux d&apos;énergie inclus dans l&apos;utilisation d&apos;énergie par les unités résidentes (utilisation intérieure d&apos;énergie nette), mais exclus de la consommation d&apos;énergie intérieure brute</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_RES"><skos:prefLabel xml:lang="de">Energieverbrauch von gebietsansässigen Einheiten</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by resident units</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;énergie par les unités résidentes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_RES_ABR"><skos:prefLabel xml:lang="de">Energieverbrauch von gebietsansässigen Einheiten, im Ausland gekaufte Treibstoffe - insgesamt</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by resident units, fuel purchased abroad - total</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’énergie par les unités résidentes, carburant acheté à l’étranger - total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_RES_ABR_ATR"><skos:prefLabel xml:lang="de">Energieverbrauch von gebietsansässigen Einheiten, im Ausland gekaufte Treibstoffe - Luftverkehr</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by resident units, fuel purchased abroad - air transport</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’énergie par les unités résidentes, carburant acheté à l’étranger - transport aérien</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_RES_ABR_FWTR"><skos:prefLabel xml:lang="de">Energieverbrauch von gebietsansässigen Einheiten, im Ausland gekaufte Treibstoffe - Fischereifahrzeuge</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by resident units, fuel purchased abroad - fishing vessels</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’énergie par les unités résidentes, carburant acheté à l’étranger - navires de pêche</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_RES_ABR_LTR"><skos:prefLabel xml:lang="de">Energieverbrauch von gebietsansässigen Einheiten, im Ausland gekaufte Treibstoffe - Landverkehr</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by resident units, fuel purchased abroad - land transport</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’énergie par les unités résidentes, carburant acheté à l’étranger - transport terrestre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_RES_ABR_WTR"><skos:prefLabel xml:lang="de">Energieverbrauch von gebietsansässigen Einheiten, im Ausland gekaufte Treibstoffe - Wasserverkehr</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by resident units, fuel purchased abroad - water transport</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’énergie par les unités résidentes, carburant acheté à l’étranger - transport par voies fluviales et maritimes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_TER"><skos:prefLabel xml:lang="de">Bruttoinlandsenergieverbrauch (Territorial-Prinzip)</skos:prefLabel><skos:prefLabel xml:lang="en">Gross inland energy consumption (territory principle)</skos:prefLabel><skos:prefLabel xml:lang="fr">Consommation d&apos;énergie intérieure brute (principe du territoire)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_TER_NRES"><skos:prefLabel xml:lang="de">Energieverbrauch von nicht-gebietsansässigen Einheiten (sofern er im Bruttoinlandsenergieverbrauch enthalten ist), im Inland gekaufte Treibstoffe - insgesamt</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by non-resident units (only if included in gross inland energy consumption), fuel purchased on the territory - total</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;énergie par des unités non résidentes (uniquement si incluse dans la consommation intérieure d&apos;énergie brute), carburant acheté sur le territoire - total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_TER_NRES_ATR"><skos:prefLabel xml:lang="de">Energieverbrauch von nicht-gebietsansässigen Einheiten (sofern er im Bruttoinlandsenergieverbrauch enthalten ist), im Inland gekaufte Treibstoffe - Luftverkehr</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by non-resident units (only if included in gross inland energy consumption), fuel purchased on the territory - air transport</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;énergie par des unités non résidentes (uniquement si incluse dans la consommation intérieure  d&apos;énergie brute), carburant acheté sur le territoire - transport aérien</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_TER_NRES_LTR"><skos:prefLabel xml:lang="de">Energieverbrauch von nicht-gebietsansässigen Einheiten (sofern er im Bruttoinlandsenergieverbrauch enthalten ist), im Inland gekaufte Treibstoffe - Landverkehr</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by non-resident units (only if included in gross inland energy consumption), fuel purchased on the territory - land transport</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;énergie par des unités non résidentes (uniquement si incluse dans la consommation intérieure d&apos;énergie brute), carburant acheté sur le territoire - transport terrestre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_PEFA?code=EUSE_TER_NRES_WTR"><skos:prefLabel xml:lang="de">Energieverbrauch von nicht-gebietsansässigen Einheiten (sofern er im Bruttoinlandsenergieverbrauch enthalten ist), im Inland gekaufte Treibstoffe - Wasserverkehr</skos:prefLabel><skos:prefLabel xml:lang="en">Energy use by non-resident units (only if included in gross inland energy consumption), fuel purchased on the territory - water transport</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;énergie par des unités non résidentes (uniquement si incluse dans la consommation intérieure d&apos;énergie brute), carburant acheté sur le territoire - transport par voies fluviales et maritimes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=TJ"><skos:prefLabel xml:lang="de">Terajoule</skos:prefLabel><skos:prefLabel xml:lang="en">Terajoule</skos:prefLabel><skos:prefLabel xml:lang="fr">Térajoule</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries r