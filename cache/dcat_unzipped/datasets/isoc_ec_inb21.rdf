opa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBCD"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate): Personen haben Bedenken hinsichtlich der Lieferkosten</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals have concerns about the cost of delivery of goods</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers sont préoccupés par le coût de la livraison des biens</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBDNS1"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate):  Ausländische Händler verkauften nicht in das Wohnsitzland der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): The foreign retailer did not sell to the country of the individual</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les vendeurs étrangers ne vendent pas à destination du pays du particulier</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBNND"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate): Es bestand für die Personen kein Bedarf, online zu kaufen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals had no need to buy on line</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers n&apos;ont pas eu la nécessité d&apos;acheter en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBOTH1"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate):  Personen hatten andere Gründen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals had other reasons</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers ont eu d&apos;autres raisons</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBPSC1"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate): Personen haben Bedenken hinsichtlich der Zahlungssicherheit oder der Privatsphäre</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals have concerns about payment security or privacy</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers sont préoccupés par la sécurité des paiements ou la vie privée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSHAB1"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate): Personen kaufen lieber persönlich im Geschäft bzw. möchten die Ware sehen, Treue zum Geschäft oder Gewohnheit</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals prefer to shop in person, they like to see product, loyalty to shops or force of habit</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers préfèrent acheter en personne et voir le produit, habitudes ou fidélité à des magasins</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSKL1"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate): Personen fehlen die notwendigen Kenntnisse</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals lack the necessary skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers ne possèdent pas les compétences requises à cette fin</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSR1"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate): Personen haben Bedenken hinsichtlich der Zuverlässigkeit und Schnelligkeit der Lieferung</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals have concerns about the reliability or speed of delivery</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers sont préoccupés par la fiabilité ou le délai de livraison</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBTRCM1"><skos:prefLabel xml:lang="de">Grund, nicht über eine Webseite oder App zu kaufen (3 Monate):  Personen haben Bedenken über Warenrücksendungen/ Reklamation / Erstattungen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not buying via a website or an app (3 months): Individuals have concerns about returning goods, complaints / reimbursement</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas acheter sur un site internet ou une app (3 mois): Les particuliers sont préoccupés par le retour des marchandises, les réclamations / remboursement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_BGT3_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben ohne online zu kaufen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet and did not purchase online in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisé l&apos;internet mais n&apos;ayant pas commandé en ligne au cours des 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50961</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource