refLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMDENC"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Verschlüßelungstechniken von Daten, Dokumenten oder E-Mails</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: encryption techniques for data, documents or e-mails</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: techniques de cryptage pour les données, les documents ou les courriels</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMDUO"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: mindestens zwei Authentifizierungsmechanismen (d. h. Kombination aus z. B. benutzerdefiniertem Passwort, Einmalpasswort (OTP), Code, der über ein Sicherheitstoken generiert oder über ein Smartphone empfangen wird, biometrische Verfahren)</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: combination of at least two authentication mechanisms (e.g. user-defined password, one-time password (OTP), code generated via a security token or received via a smartphone, biometric methods)</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure de sécurité informatique utilisée : combinaison d&apos;au moins deux mécanismes d&apos;authentification (par exemple: mot de passe défini par l&apos;utilisateur, mot de passe à usage unique (OTP), code généré par un jeton de sécurité ou reçu sur un smartphone, méthodes biométriques)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMOSBU"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Datensicherung an einem getrennten Speicherort (inkl. Sicherung in der Cloud)</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: data backup to a separate location (including backup to the cloud)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: sauvegarde des données dans un endroit distinct (y compris la sauvegarde sur le cloud)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMSPSW"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Authentifizierung über sichere Passwörter</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: strong password authentication</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: authentification par mot de passe sûr</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMUIBM"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Authentifizierung durch biometrische Erkennungsverfahren</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: authentication via biometric methods implemented by the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: authentification à l&apos;aide de méthodes biométriques mises en œuvre par l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17532</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-12</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-r