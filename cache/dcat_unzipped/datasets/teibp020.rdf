http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/BOP_ITEM" > <skos:prefLabel xml:lang="de">Zahlungsbilanz Position</skos:prefLabel><skos:prefLabel xml:lang="en">Balance of payments item</skos:prefLabel><skos:prefLabel xml:lang="fr">Poste de la balance des paiements</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CURRENCY" > <skos:prefLabel xml:lang="de">Währung</skos:prefLabel><skos:prefLabel xml:lang="en">Currency</skos:prefLabel><skos:prefLabel xml:lang="fr">Monnaie</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa