<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tps00215"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-07-25</dct:issued><dcat:keyword  xml:lang="de">Altersklasse</dcat:keyword><dcat:keyword  xml:lang="en">Age class</dcat:keyword><dcat:keyword  xml:lang="fr">Classe d&apos;âge</dcat:keyword><dcat:keyword  xml:lang="de">Dauer</dcat:keyword><dcat:keyword  xml:lang="en">Duration</dcat:keyword><dcat:keyword  xml:lang="fr">Durée</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Internationale Standardklassifikation des Bildungswesens (ISCED 2011)</dcat:keyword><dcat:keyword  xml:lang="en">International Standard Classification of Education (ISCED 2011)</dcat:keyword><dcat:keyword  xml:lang="fr">Classification Internationale Type de l&apos;Education (CITE 2011)</dcat:keyword><dcat:keyword  xml:lang="de">Geschlecht</dcat:keyword><dcat:keyword  xml:lang="en">Sex</dcat:keyword><dcat:keyword  xml:lang="fr">Sexe</dcat:keyword><dcat:keyword  xml:lang="de">Ausbildung</dcat:keyword><dcat:keyword  xml:lang="en">Training</dcat:keyword><dcat:keyword  xml:lang="fr">Formation</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dcat:keyword  xml:lang="de">Arbeitserfahrung im Studium</dcat:keyword><dcat:keyword  xml:lang="en">Work experience during studies</dcat:keyword><dcat:keyword  xml:lang="fr">Expérience professionnelle durant les études</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Exposure of VET graduates to work-based learning</dct:title><dct:description xml:lang="en">&lt;p&gt;Share of recent graduates from VET (vocational education and training) benefitting from exposure to work-based learning during their vocational education and training, according to the EU Labour Force Survey. The denominator covers people aged 20-34 with an upper secondary or post-secondary non-tertiary educational attainment of vocational orientation who had successfully completed their highest level of education in the last three years. The numerator covers those of the denominator who indicated a &quot;work experience while studying&quot; of at least one month (referring to work experiences at a workplace e.g. in a company, government institution or non-profit organisation that were part of the curriculum of the formal programme that led to the highest level of education successfully completed. Purely school-based work experiences are not considered).&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Exposition des diplômés de l’EFP à la formation par le travail</dct:title><dct:description xml:lang="fr">&lt;p&gt;Proportion de diplômés récents de l&apos;EFP (enseignement et formation professionnels) bénéficiant d&apos;une exposition à l&apos;apprentissage par le travail au cours de leur enseignement et formation professionnels, basé sur l&apos;Enquête&amp;nbsp;sur les forces de travail de l&apos;UE. Le dénominateur couvre les personnes âgées de 20 à 34 ans ayant un diplôme de second cycle d&apos;enseignement secondaire ou post-secondaire non supérieur à orientation professionnelle qui ont réussi leur plus haut niveau d&apos;études au cours des trois dernières années. Le numérateur couvre ceux du dénominateur qui ont indiqué une &quot;expérience de travail pendant les études&quot; d&apos;au moins un mois (faisant référence à des expériences de travail sur un lieu de travail, par ex. dans une entreprise, une institution gouvernementale ou une organisation à but non lucratif qui faisaient partie du programme d&apos;études du programme formel qui a conduit au plus haut niveau d&apos;études complété avec succès. Les expériences de travail purement scolaires ne sont pas prises en compte).&lt;/p&gt;</dct:description><dct:title xml:lang="de">Lernen am Arbeitsplatz in der beruflichen Aus- und Weiterbildung</dct:title><dct:description xml:lang="de">&lt;p&gt;Anteil der Absolventen im berufsbildenden Bereich, die kürzlich ihre Abschlussprüfung bestanden haben und während ihrer Ausbildung von Lernen am Arbeitsplatz profitiert haben, berechnet anhand der EU-Arbeitskräfteerhebung. Der Nenner umfasst Personen im Alter von 20-34 Jahren mit einem Abschluss im Sekundarbereich II oder im postsekundären, nicht tertiären Bereich mit berufsbildender Orientierung, die in den letzten drei Jahren ihren höchsten Bildungsabschluss erfolgreich abgeschlossen haben. Der Zähler umfasst diejenigen des Nenners, die eine studienbegleitende Berufserfahrung von mindestens einem Monat angegeben haben (bezieht sich auf Arbeitserfahrungen an einem Arbeitsplatz, z.B. in einem Unternehmen, einer staatlichen Einrichtung oder einer gemeinnützigen Organisation, die Teil des Lehrplans des formalen Programms waren, das zum erfolgreich abgeschlossenen höchsten Bildungsabschluss führte. Rein schulische Arbeitserfahrungen werden nicht berücksichtigt).&lt;/p&gt;</dct:description><dct:identifier>tps00215</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tps00215"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LIE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/AGE" > <skos:prefLabel xml:lang="de">Altersklasse</skos:prefLabel><skos:prefLabel xml:lang="en">Age class</skos:prefLabel><skos:prefLabel xml:lang="fr">Classe d&apos;âge</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/DURATION" > <skos:prefLabel xml:lang="de">Dauer</skos:prefLabel><skos:prefLabel xml:lang="en">Duration</skos:prefLabel><skos:prefLabel xml:lang="fr">Durée</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/E