c.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=MJAN"><skos:prefLabel xml:lang="de">Bevölkerung am 1. Januar - Männer</skos:prefLabel><skos:prefLabel xml:lang="en">Population on 1 January - males</skos:prefLabel><skos:prefLabel xml:lang="fr">Population au 1er janvier - hommes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=MLBIRTH"><skos:prefLabel xml:lang="de">Lebendgeburten - Männer</skos:prefLabel><skos:prefLabel xml:lang="en">Live births - males</skos:prefLabel><skos:prefLabel xml:lang="fr">Naissances vivantes - hommes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=NATGROW"><skos:prefLabel xml:lang="de">Natürliche Bevölkerungsveränderung</skos:prefLabel><skos:prefLabel xml:lang="en">Natural change of population</skos:prefLabel><skos:prefLabel xml:lang="fr">Variation naturelle de la population</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=NATGROWRT"><skos:prefLabel xml:lang="de">Rate der natürlichen Bevölkerungsveränderung</skos:prefLabel><skos:prefLabel xml:lang="en">Crude rate of natural change of population</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de variation naturelle de la population</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=NATT"><skos:prefLabel xml:lang="de">Summe der Geburten und Todesfälle</skos:prefLabel><skos:prefLabel xml:lang="en">Sum of births and deaths (natural turnover)</skos:prefLabel><skos:prefLabel xml:lang="fr">Somme des naissances et des décès</sko