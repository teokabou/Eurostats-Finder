nation/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP01_1D"><skos:prefLabel xml:lang="de">Trends der Studentenzahl (ISCED 5-6) (1 000)</skos:prefLabel><skos:prefLabel xml:lang="en">Trends in the number of students (ISCED 5-6) (1 000)</skos:prefLabel><skos:prefLabel xml:lang="fr">Tendance du nombre d&apos;étudiants (CITE 5-6) (1 000)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP01_2"><skos:prefLabel xml:lang="de">Frauen unter den Studenten der ISCED-Stufe 5-6 - in % aller Studenten dieser Stufe</skos:prefLabel><skos:prefLabel xml:lang="en">Women among students in ISCED 5-6 - as % of the total students at this level</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes parmi les étudiants au niveau CITE 5-6 - en % de l&apos;ensemble des étudiants de ce niveau</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP01_3"><skos:prefLabel xml:lang="de">Weibliche Studenten pro 100 männliche Studenten im Tertiärbildungsbereich (ISCED 5-6)</skos:prefLabel><skos:prefLabel xml:lang="en">Female students per 100 males in tertiary education (ISCED5-6)</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes pour 100 étudiants masculins dans l&apos;enseignement supérieur (ISCED 5-6)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP02_1"><skos:prefLabel xml:lang="de">Studenten der ISCED-Stufen 5-6, die in folgenden Fachrichtungen eingeschrieben sind: Wissenschaft, Mathematik, Informatik, Ingenieurwesen, Herstellung und Aufbau - in % aller Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students at ISCED levels 5-6 enrolled in the following fields: science, mathematics, computing, engineering, manufacturing, construction - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants inscrits aux niveaux CITE 5-6, dans les domaines suivants: sciences, mathématiques, informatique, ingénierie, industrie manufacturière, construction - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP02_2"><skos:prefLabel xml:lang="de">Weibliche Studenten der ISCED-Stufen 5-6, die in den folgenden Bereichen eingeschrieben sind: Wissenschaft, Mathematik und Informatik; Ingenieurwesen, verarbeitendes Gewerbe und Bauwesen - in % aller weiblichen Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Female students at ISCED levels 5-6 enrolled in the following fields: science, mathematics and computing; engineering, manufacturing and construction - as % of all female students</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes aux niveaux 5-6 de la CITE inscrites dans les domaines suivants: science, mathématiques et sciences informatiques; ingénierie, industries de transformation et production - en % de toutes les femmes étudiantes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP02_3"><skos:prefLabel xml:lang="de">Männliche Studenten der ISCED-Stufen 5-6, die in den folgenden Bereichen eingeschrieben sind: Wissenschaft, Mathematik und Informatik; Ingenieurwesen, verarbeitendes Gewerbe und Bauwesen - in % aller männlichen Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Male students at ISCED levels 5-6 enrolled in the following fields: science, mathematics and computing; engineering, manufacturing and construction - as % of all male students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants masculins aux niveaux 5-6 de la CITE inscrits dans les domaines suivants: science, mathématiques et sciences informatiques; ingénierie, industries de transformation et production - en % de tous les étudiants masculins</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_1"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die im Bildungsbereich eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesem Bereich</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in education field - as % of male and female students in this field</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes (CITE 5-6) inscrites dans le domaine de l&apos;éducation - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_11"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die im Bildungsbereich eingeschrieben sind - in % der gesamten Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in education field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits dans un domaine de l&apos;éducation - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_12"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die in Geisteswissenschaften und Kunst eingeschrieben sind - in % der gesamten Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in humanities and art field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits en lettres et art - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_13"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die in Sozial-, Rechts- und Wirtschaftswissenschaften eingeschrieben sind</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in social science, business and law field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits en sciences sociales, commerce et droit - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_14"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die in Wissenschaft, Mathematik und Computing eingeschrieben sind - in % der gesamten Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in science, mathematics and computing field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits en sciences, mathématiques et sciences informatiques - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_15"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die in Maschinenbau, Verarbeitungsindustrie und Bau eingeschrieben sind - in % der gesamten Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in engineering, manufacturing and construction field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits en ingénierie, industrie manufacturière et construction - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_16"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die in Ackerbau und Veterinärmedizin eingeschrieben sind - in % der gesamten Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in agriculture and veterinary field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits en agriculture et en médecine vétérinaire - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_17"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die im Bereich der Gesundheit und der Sozialleistungen eingeschrieben sind - in % der gesamten Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in health and welfare field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits dans le domaine de la santé et des services sociaux - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_18"><skos:prefLabel xml:lang="de">Studenten (ISCED-Stufen 5-6), die im Bereich der Dienstleistungen eingeschrieben sind - in % der gesamten Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) enrolled in services field - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) inscrits dans le domaine des services - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_2"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die in Geisteswissenschaften und Kunst eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesen Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in humanities and art field - as % of male and female students in these fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes inscrites (CITE 5-6) dans le domaine des lettres et de l&apos;art - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_3"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die in Sozial-, Rechts- und Wirtschaftswissenschaften eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesen Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in social science, business and law field - as % of male and female students in these fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes inscrites (CITE 5-6) dans le domaine des sciences sociales, de la gestion d&apos;entreprise, et du droit - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_4"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die in Wissenschaft, Mathematik und Informatik eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesen Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in science, mathematics and computing field - as % of male and female students in these fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes inscrites (CITE 5-6) dans le domaine des sciences, des mathématiques et de l&apos;informatique - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_5"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die in Ingenieurwesen, Herstellung und Aufbau eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesen Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in engineering, manufacturing and construction field - as % of male and female students in these fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes inscrites (CITE 5-6) dans le domaine de l&apos;ingénierie, de l&apos;industrie manufacturière et de la construction - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_6"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die in Landwirtschaft und im veterinärmedizinischem Bereich eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesen Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in agriculture and veterinary field - as % of male and female students in these fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes inscrites (CITE 5-6) dans le domaine agricole et vétérinaire - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_7"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die in Gesundheit und Sozialleistungen eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesen Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in health and welfare field - as % of male and female students in these fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes inscrites (CITE 5-6) dans le domaine de la santé et du bien-être - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_8"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die im Dienstleistungsbereich eingeschrieben sind - in % der männlichen und weiblichen Studenten in diesem Bereich</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in services field - as % of male and female students in this field</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes inscrites (CITE 5-6) dans le domaine des services - en % des étudiants masculins et féminins dans ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP03_9"><skos:prefLabel xml:lang="de">Weibliche Studenten (ISCED 5-6), die in einem unbekannten Bereich eingeschrieben sind - in % der männlichen und weiblichen Studenten dieses Bereiches</skos:prefLabel><skos:prefLabel xml:lang="en">Female students (ISCED 5-6) enrolled in unknown field - as % of male and female students in this field</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes étudiantes (CITE 5-6) inscrites dans un domaine inconnu - en % des étudiants hommes et femmes de ce domaine</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP04_1"><skos:prefLabel xml:lang="de">Studenten (ISCED 5-6), die in andere EU27-Staaten (2007-2013) studieren - in % aller Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) studying in another EU27 (2007-2013) - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) étudiant dans d&apos;autres pays UE27 (2007-2013) - en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP04_1D"><skos:prefLabel xml:lang="de">Studenten (ISCED 5-6), die in andere EU27-Staaten (2007-2013) studieren (1 000)</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) studying in another EU27 (2007-2013) (1 000)</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) étudiant dans d&apos;autres pays UE27 (2007-2013) (1 000)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP05_1"><skos:prefLabel xml:lang="de">Studenten (ISCED 5-6), die in andere EU27 (2007-2013)-, EWR-, Beitrittländern studieren - in % aller Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) studying in another EU27 (2007-2013), EEA or Candidate country - as % of all students</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) étudiant dans d&apos;autres pays UE27 (2007-2013), pays EEE ou pays candidats en % de l&apos;ensemble des étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP05_1D"><skos:prefLabel xml:lang="de">Studenten (ISCED 5-6), die in andere EU27 (2007-2013)-, EWR-, Beitrittländern studieren (1 000)</skos:prefLabel><skos:prefLabel xml:lang="en">Students (ISCED 5-6) studying in another EU27 (2007-2013), EEA or Candidate country (1 000)</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants (CITE 5-6) étudiant dans d&apos;autres pays UE27 (2007-2013), pays EEE ou pays candidats (1 000)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP05_3"><skos:prefLabel xml:lang="de">Ausländische Studierende aus den EU27 (2007-2013)/EWR/Beitrittländern, Tertiärbildungsbereich (ISCED 5-6) - in % aller Studenten</skos:prefLabel><skos:prefLabel xml:lang="en">Inflow of students (ISCED 5-6) from EU27 (2007-2013), EEA and Candidate countries - as % of all students in the country</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants non-nationaux des pays de l&apos;UE27 (2007-2013)/EEE/candidats, dans l&apos;enseignements supérieur (CITE 5 à 6) - en % de tous les étudiants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP05_3D"><skos:prefLabel xml:lang="de">Ausländische Studierende aus den EU27 (2007-2013)/EWR/Beitrittländern, Tertiärbildungsbereich (ISCED 5-6) (1 000)</skos:prefLabel><skos:prefLabel xml:lang="en">Inflow of students (ISCED 5-6) from EU27 (2007-2013), EEA and Candidate countries (1 000)</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants non-nationaux des pays de l&apos;UE27 (2007-2013)/EEE/candidats, enseignement supérieur (CITE 5-6) (1 000)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP06_1"><skos:prefLabel xml:lang="de">Medianalter im Tertiärbildungsbereich (ISCED 5-6)</skos:prefLabel><skos:prefLabel xml:lang="en">Median age in tertiary education (ISCED 5-6)</skos:prefLabel><skos:prefLabel xml:lang="fr">Age médian dans l&apos;enseignement supérieur (ISCED 5-6)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP06_2"><skos:prefLabel xml:lang="de">Zentil von 15-Jährigen im Tertiärbereich (ISCED 5-6)</skos:prefLabel><skos:prefLabel xml:lang="en">Centile 15 age in tertiary education (ISCED 5-6)</skos:prefLabel><skos:prefLabel xml:lang="fr">Centile des personnes âgées de 15 ans dans l&apos;enseignement post-secondaire (CITE 5-6)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP06_3"><skos:prefLabel xml:lang="de">Zentil von 85-Jährigen im Tertiärbereich (ISCED 5-6)</skos:prefLabel><skos:prefLabel xml:lang="en">Centile 85 age in tertiary education (ISCED 5-6)</skos:prefLabel><skos:prefLabel xml:lang="fr">Centile des personnes âgées de 85 ans dans l&apos;enseignement post-secondaire (CITE 5-6)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP07_1"><skos:prefLabel xml:lang="de">Studienanfänger im theoretischen Studienanfangsalter der ISCED-Stufe 5 in % aller Personen in der entsprechenden Altersgruppe</skos:prefLabel><skos:prefLabel xml:lang="en">Entrants at theoretical starting age in ISCED level 5 as % of all persons of the corresponding age group</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants entrants à l&apos;âge théorique de début des études au niveau CITE 5 en % des personnes appartenant au groupe d&apos;âge correspondant</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TP07_2"><skos:prefLabel xml:lang="de">Studienanfänger im theoretischen Studienanfangsalter der ISCED-Stufe 5 in % aller Studienanfänger der ISCED-Stufe 5</skos:prefLabel><skos:prefLabel xml:lang="en">Entrants at the theoretical starting age in ISCED level 5 as % of all entrants in ISCED level 5</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants entrants à l&apos;âge théorique de début des études au niveau CITE 5 en % de tous les étudiants entrants au niveau CITE 5</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1242</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/JUST" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/HEAL" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-03-15</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1998-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-12-31</dcat:endDate></dct:PeriodOfTime><