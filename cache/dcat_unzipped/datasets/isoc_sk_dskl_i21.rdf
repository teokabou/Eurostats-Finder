:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_AB"><skos:prefLabel xml:lang="de">Personen, die insgesamt höher als grundlegende digitale Kenntnisse haben (alle fünf Teilindikatoren sind höher als grundlegend)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with above basic overall digital skills (all five component indicators are at above basic level)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences numériques générales avancées (toutes les cinq composantes de l&apos;indicateur composite sont de niveau avancé)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_B"><skos:prefLabel xml:lang="de">Personen, die insgesamt grundlegende digitale Kenntnisse haben (alle fünf Teilindikatoren sind grundlegend oder höher als grundlegend, jedoch nicht alle höher als grundlegend)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic overall digital skills (all five component indicators are at basic or above basic level, without being all above basic)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences numériques générales de base (toutes les cinq composantes de l&apos;indicateur composite sont de niveau de base ou avancé, sans être toutes avancées)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_BAB"><skos:prefLabel xml:lang="de">Personen, die insgesamt grundlegende oder höher als grundlegende digitale Kenntnisse haben (alle fünf Teilindikatoren sind grundlegend oder höher als grundlegend)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic or above basic overall digital skills (all five component indicators are at basic or above basic level)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences numériques générales de base ou avancées (toutes les cinq composantes de l&apos;indicateur composite sont de niveau de base ou avancé)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_CC_AB"><skos:prefLabel xml:lang="de">Personen, die höher als grundlegende Kenntnisse bezüglich Kommunikation und Zusammenarbeit über das Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with above basic communication and collaboration skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences avancées en communication et en collaboration sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_CC_B"><skos:prefLabel xml:lang="de">Personen, die grundlegende Kenntnisse bezüglich Kommunikation und Zusammenarbeit über das Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic communication and collaboration skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base en communication et en collaboration sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_CC_BAB"><skos:prefLabel xml:lang="de">Personen, die grundlegende oder höher als grundlegende Kenntnisse bezüglich Kommunikation und Zusammenarbeit über das Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic or above basic communication and collaboration skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base ou avancées en communication et en collaboration sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_DCC_AB"><skos:prefLabel xml:lang="de">Personen, die höher als grundlegende Kenntnisse zur Erstellung von digitalen Inhalten haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with above basic digital content creation skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences avancées en création de contenu sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_DCC_B"><skos:prefLabel xml:lang="de">Personen, die grundlegende Kenntnisse zur Erstellung von digitalen Inhalten haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic digital content creation skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base en création de contenu sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_DCC_BAB"><skos:prefLabel xml:lang="de">Personen, die grundlegende oder höher als grundlegende Kenntnisse zur Erstellung von digitalen Inhalten haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic or above basic digital content creation skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base ou avancées en création de contenu sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_IC_S"><skos:prefLabel xml:lang="de">Personen, die Kenntnisse zur Informationsbeschaffung über das Internet und zur Kommunikation haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with online information and communication skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences pour se procurer de l&apos;information sur internet et en communication</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_IL_AB"><skos:prefLabel xml:lang="de">Personen, die höher als grundlegende Kenntnisse zur Informationsbeschaffung über das Internet und zur Datenkompetenz haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with above basic information and data literacy skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences avancées pour se procurer de l&apos;information sur internet et en littératie numérique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_IL_B"><skos:prefLabel xml:lang="de">Personen, die grundlegende Kenntnisse zur Informationsbeschaffung über das Internet und zur Datenkompetenz haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic information and data literacy skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base pour se procurer de l&apos;information sur internet et en littératie numérique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_IL_BAB"><skos:prefLabel xml:lang="de">Personen, die grundlegende oder höher als grundlegende Kenntnisse zur Informationsbeschaffung über das Internet und zur Datenkompetenz haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic or above basic information and data literacy skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base ou avancées pour se procurer de l&apos;information sur internet et en littératie numérique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_LM"><skos:prefLabel xml:lang="de">Personen, die insgesamt limitierte digitale Kenntnisse haben (zwei von fünf Teilindikatoren sind grundlegend oder höher als grundlegend)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with limited overall digital skills (two out of five component indicators are at basic or above basic level)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences numériques générales limitées (deux composantes de l&apos;indicateur composite sur cinq sont de niveau de base ou avancé)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_LW"><skos:prefLabel xml:lang="de">Personen, die insgesamt geringe digitale Kenntnisse haben (vier von fünf Teilindikatoren sind grundlegend oder höher als grundlegend)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with low overall digital skills (four out of five component indicators are at basic or above basic level)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant de faibles compétences numériques générales (quatre composantes de l&apos;indicateur composite sur cinq sont de niveau de base ou avancé)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_N"><skos:prefLabel xml:lang="de">Personen, die insgesamt eingeschränkte digitale Kenntnisse haben (drei von fünf Teilindikatoren sind grundlegend oder höher als grundlegend)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with narrow overall digital skills (three out of five component indicators are at basic or above basic level)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences numériques générales restreintes (trois composantes de l&apos;indicateur composite sur cinq sont de niveau de base ou avancé)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_NA"><skos:prefLabel xml:lang="de">Die digitalen Kompetenzen konnten nicht bewertet werden, da die Personen das Internet in den letzten 3 Monaten nicht genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Digital skills could not be assessed because the individual has not used the internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Les compétences numériques n&apos;ont pas pu être évaluées parce que les particuliers n&apos;ont pas utilisé internet dans les 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_PS_AB"><skos:prefLabel xml:lang="de">Personen, die höher als grundlegende Kenntnisse zur Problemlösung haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with above basic problem solving skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences avancées en résolution de problèmes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_PS_B"><skos:prefLabel xml:lang="de">Personen, die grundlegende Kenntnisse zur Problemlösung haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic problem solving skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base en résolution de problèmes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_PS_BAB"><skos:prefLabel xml:lang="de">Personen, die grundlegende oder höher als grundlegende Kenntnisse zur Problemlösung haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic or above basic problem solving skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base ou avancées en résolution de problèmes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_SF_AB"><skos:prefLabel xml:lang="de">Personen, die höher als grundlegende Kenntnisse zur Sicherheit im Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with above basic safety skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences avancées en matière de sécurité sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_SF_B"><skos:prefLabel xml:lang="de">Personen, die grundlegende Kenntnisse zur Sicherheit im Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic safety skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base en matière de sécurité sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_SF_BAB"><skos:prefLabel xml:lang="de">Personen, die grundlegende oder höher als grundlegende Kenntnisse zur Sicherheit im Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with basic or above basic safety skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences de base ou avancées en matière de sécurité sur internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_DSK2_X"><skos:prefLabel xml:lang="de">Personen, die insgesamt keine digitalen Kenntnisse haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals with no overall digital skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas de compétences numériques générales</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">206281</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept