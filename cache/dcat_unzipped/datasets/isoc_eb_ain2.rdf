untry/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AIX_CC1SIX_DA"><skos:prefLabel xml:lang="de">Unternehmen, die Datenanalysen durchführen, aber keine KI-Technologien nutzen und keine anspruchsvollen oder mittleren CC-Dienste kaufen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises perform data analytics, but don&apos;t use AI technologies and don&apos;t buy sophisticated or intermediate cloud computing services</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises effectuent des analyses de données, mais n&apos;utilisent pas les technologies d&apos;IA et n&apos;achètent pas de services de cloud computing sophistiqués ou intermédiaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AIX_CC1SI_DA"><skos:prefLabel xml:lang="de">Unternehmen, die anspruchsvolle oder mittlere CC-Dienste kaufen und Datenanalysen durchführen, aber keine KI-Technologien nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises buy sophisticated or intermediate cloud computing services and perform data analytics, but don&apos;t use AI technologies</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises achètent des services de cloud computing sophistiqués ou intermédiaires et effectuent des analyses de données, mais n&apos;utilisent pas les technologies d&apos;IA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AIX_CC1SI_DAX"><skos:prefLabel xml:lang="de">Unternehmen, die anspruchsvolle oder mittlere CC-Dienste kaufen, aber keine KI-Technologien nutzen und keine Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises buy sophisticated or intermediate cloud computing services, but don&apos;t use AI technologies and don&apos;t perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises achètent des services de cloud computing sophistiqués ou intermédiaires, mais n&apos;utilisent pas les technologies d&apos;IA et n&apos;effectuent pas d&apos;analyse de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_0"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Systeme (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises don&apos;t use any AI system (of E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas de système d&apos;IA (de E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_1"><skos:prefLabel xml:lang="de">Unternehmen verwenden eines der KI-Systeme (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use one AI system (of E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant un des systèmes d&apos;IA (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_2"><skos:prefLabel xml:lang="de">Unternehmen verwenden zwei der KI-Systeme (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use two AI systems (of E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant deux des systèmes d&apos;IA (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_3"><skos:prefLabel xml:lang="de">Unternehmen verwenden drei der KI-Systeme (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use three AI systems (of E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant  trois des systèmes d&apos;IA (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_4"><skos:prefLabel xml:lang="de">Unternehmen verwenden vier KI-Systeme (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use four AI systems (of E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant quatre des systèmes d&apos;IA (E_CHTB, E_BDAML, E_BDANL, E_RBTS)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_ADOWN"><skos:prefLabel xml:lang="de">Die KI-Technologien der Unternehmen wurden von eigenen Beschäftigten entwickelt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; AI technologies were developed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les technologies d&apos;IA utilisées par l&apos;entreprise sont des logiciels ou systèmes développés par son personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_AEXT"><skos:prefLabel xml:lang="de">Die KI-Technologien der Unternehmen wurden von externen Anbietern entwickelt oder modifiziert</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; AI technologies were  developed or modified by external providers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les technologies d&apos;IA utilisées par l&apos;entreprise sont des logiciels ou systèmes développés ou modifiés par des prestataires externes sous contrat</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_AMOWN"><skos:prefLabel xml:lang="de">Die KI-Technologien der Unternehmen waren kommerzielle Software oder von eigenen Beschäftigten modifizierte Systeme</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; AI technologies were commercial software or systems modified by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les technologies d&apos;IA utilisées par l&apos;entreprise sont des logiciels ou systèmes commerciaux modifiés par son personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_AOS"><skos:prefLabel xml:lang="de">Die KI-Technologien der Unternehmen waren Open-Source-Software oder von eigenen Beschäftigten modifizierte Systeme</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; AI technologies were open-source software or systems modified by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les technologies d&apos;IA utilisées par l&apos;entreprise sont des logiciels ou systèmes libres modifiés par son personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_ARDY"><skos:prefLabel xml:lang="de">Die KI-Technologien der Unternehmen waren kommerzielle Software oder einsatzbereite Systeme</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; AI technologies were commercial software or systems ready to use</skos:prefLabel><skos:prefLabel xml:lang="fr">Les technologies d&apos;IA utilisées par l&apos;entreprise sont des logiciels ou systèmes commerciaux achetés prêts à l’emploi</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BCDP"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien aufgrund von Bedenken hinsichtlich der Verletzung von Datenschutz und Privatsphäre</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because of concerns regarding violation of data protection and privacy</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA en raison de préoccupations concernant la violation de la protection des données et le respect de la vie privée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BCST"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien, weil die Kosten zu hoch erscheinen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because the costs seem too high</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA car les coûts semblent trop élevés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BDDT"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien aufgrund von Schwierigkeiten mit der Verfügbarkeit oder Qualität der erforderlichen Daten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because of difficulties with availability or quality of the necessary data</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA en raison de difficultés liées à la disponibilité ou à la qualité des données nécessaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BEC"><skos:prefLabel xml:lang="de">Die Unternehmen verwenden aus ethischen Überlegungen keine KI-Technologien</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because of ethical considerations</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA en raison de considérations éthiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BIAS"><skos:prefLabel xml:lang="de">Unternehmen, die über Maßnahmen verfügen, die von KI-Technologien erzeugten Ergebnisse auf mögliche Voreingenommenheit gegenüber Einzelpersonen zu überprüfen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises which have measures to check the results generated by AI technologies for possible biases towards individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui disposent de mesures de vérificaction des résultats générés par les technologies d&apos;IA afin de détecter d&apos;éventuels biais envers les individus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BIAS_ADOWN"><skos:prefLabel xml:lang="de">Unternehmen, die über Maßnahmen verfügen, die von KI erzeugten Ergebnisse auf mögliche Voreingenommenheit gegenüber Einzelpersonen zu überprüfen, und deren KI-Technologien von eigenen Beschäftigten entwickelt wurden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises which have measures to check the results generated by AI for possible biases towards individuals, and their AI technologies were developed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui disposent de mesures de vérification des résultats générés par l&apos;IA afin de détecter d&apos;éventuels biais envers les individus, et dont les technologies d&apos;IA ont été développées par leurs propres employés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BIAS_AEXT"><skos:prefLabel xml:lang="de">Unternehmen, die über Maßnahmen verfügen, die von KI erzeugten Ergebnisse auf mögliche Voreingenommenheit gegenüber Einzelpersonen zu überprüfen, und deren KI-Technologien von externen Anbietern entwickelt oder modifiziert wurden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises which have measures to check the results generated by AI for possible biases towards individuals, and their AI technologies were developed or modified by external providers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui disposent de mesures pour vérifier les résultats générés par l&apos;IA afin de détecter d&apos;éventuels biais envers les individus, et dont les technologies d&apos;IA ont été développées ou modifiées par des fournisseurs externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BIAS_AMOWN"><skos:prefLabel xml:lang="de">Unternehmen, die über Maßnahmen verfügen, um die von KI erzeugten Ergebnisse auf mögliche Voreingenommenheit gegenüber Einzelpersonen zu überprüfen, und deren KI-Technologien kommerzielle Software oder von eigenen Beschäftigten modifizierte Systeme waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises which have measures to check the results generated by AI for possible biases towards individuals, and their AI technologies were commercial software or systems modified by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui disposent de mesures pour vérifier les résultats générés par l&apos;IA afin de détecter d&apos;éventuels biais envers les individus, et dont les technologies d&apos;IA sont des logiciels commerciaux ou des systèmes modifiés par leurs propres employés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BIAS_AOS"><skos:prefLabel xml:lang="de">Unternehmen, die über Maßnahmen verfügen, die von KI erzeugten Ergebnisse auf mögliche Voreingenommenheit gegenüber Einzelpersonen zu überprüfen, und deren KI-Technologien Open-Source-Software oder von eigenen Beschäftigten modifizierte Systeme waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises which have measures to check the results generated by AI for possible biases towards individuals, and their AI technologies were open-source software or systems modified by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui disposent de mesures pour vérifier les résultats générés par l&apos;IA afin de détecter d&apos;éventuels biais envers les individus, et dont les technologies d&apos;IA sont des logiciels open source ou des systèmes modifiés par leurs propres employés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BIAS_ARDY"><skos:prefLabel xml:lang="de">Unternehmen, die über Maßnahmen verfügen, die von KI erzeugten Ergebnisse auf mögliche Voreingenommenheit gegenüber Einzelpersonen zu überprüfen, und deren KI-Technologien kommerzielle Software oder einsatzbereite Systeme waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises which have measures to check the results generated by AI for possible biases towards individuals, and their AI technologies were purchased commercial software or systems ready to use</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui disposent de mesures pour vérifier les résultats générés par l&apos;IA afin de détecter d&apos;éventuels biais envers les individus, et dont les technologies d&apos;IA ont été achetées en tant que logiciels commerciaux ou systèmes prêts à l&apos;emploi</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BINC"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien aufgrund von Inkompatibilität mit vorhandenen Geräten, Software oder Systemen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because of incompatibility with existing equipment, software or systems</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA en raison de l&apos;incompatibilité avec les équipements, logiciels ou systèmes existants</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BLE"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien mangels einschlägigem Fachwissen im Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because of a lack of relevant expertise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA en raison d&apos;un manque d’expertise dans l’entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BLEG"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien wegen Unklarheiten über die rechtlichen Folgen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because of a lack of clarity about the legal consequences</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA en raison d&apos;un manque de clarté quant aux conséquences juridiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_BNU"><skos:prefLabel xml:lang="de">Die Unternehmen verwenden keine KI-Technologien weil sie für das Unternehmen nicht sinnvoll sind</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies, because artificial Intelligence technologies are not useful for Enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA car elles sont pas utiles à l’entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen und kostenpflichtige Cloud Computing Dienste (CC-Dienste) über das Internet beziehen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies and buy any cloud computing services used over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies d&apos;intelligence artificielle et achètent des services de cloud computing utilisés sur Internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SIX_DA"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen und Datenanalysen durchführen, aber keine anspruchsvollen oder mittleren CC-Dienste kaufen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies and perform data analytics, but don&apos;t buy sophisticated or intermediate cloud computing services</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies d&apos;intelligence artificielle et effectuent des analyses de données, mais n&apos;achètent pas de services de cloud computing sophistiqués ou intermédiaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SIX_DAX"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen, aber keine anspruchsvollen oder mittleren CC-Dienste kaufen und keine Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies, but don&apos;t buy sophisticated or intermediate cloud computing services and don&apos;t perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies d&apos;intelligence artificielle, mais n&apos;achètent pas de services de cloud computing sophistiqués ou intermédiaires et n&apos;effectuent pas d&apos;analyse de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SI_DA"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen und anspruchsvolle oder mittlere CC-Dienste kaufen und Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies and buy sophisticated or intermediate cloud computing services and perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent des technologies d&apos;intelligence artificielle ou achètent des services de cloud computing sophistiqués ou intermédiaires ou effectuent des analyses de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SI_DASANY"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen oder anspruchsvolle oder mittlere CC-Dienste kaufen oder Datenanalysen von Daten aus beliebigen Datenquellen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies or buy sophisticated or intermediate cloud computing services or perform data analytics on data from any source</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent des technologies d&apos;intelligence artificielle ou achètent des services de cloud computing sophistiqués ou intermédiaires ou effectuent des analyses de données sur des données provenant de n&apos;importe quelle source</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SI_DASANY2"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen oder anspruchsvolle oder mittlere CC-Dienste kaufen oder Datenanalysen von Daten aus mindestens einer der folgenden Datenquellen durchführen: E_DASWEB, E_DASLOC, E_DASSDS, E_DASGOV und E_DASSAT</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies or buy sophisticated or intermediate cloud computing services or perform data analytics on data from any source among E_DASWEB, E_DASLOC, E_DASSDS, E_DASGOV and E_DASSAT</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent des technologies d&apos;intelligence artificielle ou achètent des services de cloud computing sophistiqués ou intermédiaires ou effectuent des analyses de données sur des données provenant de n&apos;importe quelle source parmi E_DASWEB, E_DASLOC, E_DASSDS, E_DASGOV et E_DASSAT</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SI_DASGE3"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen oder anspruchsvolle oder mittlere CC-Dienste kaufen oder Datenanalysen von Daten aus mindestens drei Datenquellen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies or buy sophisticated or intermediate cloud computing services or perform data analytics on data from at least three sources</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent des technologies d&apos;intelligence artificielle ou achètent des services de cloud computing sophistiqués ou intermédiaires ou effectuent des analyses de données sur des données provenant d&apos;au moins trois sources</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SI_DAX"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen und anspruchsvolle oder mittlere CC-Dienste kaufen, aber keine Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies and buy sophisticated or intermediate cloud computing services, but don&apos;t perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent des technologies d&apos;intelligence artificielle et achètent des services de cloud computing sophistiqués ou intermédiaires, mais n&apos;effectuent pas d&apos;analyse de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_CC1SI_DA_ANY"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen oder anspruchsvolle oder mittlere CC-Dienste kaufen oder Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies or buy sophisticated or intermediate cloud computing services or perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent des technologies d&apos;intelligence artificielle ou achètent des services de cloud computing sophistiqués ou intermédiaires ou effectuent des analyses de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_DA"><skos:prefLabel xml:lang="de">Unternehmen, die KI-Technologien nutzen und Datenanalysen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies and perform data analytics</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies d&apos;IA et effectuent des analyses de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_EC"><skos:prefLabel xml:lang="de">Unternehmen, die jemals in Erwägung gezogen haben, eine der KI-Technologien einzusetzen: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises who ever considered to use one of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises ayant déjà envisagé d’utiliser l’une des technologies d’IA : AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_P1ANY"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für mindestens einen der Gründe: AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for at least one of the purposes: AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies d&apos;IA pour au moins l&apos;un des objectifs : AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_P1GE2"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für mindestens zwei der Gründe: AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for at least two of the purposes: AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies d&apos;IA pour au moins deux des objectifs : AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_P1GE3"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für mindestens drei der Gründe: AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for at least three of the purposes: AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies d&apos;IA pour au moins trois des objectifs : AI_PMS, AI_PPP, AI_PBAM, AI_PLOG, AI_PITS, AI_PFIN, AI_PRDI</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PANY"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für mindestens einen der Gründe: AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for at least one of the purposes: AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour au moins une raison : (AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PBA"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für die Organisation von Unternehmensverwaltungsprozessen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for organisation of business administration processes</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour l’organisation des processus de gestion d’entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PBAM"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien zur Organisation von Unternehmensverwaltungsprozessen oder das Management</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for organisation of business administration processes or management</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies de l&apos;IA pour l&apos;organisation des processus d&apos;administration ou de gestion des affaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PBAMX"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien zur Organisation von Unternehmensverwaltungsprozessen oder das Management</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies for organisation of business administration processes or management</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises n&apos;utilisent pas les technologies d&apos;IA pour l&apos;organisation des processus d&apos;administration ou de gestion des affaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PDI"><skos:prefLabel xml:lang="de">Unternehmen, die Daten von Einzelpersonen mithilfe von KI-Technologien verarbeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises which process data on individuals using AI technologies</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui traitent des données sur les individus à l&apos;aide de technologies d&apos;IA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PFIN"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für Buchführung, Controlling oder Finanzverwaltung</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for accounting, controlling or finance management</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies de l&apos;IA pour la comptabilité, le contrôle ou la gestion financière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PFINX"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien für Buchführung, Controlling oder Finanzverwaltung</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies for accounting, controlling or finance management</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises n&apos;utilisent pas les technologies d&apos;IA pour la comptabilité, le contrôle ou la gestion financière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PGE2"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für mindestens zwei der Gründe: AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for at least two of the purposes: AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour au moins deux raisons : (AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PGE3"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für mindestens drei der Gründe: AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for at least three of the purposes: AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour au moins trois raisons : (AI_PMS, AI_PPP, AI_PBA, AI_PME, AI_PLOG, AI_PITS, AI_PHR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PHR"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für die Personalverwaltung oder Personaleinstellung</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for human resources management or recruiting</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour la gestion des ressources humaines ou le recrutement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PITS"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für die IKT-Sicherheit</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for ICT security</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour la sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PLOG"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für die Logistik</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for logistics</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour la logistique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PME"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für die Unternehmensführung</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for management of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour la gestion des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PMS"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für Marketing oder Verkauf</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for marketing or sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour la commercialisation ou la vente</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PPP"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für Produktionsprozesse</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for production processes</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA pour les processus de production</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PRDI"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien für Forschung und Entwicklung (F&amp;E) oder Innovationstätigkeit</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies for research and development (R&amp;D) or innovation activity</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises utilisent les technologies de l&apos;IA pour la recherche et le développement (R&amp;D) ou l&apos;activité d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_PRDIX"><skos:prefLabel xml:lang="de">Unternehmen verwenden keine KI-Technologien für Forschung und Entwicklung (F&amp;E) oder Innovationstätigkeit</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use AI technologies for research and development (R&amp;D) or innovation activity</skos:prefLabel><skos:prefLabel xml:lang="fr">Les entreprises n&apos;utilisent pas les technologies d&apos;IA pour la recherche et le développement (R&amp;D) ou l&apos;activité d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TANY"><skos:prefLabel xml:lang="de">Unternehmen verwenden mindestens eines der KI-Technologien: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use at least one of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant au moins une technologie d&apos;IA listées : (AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TAR"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien, die die physische Bewegung von Maschinen durch autonome Entscheidungen basierend auf der Beobachtung der Umgebung ermöglichen (autonome Roboter, selbstfahrende Autos, autonome Drohnen)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies enabling physical movement of machines via autonomous decisions based on observation of surroundings (autonomous robots, self-driving vehicles, autonomous drones)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA qui permettent la circulation physique de machines au moyen de décisions autonomes fondées sur l&apos;observation de l&apos;environnement (robots autonomes, véhicules autonomes, drones autonomes)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TGE2"><skos:prefLabel xml:lang="de">Unternehmen verwenden mindestens zwei der KI-Technologien: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use at least two of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant au moins deux technologies d&apos;IA listées : (AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TGE3"><skos:prefLabel xml:lang="de">Unternehmen verwenden mindestens drei der KI-Technologien: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use at least three of the  AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant au moins trois technologies d&apos;IA listées : (AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TIR"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien, die Objekte oder Personen auf der Grundlage von Bildern identifizieren (Bilderkennung, Bildverarbeitung)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies identifying objects or persons based on images (image recognition, image processing)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA qui identifient des objets ou des personnes à partir d&apos;images (reconnaissance d&apos;images, traitement d&apos;images)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TML"><skos:prefLabel xml:lang="de">Unternehmen verwenden Maschinelles Lernen (z.B. Deep Learning) zur Datenanalyse</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use machine learning (e.g. deep learning) for data analysis</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;apprentissage automatique (p.ex. apprentissage profond) pour l&apos;analyse de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TNLG"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien, die geschriebene oder gesprochene Sprache erzeugen (Generierung natürlicher Sprache)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies generating written or spoken language (natural language generation)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA qui produisent du langage écrit ou parlé (génération de langage naturel)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TPA"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien, die unterschiedliche Arbeitsabläufe automatisieren oder Entscheidungsfindung unterstützen (auf KI basierende und auf Software-Roboter gestützte Prozessautomatisierung)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies automating different workflows or assisting in decision making (AI based software robotic process automation)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA qui automatisent différents flux de travail ou qui aident à la prise de décision (automatisation des processus robotiques basée sur l&apos;IA)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TSR"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien, die gesprochene Sprache in ein maschinenlesbares Format umwandeln (Spracherkennung)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies converting spoken language into machine-readable format (speech recognition)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA qui convertissent la parole en un format lisible par une machine (reconnaissance vocale)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TTM"><skos:prefLabel xml:lang="de">Unternehmen verwenden KI-Technologien, die geschriebene Sprache analysieren (Textauswertung)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use AI technologies performing analysis of written language (text mining)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant les technologies d&apos;IA qui analysent le langage écrit (exploration de texte)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AI_TX"><skos:prefLabel xml:lang="de">Unternehmen verwenden keines der KI-Technologien: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises don&apos;t use any of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas les technologies d&apos;IA listées (AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_BDAML"><skos:prefLabel xml:lang="de">Unternehmen analysieren Big Data intern mittels Maschinellem Lernen (Machine Learning, Deep Learning)</skos:prefLabel><skos:prefLabel xml:lang="en">Analyse big data internally using machine learning</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises analysant des données massives en interne en utilisant le machine learning ou apprentissage automatique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_BDANL"><skos:prefLabel xml:lang="de">Unternehmen analysieren Big Data intern mittels automatischer Verarbeitung oder Generierung natürlicher Texte und Sprache (Natural Language Processing, Natural Language Generation)</skos:prefLabel><skos:prefLabel xml:lang="en">Analyse big data internally using natural language processing, natural language generation or speech recognition</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises analysant des données massives en interne en utilisant le natural language processing (NLP) ou traitement automatique du langage naturel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CHTB"><skos:prefLabel xml:lang="de">Unternehmen mit einem Chat-Service, bei dem ein Chatbot oder virtuelle Agenten automatisiert auf Kundenanfragen antworten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with a chat service where a chatbot or a virtual agent replies to customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un service de chat géré par un chatbot ou un agent virtuel répondant aux clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_HI_AI_TANY"><skos:prefLabel xml:lang="de">Unternehmen mit hoher digitaler Intensität, die beliebige KI-Technologien nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with high digital intensity index, which use any artificial intelligence technology</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à indice d&apos;intensité numérique élevé, qui utilisent une technologie d&apos;intelligence artificielle</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_LO_AI_TANY"><skos:prefLabel xml:lang="de">Unternehmen mit niedriger digitaler Intensität, die beliebige KI-Technologien nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with low digital intensity index, which use any artificial intelligence technology</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à faible indice d&apos;intensité numérique, qui utilisent une technologie d&apos;intelligence artificielle</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VHI_AI_TANY"><skos:prefLabel xml:lang="de">Unternehmen mit sehr hoher digitaler Intensität, die beliebig KI-Technologien nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very high digital intensity index, which use any artificial intelligence technology</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à très haut indice d&apos;intensité numérique, qui utilisent une technologie d&apos;intelligence artificielle</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_DI3_VLO_AI_TANY"><skos:prefLabel xml:lang="de">Unternehmen mit sehr niedriger digitaler Intensität, die beliebige KI-Technologien nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with very low digital intensity index, which use any artificial intelligence technology</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises à très faible indice d&apos;intensité numérique, qui utilisent une technologie d&apos;intelligence artificielle</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS"><skos:prefLabel xml:lang="de">Unternehmen, die Serviceroboter nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_AI_EC"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die jemals erwägt haben, eine der aufgeführten KI-Technologien einzusetzen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which ever considered to use any of the AI technologies</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises qui ont déjà envisagé d&apos;utiliser l’une des technologies d’IA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_AI_PDI"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die personenbezogene Daten mithilfe von KI-Technologies verarbeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which process data on individuals using AI technologies</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises qui traitent des données sur les individus à l&apos;aide de technologies d&apos;IA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_AI_TANY"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die mindestens eine KI-System verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises using at least one AI technologies</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant au moins une des technologies d&apos;IA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_AI_TX"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die keine KI-Systeme verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises using no AI technologies</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises n&apos;utilisant aucune technologies d&apos;IA</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">268184</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_ain2"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_ain2</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_ain2"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="htt