ut="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IP?code=TIPSBP70"><skos:prefLabel xml:lang="de">Finanzierungssaldo (Leistungs- und Vermögensübertragungsbilanz) - % des BIP</skos:prefLabel><skos:prefLabel xml:lang="en">Net Lending/Borrowing (current and capital account) - % of GDP</skos:prefLabel><skos:prefLabel xml:lang="fr">Capacité/besoin de financement (compte des transactions courantes et en capital) - % du PIB</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IP?code=TIPSBP90"><skos:prefLabel xml:lang="de">Verbindlichkeiten aus Direktinvestitionen (Ströme) - % des BIP</skos:prefLabel><skos:prefLabel xml:lang="en">Direct investment liabilities (flows) - % of GDP</skos:prefLabel><skos:prefLabel xml:lang="fr">Engagements au titre des investissements directs (flux) - % du PIB</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IP?code=TIPSCP10"><skos:prefLabel xml:lang="de">Kerninflationsgefälle gegenüber Euroraum</skos:prefLabel><skos:prefLabel xml:lang="en">Core inflation differential vis-à-vis EA</skos:prefLabel><skos:prefLabel xml:lang="fr">Différentiel d&apos;inflation sous-jacente par rapport à la zone euro</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IP?code=TIPSEN10"><skos:prefLabel xml:lang="de">Nettohandelsbilanz der Energieprodukte - % des BIP</skos:prefLabel><skos:prefLabel xml:lang="en">Net trade balance of energy products - % of GDP</skos:prefLabel><skos:prefLabel xml:lang="fr">Balance commerciale nette des produits énergétiques - % du PIB</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:abo