refLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_FIXBB"><skos:prefLabel xml:lang="de">Unternehmen, die DSL oder einen anderen festen Breitbandzugang verwenden (ab 2014)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use DSL or other fixed broadband connection (as of 2014)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant DSL ou une autre connexion fixe à large bande (à partir de 2014)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ISPDF1_30_100"><skos:prefLabel xml:lang="de">Die maximale vertraglich vereinbarte Download-Geschwindigkeit der schnellsten festen Internetverbindung des Unternehmens ist mindestens 30 Mbit/s aber weniger als 100 Mbit/s</skos:prefLabel><skos:prefLabel xml:lang="en">The maximum contracted download speed of the fastest fixed line internet connection is at least 30 Mb/s but less than 100 Mb/s</skos:prefLabel><skos:prefLabel xml:lang="fr">Vitesse de téléchargement maximale prévue par le contrat de la connexion internet fixe la plus rapide: de 30 à moins de 100 Mbit/s</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ISPDF1_GE100"><skos:prefLabel xml:lang="de">Die maximale vertraglich vereinbarte Download-Geschwindigkeit der schnellsten festen Internetverbindung des Unternehmens ist mindestens 100 Mbit/s</skos:prefLabel><skos:prefLabel xml:lang="en">The maximum contracted download speed of the fastest fixed line internet connection is at least 100 Mb/s</skos:prefLabel><skos:prefLabel xml:lang="fr">Vitesse de téléchargement maximale prévue par le contrat de la connexion internet fixe la plus rapide: 100 Mbit/s et plus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ISPDF1_GE30"><skos:prefLabel xml:lang="de">Die maximale vertraglich vereinbarte Download-Geschwindigkeit der schnellsten festen Internetverbindung des Unternehmens ist mindestens 30 Mbit/s</skos:prefLabel><skos:prefLabel xml:lang="en">The maximum contracted download speed of the fastest fixed line internet connection is at least 30 Mb/s</skos:prefLabel><skos:prefLabel xml:lang="fr">Vitesse de téléchargement maximale prévue par le contrat de la connexion internet fixe la plus rapide: 30 Mbit/s et plus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ISPDF_100_500"><skos:prefLabel xml:lang="de">Die maximale vertraglich vereinbarte Download-Geschwindigkeit der schnellsten festen Internetverbindung des Unternehmens ist mindestens 100 Mbit/s aber weniger als 500 Mbit/s</skos:prefLabel><skos:prefLabel xml:lang="en">The maximum contracted download speed of the fastest fixed line internet connection is at least 100 Mb/s but less than 500 Mb/s</skos:prefLabel><skos:prefLabel xml:lang="fr">Vitesse de téléchargement maximale prévue par le contrat de la connexion internet fixe la plus rapide: de 100 à moins de 500 Mbit/s</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ISPDF_500_1G"><skos:prefLabel xml:lang="de">Die maximale vertraglich vereinbarte Download-Geschwindigkeit der schnellsten festen Internetverbindung des Unternehmens ist mindestens 500 Mbit/s aber weniger als 1 Gbit/s</skos:prefLabel><skos:prefLabel xml:lang="en">The maximum contracted download speed of the fastest fixed line internet connection is at least 500 Mb/s but less than 1 Gb/s</skos:prefLabel><skos:prefLabel xml:lang="fr">Vitesse de téléchargement maximale prévue par le contrat de la connexion internet fixe la plus rapide: de 500 à moins de 1 Gbit/s</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ISPDF_GE1G"><skos:prefLabel xml:lang="de">Die maximale vertraglich vereinbarte Download-Geschwindigkeit der schnellsten festen Internetverbindung des Unternehmens ist mindestens 1 Gbit/s</skos:prefLabel><skos:prefLabel xml:lang="en">The maximum contracted download speed of the fastest fixed line internet connection is at least 1 Gb/s</skos:prefLabel><skos:prefLabel xml:lang="fr">Vitesse de téléchargement maximale prévue par le contrat de la connexion internet fixe la plus rapide: 1 Gbit/s et plus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ISPDF_LT30"><skos:prefLabel xml:lang="de">Die maximale vertraglich vereinbarte Download-Geschwindigkeit der schnellsten festen Internetverbindung des Unternehmens ist weniger als 30 Mbit/s</skos:prefLabel><skos:prefLabel xml:lang="en">The maximum contracted download speed of the fastest fixed line internet connection is less than 30 Mb/s</skos:prefLabel><skos:prefLabel xml:lang="fr">Vitesse de téléchargement maximale prévue par le contrat de la connexion internet fixe la plus rapide: moins de 30 Mbit/s</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_FIXBB"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die einen festen Breitbandzugang verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using a fixed broadband connection</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentrage d&apos;entreprises utilisant une connexion fixe à large bande</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40329</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat: