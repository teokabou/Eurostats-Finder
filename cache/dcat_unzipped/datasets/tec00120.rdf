ications.europa.eu/resource/authority/country/1A0"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/USA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/JPN"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NA_ITEM" > <skos:prefLabel xml:lang="de">Volkswirtschaftliche Gesamtrechnungen Indikator (ESVG 2010)</skos:prefLabel><skos:prefLabel xml:lang="en">National accounts indicator (ESA 2010)</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur des comptes nationaux (SEC 2010)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/PPP_CAT" > <skos:prefLabel xml:lang="de">Analytische Kategorien zur Berechnung der Kaufkraftparitäten (KKP)</skos:prefLabel><skos:prefLabel xml:lang="en">Analytical categories for purchasing power parities (PPPs) calculation</skos:prefLabel><skos:prefLabel xml:lang="fr">Catégories analytiques pour le calcul des parités de pouvoir d&apos;achat (PPA)<