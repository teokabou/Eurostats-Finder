<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/sdg_14_21"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-12</dct:issued><dcat:keyword  xml:lang="de">Fanggebiete</dcat:keyword><dcat:keyword  xml:lang="en">Fishing regions</dcat:keyword><dcat:keyword  xml:lang="fr">Zones de pêche</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Umweltindikator</dcat:keyword><dcat:keyword  xml:lang="en">Environment indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur de l&apos;environnement</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Estimated trends in fish stock biomass, by fishing areas</dct:title><dct:description xml:lang="en">&lt;p&gt;Fish stock biomass is a function of biological characteristics such as abundance and weight and can indicate the status of a fish stock when measured against reference values. This is a model-based indicator that is computed using results from single-species quantitative stock assessments. It shows the median value of fish stock biomass relative to 2003. The full time series is updated every year, sometimes including new stocks due to newly available quantitative assessments which can result in small differences from one release year to the next.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Tendances estimées de la biomasse du stock de poissons par zones de pêche</dct:title><dct:description xml:lang="fr">&lt;p&gt;La biomasse du stock de poissons est fonction de caractéristiques biologiques telles que l’abondance et le poids et peut indiquer l’état d’un stock de poissons lorsqu’elle est mesurée par rapport aux valeurs de référence. Il s’agit d’un indicateur basé sur des modèles qui est calculé à partir des résultats des évaluations quantitatives des stocks d’une seule espèce. Il montre la valeur médiane de la biomasse du stock de poissons par rapport à 2003. Les séries chronologiques complètes sont mises à jour chaque année, incluant parfois de nouveaux stocks en raison d’évaluations quantitatives nouvellement disponibles, ce qui peut entraîner de petites différences d’une année à l’autre.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Geschätzte Entwicklung der Fischbestandsbiomasse, nach Fischereigebieten</dct:title><dct:description xml:lang="de">&lt;p&gt;Die Biomasse des Fischbestands ist eine Funktion biologischer Merkmale wie Abundanz und Gewicht und kann den Status eines Fischbestands angeben, wenn er anhand von Referenzwerten gemessen wird. Dies ist ein modellbasierter Indikator, der anhand von Ergebnissen aus quantitativen Bestandsbewertungen einzelner Arten berechnet wird. Sie zeigt den Medianwert der Biomasse des Fischbestands im Vergleich zu 2003. Die Vollzeitreihe wird jedes Jahr aktualisiert, manchmal einschließlich neuer Bestände aufgrund neu verfügbarer quantitativer Bewertungen, die zu kleinen Unterschieden von einem Veröffentlichungsjahr zum nächsten führen können.&lt;/p&gt;</dct:description><dct:identifier>sdg_14_21</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_14_21"/><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FISHREG" > <skos:prefLabel xml:lang="de">Fanggebiete</skos:prefLabel><skos:prefLabel xml:lang="en">Fishing regions</skos:prefLabel><skos:prefLabel xml:lang="fr">Zones de pêche</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ENV" > <skos:prefLabel xml:lang="de">Umweltindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Environment indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur de l&apos;environnement</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ENV?code=FSTK_BMA_I03"><skos:prefLabel xml:lang="de">Biomasse von Fischbeständen - Index 2003 = 100</skos:prefLabel><skos:prefLabel xml:lang="en">Fish stock biomass - index 2003 = 100</skos:prefLabel><skos:prefLabel xml:lang="fr">Biomasse du stock de poissons - indice 2003 = 100</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-07</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2003-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_14_21"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/sdg_14_21</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/sdg_14_21_esmsip2.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https:/