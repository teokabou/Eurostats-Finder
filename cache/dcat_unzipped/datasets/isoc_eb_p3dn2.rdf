mbre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Druckern nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des imprimantes 3D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D1_OTH"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Druckdienste anderer Unternehmen nutzen (ab 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing services provided by other enterprises (as of 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des services d&apos;impression 3D fournis par d&apos;autres entreprises (à partir de 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D1_OWN"><skos:prefLabel xml:lang="de">Unternehmen, die firmeneigene 3D-Drucker nutzen (ab 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Use own 3D printers (as of 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des imprimantes 3D de l&apos;entreprise (à partir de 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_ANY"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Druckern für einen der aufgeführten Zwecke nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing, for any of the listed purposes</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant de l&apos;impression 3D pour au moins un des buts mentionnés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_NONE"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Druckern für keinen der aufgeführten Zwecke nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing, for none of the listed purposes</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant de l&apos;impression 3D, mais pour aucun des buts mentionnés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_OTH"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Druckdienste anderer Unternehmen nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing services provided by other enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des services d&apos;impression 3D fournis par d&apos;autres entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_OWN"><skos:prefLabel xml:lang="de">Unternehmen, die firmeneigene 3D-Drucker nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use own 3D printers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des imprimantes 3D de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_PGPP"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Drucker nutzen für Waren für innerbetriebliche Produktionsprozesse, ohne Prototypen oder Modelle</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing for goods to be used in the enterprise&apos;s production process, excluding prototypes or models</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant de l&apos;impression 3D pour produits à utiliser dans le processus de production de votre entreprise, à l&apos;exclusion des prototypes ou modèles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_PGS"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Drucker nutzen für Waren zum Verkauf, ohne Prototypen oder Modelle</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing for goods for sale, excluding prototypes or models</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant de l&apos;impression 3D pour produits à vendre à l&apos;exclusion des prototypes ou modèles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_PPMI"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Drucker nutzen für Prototypen oder Modelle für den innerbetrieblichen Gebrauch</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing for prototypes or models for internal use</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant de l&apos;impression 3D pour prototypes ou modèles à usage interne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_P3D_PPMS"><skos:prefLabel xml:lang="de">Unternehmen, die 3D-Drucker nutzen für Prototypen oder Modelle zum Verkauf</skos:prefLabel><skos:prefLabel xml:lang="en">Use 3D printing for prototypes or models for sale</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant de l&apos;impression 3D pour prototypes ou modèles à vendre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBT"><skos:prefLabel xml:lang="de">Unternehmen, die Industrie- oder Serviceroboter nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use industrial or service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots industriels ou de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTI"><skos:prefLabel xml:lang="de">Unternehmen, die Industrieroboter nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use industrial robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots industriels</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS"><skos:prefLabel xml:lang="de">Unternehmen, die Serviceroboter nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_ANY"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter für mindestens einen der aufgeführten Zwecke</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots, for any of the listed purposes</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour au moins un des buts mentionnés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_AW"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter für die Ausführung von Montagearbeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots for assembly works</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour les travaux d&apos;assemblage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_CDR"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter für Bau- oder Reparaturarbeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots for construction works or damage repair tasks</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour les travaux de construction ou les tâches de réparation des dommages</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_CWD"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter zur Reinigung oder Abfallentsorgung</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots for cleaning or waste disposal tasks</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour le nettoyage ou le traitement des déchets</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_GE2"><skos:prefLabel xml:lang="de">Unternehmen, die Serviceroboter für mindestens zwei Zwecke nutzen (von RBTS_SSI, RBTS_TPG, RBTS_CWD, RBTS_WMS, RBTS_AW, RBTS_SC, RBTS_CDR)</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots, for at least two purposes (of RBTS_SSI, RBTS_TPG, RBTS_CWD, RBTS_WMS, RBTS_AW, RBTS_SC, RBTS_CDR)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour au moins deux buts (de RBTS_SSI, RBTS_TPG, RBTS_CWD, RBTS_WMS, RBTS_AW, RBTS_SC, RBTS_CDR)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_NONE"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter, aber für keinen der aufgeführten Zwecke</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots, for none of the listed purposes</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service, mais pour aucun des buts mentionnés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_SC"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter zur Kundenbetreuung im Verkauf</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots for robotic store clerk tasks</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour l&apos;automatisation de la vente en magasin</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_SSI"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter für Überwachungs-, Sicherheits- oder Kontrolltätigkeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots for surveillance, security or inspection tasks</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour la surveillance, la sécurité ou l&apos;inspection</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_TPG"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter zur Beförderung von Personen oder Waren</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots for transportation of people or goods</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour le transport de personnes ou de biens</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTS_WMS"><skos:prefLabel xml:lang="de">Unternehmen nutzen Serviceroboter zur Lagerverwaltung</skos:prefLabel><skos:prefLabel xml:lang="en">Use service robots for warehouse management systems</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots de service pour la gestion d&apos;entrepôts</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWDR"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter teilweise wegen Schwierigkeiten bei der Personalrekrutierung</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, partly because of difficulties to recruit personnel</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots, en partie à cause de la difficulté à recruter du personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWDRX"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter aus anderen Gründen als Schwierigkeiten bei der Personalrekrutierung</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, but not because of difficulties to recruit personnel</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots, mais pas à cause de la difficulté à recruter du personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWER"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter, teilweise um das Angebot an vom Unternehmen produzierten Waren oder angebotenen Dienstleistungen zu erweitern</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, partly to expand the range of goods produced or services provided by the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise utilisant des robots, en partie pour élargir la gamme de biens produits ou de services fournis par l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWERX"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter aus anderen Gründen als um das Angebot an vom Unternehmen produzierten Waren oder angebotenen Dienstleistungen zu erweitern</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, but not to expand the range of goods produced or services provided by the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise utilisant des robots, mais pas pour élargir la gamme de biens produits ou de services fournis par l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWES"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter, teilweise um die Arbeitssicherheit zu erhöhen</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, partly to enhance safety at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots, en partie pour améliorer la sécurité au travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWESX"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter aus anderen Gründen als um die Arbeitssicherheit zu erhöhen</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, but not to enhance safety at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots, mais pas pour améliorer la sécurité au travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWHCL"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter teilweise wegen der hohen Arbeitskosten</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, partly because the high cost of labour</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots, en partie à cause du coût élevé de la main-d&apos;œuvre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWHCLX"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter aus anderen Gründen als hohe Arbeitskosten</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, but not because the high cost of labour</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des robots, mais pas à cause du coût élevé de la main-d&apos;œuvre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWHP"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter, teilweise um eine hohe Präzision oder standardisierte Qualität von Prozessen und/oder produzierten Waren und Dienstleistungen sicherzustellen</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, partly to ensure high precision or standardized quality of processes and/or goods and services produced</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise utilisant des robots, en partie pour assurer une haute précision ou une qualité standardisée des processus et/ou des biens et services produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWHPX"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter aus anderen Gründen als um eine hohe Präzision oder standardisierte Qualität von Prozessen und/oder produzierten Waren und Dienstleistungen sicherzustellen</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, but not to ensure high precision or standardized quality of processes and/or goods and services produced</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise utilisant des robots, mais pas pour assurer une haute précision ou une qualité standardisée des processus et/ou des biens et services produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWTI"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter teilweise aufgrund steuerlicher oder anderer staatlicher Anreize</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, partly because of tax or other government incentives</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise utilisant des robots, en partie à cause d&apos;incitations fiscales ou gouvernementales</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBTWTIX"><skos:prefLabel xml:lang="de">Das Unternehmen nutzt Roboter aus anderen Gründen als aufgrund steuerlicher oder anderer staatlicher Anreize</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise uses robots, but not because of tax or other government incentives</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise utilisant des robots, mais pas à cause d&apos;incitations fiscales ou gouvernementales</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBT_5_10"><skos:prefLabel xml:lang="de">Unternehmen nutzen zwischen 5 und 10 Industrie- oder Serviceroboter</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using between 5 and 10 industrial or service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant plus de 10 robots industriels ou de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBT_GT10"><skos:prefLabel xml:lang="de">Unternehmen nutzen mehr als 10 Industrie- oder Serviceroboter</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using more than 10 industrial or service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant moins de 5 robots industriels ou de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_RBT_LT5"><skos:prefLabel xml:lang="de">Unternehmen nutzen weniger als 5 Industrie- oder Serviceroboter</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using less than 5 industrial or service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant de 5 à 10 robots industriels ou de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_P3D"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die 3D Drucker nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises with 3D printing</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;impression 3D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_RBT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die Industrie- oder Serviceroboter nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using industrial or service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant des robots industriels ou de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_RBTS"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die Serviceroboter nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using service robots</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant des robots de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">118502</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-10</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://pub