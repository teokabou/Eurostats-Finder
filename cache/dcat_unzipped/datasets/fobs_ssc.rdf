ist/ESTAT/INDIC_FB?code=311_E"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - das Finden von qualifiziertem Personal</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - availability of qualified personnel</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - disponibilté du personnel qualifié</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_F"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - die Personalkosten</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - staff costs</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - coût du personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_G"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - die behördlichen und administrativen Verpflichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - regulatory and administrative burden</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - charges administratives</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_H"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - die Anpassung an neue technische Standards</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - adapting to new technical standards</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - adaptation aux nouveaux standards technologiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_I"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - die Führungskompetenz</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - availability of managerial competences</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - disponibilité de compétences en gestion</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_J"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - die Vereinbarkeit von Familie und Arbeit</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - combining family and work</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - allier travail et vie familiale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_K"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - das Finden von Geschäftspartnern</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - finding partners</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - trouver des partenaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_L"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - nicht oder spät zahlende Kunden</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - non or late paying customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - pas assez de clients ou clients en retard de paiement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_T"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - Gesamt</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - total</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le développement de l&apos;entreprise - total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=401_A"><skos:prefLabel xml:lang="de">Strategischen Pläne - das Unternehmen so weiterführen wie bisher</skos:prefLabel><skos:prefLabel xml:lang="en">Strategic plans - continuing the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Plans pour la poursuite des activités de l&apos;entreprise - continuation sans changement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=401_B"><skos:prefLabel xml:lang="de">Strategischen Pläne - das Unternehmen mit einem oder mehreren anderen Unternehmen verschmelzen</skos:prefLabel><skos:prefLabel xml:lang="en">Strategic plans - affiliation</skos:prefLabel><skos:prefLabel xml:lang="fr">Plans pour la poursuite des activités de l&apos;entreprise - affiliation avec une ou plusieurs entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=401_C"><skos:prefLabel xml:lang="de">Strategischen Pläne - das derzeitige Unternehmen verkaufen oder schließen und ein neues in derselben Branche gründen</skos:prefLabel><skos:prefLabel xml:lang="en">Strategic plans - close and start new enterprise in the same activity</skos:prefLabel><skos:prefLabel xml:lang="fr">Plans pour la poursuite des activités de l&apos;entreprise - vente ou fermeture de l&apos;entreprise en vue de lancer une nouvelle entreprise dans la même branche d&apos;activité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=401_D"><skos:prefLabel xml:lang="de">Strategischen Pläne - das derzeitige Unternehmen verkaufen oder schließen und ein neues in einer anderen Branche gründen</skos:prefLabel><skos:prefLabel xml:lang="en">Strategic plans - close and start new enterprise in another activity</skos:prefLabel><skos:prefLabel xml:lang="fr">Plans pour la poursuite des activités de l&apos;entreprise - vente ou fermeture de l&apos;entreprise en vue de lancer une nouvelle entreprise dans une autre branche d&apos;activité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=401_E"><skos:prefLabel xml:lang="de">Strategischen Pläne - das derzeitige Unternehmen verkaufen oder schließen ohne ein neues Unternehmen zu gründen</skos:prefLabel><skos:prefLabel xml:lang="en">Strategic plans - close without starting new enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Plans pour la poursuite des activités de l&apos;entreprise - vente ou fermeture de l&apos;entreprise sans lancer une nouvelle entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=401_T"><skos:prefLabel xml:lang="de">Strategischen Pläne - Gesamt</skos:prefLabel><skos:prefLabel xml:lang="en">Strategic plans - total</skos:prefLabel><skos:prefLabel xml:lang="fr">Plans pour la poursuite des activités de l&apos;entreprise - total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=402_A"><skos:prefLabel xml:lang="de">Erwartete Entwicklung der Unternehmensaktivität - Umsatzanstieg</skos:prefLabel><skos:prefLabel xml:lang="en">Expected development of business activity - increase of turnover</skos:prefLabel><skos:prefLabel xml:lang="fr">Evolution prévue de l&apos;activité de l&apos;entreprise - augmentation du chiffre d&apos;affaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=402_B"><skos:prefLabel xml:lang="de">Erwartete Entwicklung der Unternehmensaktivität - Anstieg der Anzahl der Angestellten</skos:prefLabel><skos:prefLabel xml:lang="en">Expected development of business activity - increase of number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Evolution prévue de l&apos;activité de l&apos;entreprise - augmentation du nombre de personnes occupées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=402_C"><skos:prefLabel xml:lang="de">Erwartete Entwicklung der Unternehmensaktivität - Anstieg der Auswahl der angebotenen Güter und Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Expected development of business activity - increase of variety of goods and services for sale</skos:prefLabel><skos:prefLabel xml:lang="fr">Evolution prévue de l&apos;activité de l&apos;entreprise - augmentation de la diversité des biens et services offerts</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=402_D"><skos:prefLabel xml:lang="de">Erwartete Entwicklung der Unternehmensaktivität - Ertragsanstieg</skos:prefLabel><skos:prefLabel xml:lang="en">Expected development of business activity - increase of profitability</skos:prefLabel><skos:prefLabel xml:lang="fr">Evolution prévue de l&apos;activité de l&apos;entreprise - augmentation de la rentabilité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=402_T"><skos:prefLabel xml:lang="de">Erwartete Entwicklung der Unternehmensaktivität - Gesamt</skos:prefLabel><skos:prefLabel xml:lang="en">Expected development of business activity - total</skos:prefLabel><skos:prefLabel xml:lang="fr">Evolution prévue de l&apos;activité de l&apos;entreprise - total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_A"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - mehr Mitarbeiter einstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - hire more employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - embaucher plus de personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_B"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - den bisherigen Mitarbeitern mehr bezahlen</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - increase remuneration of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - augmenter la rémunération des employé(e)s</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_C"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - mehr in das Unternehmen selber investieren</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - invest in the activity of the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - investir dans l&apos;activité de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_D"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - Kredite und Schulden zurückzahlen</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - pay off loans or credits</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - rembourser les prêts ou dettes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_E"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - das eigene Gehalt erhöhen</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - increase own salary from the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - augmenter le salaire de l&apos;entrepreneur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_F"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - die eigene Arbeitszeit reduzieren</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - reduce own working time</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - réduire le temps de travail de l&apos;entrepreneur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_G"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - nichts von all dem</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - none/not relevant</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - aucune des options précitées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=403_T"><skos:prefLabel xml:lang="de">Höchste Priorität wenn Einkommen steigt - Gesamt</skos:prefLabel><skos:prefLabel xml:lang="en">Highest priority if earnings increase - total</skos:prefLabel><skos:prefLabel xml:lang="fr">Priorité principale si les revenus de l&apos;entreprise augmentent - total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">83560</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-03-27</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/fobs_ssc"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/fobs_ssc</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/sbs_h_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/fobs_ssc"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/sbs_h_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></