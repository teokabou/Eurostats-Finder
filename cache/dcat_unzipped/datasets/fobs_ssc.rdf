mx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=101_A"><skos:prefLabel xml:lang="de">Zahl der Lohn-und Gehaltsempfänger im Jahr der Unternehmensgründung</skos:prefLabel><skos:prefLabel xml:lang="en">Number of employees in the year of enterprise birth</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre de salariés, l&apos;année de création de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=101_N"><skos:prefLabel xml:lang="de">Zahl der Einheiten, die von 2002 bis 2005 überlebt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Number of units having survived from 2002 to 2005</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre d&apos;unités ayant survécu entre 2002 et 2005</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=201_A"><skos:prefLabel xml:lang="de">Art der Unternehmensgründung - neues Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Start-up type - new enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Origine de l&apos;entreprise - nouvelle création</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=201_C"><skos:prefLabel xml:lang="de">Art der Unternehmensgründung - Neubeginn eines Unternehmens, das über zwei Jahre geruht hat</skos:prefLabel><skos:prefLabel xml:lang="en">Start-up type - reactivation after more than 2 years</skos:prefLabel><skos:prefLabel xml:lang="fr">Origine de l&apos;entreprise - reprise d&apos;activité après un arrêt temporaire de plus de deux ans</skos:prefLab