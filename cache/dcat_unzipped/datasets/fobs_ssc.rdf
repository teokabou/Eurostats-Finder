issemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=310_C"><skos:prefLabel xml:lang="de">Hindernisse Produkte oder Dienstleistungen zu verkaufen - schwierige Preisgestaltung</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to selling products or services - difficult pricing</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour vendre des produits ou services - difficultés de fixation des prix pour les produits ou services vendus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=310_D"><skos:prefLabel xml:lang="de">Hindernisse Produkte oder Dienstleistungen zu verkaufen - fehlende Marketingkenntnisse</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to selling products or services - lack of marketing skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour vendre des produits ou services - manque des compétences requises en marketing</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=310_T"><skos:prefLabel xml:lang="de">Hindernisse Produkte oder Dienstleistungen zu verkaufen - Gesamt</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to selling products or services - total</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour vendre des produits ou services - total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_FB?code=311_A"><skos:prefLabel xml:lang="de">Hindernisse für die Entwicklung der Geschäftstätigkeit - die Ertragslage bzw. die Rentabilität</skos:prefLabel><skos:prefLabel xml:lang="en">Impediments to developing the business activity - profitability</skos:prefLabel><skos:prefLabel xml:lang="fr">Obstacles pour le dév