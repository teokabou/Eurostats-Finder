owser/view/sdg_08_11/default/table"/><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/VISUALIZATION"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_08_11?format=tsv&amp;compressed=true"><dct:title xml:lang="en">Download dataset in TSV format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_08_11?format=tsv&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/sdg_08_11?format=tsv&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/TSV"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/tab-separated-values"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dcat:byteSize>7705</dcat:byteSize><spdx:checksum> <spdx:Checksum> <spdx:algorithm rdf:resource="http://spdx.org/rdf/terms#checksumAlgorithm_sha256"/><spdx:checksumValue>d3b0f21a34bb1779dae7b8bfff57bd2aab11b63b34cde36799260921f588ee9f</spdx:checksumV