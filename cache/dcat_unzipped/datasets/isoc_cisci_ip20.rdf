"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1X"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): keine elektronischen Identifikationsverfahren (I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL, I_IUID1_OTH)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have not used any electronic identification procedure for accessing online services of I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL, I_IUID1_OTH (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune procédure d&apos;identification utilisée pour l&apos;accès aux services en ligne (3 mois) parmi I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL, I_IUID1_OTH</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_CCRD"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): ein elektronisches Identifikationszertifikat oder -karte mit einem Kartenleser</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used electronic identification certificate or card with a card reader or an app as identification procedure for accessing online services (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’une carte d&apos;identité ou autre preuve d&apos;identification électronique au moyen d&apos;un lecteur de carte comme procédure d&apos;identification pour l’accès aux services en ligne (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_GE4"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): mindestens 4 der elektronischen Identifikationsverfahren (I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL, I_IUID1_OTH)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used at least 4 identification procedures for accessing online services of I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL, I_IUID1_OTH (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;au moins 4 des procédures d&apos;identification électronique pour l&apos;accès aux services en ligne (3 mois) parmi I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL, I_IUID1_OTH</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_MP"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): Verfahren mittels Smartphone (Code via Messaging)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a procedure involving their mobile phone (a code received via a message) as identification procedure for accessing online services (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation du téléphone mobile (grâce à un code reçu par message) comme procédure d&apos;identification pour l’accès aux services en ligne (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_OTH"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): andere elektronische Identifikationsverfahren (als I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used other electronic identification procedure for accessing online services (3 months) than I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL</skos:prefLabel><skos:prefLabel xml:lang="fr">Procédure d&apos;identification pour l&apos;accès aux services en ligne (3 mois): autres que I_IUID1_UP, I_IUID1_SM, I_IUID1_ST, I_IUID1_CCRD, I_IUID1_MP, I_IUID1_PCL</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_PCL"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): eine Liste mit PIN-Codes oder nach dem Zufallsprinzip ausgewählter Zeichenfolge für die einmalige Verwendung</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used single use pin code list or random characters of a password as identification procedure for accessing online services (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’un code sur une carte à usage unique ou des caractères de mot de passe aléatoires comme procédure d&apos;identification pour l’accès aux services en ligne (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_SM"><skos:prefLabel xml:lang="de">Identifikationsverfahren für (andere) Online-Dienste (3 Monate): das Login über soziale Medien</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used social media login as identification procedure for accessing otheronline services (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’un accès pour les média sociaux comme procédure d&apos;identification pour l’accès aux autres services en ligne (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_ST"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): einen Security-Token</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a security token as identification procedure for accessing online services (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’un token de sécurité comme procédure d&apos;identification pour l’accès aux services en ligne (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUID1_UP"><skos:prefLabel xml:lang="de">Identifikationsverfahren für Online-Dienste (3 Monate): einfaches Login mit Benutzername und Passwort</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used simple login with username and password as identification procedure for accessing online services (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d’un simple accès avec un identifiant et un mot de passe comme procédure d&apos;identification pour l’accès aux services en ligne (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">53129</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.e