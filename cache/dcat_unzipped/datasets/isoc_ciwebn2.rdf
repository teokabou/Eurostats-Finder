"http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CHTB"><skos:prefLabel xml:lang="de">Unternehmen mit einem Chat-Service, bei dem ein Chatbot oder virtuelle Agenten automatisiert auf Kundenanfragen antworten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with a chat service where a chatbot or a virtual agent replies to customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un service de chat géré par un chatbot ou un agent virtuel répondant aux clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CHTP"><skos:prefLabel xml:lang="de">Unternehmen mit einem Chat-Service, bei dem Personen auf Kundenanfragen antworten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with a chat service where a person replies to customers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un service de chat sur lequel une personne physique répond aux clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_MOBAPP"><skos:prefLabel xml:lang="de">Unternehmen mit mobiler App für Kunden (z. B. für Treueprogramm, E-Commerce, Kundenbetreuung)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises having a mobile app for clients (e.g. for loyalty program, e-commerce, customer support)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;une application mobile pour les clients (par exemple, pour le programme de fidélité, le commerce électronique, le support client)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB"><skos:prefLabel xml:lang="de">Unternehmen mit einer Website</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises with a website</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant un site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB1_GE1"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Website mindestens eines der folgenden enthält: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC oder WEBLANG</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has at least one of: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC or WEBLANG</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le site Web comporte au moins l&apos;un des éléments suivants : WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC ou WEBLANG</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB1_GE2"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Website mindestens zwei der folgenden enthält: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC oder WEBLANG</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has at least two of: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC or WEBLANG</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le site Web comporte au moins deux des éléments suivants : WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC ou WEBLANG</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB1_GE3"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Website mindestens drei der folgenden enthält: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC oder WEBLANG</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has at least three of: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC or WEBLANG</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le site Web comporte au moins trois des éléments suivants : WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER, WEBCHT, WEBVAC ou WEBLANG</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBACC"><skos:prefLabel xml:lang="de">Unternehmen, die auf ihrer Website Produkt- oder Dienstleistungsbeschreibungen oder Preislisten bereitstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provided description of goods or services, price lists</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises avec un site web qui fournit des descriptions de biens ou services ou des listes de prix</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBCHT"><skos:prefLabel xml:lang="de">Unternehmen, deren Website einen Chat-Service für den Kundendienst bereitstellt (einen Chatbot, einen virtuellen Agenten oder eine Person antworten auf Kundenanfragen)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provides a chat service for customer support (a chatbot, virtual agent or a person replying to customers)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le site Web fournit un service de chat pour le support client (un chatbot, un agent virtuel ou une personne répondant aux clients)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBCMP"><skos:prefLabel xml:lang="de">Unternehmen, deren Website über elektronische Entgegennahme von Beschwerden zur weiteren Bearbeitung verfügt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provided for the electronic submission of complaints</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web avec la possibilité de transmission électronique des réclamations</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBCTM"><skos:prefLabel xml:lang="de">Unternehmen, deren Website Besuchern die Möglichkeit bietet, Waren oder Dienstleistungen online individuell anzupassen oder zu gestalten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provides possibility for visitors to customise or design online goods or services</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le site Web offre aux visiteurs la possibilité de personnaliser ou de concevoir des biens ou des services en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBF2"><skos:prefLabel xml:lang="de">Unternehmen, deren Website mindestens eine der Funktionen webctm, webot, webacc, webper hat</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website had at least one of the following: webacc, webctm, webot or webper</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant un site web avec au moins une des fonctionnalités parmi webacc, webctm, webot, webper</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBF3"><skos:prefLabel xml:lang="de">Unternehmen, deren Website Online-Bestellung/Reservierung/Buchung und mindestens eine der Funktionen webctm, webot, webacc, webper hat</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website had online ordering, reservation or booking and at least one of: webacc, webctm, webot or webper</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant un site web avec la possibilité de commande/réservation en ligne et au moins une des fonctionnalités parmi webacc, webctm, webot, webper</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBLANG"><skos:prefLabel xml:lang="de">Unternehmen, auf deren Website Inhalte in mindestens zwei Sprachen verfügbar sind</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has content available in at least two languages</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le site Web a du contenu disponible dans au moins deux langues</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBORD"><skos:prefLabel xml:lang="de">Unternehmen, die auf ihrer Website Online-Bestellungs- oder Reservierungssysteme bereitstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provided online ordering or reservation or booking, e.g. shopping cart</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web avec la possibilité de commande ou réservation en ligne ou un service de réservation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBOT"><skos:prefLabel xml:lang="de">Unternehmen, die auf ihrer Website die Überprüfung des Auftrags- oder Lieferstatus von Bestellungen ermöglichen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provided order tracking available online</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web avec la possibilité du suivi des commandes en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBPER"><skos:prefLabel xml:lang="de">Unternehmen, deren Website personalisierte Inhalte für regelmäßige/wiederkehrende Besucher bietet</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has personalised content for regular/recurrent visitors</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le site Web a un contenu personnalisé pour les visiteurs réguliers/récurrents</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBPRV"><skos:prefLabel xml:lang="de">Unternehmen, die auf ihrer Website Datenschutzerklärungen und Hinweise zur Sicherung der Website-Nutzung bereitstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provided a private policy statement, a privacy seal or certification related to website safety</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web qui fournit une charte ou garantie de confidentialité ou un certificat relatif à la sécurité sur le web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBSM"><skos:prefLabel xml:lang="de">Unternehmen, deren Website über Links oder Hinweise zum Unternehmensprofil in sozialen Medien verfügt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website had links or references to the enterprise&apos;s social media profiles</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web avec des liens ou références vers les profils de l&apos;entreprise sur les médias sociaux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEBVAC"><skos:prefLabel xml:lang="de">Unternehmen, die auf ihrer Website Stellenangebote veröffentlichen oder Online-Bewerbungen entgegennehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website provided advertisement of open job positions or online job application</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web qui présente des postes vacants ou demandes d&apos;emploi en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB_GE1"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Website mindestens eines der folgenden enthält: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER oder WEBPSM</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has at least one of: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER or WEBPSM</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web avec au moins un parmi : WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER or WEBPSM</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB_GE2"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Website mindestens zwei der folgenden enthält: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER oder WEBPSM</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has at least two of: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER or WEBPSM</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web avec au moins deux parmi : WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER or WEBPSM</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB_GE3"><skos:prefLabel xml:lang="de">Unternehmen, bei denen die Website mindestens drei der folgenden enthält: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER oder WEBPSM</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises where the website has at least three of: WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER or WEBPSM</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant d&apos;un site web avec au moins trois parmi :WEBACC, WEBORD, WEBCTM, WEBOT, WEBPER or WEBPSM</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB_MA_SM1_ANY"><skos:prefLabel xml:lang="de">Unternehmen mit Website und mobiler App für Kunden und Nutzung von sozialen Medien</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises having a website and a mobile app for clients and using any social media</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant un site Web et une application mobile pour les clients et utilisant n&apos;importe quel média social</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_WEB_MOBAPP"><skos:prefLabel xml:lang="de">Unternehmen mit Website und mobiler App für Kunden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises having a website and a mobile app for clients</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant un site Web et une application mobile pour les clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IACC"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises with internet access</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_WEB"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die eine Website haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises having a website</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage d&apos;entreprises disposant d&apos;un site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">145122</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><f