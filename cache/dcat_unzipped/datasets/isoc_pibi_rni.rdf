y/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/HHTYP" > <skos:prefLabel xml:lang="de">Haushaltstyp</skos:prefLabel><skos:prefLabel xml:lang="en">Type of household</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de ménage</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XACC"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da die Zugangskosten (Telefon usw.) zu hoch sind</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because the access costs are too high (telephone, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile parce que les coûts d&apos;accès sont trop élevés (téléphone, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XBBNA"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da Breitband in der Region nicht verfügbar ist</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to the internet at home, because broadband is not available in the area</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile parce qu&apos;il n&apos;y a pas de large bande disponible dans la région</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XCOST"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da die Geräte- und Zugangskosten zu hoch sind</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because the access and equipment costs are too high</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile parce que les coûts d&apos;accès et d&apos;équipement sont trop élevés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XDIS"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da eine körperliche Behinderung besteht</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because of a physical disability</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile en raison d&apos;un handicap physique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XELSE"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da andernorts ein Zugang besteht</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because of access elsewhere</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile en raison d&apos;un accès ailleurs</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XEQU"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da die Gerätekosten zu hoch sind</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because the equipment costs are too high</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile en raison du coût trop élevé d&apos;équipement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XNEED"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da kein Bedarf am Internet besteht (Inhalt nicht nützlich, uninteressant usw.)</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because access not needed (content is not useful, not interesting, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile car ils estiment ne pas en avoir besoin (le contenu n&apos;est pas utile, pas intéressant, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XOTH"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, wegen anderer Gründe haben</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because of other reasons</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile pour d&apos;autres raisons</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XSEC"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da Bedenken hinsichtlich der Privatsphäre oder der Sicherheit bestehen</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because of privacy or security concerns</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile pour des raisons de confidentialité ou de sécurité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XSKL"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da die erforderlichen Kenntnisse fehlen</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because of lack of skills</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile par manque de savoir-faire</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=H_XWANT"><skos:prefLabel xml:lang="de">Haushalte ohne häuslichen Internetzugang, da das Internet nicht erwünscht ist (schädliche Inhalte usw.)</skos:prefLabel><skos:prefLabel xml:lang="en">Households without access to internet at home, because access not wanted (content is harmful, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Ménages n&apos;ayant pas d&apos;accès à l&apos;internet à leur domicile car l&apos;accès n&apos;est pas souhaité (contenu nocif, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_HH"><skos:prefLabel xml:lang="de">Prozent der Haushalte</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of households</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des ménages</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_HH_BROADX"><skos:prefLabel xml:lang="de">Prozent der Haushalte ohne Breitbandzugang</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of households without broadband access</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des ménages qui n&apos;ont pas d&apos;accès à large bande</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_HH_IACCX"><skos:prefLabel xml:lang="de">Prozent der Haushalte ohne Internetzugang zu Hause</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of households without internet access at home</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des ménages qui n&apos;ont pas d&apos;accès à l&apos;internet à la maison</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15965</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_pibi_rni"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_pibi_rni</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><f