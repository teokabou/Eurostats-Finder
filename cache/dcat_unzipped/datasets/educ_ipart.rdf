/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P01_1"><skos:prefLabel xml:lang="de">Schüler in öffentlichen Bildungseinrichtungen (ISCED 1 bis 4) - in % aller Studenten in öffentlichen und privaten Bildungseinrichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Students in public institutions (ISCED 1 to 4) - as % of all students in public and private institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants dans les institutions publiques (CITE 1 à 4) - en % de l&apos;ensemble des étudiants dans des institutions publiques ou privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P01_2"><skos:prefLabel xml:lang="de">Schüler in privaten Bildungseinrichtungen (ISCED 1 bis 4) - in % aller Studenten in öffentlichen und privaten Bildungseinrichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Students in private institutions (ISCED 1 to 4) - as % of all students in public and private institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants dans les institutions privées (CITE 1 à 4) - en % de l&apos;ensemble des étudiants dans des institutions publiques et privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P01_3"><skos:prefLabel xml:lang="de">Studenten in öffentlichen subventionierten Bildungseinrichtungen (ISCED 1 bis 4) - in % aller Studenten in öffentlichen und privaten Bildungseinrichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Students in private dependent institutions (ISCED 1 to 4) - as % of all students in public and private institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants dans les institutions dépendant des pouvoirs publics (CITE 1 à 4) - en % de l&apos;ensemble des étudiants dans des institutions publiques et privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P01_4"><skos:prefLabel xml:lang="de">Studenten in öffentlichen unsubventionierten Bildungseinrichtungen (ISCED 1 bis 4) - in % aller Studenten in öffentlichen und privaten Bildungseinrichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Students in private independent institutions (ISCED 1 to 4) - as % of all students in public and private institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Étudiants dans les institutions indépendantes des pouvoirs publics (CITE 1 à 4) - en % de l&apos;ensemble des étudiants dans des institutions publiques et privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P02_0"><skos:prefLabel xml:lang="de">Teilnehmer an der Vorschulbildung (von 4 Jahren bis zu dem gesetzlichen Einschulungsalter) - in % der Einwohner der entsprechenden Altersgruppe</skos:prefLabel><skos:prefLabel xml:lang="en">Participants in early education (aged between 4-years-old and the starting age of compulsory education) - as % of inhabitants of the corresponding age group</skos:prefLabel><skos:prefLabel xml:lang="fr">Participants à l&apos;enseignement préscolaire (âgés entre 4 ans et l&apos;âge de début de la scolarité obligatoire) - en % des habitants du groupe d&apos;âge correspondant</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P02_0F"><skos:prefLabel xml:lang="de">Weibliche Teilnehmer an der Vorschulbildung (von 4 Jahren bis zu dem gesetzlichen Einschulungsalter) - in % der weiblichen Einwohner der entsprechenden Altersgruppe</skos:prefLabel><skos:prefLabel xml:lang="en">Female participants in early education (aged between 4-years-old and the starting age of compulsory education) - as % of female inhabitants of the corresponding age group</skos:prefLabel><skos:prefLabel xml:lang="fr">Participants de sexe féminin à l&apos;enseignement préscolaire (âgés entre 4 ans et l&apos;âge de début de la scolarité obligatoire) - en % des habitants de sexe féminin du groupe d&apos;âge correspondant</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P02_0M"><skos:prefLabel xml:lang="de">Männliche Teilnehmer an der Vorschulbildung (von 4 Jahren bis zu dem gesetzlichen Einschulungsalter) - in % der männlichen Einwohner der entsprechenden Altersgruppe</skos:prefLabel><skos:prefLabel xml:lang="en">Male participants in early education (aged between 4-years-old and the starting age of compulsory education) - as % of male inhabitants of the corresponding age group</skos:prefLabel><skos:prefLabel xml:lang="fr">Participants de sexe masculin à l&apos;enseignement préscolaire (âgés entre 4 ans et l&apos;âge de début de la scolarité obligatoire) - en % des habitants de sexe masculin du groupe d&apos;âge correspondant</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=P02_1"><skos:prefLabel xml:lang="de">Teilnehmer der ISCED-Stufe 0 im Alter von 3 Jahren - in % der Bevölkerung im Alter von 3 Jahren</skos:prefLabel><skos:prefLabel xml:lang="en">Participants at ISCED level 0 aged 3 years - as % of population aged 3</skos:prefLabel><s