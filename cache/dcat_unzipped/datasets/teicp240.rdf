esource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/ei_cp_esms.sdmx.zip"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) SDMX</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/teicp240"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/ei_cp_esms.sdmx.zip]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/XML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/databrowser/view/teicp240/default/table"><dct:title xml:lang="en">Table, graphs and map visualizations are also available.</dct:title><dct:title xml:lang="fr">Des visualisations sous forme de tableau, graphique et carte géographique sont aussi disponibles.</dct:title><dct:title xml:lang="de">Tabellen, Grafiken und geografische Darstellungen sind ebenfalls verfügbar.</dct:title><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/teicp240/default/table"/><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/VISUALIZATION"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dct:format rdf:resource="http://publications.europa.eu/resource/au