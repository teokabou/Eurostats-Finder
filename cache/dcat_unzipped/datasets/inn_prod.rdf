re</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=AVG"><skos:prefLabel xml:lang="de">Durchschnitt</skos:prefLabel><skos:prefLabel xml:lang="en">Average</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyenne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENT_POPU"><skos:prefLabel xml:lang="de">Zahl der Unternehmen in jeweiliger Schicht (bezogene Stichprobe)</skos:prefLabel><skos:prefLabel xml:lang="en">Number of enterprises in current strata (realised sample)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre d&apos;entreprises dans la strate actuelle (échantillon réalisé)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INAB_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INAB_NO"><skos:prefLabel xml:lang="de">Unternehmen, das keine Innovationstätigkeit eingestellt hat</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprise with no abandoned innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise n&apos;ayant pas abandonné des activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INAB_YES"><skos:prefLabel xml:lang="de">Unternehmen hat Innovationstätigkeiten eingestellt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprise with abandoned innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise ayant abandonné des activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INDEXP2"><skos:prefLabel xml:lang="de">Gesamtausgaben für Innovation als Anteil am Gesamtumsatz 2000</skos:prefLabel><skos:prefLabel xml:lang="en">Total innovation expenditure as a share of total turnover 2000</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses totales liées aux activités d&apos;innovation en part du chiffre d&apos;affaires total, 2000</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INHOUSE"><skos:prefLabel xml:lang="de">Im eigenen Haus innovierende Unternehmen nach Innovatortyp</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises innovating inhouse by type of innovators</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises innovant en interne par type d&apos;innovateurs</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INMAR_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INMAR_NO"><skos:prefLabel xml:lang="de">Unternehmen hat keine neuen oder verbesserten Produkte auf den Markt gebracht</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprise did not introduced new or improved products on the market</skos:prefLabel><skos:prefLabel xml:lang="fr">L&apos;entreprise n&apos;a pas introduit des produits nouveaux ou améliorés sur le marché.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INMAR_YES"><skos:prefLabel xml:lang="de">Unternehmen hat neue oder verbesserte Produkte auf den Markt gebracht</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprise introduced new or improved products on the market</skos:prefLabel><skos:prefLabel xml:lang="fr">L&apos;entreprise a introduit des produits nouveaux ou améliorés sur le marché.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INON_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INON_NO"><skos:prefLabel xml:lang="de">Unternehmen ohne laufende Innovationstätigkeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have no, not yet completed ongoing innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">L&apos;entreprise n&apos;a pas d&apos;activités d&apos;innovation en cours non terminées.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INON_YES"><skos:prefLabel xml:lang="de">Unternehmen mit laufenden Innovationstätigkeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have not yet completed or ongoing innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">L&apos;entreprise a des activités d&apos;innovation en cours ou ne les a pas terminées.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPCSW_COP"><skos:prefLabel xml:lang="de">Verfahren wurde vom Unternehmen zusammen mit anderen Unternehmen oder Einrichtungen entwickelt</skos:prefLabel><skos:prefLabel xml:lang="en">Process, developed in cooperation with other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Procédé, développé par l&apos;entreprise avec d&apos;autres entreprises ou instituts</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPCSW_ENT"><skos:prefLabel xml:lang="de">Verfahren wurde hauptsächlich vom Unternehmen oder der Unternehmensgruppe entwickelt</skos:prefLabel><skos:prefLabel xml:lang="en">Process, developed by enterprise or group</skos:prefLabel><skos:prefLabel xml:lang="fr">Procédé, développé principalement par l&apos;entreprise ou le groupe d&apos;entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPCSW_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu dem Merkmal, wer diese Produkte hauptsächlich entwickelt hat</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable, who mainly developed these products</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée: responsable principal du développement de ces produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPCSW_OTH"><skos:prefLabel xml:lang="de">Verfahren wurde hauptsächlich von anderen Unternehmen oder Einrichtungen entwickelt</skos:prefLabel><skos:prefLabel xml:lang="en">Process, developed mainly by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Procédé, développé principalement par d&apos;autres entreprises ou instituts</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPCS_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPCS_NO"><skos:prefLabel xml:lang="de">Kein Prozessinnovator, der kein neues oder erheblich verbessertes Verfahren auf den Markt gebracht hat</skos:prefLabel><skos:prefLabel xml:lang="en">Not a process Innovator, did not introduce onto the market a new or significantly improved process</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise n&apos;étant pas innovante au niveau du procédé, n&apos;ayant pas introduit sur le marché un procédé nouveau ou amélioré de manière significative</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPCS_YES"><skos:prefLabel xml:lang="de">Prozessinnovator, der ein neues oder erheblich verbessertes Verfahren auf den Markt gebracht hat</skos:prefLabel><skos:prefLabel xml:lang="en">Process Innovator, introduced onto the market a new or significantly improved process</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise innovante au niveau du procédé, ayant introduit sur le marché un procédé nouveau ou amélioré de manière significative</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTW_COP"><skos:prefLabel xml:lang="de">Produktentwicklung durch das Unternehmen zusammen mit anderen Unternehmen oder Einrichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Product, developed in cooperation with other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Produit, développé par l&apos;entreprise avec d&apos;autres entreprises ou instituts</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTW_ENT"><skos:prefLabel xml:lang="de">Produktentwicklung hauptsächlich durch das Unternehmen oder die Unternehmensgruppe</skos:prefLabel><skos:prefLabel xml:lang="en">Product, developed by enterprise or group</skos:prefLabel><skos:prefLabel xml:lang="fr">Produit, développé principalement par l&apos;entreprise ou le groupe d&apos;entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTW_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu dem Merkmal Wer hat diese Produkte hauptsächlich entwickelt</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable, who mainly developed these products</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée: responsable principal du développement de ces produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTW_OTH"><skos:prefLabel xml:lang="de">Produktentwicklung hauptsächlich durch andere Unternehmen oder Einrichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Product, developed mainly by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Produit, développé principalement par d&apos;autres entreprises ou instituts</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDT_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDT_NO"><skos:prefLabel xml:lang="de">Kein Produktinnovator, d. h. hat keine neuen oder erheblich verbesserten Produkte auf den Markt gebracht</skos:prefLabel><skos:prefLabel xml:lang="en">Not product innovator, did not introduce new or significantly improved products onto the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise n&apos;étant pas innovante au niveau des produits, n&apos;ayant pas introduit sur le marché des produits nouveaux ou améliorés de manière significative</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDT_YES"><skos:prefLabel xml:lang="de">Produktinnovator, der neue oder erheblich verbesserte Produkte auf den Markt gebracht hat</skos:prefLabel><skos:prefLabel xml:lang="en">Product innovator, introduced new or significantly improved products onto the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprise innovante au niveau des produits, ayant introduit sur le marché des produits nouveaux ou améliorés de manière significative</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INTURN"><skos:prefLabel xml:lang="de">Umsatz mit neuen, erheblich verbesserten Produkten, die jedoch keine Marktneuheiten darstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover of new or significantly improved products, but not new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux produits nouveaux ou améliorés de manière significative, mais ne constituant pas une nouveauté pour le marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INTURN_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for the given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=MARTURN"><skos:prefLabel xml:lang="de">Umsatz mit neuen oder erheblich verbesserten Produkten, die Marktneuheiten darstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover of new or significantly improved products, and new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux produits nouveaux ou améliorés de manière significative et constituant une nouveauté pour le marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=MARTURN_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for the given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=NR"><skos:prefLabel xml:lang="de">Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Number</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=RT"><skos:prefLabel xml:lang="de">Quote</skos:prefLabel><skos:prefLabel xml:lang="en">Rate</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SB311"><skos:prefLabel xml:lang="de">Im eigenen Haus innovierende Unternehmen als Anteil der Gesamtheit</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises innovating in-house of the total population</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises innovant en interne en pourcentage de la population totale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SB341"><skos:prefLabel xml:lang="de">Umsatz mit neuen oder erheblich verbesserten Produkten, die nur für das Unternehmen neu sind, als Anteil am Gesamtumsatz</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover of new or significantly improved products, but not new to the market as a share of total turnover</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux produits nouveaux ou améliorés de manière significative, ne constituant une nouveauté que pour la société, en part du chiffre d&apos;affaires total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SB421"><skos:prefLabel xml:lang="de">Umsatz mit neuen oder erheblich verbesserten Produkten, die Marktneuheiten darstellen, als Anteil am Gesamtumsatz</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover of new or significantly improved products, and new to the market as a share of total turnover</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux produits nouveaux ou améliorés de manière significative, nouveaux pour le marché, en part du chiffre d&apos;affaires total</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=UNGTURN"><skos:prefLabel xml:lang="de">Umsatz mit nicht oder nur geringfügig geänderten Produkten, die keine Marktneuheiten darstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover of unchanged or marginally modified products, but not new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux produits inchangés ou modifiés de manière marginale, mais ne constituant pas une nouveauté pour le marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=UNGTURN_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for the given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">320172</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-03-27</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2000-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2000-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/inn_prod"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/inn_prod</schema:url><d