/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC01_1"><skos:prefLabel xml:lang="de">Frauen mit Hochschulabschluß der ISCED-Stufen 5-6 pro 100 Männer</skos:prefLabel><skos:prefLabel xml:lang="en">Women per 100 men graduating from ISCED levels 5-6</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes diplômées des niveaux CITE 5-6 pour 100 hommes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_1"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) im Aus- und Weiterbildungsbereich - in % aller Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in education and training field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine de l&apos;enseignement et de la formation - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_10"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in Mathematik, Wissenschaft und Technologie je 1 000 Einwohner im Alter von 20-29 Jahren</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in mathematics, science and technology per 1 000 inhabitants aged 20-29</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) en mathématiques, science et technologie pour 1 000 habitants âgés de 20-29 ans</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_12"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in den Mathematik-, Wissenschaft- und Technikbereichen - in % aller Bereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in Maths, Science and Technology fields - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (ISCED 5-6) dans les domaines des mathématiques, des sciences et de la technologie - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_2"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in Geisteswissenschaften und Kunst - in % aller Bereiche</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in humanities and art field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine des lettres et des arts - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_3"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in Sozial-, Rechts- und Wirtschaftswissenschaften - in % aller Fächer</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in social science, business and law field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine des sciences sociales, de la gestion d&apos;entreprise et en droit - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_4"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in Wissenschaft, Mathematik und Informatik in % aller Bereiche</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in science, mathematics and computing field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine des sciences, des mathématiques et de l&apos;informatique - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_5"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in Ingenieurwesen, Herstellung und Aufbau - in % aller Bereiche</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in engineering, manufacturing and construction field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine de l&apos;ingénierie, de l&apos;industrie manufacturière et de la construction - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_6"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in Landwirtschaft und veterinärmedizinischem Bereich- in % aller Bereiche</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in agriculture and veterinary field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine agricole et vétérinaire - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_7"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) in Gesundheit und Sozialleistungen - in % aller Bereiche</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in health and welfare field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine de la santé et du bien-être - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_8"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) im Dienstleistungsbereich - in % aller Bereiche</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in services field - as % of all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans le domaine des services - en % de l&apos;ensemble des domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC02_9"><skos:prefLabel xml:lang="de">Absolventen (ISCED 5-6) im unbekannten Bereich - in % der gesamten Absolventen die in alle Bereiche bekannt sind (100%)</skos:prefLabel><skos:prefLabel xml:lang="en">Graduates (ISCED 5-6) in unknown field - as % of graduates in all known fields of education (100%)</skos:prefLabel><skos:prefLabel xml:lang="fr">Diplômés (CITE 5-6) dans un domaine inconnu - en % de l&apos;ensemble des diplômés des domaines connus de l&apos;enseignement et de la formation (100%)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC03_1"><skos:prefLabel xml:lang="de">Weibliche Absolventen (ISCED 5-6) im Aus- und Weiterbildungsbereich - in % aller weiblichen und männlichen Absolventen</skos:prefLabel><skos:prefLabel xml:lang="en">Female graduates (ISCED 5-6) in education and training field - as % of males and females graduates</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes diplômées (CITE 5-6) dans le domaine de l&apos;enseignement et de la formation - en % des diplômés hommes et femmes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC03_10"><skos:prefLabel xml:lang="de">Männliche Absolventen (ISCED 5-6) in Mathematik, Wissenschaft und Technologie je 1 000 männliche Einwohner im Alter von 20-29 Jahren</skos:prefLabel><skos:prefLabel xml:lang="en">Male graduates (ISCED 5-6) in mathematics, science and technology per 1 000 male inhabitants aged 20-29</skos:prefLabel><skos:prefLabel xml:lang="fr">Hommes diplômés (CITE 5-6) en mathématiques, science et technologie pour 1000 habitants de sexe masculin âgés de 20-29 ans</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC03_11"><skos:prefLabel xml:lang="de">Weibliche Absolventen (ISCED 5-6) in den Mathematik-, Wissenschaft- und Technikbereichen - in % der gesamten weiblichen Absolventen aller Bildungsbereichen</skos:prefLabel><skos:prefLabel xml:lang="en">Female graduates (ISCED 5-6) in Maths, Science and Technology fields - as % of total female graduates all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes diplômées (ISCED 5-6) dans les domaines des mathématiques, des sciences et de la technologie - en % de l&apos;ensemble des femmes diplômées dans tous les domaines</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=TC03_12"><skos:prefLabel xml:lang="de">Männliche Absolventen (ISCED 5-6) in den Mathematik-, Wissenschaft- und Technikbereichen - in % der gesamten männlichen Absolventen aller Bildungsbereiche</skos:prefLabel><skos:prefLabel xml:lang="en">Male graduates (ISCED 5-6) in Maths, Science and Technology fields - as % of total male graduates all fields</skos:prefLabel><skos:prefLabel xml:lang="fr">Hommes diplômés (ISCED 5-6) dans les domaines des mathématiques, des sciences et d