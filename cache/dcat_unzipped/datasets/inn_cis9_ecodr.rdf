<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/inn_cis9_ecodr"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-01-17</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Innovationsindikator</dcat:keyword><dcat:keyword  xml:lang="en">Innovation indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur l&apos;innovation</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</dcat:keyword><dcat:keyword  xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</dcat:keyword><dcat:keyword  xml:lang="en">Size classes in number of employees</dcat:keyword><dcat:keyword  xml:lang="fr">Classes de taille en nombre de salariés</dcat:keyword><dcat:keyword  xml:lang="de">Gliederung nach Innovationsart</dcat:keyword><dcat:keyword  xml:lang="en">Breakdown by type of innovator</dcat:keyword><dcat:keyword  xml:lang="fr">Ventilation par type d&apos;innovateur</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Importance of the drivers to introduce innovations with environmental benefits and procedures to reduce environmental impacts in the enterprises, by NACE Rev. 2 activity and size class (2014)</dct:title><dct:description xml:lang="en">Importance of the drivers to introduce innovations with environmental benefits and procedures to reduce environmental impacts in the enterprises, by NACE Rev. 2 activity and size class (2014)</dct:description><dct:title xml:lang="fr">Importance des facteurs poussant à adopter des innovations présentant des avantages pour l&apos;environnement et des procédures de réduction de l&apos;incidence environnementale, dans les entreprises par activité de la NACE Rév. 2 et classe de taille (2014)</dct:title><dct:description xml:lang="fr">Importance des facteurs poussant à adopter des innovations présentant des avantages pour l&apos;environnement et des procédures de réduction de l&apos;incidence environnementale, dans les entreprises par activité de la NACE Rév. 2 et classe de taille (2014)</dct:description><dct:title xml:lang="de">Bedeutung der Triebkräfte für die Einführung von Innovationen mit ökologischen Vorteilen sowie von Verfahren zur Verringerung ökologischer Folgen in Unternehmen, nach NACE Rev. 2 Tätigkeit und Größenklasse (2014)</dct:title><dct:description xml:lang="de">Bedeutung der Triebkräfte für die Einführung von Innovationen mit ökologischen Vorteilen sowie von Verfahren zur Verringerung ökologischer Folgen in Unternehmen, nach NACE Rev. 2 Tätigkeit und Größenklasse (2014)</dct:description><dct:identifier>inn_cis9_ecodr</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/inn_cis9_ecodr"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.eur