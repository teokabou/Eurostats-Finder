en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN" > <skos:prefLabel xml:lang="de">Innovationsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Innovation indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;innovation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZECLAS" > <skos:prefLabel xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre de salariés</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/TYPE_INN" > <skos:prefLabel xml:lang="de">Gliederung nach Innovationsart</skos:prefLabel><skos:prefLabel xml:lang="en">Breakdown by type of innovator</skos:prefLabel><skos:prefLabel xml:lang="fr">Ventilation par type d&apos;innovateur</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENAGR_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die freiwillige Maßnahmen oder Initiativen für gute Umweltpraxis innerhalb der Branche ein sehr wichtiger Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which voluntary actions or initiatives for environmental good practice within the sector were a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les actions ou initiatives volontaires en faveur de bonnes pratiques environnementales dans leur secteur ont constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENAGR_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die freiwillige Maßnahmen oder Initiativen für gute Umweltpraxis innerhalb der Branche kein relevanter Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which voluntary actions or initiatives for environmental good practice within the sector were not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les actions ou initiatives volontaires en faveur de bonnes pratiques environnementales dans leur secteur n&apos;étaient pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENCOST_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die hohe Energie-, Wasser- oder Materialkosten ein sehr wichtiger Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which high cost of energy, water or materials was a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles le prix élevé de l&apos;énergie, de l&apos;eau ou des matériaux a constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENCOST_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die hohe Energie-, Wasser- oder Materialkosten kein relevanter Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which high cost of energy, water or materials was not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles le prix élevé de l&apos;énergie, de l&apos;eau ou des matériaux n&apos;était pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENDEM_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die die derzeitige oder erwartete Marktnachfrage nach umweltbezogenen Innovationen ein sehr wichtiger Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which current or expected market demand for environmental innovations was a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles la demande existante ou escomptée sur le marché pour des innovations environnementales a constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENDEM_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die die derzeitige oder erwartete Marktnachfrage nach umweltbezogenen Innovationen kein relevanter Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which current or expected market demand for environmental innovations was not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles la demande existante ou escomptée sur le marché pour des innovations environnementales n&apos;était pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENEREG_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die geltende Umweltvorschriften ein sehr wichtiger Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which existing environmental regulations were a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les réglementations environnementales existantes ont constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENEREG_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die geltende Umweltvorschriften kein relevanter Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which existing environmental regulations were not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les réglementations environnementales existantes n&apos;étaient pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENETX_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die geltende Umweltsteuern, -abgaben oder -gebühren ein sehr wichtiger Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which existing environmental taxes, charges or fees were a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les taxes ou redevances environnementales existantes ont constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENETX_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die geltende Umweltsteuern, -abgaben oder -gebühren kein relevanter Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which existing environmental taxes, charges or fees were not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les taxes ou redevances environnementales existantes n&apos;étaient pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENGRA_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die staatliche Beihilfen, Subventionen oder andere finanzielle Anreize für umweltbezogene Innovationen ein sehr wichtiger Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which Government grants, subsidies or other financial incentives for environmental innovations were a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les aides publiques, subventions ou autres incitations financières pour les innovations environnementales ont constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENGRA_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die staatliche Beihilfen, Subventionen oder andere finanzielle Anreize für umweltbezogene Innovationen kein relevanter Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which Government grants, subsidies or other financial incentives for environmental innovations were not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les aides publiques, subventions ou autres incitations financières pour les innovations environnementales n&apos;étaient pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENREGF_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die künftig zu erwartende Umweltvorschriften oder -steuern ein sehr wichtiger Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which environmental regulations or taxes expected in the future were a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les réglementations ou taxes environnementales attendues à l&apos;avenir ont constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENREGF_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die künftig zu erwartende Umweltvorschriften oder -steuern kein relevanter Faktor waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which environmental regulations or taxes expected in the future were not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les réglementations ou taxes environnementales attendues à l&apos;avenir n&apos;étaient pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENREP_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die die Verbesserung der Unternehmensreputation ein sehr wichtiger Faktor war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which improving the enterprise&apos;s reputation was a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles l&apos;amélioration de leur réputation a constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENREP_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die die Verbesserung der Unternehmensreputation kein relevanter Faktor war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which improving the enterprise&apos;s reputation was not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles l&apos;amélioration de leur réputation n&apos;était pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENREQU_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, für die die Notwendigkeit, Anforderungen für öffentliche Aufträge einzuhalten, ein sehr wichtiger Faktor war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the need to meet requirements for public procurement contracts was a highly important factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles la nécessité de satisfaire aux exigences des marchés publics a constitué un facteur très important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENREQU_NR"><skos:prefLabel xml:lang="de">Unternehmen, für die die Notwendigkeit, Anforderungen für öffentliche Aufträge einzuhalten, kein relevanter Faktor war</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the need to meet requirements for public procurement contracts was not a relevant factor</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles la nécessité de satisfaire aux exigences des marchés publics n&apos;était pas un facteur significatif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENVBF"><skos:prefLabel xml:lang="de">Unternehmen, die vor 2012 Verfahren zur Ermittlung und Verringerung von ökologischen Folgen eingeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that had procedures implemented before 2012 to identify and reduce the environmental impacts</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant appliqué des procédures pour déterminer et réduire l&apos;incidence environnementale avant 2012</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENVBT"><skos:prefLabel xml:lang="de">Unternehmen, die zwischen 2012 und 2014 Verfahren zur Ermittlung und Verringerung von ökologischen Folgen eingeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that had procedures implemented between 2012 and 2014 to identify and reduce the environmental impacts</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant appliqué des procédures pour déterminer et réduire l&apos;incidence environnementale entre 2012 et 2014</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENVID_NO"><skos:prefLabel xml:lang="de">Unternehmen, die nicht über Verfahren zur Ermittlung und Verringerung von ökologischen Folgen verfügten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that did not have procedures to identify and reduce the environmental impacts</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ne disposant pas de procédures pour déterminer et réduire l&apos;incidence environnementale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENVID_YES"><skos:prefLabel xml:lang="de">Unternehmen, die über Verfahren zur Ermittlung und Verringerung von ökologischen Folgen verfügten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that had procedures to identify and reduce the environmental impacts</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant de procédures pour déterminer et réduire l&apos;incidence environnementale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=NR"><skos:prefLabel xml:lang="de">Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Number</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC"><skos:prefLabel xml:lang="de">Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">133550</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-04-23</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/inn_cis9_ecodr"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/inn_cis9_ecodr</schema:url><dct:titl