/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBANY"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis bei mindestens einer der folgenden Aktivitäten: I_SBGOOD, I_SBBANK, I_SBPERS, I_SBGOV, I_SBSOFT oder I_SBMOB1</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from doing any of the following activities: I_SBGOOD, I_SBBANK, I_SBPERS, I_SBGOV, I_SBSOFT or I_SBMOB1</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu de réaliser une des activités suivantes: I_SBGOOD, I_SBBANK, I_SBPERS, I_SBGOV, I_SBSOFT ou I_SBMOB1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBBANK"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis beim Internetbanking</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from carrying out internet banking</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu de gérer son compte bancaire en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBGOOD"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis beim Einkauf oder der Bestellung von Waren oder Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from ordering or buying goods or services</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu de commander/acheter des biens/services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBGOV"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis bei der Kommunikation mit Ämtern und Behörden</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from communicating with public services or administrations</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu de recourir à l&apos;administration ou aux services publics en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBMOB"><skos:prefLabel xml:lang="de">Internet nicht mit mobilen Geräten (z.B. Laptop, Handy) über eine drahtlose Verbindung außerhalb der Wohnung genutzt wegen Sicherheitsbedenken</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns kept individual from using the internet with mobile device (e.g. laptop) via wireless connection from places other than home</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont empêché l&apos;individu d&apos;utiliser une connexion sans fil mobile (type wifi) depuis un autre lieu que le domicile</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBMOB1"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis bei der Nutzung des Internets über öffentliches WLAN</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from using the Internet via public WiFi</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu d&apos;utiliser l&apos;internet via un wifi public</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBOTH"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis für andere Aktivitäten als die folgenden: I_SBGOOD, I_SBBANK, I_SBPERS, I_SBGOV, I_SBSOFT und I_SBMOB1</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from doing other activities than I_SBGOOD, I_SBBANK, I_SBPERS, I_SBGOV, I_SBSOFT and I_SBMOB1</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu de réaliser d&apos;autres activités que les suivantes: I_SBGOOD, I_SBBANK, I_SBPERS, I_SBGOV, I_SBSOFT et I_SBMOB1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBPERS"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis bei der Übermittlung persönlicher Informationen an soziale oder berufliche Netzwerkdienste</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from providing personal information to social or professional networking services</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu de communiquer des données personnelles à des réseaux sociaux ou professionnels en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SBSOFT"><skos:prefLabel xml:lang="de">Sicherheitsbedenken als Hindernis beim Herunterladen von Software oder Apps, Musik- und Videodateien, Spielen und sonstigen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Security concerns limited or prevented individuals from downloading software or apps, music, video files, games or other data files</skos:prefLabel><skos:prefLabel xml:lang="fr">Les questions de sécurité ont limité ou empêché l&apos;individu de télécharger des logiciels, de la musique, des films, des jeux ou d&apos;autres fichiers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECFL2GB"><skos:prefLabel xml:lang="de">Aufgrund von finanziellem Verlust über das Internet sowie Sicherheitsbedenken wurden Einkäufe/Bestellungen oder Bankgeschäfte unterlassen</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced financial loss over the internet and security concerns limited or prevented individuals from doing any of the following activities: I_SBGOOD, I_SBBANK</skos:prefLabel><skos:prefLabel xml:lang="fr">Une perte d&apos;argent sur l&apos;internet et des questions de sécurité ont limité ou empêché l&apos;individu de réaliser les activités suivantes: I_SBGOOD, I_SBBANK</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_SECFLGB"><skos:prefLabel xml:lang="de">Aufgrund von finanziellem Schaden über das Internet sowie Sicherheitsbedenken wurden Einkäufe/Bestellungen oder Bankgeschäfte unterlassen</skos:prefLabel><skos:prefLabel xml:lang="en">Experienced financial loss over the internet and security concerns kept individual from doing ordering/bying goods/services or carrying out banking activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Une perte d&apos;argent sur l&apos;internet et des questions de sécurité ont empêché l&apos;individu de commander/acheter des biens/services ou de gérer son compte bancaire en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">71401</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_ax"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAG