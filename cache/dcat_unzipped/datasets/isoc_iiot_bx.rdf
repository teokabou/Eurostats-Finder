<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_iiot_bx"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-26</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Internet of Things - barriers to use</dct:title><dct:description xml:lang="en">Internet of Things - barriers to use</dct:description><dct:title xml:lang="fr">Internet des objets - raisons pour ne pas l&apos;utiliser</dct:title><dct:description xml:lang="fr">Internet des objets - raisons pour ne pas l&apos;utiliser</dct:description><dct:title xml:lang="de">Internet der Dinge - Gründe für Nichtverwendung</dct:title><dct:description xml:lang="de">Internet der Dinge - Gründe für Nichtverwendung</dct:description><dct:identifier>isoc_iiot_bx</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_iiot_bx"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCPP"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: Bedenken wegen der Privatsphäre und des Schutzes persönlicher Daten, die durch diese Geräte/Systeme generiert werden (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: concerns about the privacy and protection of personal data generated by those devices or systems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: préoccupations relatives à la protection de la vie privée et des données personnelles (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCPP2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: Bedenken hinsichtlich Privatsphäre und Datenschutz (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: concerns about privacy and protection of data (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: craintes relatives à la vie privée et la protection des données (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCSC"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: Sicherheitsbedenken in Bezug auf IT-Sicherheit (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: concerns about security (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: préoccupations relatives à la sécurité (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCSC2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: Sicherheitsbedenken (z. B. dass das Gerät oder System gehackt werden könnte) (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: concerns about security (e.g. that the device or system will be hacked) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: craintes relatives à la sécurité (par exemple le piratage de l&apos;équipement ou du système) (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCSH"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: Sicherheitsbedenken in Bezug auf persönlichen Schutz und gesundheitlicher Aspekte (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: concerns about safety or health (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: préoccupations relatives à la protection ou à la santé (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCSH2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: Sicherheits- oder Gesundheitsbedenken (z. B. dass die Nutzung des Geräts oder Systems zu einem Unfall, einer Verletzung oder einem Gesundheitsproblem führen könnte) (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: concerns about safety or health (e.g. that the use of the device or system could lead to an accident, injury or health problem) (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: craintes relatives à la sécurité ou à la santé (par exemple l&apos;utilisation de l&apos;équipement ou du système pourrait entraîner un accident, une blessure ou des problèmes de santé)(3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCST"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: Kosten zu hoch (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: costs too high (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: coûts trop élevés (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BCST2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: zu hohe Kosten (in den letzten 3 Monaten) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: costs too high (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: prix trop élevés (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BDK"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: nicht bekannt, dass es solche Geräte / Systeme gibt (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: didn&apos;t know such devices or systems exist (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: ne sait pas que de tels dispositifs / systèmes existent (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BDK2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: wusste nicht, dass es solche Geräte oder Systeme gibt (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: didn&apos;t know such devices or systems exist (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: ignorance de l&apos;existence de tels dispositifs (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BLC"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: Kompatibilitätsprobleme (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: lack of compatibility with other devices or systems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: pas compatible avec d’autres dispositifs / systèmes (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BLC2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: mangelnde Kompatibilität mit anderen Geräten oder Systemen (in den letzten 3 Monaten) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: lack of compatibility with other devices or systems (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: non compatibilité avec les autres équipements ou systèmes (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BLSK"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: es fehlen ausreichende Kenntnisse (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: lack of skills to use those devices or systems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: manque de compétences (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BLSK2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: fehlende Fähigkeiten (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: lack of skill to use those devices or systems (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: absence de compétences pour utiliser ces équipements ou systèmes (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BNN"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: kein Bedarf (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: no need to use those connected devices or systems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: pas besoin (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BNN2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: kein Bedarf (in den letzten 3 Monaten) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: no need to use those connected devices/systems (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: aucune nécessité d&apos;utiliser de tels dispositifs (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BOTH"><skos:prefLabel xml:lang="de">Grund, warum mit dem Internet verbundene Geräte / Systeme nicht genutzt werden: andere Gründe (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IOT: other reasons (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour ne pas utiliser de dispositifs / systèmes connectés à l’internet: autres motifs (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_BOTH2"><skos:prefLabel xml:lang="de">Grund für die Nichtnutzung von IoT-Systemen: Andere Gründe (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for not using IoT systems: other reasons (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison de la non utilisation des systèmes de l&apos;internet des objets: autres (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PDU"><skos:prefLabel xml:lang="de">IoT-Nutzung: zu privaten Zwecken - auf Schwierigkeiten bei der Nutzung des Geräts gestoßen (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">IoT use: for private purposes - encountered difficulties in using the device (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation de l&apos;internet des objets : à des fins privées - difficultés rencontrées lors de l&apos;utilisation d&apos;un tel appareil (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PDU2"><skos:prefLabel xml:lang="de">Personen nutzten IoT für private Zwecke und hatten Schwierigkeiten bei der Gerätenutzung (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used IoT and encountered difficulties in using the device (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet des objets (IdO) et ayant rencontré d&apos;autres types de problèmes (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_POTH"><skos:prefLabel xml:lang="de">IoT-Nutzung: zu privaten Zwecken - auf andere Probleme gestoßen (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">IoT use: for private purposes - encountered other problems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation de l&apos;internet des objets : à des fins privées - autre type de problèmes (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_POTH2"><skos:prefLabel xml:lang="de">Personen nutzten IoT für private Zwecke und stießen auf andere Probleme (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used used IoT and encountered other problems (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet des objets (IdO) et n&apos;ayant rencontré aucun problème à utiliser ces appareils (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PSEC"><skos:prefLabel xml:lang="de">IoT-Nutzung: zu privaten Zwecken - auf Sicherheits- oder Datenschutzprobleme gestoßen (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">IoT use: for private purposes - encountered security or privacy problems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation de l&apos;internet des objets : à des fins privées - problèmes de sécurité ou de confidentialité (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PSEC2"><skos:prefLabel xml:lang="de">Personen nutzten IoT für private Zwecke und stießen auf Sicherheits- oder Datenschutzprobleme (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used IoT and encountered security or privacy problems (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet des objets (IdO) et ayant rencontré des problèmes de sécurité ou de respect de la vie privée (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PSHE"><skos:prefLabel xml:lang="de">IoT-Nutzung: zu privaten Zwecken - auf Sicherheits- oder Gesundheitsprobleme gestoßen (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">IoT use: for private purposes - encountered safety or health problems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation de l&apos;internet des objets : à des fins privées - problèmes liés à la sécurité ou à la santé (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PSHE2"><skos:prefLabel xml:lang="de">Personen nutzten IoT für private Zwecke und stießen auf Sicherheits- oder Gesundheitsprobleme (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used IoT and encountered safety or health problems (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet des objets (IdO) et ayant rencontré des problèmes de sécurité ou de santé (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PX"><skos:prefLabel xml:lang="de">IoT-Nutzung: zu privaten Zwecken - auf keine Probleme gestoßen (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">IoT use: for private purposes - encountered no problems (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation de l&apos;internet des objets : à des fins privées - pas de problème rencontré (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOT_PX2"><skos:prefLabel xml:lang="de">Personen nutzten IoT für private Zwecke und stießen auf keine Probleme (letzte 3 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used IoT and have not encountered any problems (last 3 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet des objets (IdO) et ayant rencontré des problèmes à utiliser ces appareils (3 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IOT_BDKX"><skos:prefLabel xml:lang="de">Prozent der Personen, die keine mit dem Internet verbundenen Geräte oder Systeme verwendet haben, obwohl sie von solchen Kenntnis haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have not used any internet-connected device or systems although they knew about them</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers n&apos;ayant pas utilisé de dispositifs ou systèmes connectés à l’internet bien qu&apos;ils savent que cela existe</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IOT_DX"><skos:prefLabel xml:lang="de">Prozent der Personen, die keine mit dem Internet verbundenen Geräte oder Systeme verwendet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have not used any internet-connected devices or systems</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers n&apos;ayant pas utilisé de dispositifs ou systèmes connectés à l’internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IOT_DX2"><skos:prefLabel xml:lang="de">Prozent der Personen, die keines der genannten internetverbundenen Geräte oder Systeme in den letzten 3 Monaten genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have not used any of the mentioned internet-connected devices or systems in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de personnes n&apos;ayant pas utilisé l’un des dispositifs ou systèmes connectés à l’internet mentionnés au cours des 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IOT_USE"><skos:prefLabel xml:lang="de">Prozent der Personen, die eines der genannten internetverbundenen Geräte oder Systeme in den letzten 3 Monaten genutzt haben (bis 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have used any of the mentioned internet-connected devices or systems in the last 3 months (until 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant utilisé l’un des dispositifs ou systèmes connectés à l’internet mentionnés au cours des 3 derniers mois (jusqu&apos;en 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IOT_USE2"><skos:prefLabel xml:lang="de">Prozent der Personen, die eines der genannten internetverbundenen Geräte oder Systeme in den letzten 3 Monaten genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have used any of the mentioned internet-connected devices or systems in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant utilisé l’un des dispositifs ou systèmes connectés à l’internet mentionnés au cours des 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">330124</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/r