<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/sdg_13_70a"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-11</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Green bond issuance by corporates and governments</dct:title><dct:description xml:lang="en">&lt;p&gt;Green bonds are loans provided by an investor to a borrower which are used to fund projects or activities that promote climate change mitigation or adaptation or other environmental objectives. While the green bond definition can vary, this indicator includes bonds that are aligned with the four core components of the International Capital Market Association (ICMA) green bond principles or are certified by the Climate Bond Initiative (CBI). Issuers include corporates such as a company or financial corporation, and sovereign bond issuers which are national governments.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Émission d’obligations vertes par les entreprises et les administrations publiques</dct:title><dct:description xml:lang="fr">&lt;p&gt;Les obligations vertes sont des prêts accordés par un investisseur à un emprunteur qui servent à financer des projets ou des activités qui favorisent l’atténuation du changement climatique ou l’adaptation à celui-ci ou d’autres objectifs environnementaux. Bien que la définition des obligations vertes puisse varier, cet indicateur inclut les obligations qui sont alignées sur les quatre composantes essentielles des principes de l’Association internationale des marchés de capitaux (ICMA) ou qui sont certifiées par l’initiative sur les obligations climatiques (CBI). Les émetteurs comprennent des entreprises telle qu’une société ou une société financière, et des émetteurs d’obligations souveraines qui sont des gouvernements nationaux.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Ausgabe grüner Anleihen durch Unternehmen und Regierungen</dct:title><dct:description xml:lang="de">&lt;p&gt;Grüne Anleihen sind Darlehen, die ein Investor einem Kreditnehmer zur Verfügung stellt und die zur Finanzierung von Projekten oder Aktivitäten verwendet werden, die den Klimaschutz, die Anpassung an den Klimawandel oder andere Umweltziele fördern. Obgleich die Definition von grünen Anleihen variieren kann, umfasst dieser Indikator Anleihen, die mit den vier Kernkomponenten der Green-Bond-Prinzipien der International Capital Market Association (ICMA) übereinstimmen oder von der Climate Bond Initiative (CBI) zertifiziert sind. Zu den Emittenten gehören Unternehmen wie Firmen oder Kapitalgesellschaften sowie staatliche Emittenten, also nationale Regierungen.&lt;/p&gt;</dct:description><dct:identifier>sdg_13_70a</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_13_70a"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf: