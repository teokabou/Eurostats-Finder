c.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=DEATHRATE"><skos:prefLabel xml:lang="de">Altersspezifische Sterbeziffer (Mx)</skos:prefLabel><skos:prefLabel xml:lang="en">Age specific death rate (Mx)</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de mortalité à l&apos;âge x (Mx)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=LIFEXP"><skos:prefLabel xml:lang="de">Lebenserwartung im Alter x in Jahren (ex)</skos:prefLabel><skos:prefLabel xml:lang="en">Life expectancy at given exact age (ex)</skos:prefLabel><skos:prefLabel xml:lang="fr">Esperance de vie à l&apos;âge exact (ex)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=NUMBERDYING"><skos:prefLabel xml:lang="de">Gestorbene im Alter x bis unter x+1 (dx)</skos:prefLabel><skos:prefLabel xml:lang="en">Number dying between exact ages (dx)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre de décès entre deux âges exacts (dx)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=PROBDEATH"><skos:prefLabel xml:lang="de">Sterbewahrscheinlichkeit vom Alter x bis x+1 (qx)</skos:prefLabel><skos:prefLabel xml:lang="en">Probability of dying between exact ages (qx)</skos:prefLabel><skos:prefLabel xml:lang="fr">Probabilité de décès entre deux âges exacts (qx)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=PROBSURV"><skos:prefLabel xml:lang="de">Überlebenswahrscheinlichkeit vom Alter x bis x+1 (px)</skos:prefLabel><skos:prefLabel xml:lang="en">Probability of surviving between exact ages (px)</skos:prefLabel><skos:prefLabel xml:lang="fr">Probabilité de survie entre deux âges exacts (px)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=PYLIVED"><skos:prefLabel xml:lang="de">Von den Überlebenden im Alter x bis zum Alter x+1 durchlebte Jahre (Lx)</skos:prefLabel><skos:prefLabel xml:lang="en">Person-years lived between exact age (Lx)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre d&apos;années personnes vécues entre deux âges exacts (Lx)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=SURVIVORS"><skos:prefLabel xml:lang="de">Überlebende im Alter x (lx)</skos:prefLabel><skos:prefLabel xml:lang="en">Number left alive at given exact age (lx)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre des survivants à l&apos;âge exact (lx)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=TOTPYLIVED"><skos:prefLabel xml:lang="de">Von den Überlebenden im Alter x ingesamt noch zu durchlebende Jahre (Tx)</skos:prefLabel><skos:prefLabel xml:lang="en">Total person-years lived above given exact age (Tx)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre totale d&apos;années personne vécues après l&apos;âge exact (Tx)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1042347</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:t