<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/naio_10_fgti"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-02</dct:issued><dcat:keyword  xml:lang="de">Exportland</dcat:keyword><dcat:keyword  xml:lang="en">Country of export</dcat:keyword><dcat:keyword  xml:lang="fr">Pays d&apos;exportation</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Imports by industry (FIGARO application)</dct:title><dct:description xml:lang="en">&lt;p&gt; The total imports (intra- and extra-EU) of goods and services for the intermediate and final uses of the EU, based on the EU Inter-Country Input-Output Industry-by-Industry Tables (FIGARO). The values are measured in basic prices and differ from the international trade statistics, which are measured in CIF values and do not follow the national accounts concepts. It is measured in million euros.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Importations par industrie (Application FIGARO)</dct:title><dct:description xml:lang="fr">&lt;p&gt; Les importations totales (intra- et extra-UE) de biens et services pour les utilisations intermédiaires et finales de l&apos;UE, basées sur les tableaux internationaux des entrées-sorties par industrie de l&apos;UE (FIGARO). Les valeurs sont mesurées aux prix de base et diffèrent des statistiques du commerce international, qui sont mesurées en valeurs CIF (coût, assurance et fret) et ne suivent pas les concepts des comptes nationaux. Elles sont mesurées en millions d&apos;euros.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Importe nach Wirtschaftszweigen (FIGARO-Anwendung)</dct:title><dct:description xml:lang="de">&lt;p&gt; Gesamtimporte (intra und extra-EU) von Waren und Dienstleistungen für Vorleistungen und Endverwendung in der EU, basierend auf den EU-Länderübergreifenden Input-Output-Tabellen nach Wirtschaftszweigen (FIGARO). Importe werden zu Herstellungspreisen angegeben, und unterscheiden sich von der internationalen Handelsstatistik, welche Importe in CIF ausweist (inkl. sämtlicher Kosten, Versicherung und Fracht) und von den Konzepten der Volkswirtschaftlichen Gesamtrechnungen abweicht. Die Werte sind in Millionen Euro angegeben.&lt;/p&gt;</dct:description><dct:identifier>naio_10_fgti</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/naio_10_fgti"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publicatio