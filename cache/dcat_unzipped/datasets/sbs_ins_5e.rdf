efLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB" > <skos:prefLabel xml:lang="de">Wirtschaftlicher Indikator für strukturelle Unternehmensstatistik</skos:prefLabel><skos:prefLabel xml:lang="en">Economical indicator for structural business statistics</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur économique des statistiques structurelles sur les entreprises</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V33111"><skos:prefLabel xml:lang="de">Gebuchte Bruttobeiträge des selbst abgeschlossenen Geschäfts nach (Unter-)Kategorien der CPA ( 5-stellige Ebene und Unterkategorien 66.03.21, 66.03.22) - Millionen euro</skos:prefLabel><skos:prefLabel xml:lang="en">Gross premiums written in direct business by (sub) categories of the CPA (5-digit level and subcategories 66.03.21, 66.03.22) - million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Primes brutes émises au titre de l&apos;assurance directe par (sous)-catégories de la CPA (niveau à 5 chiffres et sous-catégories 66.03.21, 66.03.22) - millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V33121"><skos:prefLabel xml:lang="de">Rückversicherungsanteil an den gebuchten Bruttobeiträgen des selbst abgeschlossenen Geschäfts nach (Unter-)Kategorien der CPA (5-stellige Ebene und Unterkategorien 66.03.21, 66.03.22) - Millionen euro</skos:prefLabel><skos:prefLabel xml:lang="en">Reinsurers share of gross direct premiums written by (sub) categories of the CPA (5 digit level and subcategories 66.03.21,66.03.22) - million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des réassureurs dans le montant des primes brutes émises au titre de l&apos;assurance directe par (sous)-catégories de la CPA (niveau à 5 chiffres et sous-catégories 66.03.21, 66.03.22) - millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V33131"><skos:prefLabel xml:lang="de">Bruttoaufwendungen für Versicherungsfälle des selbst abgeschlossenen Geschäfts, nach (Unter-)Kategorien der CPA (5-stellige Ebene und Unterkategorien 66.03.21, 66.03.22) - Millionen euro</skos:prefLabel><skos:prefLabel xml:lang="en">Gross claims incurred, direct business by (sub) categories of the CPA (5-digit level and subcategories 66.03.21, 66.03.22) - million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Charge brute des sinistres au titre de l&apos;assurance directe par (sous)-catégories de la CPA (niveau à 5 chiffres et sous-catégories 66.03.21, 66.03.22) - millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V33141"><skos:prefLabel xml:lang="de">Bruttoaufwendungen für den Versicherungsbetrieb des selbst abgeschlossenen Geschäfts, nach (Unter-) Kategorien der CPA (5-stellige Ebene und Unterkategorien 66.03.21, 66.03.22) - Millionen euro</skos:prefLabel><skos:prefLabel xml:lang="en">Gross operating expenses, direct business by (sub) categories of the CPA (5-digit level and subcategories 66.03.21, 66.03.22) - million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Frais d&apos;exploitation bruts au titre de l&apos;assurance directe par (sous)-catégories de la CPA (niveau à 5 chiffres et sous-catégories 66.03.21, 66.03.22) - millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V33151"><skos:prefLabel xml:lang="de">Rückversicherungssaldo des selbst abgeschlossenen Versicherungsgeschäfts, nach (Unter-)Kategorien der CPA (5-stellige Ebene und Unterkategorien 66.03.21, 66.03.22) - Millionen euro</skos:prefLabel><skos:prefLabel xml:lang="en">Reinsurance balance, direct business by (sub) categories of the CPA (5-digit level and subcategories 66.03.21, 66.03.22) - million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Solde de réassurance au titre de l&apos;assurance directe par (sous)-catégories de la CPA (niveau à 5 chiffres et sous-catégories 66.03.21, 66.03.22) - millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V37333"><skos:prefLabel xml:lang="de">Bruttorückstellung für noch nicht abgewickelte Versicherungsfälle des in Rückdeckung übernommenen Geschäfts, nach Produkt - Millionen euro</skos:prefLabel><skos:prefLabel xml:lang="en">Gross provision for outstanding claims, related to direct business, by product - million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Provision brute pour sinistres au titre de la réassurance acceptée, par produit - millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V39100"><skos:prefLabel xml:lang="de">am Ende des Geschäftsjahres bestehenden Versicherungsverträge: selbst abgeschlossene Einzel-Lebensversicherungsverträge für die CPA-Unterkategorien 66.01.1, 66.03.1, 66.03.4 und 66.03.5 - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Contracts outstanding at the end of the accounting year, relating to direct business for all individual life insurance contracts and for the following subcategories of the CPA: 66.01.1, 66.03.1, 66.03.4, 66.03.5 - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Contrats existants à la fin de l&apos;exercice comptable au titre de l&apos;assurance directe, pour tous les contrats d&apos;assurance-vie individuels et pour les sous-catégories suivantes de la CPA: 66.01.1, 66.03.1, 66.03.4, 66.03.5 - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V39200"><skos:prefLabel xml:lang="de">Versicherten Personen am Ende des Geschäftsjahres: selbst abgeschlossene Gruppen-Lebensversicherungsverträge für die CPA-Unterkategorie 66.03.1 - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Insured persons at the end of the accounting year, relating to direct business for all group life insurance contracts and for the following subcategory of the CPA: 66.03.1 - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes assurées à la fin de l&apos;exercice comptable au titre de l&apos;assurance directe pour tous les contrats d&apos;assurance-vie de groupe et pour la sous-catégorie suivantes de la CPA: 66.03.1 - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V39300"><skos:prefLabel xml:lang="de">Versicherten Fahrzeuge am Ende des Geschäftsjahres: selbst abgeschlossenes Geschäft für die CPA-Unterkategorie 66.03.2 - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Insured vehicles at the end of the accounting year, relating to direct business, for the following subcategory of the CPA: 66.03.2 - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Véhicules assurés à la fin de l&apos;exercice comptable, au titre de l&apos;assurance directe, pour la sous-catégorie suivante de la CPA: 66.03.2 - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V39400"><skos:prefLabel xml:lang="de">Bruttoversicherungssumme (selbst abgeschlossenes Geschäft) am Ende des Geschäftsjahres für die CPA-Unterkategorien 66.01.1 und 66.01.4 - Millionen euro</skos:prefLabel><skos:prefLabel xml:lang="en">Gross insured sum at the end of the accounting year, relating to direct business, for the following subcategories of the CPA: 66.01.1 and 66.01.4 - million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Sommes brutes assurées à la fin de l&apos;exercice comptable au titre de l&apos;assurance directe, pour les sous-catégories suivantes de la CPA: 66.01.1 and 66.01.4 - millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V39500"><skos:prefLabel xml:lang="de">Während des Geschäftsjahres eingetretenen Versicherungsfälle (selbst abgeschlossenes Geschäft) für die CPA-Unterkategorie 66.03.2 - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Claims incurred during the accounting year, relating to direct business, for the following subcategory of the CPA: 66.03.2 - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Sinistres survenus au cours de l&apos;exercice comptable au titre de l&apos;assurance directe, pour la sous-catégorie suivante de la CPA: 66.03.2 - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12135</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-02-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1995-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/sbs_ins_5e"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/sbs_ins_5e</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/sbs_h_esms.htm"><dct:title xml:la