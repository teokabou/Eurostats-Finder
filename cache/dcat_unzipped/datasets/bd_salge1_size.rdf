stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS" > <skos:prefLabel xml:lang="de">Wirtschaftlicher Indikator für strukturelle Unternehmensstatistik</skos:prefLabel><skos:prefLabel xml:lang="en">Economical indicator for structural business statistics</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur économique des statistiques structurelles sur les entreprises</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZECLAS" > <skos:prefLabel xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre de salariés</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_BRTHR_PC"><skos:prefLabel xml:lang="de">Beschäftigungsanteil von Unternehmen mit dem ersten Beschäftigten - Beschäftigte in Unternehmen mit dem ersten Beschäftigten dividiert durch Beschäftigte in Unternehmen mit mindestens einem Beschäftigten - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employment share of enterprises having the first employee - persons employed in enterprises having the first employee divided by persons employed in enterprises having at least one employee - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part de l&apos;emploi des entreprises employant le premier salarié - personnes occupées dans les entreprises employant le premier salarié divisée par les personnes occupées dans les entreprises employant au moins un salarié - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_BRTH_NR"><skos:prefLabel xml:lang="de">Beschäftigte in Unternehmen mit dem ersten Arbeitnehmer - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in enterprises having the first employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans des entreprises employant le premier salarié - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_DTHR_PC"><skos:prefLabel xml:lang="de">Beschäftigungsanteil der Unternehmen ohne Beschäftigte - Beschäftigte in Unternehmen ohne Beschäftigte dividiert durch Beschäftigte mit mindestens einem Arbeitnehmer - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employment share of enterprises having no employees anymore - persons employed  in enterprises having no employees anymore divided by persons employed having at least one employee - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part de l&apos;emploi des entreprises n&apos;employant plus de salariés - personnes occupées dans des entreprises n&apos;employant plus de salariés divisées par personnes occupées employant au moins un salarié - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_DTH_NR"><skos:prefLabel xml:lang="de">Beschäftigte in Unternehmen, die keine Arbeitnehmer mehr haben - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in enterprises having no employees anymore - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans des entreprises n&apos;employant plus de salariés - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_NR"><skos:prefLabel xml:lang="de">Beschäftigte in Unternehmen mit mindestens einem Arbeitnehmer - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in enterprises having at least one employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans des entreprises employant au moins un salarié - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_SRVLR_PC"><skos:prefLabel xml:lang="de">Beschäftigungsanteil der überlebenden Arbeitgeberunternehmen - Beschäftigte in überlebenden Unternehmen mit mindestens einem Arbeitnehmer dividiert durch Beschäftigte in Unternehmen mit mindestens einem Arbeitnehmer - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employment share of survived employer enterprises - persons employed in survivals of enterprises having at least one employee divided by persons employed in enterprises having at least one employee - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part de l&apos;emploi des entreprises employant des salariés ayant survécu - personnes occupées dans les entreprises ayant survécu et ayant au moins un salarié divisées par les personnes occupées dans les entreprises employant au moins un salarié - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_SRVL_CHB_NR"><skos:prefLabel xml:lang="de">Beschäftigte in überlebenden Unternehmen mit mindestens einem Arbeitnehmer, nach Überlebensalter, in der Kohorte von Unternehmen, die den ersten Arbeitnehmer im Bezugsjahr hatten und die entsprechende Anzahl von Jahren in der Zukunft überlebt haben - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in survivals of enterprises having at least one employee, by survival age, among cohort of enterprises having the first employee in the reference year and having survived respective number of years in future - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les survies des entreprises employant au moins un salarié, par âge de survie, parmi la population d&apos;entreprises employant le premier salarié au cours de l&apos;année de référence et ayant survécu au nombre respectif d&apos;années dans le futur - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_SRVL_NR"><skos:prefLabel xml:lang="de">Beschäftigte in fortbestehenden Unternehmen mit mindestens einem Arbeitnehmer - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in survivals of enterprises having at least one employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les entreprises employant au moins un salarié et ayant survécu - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_SRVL_YBRTH_CHB_NR"><skos:prefLabel xml:lang="de">Im Geburtsjahr beschäftigte Personen in der Kohorte der Grundgesamtheit der Arbeitgeberunternehmen, die im Bezugsjahr neu geboren wurden und die entsprechende Anzahl von Jahren in der Zukunft überlebt haben - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in the year of birth in the cohort of population of employer enterprises newly born in reference year having survived respective number of years in future - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées au cours de l&apos;année de création dans la cohorte de la population des entreprises employant des salariés nouvellement nées au cours de l&apos;année de référence ayant survécu au nombre respectif d&apos;années futures - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SALGE1_SRVL_YBRTH_NR"><skos:prefLabel xml:lang="de">Beschäftigte in überlebenden Unternehmen mit mindestens einem Arbeitnehmer, im Geburtsjahr - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in survivals of enterprises having at least one employee, in the year of birth - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les entreprises employant au moins un salarié et ayant survécu, au cours de l’année de création - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_BRTHR_DTHR_PC"><skos:prefLabel xml:lang="de">Fluktuation in Arbeitgeberunternehmen - Gründungs- und Schließungsrate in Arbeitgeberunternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employer enterprises business churn - birth and death rate in employer enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Renouvellement des entreprises employant des salariés - taux de la création et de la cessation dans les entreprises employant des salariés - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_BRTHR_PC"><skos:prefLabel xml:lang="de">Gründungsrate von Arbeitgeberunternehmen - Unternehmen mit dem ersten Beschäftigten dividiert durch Unternehmen mit mindestens einem Beschäftigten - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Birth rate of employer enterprises - enterprises having the first employee divided by enterprises having at least one employee - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de la création des entreprises employant des salariés - entreprises employant le premier salarié divisées par les entreprises employant au moins un salarié - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_BRTH_EMPSIZE_NR"><skos:prefLabel xml:lang="de">Größe der Unternehmen mit dem ersten Beschäftigten - Beschäftigte in Unternehmen mit dem ersten Beschäftigten dividiert durch die Anzahl dieser Unternehmen - durchschnittliche Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Size of enterprises having the first employee - persons employed in enterprises having the first employee divided by number of those enterprises - average number</skos:prefLabel><skos:prefLabel xml:lang="fr">Taille des entreprises employant le premier salarié - personnes occupées dans les entreprises employant le premier salarié divisées par le nombre de ces entreprises - nombre moyen</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_BRTH_NR"><skos:prefLabel xml:lang="de">Unternehmen mit dem ersten Beschäftigten - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises having the first employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises employant le premier salarié - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_BRTH_PP_PC"><skos:prefLabel xml:lang="de">Anteil der Unternehmen, die den ersten Beschäftigten haben, nach Größenklasse - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of enterprises having the first employee, by size class - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion d&apos;entreprises employant le premier salarié, par classe de taille - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_DTHR_PC"><skos:prefLabel xml:lang="de">Schließungsrate der Arbeitgeberunternehmen - Unternehmen ohne Beschäftigte im Verhältnis zu Unternehmen mit mindestens einem Beschäftigten - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Death rate of employer enterprises - enterprises having no employees anymore divided enterprises having at least one employee - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de la cessation des entreprises employant des salariés - entreprises n’employant plus de salariés divisées par les entreprises employant au moins un salarié - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_DTH_EMPSIZE_NR"><skos:prefLabel xml:lang="de">Größe der Unternehmen ohne Beschäftigte - Beschäftigte in Unternehmen ohne Beschäftigte dividiert durch die Anzahl dieser Unternehmen - durchschnittliche Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Size of enterprises having no employees anymore - persons employed in enterprises having no employees anymore divided by number of those enterprises - average number</skos:prefLabel><skos:prefLabel xml:lang="fr">Taille des entreprises n&apos;employant plus de salariés - personnes occupées dans des entreprises n&apos;employant plus de salariés divisées par le nombre de ces entreprises - nombre moyen</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_DTH_NR"><skos:prefLabel xml:lang="de">Unternehmen, die keine Beschäftigten mehr haben - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises having no employees anymore - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n’employant plus de salariés - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_DTH_PP_PC"><skos:prefLabel xml:lang="de">Anteil der Unternehmen, die keine Beschäftigten mehr haben, nach Größenklasse - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of enterprises having no employees anymore, by size class - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion d&apos;entreprises n&apos;employant plus de salariés - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_NR"><skos:prefLabel xml:lang="de">Unternehmen mit mindestens einem Beschäftigten - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises having at least one employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises employant au moins un salarié - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_SRVLR_BRTH_CHB_PC"><skos:prefLabel xml:lang="de">Überlebensrate - Kohorte von Unternehmen mit dem ersten Beschäftigten im Berichtsjahr, die die entsprechende Anzahl von Jahren in der Zukunft überlebt haben, geteilt durch Unternehmen mit dem ersten Beschäftigten im Berichtsjahr - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survival rate - cohort of enterprises having the first employee in the reference year and having survived respective number of years in future divided by enterprises having the first employee in the reference year - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de survie - population d&apos;entreprises employant le premier salarié dans l&apos;année de référence et ayant survécu au nombre d&apos;années correspondant dans le futur divisée par les entreprises employant le premier salarié dans l&apos;année de référence - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_SRVLR_BRTH_PC"><skos:prefLabel xml:lang="de">Überlebensrate in Arbeitgeberunternehmen - Überlebensrate von Unternehmen mit mindestens einem Arbeitnehmer im entsprechenden Alter, geteilt durch Unternehmen mit dem ersten Arbeitnehmer im entsprechenden Geburtsjahr - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survival rate in employer enterprises - survivals of enterprises having at least one employee, of respective age, divided by enterprises having the first employee, in respective birth year - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de survie des entreprises employant des employeurs - survies d’entreprises employant au moins un salarié, de l&apos;âge respectif, divisées par les entreprises employant le premier salarié, dans l&apos;année de création respective - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_SRVLR_PC"><skos:prefLabel xml:lang="de">Anteil der überlebenden Arbeitgeberunternehmen - überlebende Unternehmen mit mindestens einem Arbeitnehmer geteilt durch Unternehmen mit mindestens einem Arbeitnehmer - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survived employer enterprises’ share - survivals of enterprises having at least one employee divided by enterprises having at least one employee - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des entreprises employant des employeurs survivantes - survie des entreprises employant au moins un salarié divisée par les entreprises employant au moins un salarié - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_SRVL_CHB_NR"><skos:prefLabel xml:lang="de">Kohorte von Unternehmen, die im Berichtsjahr den ersten Beschäftigten hatten und die entsprechende Anzahl von Jahren in der Zukunft überlebt haben - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Cohort of enterprises having the first employee in the reference year and having survived respective number of years in future - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Population d&apos;entreprises employant le premier salarié dans l&apos;année de référence et ayant survécu au nombre d&apos;années correspondant dans le futur - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_SRVL_EMPSIZE_NR"><skos:prefLabel xml:lang="de">Größe der überlebenden Arbeitgeberunternehmen - Beschäftigte in überlebenden Unternehmen mit mindestens einem Arbeitnehmer geteilt durch dieselben Unternehmen - durchschnittliche Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Size of survived employer enterprises - persons employed in survivals of enterprises having at least one employee divided by the same enterprises - average number</skos:prefLabel><skos:prefLabel xml:lang="fr">Taille des entreprises employant des employeurs ayant survécu - personnes occupées dans des survies d&apos;entreprises employant au moins un salarié divisées par les mêmes entreprises - nombre moyen</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SALGE1_SRVL_NR"><skos:prefLabel xml:lang="de">Überlebende von Unternehmen mit mindestens einem Beschäftigten - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Survivals of enterprises having at least one employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Survies d’entreprises employant au moins un salarié - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=GRW_EMP_SALGE1_SRVL_CHB_PC"><skos:prefLabel xml:lang="de">Wachstumsrate der Beschäftigung in überlebenden Arbeitgeberunternehmen nach Alter - Beschäftigte in überlebenden Unternehmen mit mindestens einem Arbeitnehmer im jeweiligen Jahr in der Kohorte der Unternehmen mit dem ersten Arbeitnehmer im Bezugsjahr, die bis zum jeweiligen Jahr überlebt haben, dividiert durch die Beschäftigten im Gründungsjahr derselben Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survived employer enterprises employment growth rate by age - persons employed in survivals of enterprises, having at least one employee, in the respective year in future among the cohort of enterprises having the first employee in the reference year and having survived to respective year divided by persons employed in the year of birth of the same enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de croissance de l&apos;emploi des entreprises employant des salariés et ayant survécu par âge - personnes occupées dans les entreprises ayant survécu, employant au moins un salarié, dans l&apos;année future respective parmi la population d&apos;entreprises employant le premier salarié dans l&apos;année de référence et ayant survécu jusqu&apos;à l&apos;année respective, divisée par les personnes occupées dans l&apos;année de création des mêmes entreprises - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=GRW_EMP_SALGE1_SRVL_PC"><skos:prefLabel xml:lang="de">Wachstumsrate der Beschäftigung in überlebenden Arbeitgeberunternehmen - Beschäftigte in überlebenden Unternehmen mit mindestens einem Beschäftigten dividiert durch die Beschäftigten in denselben Unternehmen im Jahr der Gründung - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survived employer enterprises employment growth rate - persons employed in survivals of enterprises having at least one employee divided by persons employed in the same enterprises in the year of birth - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de croissance de l&apos;emploi des entreprises employant des salariés et ayant survécu - personnes occupées dans les entreprises ayant survécu et employant au moins un salarié divisées par les personnes occupées dans les mêmes entreprises au cours de l&apos;année de création - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=GRW_ENT_SALGE1_PC"><skos:prefLabel xml:lang="de">Nettowachstum der Unternehmen mit mindestens einem Beschäftigten - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Net growth of enterprises having at least one employee - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Croissance nette des entreprises employant au moins un salarié - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_SALGE1_BRTH_NR"><skos:prefLabel xml:lang="de">Beschäftigte in Unternehmen mit dem ersten Arbeitnehmer - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Employees in enterprises having the first employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Salariés dans les entreprises employant le premier salarié - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_SALGE1_DTH_NR"><skos:prefLabel xml:lang="de">Beschäftigte in Unternehmen, die keine Arbeitnehmer mehr haben - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Employees in enterprises having no employees anymore - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Salariés dans les entreprises n’employant plus de salariés - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_SALGE1_EMP_BRTHR_PC"><skos:prefLabel xml:lang="de">Lohn- und Gehaltsempfängerquote bei neuen Arbeitgebern - Zahl der Beschäftigten in Unternehmen, die den ersten Arbeitnehmer haben, geteilt durch die Zahl der Beschäftigten in denselben Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">New employer enterprise paid employment rate - number of employees in enterprises having the first employee divided by persons employed in the same enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux d&apos;emploi salarié des nouvelles entreprises employant des employeurs - nombre de salariés dans les entreprises employant le premier salarié divisé par les personnes occupées dans les mêmes entreprises - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_SALGE1_NR"><skos:prefLabel xml:lang="de">Beschäftigte in Unternehmen mit mindestens einem Arbeitnehmer - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Employees in enterprises having at least one employee - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Salariés dans les entreprises employant au moins un salarié - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1185011</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-29</dct:modified><dct:accru