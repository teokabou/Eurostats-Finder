<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tag00029"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-01-22</dct:issued><dcat:keyword  xml:lang="de">Altersklasse</dcat:keyword><dcat:keyword  xml:lang="en">Age class</dcat:keyword><dcat:keyword  xml:lang="fr">Classe d&apos;âge</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Eurofarm Indikatoren</dcat:keyword><dcat:keyword  xml:lang="en">Eurofarm indicators</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateurs Eurofarm</dcat:keyword><dcat:keyword  xml:lang="de">Sonstige andere Erwerbstätigkeit des Betriebsinhabers</dcat:keyword><dcat:keyword  xml:lang="en">Other gainful activity of the holder</dcat:keyword><dcat:keyword  xml:lang="fr">Autre activité lucrative de l&apos;exploitant</dcat:keyword><dcat:keyword  xml:lang="de">Sonstige andere Erwerbstätigkeit des Gatten</dcat:keyword><dcat:keyword  xml:lang="en">Other gainful activity of the spouse</dcat:keyword><dcat:keyword  xml:lang="fr">Autre activité lucrative du conjoint</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Agricultural holdings by age of holder</dct:title><dct:description xml:lang="en">&lt;p&gt;Information according to age class of farm holder. The farm holder is the natural person, on whose account and in whose name the holding is operated and who is legally and economically responsible for the holding. If the holder is a group holding, the data relates to the person considered holder.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Exploitations agricoles par âge de l&apos;exploitant</dct:title><dct:description xml:lang="fr">&lt;p&gt;Information sur la classe d&apos;âge de l&apos;exploitant. L&apos;exploitant est la personne physique pour le compte et au nom de laquelle l&apos;exploitation est mise en valeur et qui est juridiquement et économiquement responsable de l&apos;exploitation. Si l&apos;exploitant est un groupement d&apos;exploitation, les données se rapportent à la personne considérée comme exploitant.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Landwirtschaftliche Betriebe nach Alter des Betriebsinhabers</dct:title><dct:description xml:lang="de">&lt;p&gt;Angaben zur Altersklasse des Betriebsinhabers. Der Betriebsinhaber ist die natürliche Person, für deren Rechnung und in deren Namen der Betrieb bewirtschaftet wird und die rechtlich und wirtschaftlich für den Betrieb verantwortlich ist. Bei Inhabern von Gruppenbetrieben beziehen sich die Daten auf die Person, die als Betriebsinhaber gilt.&lt;/p&gt;</dct:description><dct:identifier>tag00029</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tag00029"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="ht