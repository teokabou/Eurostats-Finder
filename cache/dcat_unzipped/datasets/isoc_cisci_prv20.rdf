source/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_COOK1"><skos:prefLabel xml:lang="de">Personen wissen, dass Cookies verwendet werden können, um das Internetverhalten von Personen zu beobachten (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals know that cookies can be used to trace movements of people on the internet (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui savent que des cookies peuvent être utilisés pour tracer les activités d&apos;un internaute sur l&apos;internet (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): mindestens eine von I_MAPS_RPS, I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD, I_MAPS_CWSC, I_MAPS_APD</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): at least one of I_MAPS_RPS, I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD, I_MAPS_CWSC, I_MAPS_APD</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): au moins une parmi I_MAPS_RPS, I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD, I_MAPS_CWSC, I_MAPS_APD</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_3"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): mindestens eine von I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): at least one of I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): au moins une parmi I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_5"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): mindestens eine von I_MAPS_RPS, I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD, I_MAPS_CWSC</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): at least one of I_MAPS_RPS, I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD, I_MAPS_CWSC</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): au moins une parmi I_MAPS_RPS, I_MAPS_RRGL, I_MAPS_LAP, I_MAPS_RAAD, I_MAPS_CWSC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_APD"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): Antrag an Administratoren oder Anbieter von Webseiten oder Suchmaschinen zum Zugang zu den in deren Besitz befindlichen Daten über die Auskunftsperson zwecks Aktualisierung oder Löschung</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): asked websites or search engines administrator or provider to access the data they hold about me to update or delete it</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): Demander à l’administrateur ou au fournisseur de sites web ou de moteurs de recherche d’accéder aux données qu’ils détiennent le concernant afin de les mettre à jour ou de les supprimer</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_CWSC"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): Sicherheitsstandard der Website, auf der personenbezogene Daten weitergegeben werden, überprüft</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): checked that the website where personal data provided was secure</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): Vérifier que le site internet était sûr</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_LAP"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): Zugangsmöglichkeiten zum Profil oder zu Inhalten auf sozialen Netzwerken oder in der Cloud begrenzt</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): limited access to profile or content on social networking sites or shared online storage</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): Limiter l’accès à leur profil ou au contenu des réseaux sociaux ou de stockage en ligne partagé</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_RAAD"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): Nutzung personenbezogener Daten zu Werbezwecken verweigert</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): refused allowing the use of personal data for advertising purposes</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): Refuser l’utilisation des données personnelles à des fins publicitaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_RPS"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): Erklärung über den Schutz personenbezogener Daten vor deren Weitergabe gelesen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): read privacy policy statements before providing personal data</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): Lire les déclarations sur le respect de la vie privée avant de fournir de telles données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MAPS_RRGL"><skos:prefLabel xml:lang="de">Personen verwalten ihre persönlichen Daten im Internet (3 Monate): Zugriff auf ihre geografischen Standortdaten verweigert oder eingeschränkt</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals manage access to personal data on the internet (3 months): restricted or refused access to the geographical location</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure prise pour gérer l’accès aux données personnelles (3 mois): Restreindre ou refuser l’accès à leur position géographique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PCOOK1"><skos:prefLabel xml:lang="de">Personen haben die Einstellungen Ihres Internetbrowsers verändert, um das Speichern von Cookies auf ihren Geräten einzuschränken oder zu verhindern</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have changed the settings in their internet browser to prevent or limit cookies on any of their devices</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont déjà modifié les paramètres de leur navigateur internet afin d&apos;empêcher ou de limiter la création de cookies sur leurs dispositifs</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_USLCOOK"><skos:prefLabel xml:lang="de">Personen verwenden Software zur Einschränkung der Möglichkeit, die Internetaktivitäten auf ihren Geräten zu verfolgen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals use software that limits the ability to track their activities on the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui utilisent des logiciels limitant la capacité à suivre leurs activités sur l’internet sur tout dispositif</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">77757</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_prv20"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_prv20</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/c