prefLabel><skos:prefLabel xml:lang="en">Increased capacity of production or service provision</skos:prefLabel><skos:prefLabel xml:lang="fr">Accroissement de la capacité de production ou de fourniture de services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=EENV"><skos:prefLabel xml:lang="de">Verringerung der Umweltfolgen oder Verbesserung von Gesundheit und Sicherheit</skos:prefLabel><skos:prefLabel xml:lang="en">Reduced environmental impacts or improved health and safety</skos:prefLabel><skos:prefLabel xml:lang="fr">Réduction de l&apos;impact sur l&apos;environnement ou amélioration de la santé et de la sécurité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=EFLEX"><skos:prefLabel xml:lang="de">Verbesserte Flexibilität bei der Produktion oder der Erbringung von Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Improved flexibility of production or service provision</skos:prefLabel><skos:prefLabel xml:lang="fr">Accroissement de la flexibilité de la production ou de la fourniture de services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ELBR"><skos:prefLabel xml:lang="de">Verringerung der Stücklohnkosten</skos:prefLabel><skos:prefLabel xml:lang="en">Reduced labour costs per unit output</skos:prefLabel><skos:prefLabel xml:lang="fr">Réduction du coût de la main-d&apos;oeuvre par unité produite</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=EMAR"><skos:prefLabel xml:lang="de">Erschließung neuer Märkte oder Erhöhung des Marktanteils</skos:prefLabel><skos:prefLabel xml:lang="en">Entered new markets or increased market share</skos:prefLabel><skos:prefLabel xml:lang="fr">Entrée sur de nouveaux marchés ou accroissement des parts de marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=EMAT"><skos:prefLabel xml:lang="de">Verringerung des Material- und Energieansatzes je produzierter Einheit</skos:prefLabel><skos:prefLabel xml:lang="en">Reduced materials and energy per unit output</skos:prefLabel><skos:prefLabel xml:lang="fr">Réduction de l&apos;apport de matériaux et d&apos;énergie par unité produite</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=EQUA"><skos:prefLabel xml:lang="de">Verbesserte Qualität von Waren oder Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Improved quality in goods or services</skos:prefLabel><skos:prefLabel xml:lang="fr">Amélioration de la qualité des biens ou des services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ERANGE"><skos:prefLabel xml:lang="de">Ausweitung des Angebots an Waren und Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Increased range of goods and services</skos:prefLabel><skos:prefLabel xml:lang="fr">Accroissement de la gamme de biens et de services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=EREG"><skos:prefLabel xml:lang="de">Einhaltung von Vorschriften</skos:prefLabel><skos:prefLabel xml:lang="en">Met regulation requirements</skos:prefLabel