">Gross value added per employee - thousand euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Valeur ajoutée par salarié - milliers d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91150"><skos:prefLabel xml:lang="de">Bruttowertschöpfung pro gearbeiteter Stunde der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Gross value added per hour worked by employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Valeur ajoutée par heure travaillée par les salariés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91170"><skos:prefLabel xml:lang="de">Anteil der Personalkosten an der Produktion - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Share of personnel costs in production - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des dépenses de personnel dans la valeur de la production - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91210"><skos:prefLabel xml:lang="de">Durchschnittliche Personalkosten (Personalkosten je Beschäftigten) - Tausend euro</skos:prefLabel><skos:prefLabel xml:lang="en">Average personnel costs (personnel costs per employee) - thousand euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Coûts moyens de personnel (coûts de personnel par salarié - milliers d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91230"><skos:prefLabel xml:lang="de">Arbeitskosten pro gearbeiteter Stunde der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Labour cost per hour worked by employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Coût de la main d&apos;oeuvre par heure travaillée par les salariés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91275"><skos:prefLabel xml:lang="de">Anteil der Lohn- und Gehaltsempfänger an den Beschäftigten - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Share of employees in persons employed - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des salariés dans le nombre de personnes occupées - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91290"><skos:prefLabel xml:lang="de">Wachstumsrate der Beschäftigung - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Growth rate of employment - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de croissance de l&apos;emploi - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91310"><skos:prefLabel xml:lang="de">Anteil des Arbeitgebers an den Sozialabgaben als Prozentanteil an Personalaufwendungen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employer&apos;s social charges as a percentage of personnel costs - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des charges sociales des employeurs en pourcentage des dépenses de personnel - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V92100"><skos:prefLabel xml:lang="de">Beschäftigten pro Unternehmen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed per enterprise - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées par entreprise - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V92110"><skos:prefLabel xml:lang="de">Brutto-betrieblicher Überschuß/Umsatz (Brutto-Betriebsrate) - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Gross operating surplus/turnover (gross operating rate) - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Excédent brut d&apos;exploitation/Chiffre d&apos;affaires (taux brut d&apos;exploitation) - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V92111"><skos:prefLabel xml:lang="de">Anteil der Wertschöpfung zu Faktorkosten an der Produktion - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Value added at factor cost in production value - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part de la valeur ajoutée dans la valeur de la production - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V92112"><skos:prefLabel xml:lang="de">Anteil der Personalkosten an den Gesamtkäufen von Gütern und Dienstleistungen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Share of personnel costs in total purchases of goods and services - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Ratio des dépenses de personnel sur le total des achats de biens et services - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50055</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications