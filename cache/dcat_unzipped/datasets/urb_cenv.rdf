ropa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN1002V"><skos:prefLabel xml:lang="de">Tägliche Sonnenscheindauer in Stunden</skos:prefLabel><skos:prefLabel xml:lang="en">Total number of hours of sunshine per day</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre total d&apos;heures d&apos;ensoleillement par jour</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN1003V"><skos:prefLabel xml:lang="de">Durchschnittstemperatur im wärmsten Monat - Grad</skos:prefLabel><skos:prefLabel xml:lang="en">Average temperature of warmest month - degrees</skos:prefLabel><skos:prefLabel xml:lang="fr">Température moyenne du mois le plus chaud - degrés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN1004V"><skos:prefLabel xml:lang="de">Durchschnittstemperatur im kältesten Monat - Grad</skos:prefLabel><skos:prefLabel xml:lang="en">Average temperature of coldest month - degrees</skos:prefLabel><skos:prefLabel xml:lang="fr">Température moyenne du mois le plus froid - degrés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN1005V"><skos:prefLabel xml:lang="de">Niederschläge - Liter/m²</skos:prefLabel><skos:prefLabel xml:lang="en">Rainfall - litre/m²</skos:prefLabel><skos:prefLabel xml:lang="fr">Précipitations - litres/m²</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2002V"><skos:prefLabel xml:lang="de">Tage mit Konzentrationen von Ozon (O3) über 120 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="en">Number of days ozone O3 concentrations exceed 120 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre de jours où la concentration d&apos;ozone (O3) dépasse 120 µg/m³</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2003V"><skos:prefLabel xml:lang="de">Stunden mit Konzentrationen von Stickstoffdioxid (NO2) über 200 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="en">Number of hours nitrogen dioxide NO2 concentrations exceed 200 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre d&apos;heures où la concentration de dioxyde d&apos;azote (NO2) dépasse 200 µg/m³</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2005V"><skos:prefLabel xml:lang="de">Tage mit Partikelkonzentrationen (PM10) über 50 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="en">Number of days particulate matter PM10 concentrations exceed 50 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre de jours où la concentration de particules PM10 dépasse 50 µg/m³</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2025V"><skos:prefLabel xml:lang="de">Akkumulierte Ozonkonzentration über 70 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="en">Accumulated ozone concentration in excess 70 µg/m³</skos:prefLabel><skos:prefLabel xml:lang="fr">Concentration d&apos;ozone accumulée supérieure à 70 µg/m³</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2026V"><skos:prefLabel xml:lang="de">Jährliche Durchschnittskonzentration von NO2 (in µg/m³)</skos:prefLabel><skos:prefLabel xml:lang="en">Annual average concentration of NO2 (µg/m³)</skos:prefLabel><skos:prefLabel xml:lang="fr">Concentration annuelle moyenne de NO2 (µg/m³)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2027V"><skos:prefLabel xml:lang="de">Jährliche Durchschnittskonzentration von PM10 (in µg/m³)</skos:prefLabel><skos:prefLabel xml:lang="en">Annual average concentration of PM10 (µg/m³)</skos:prefLabel><skos:prefLabel xml:lang="fr">Concentration annuelle moyenne de particules PM10 (µg/m³)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2029I"><skos:prefLabel xml:lang="de">Anteil der Gebietsansässigen, die bei Nacht einem Luftverkehrslärmpegel von über 55 dB(A) ausgesetzt sind</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of residents exposed to air traffic noise &gt;55 dB(A) at night time</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de résidents exposés la nuit à un niveau sonore résultant du trafic aérien &gt;55 dB(A)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2032I"><skos:prefLabel xml:lang="de">Anteil der Gebietsansässigen, die am Tage einem Schienenverkehrslärmpegel von über 65 dB(A) ausgesetzt sind</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of residents exposed to rail traffic noise &gt;65 dB(A) at day time</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de résidents exposés le jour à un niveau sonore résultant du trafic ferroviaire &gt;65 dB(A)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2033I"><skos:prefLabel xml:lang="de">Anteil der Gebietsansässigen, die am Tage einem Straßenverkehrslärmpegel von über 65 dB(A) ausgesetzt sind</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of residents exposed to road traffic noise &gt;65 dB(A) at day time</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de résidents exposés le jour à un niveau sonore résultant du trafic routier &gt;65 dB(A)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2035I"><skos:prefLabel xml:lang="de">Anteil der Gebietsansässigen, die bei Nacht einem Straßenverkehrslärmpegel von über 55 dB(A) ausgesetzt sind</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of residents exposed to road traffic noise &gt;55 dB(A) at night time</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de résidents exposés la nuit à un niveau sonore résultant du trafic routier supérieur à 55 dB(A)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN2036I"><skos:prefLabel xml:lang="de">Anteil der Gebietsansässigen, die bei Nacht einem Schienenverkehrslärmpegel von über 55 dB(A) ausgesetzt sind</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of residents exposed to rail traffic noise &gt;55 dB(A) at night time</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de résidents exposés la nuit à un niveau sonore résultant du trafic ferroviaire supérieur à 55 dB(A)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN3003V"><skos:prefLabel xml:lang="de">Wasserverbrauch, insgesamt - m³</skos:prefLabel><skos:prefLabel xml:lang="en">Total use of water - m³</skos:prefLabel><skos:prefLabel xml:lang="fr">Consommation totale d&apos;eau - m³</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN3010V"><skos:prefLabel xml:lang="de">Preis je m³ Wasser für private Haushalte - EUR</skos:prefLabel><skos:prefLabel xml:lang="en">Price of a m³ of domestic water - Euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Prix d&apos;un m³ d&apos;eau domestique - euro</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN3011V"><skos:prefLabel xml:lang="de">Anteil der entsprechend den geltenden Standards behandelten kommunalen Abwasserbelastung (in EW)</skos:prefLabel><skos:prefLabel xml:lang="en">Share of the urban waste water load (in population equivalents) treated according to the applicable standard -%</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion des eaux usées urbaines (en équivalents-habitant) traitées conformément aux normes en vigueur - %</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN3012V"><skos:prefLabel xml:lang="de">Anteil der Bevölkerung mit Trinkwasseranschluss - %</skos:prefLabel><skos:prefLabel xml:lang="en">Share of population connected to potable drinking water system - %</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de la population raccordée au réseau d&apos;eau potable - %</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN3013V"><skos:prefLabel xml:lang="de">Anteil der Bevölkerung mit Kanalanschluss - %</skos:prefLabel><skos:prefLabel xml:lang="en">Share of population connected to sewerage treatment system - %</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de la population raccordée au réseau d&apos;assainissement - %</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN4008V"><skos:prefLabel xml:lang="de">Erzeugte Siedlungsabfälle (Haushalts- und Gewerbeabfälle), insgesamt - 1000 t</skos:prefLabel><skos:prefLabel xml:lang="en">Municipal waste generated (domestic and commercial), total - 1000 t</skos:prefLabel><skos:prefLabel xml:lang="fr">Déchets municipaux générés (d&apos;origine domestique et commerciale), total - 1000 t</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN5200V"><skos:prefLabel xml:lang="de">Anteil (%): Flächen durchgängig städtischer Prägung</skos:prefLabel><skos:prefLabel xml:lang="en">Share of land (%): continuous residential urban fabric</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des terres (%): tissu urbain continu</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN5201V"><skos:prefLabel xml:lang="de">Anteil (%): Flächen nicht-durchgängig städtischer Prägung</skos:prefLabel><skos:prefLabel xml:lang="en">Share of land (%): discontinuous residential urban fabric</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des terres (%): tissu urbain discontinu</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN5202V"><skos:prefLabel xml:lang="de">Anteil (%): Industrie- und Gewerbeflächen</skos:prefLabel><skos:prefLabel xml:lang="en">Share of land (%): industrial, commercial, public, military and private units</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des terres (%): zones industrielles, commerciales, publiques, militaires et privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN5203V"><skos:prefLabel xml:lang="de">Anteil (%): Verkehrsflächen</skos:prefLabel><skos:prefLabel xml:lang="en">Share of land (%): transport infrastructure</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des terres (%): infrastructure de communication</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN5204V"><skos:prefLabel xml:lang="de">Anteil (%): Sonstige künstlich angelegte Flächen</skos:prefLabel><skos:prefLabel xml:lang="en">Share of land (%): other artificial areas</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des terres (%): autres territoires artificialisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EN5205V"><skos:prefLabel xml:lang="de">Anteil (%): Städtische Grünflächen und Sport und Freizeitanlagen</skos:prefLabel><skos:prefLabel xml:lang="en">Share of land (%): green urban areas and sports and leisure facilities</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des terres (%): espaces verts urbains et équipements sportifs et de loisirs</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code