t="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EC2032V"><skos:prefLabel xml:lang="de">Erwerbstätige (Arbeitsplätze) im Handel, in Verkehr und in Beherbergungs- und Gaststätten (NACE Rev. 2, G bis I)</skos:prefLabel><skos:prefLabel xml:lang="en">Employment (jobs) in trade, transport, hotels, restaurants (NACE Rev. 2, G to I)</skos:prefLabel><skos:prefLabel xml:lang="fr">Emploi (postes de travail) dans les transports, l&apos;hébergement et la restauration (NACE Rév. 2., G à I)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EC2033V"><skos:prefLabel xml:lang="de">Erwerbstätige (Arbeitsplätze) in Information und Kommunikation (NACE Rev. 2, J)</skos:prefLabel><skos:prefLabel xml:lang="en">Employment (jobs) in information and communication (NACE Rev. 2, J)</skos:prefLabel><skos:prefLabel xml:lang="fr">Emploi (postes de travail) dans l&apos;information et la communication (NACE Rév.2, J)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EC2034V"><skos:prefLabel xml:lang="de">Erwerbstätige (Arbeitsplätze) in der Erbringung von Finanz- und Versicherungsdienstleistungen (NACE Rev. 2, K)</skos:prefLabel><skos:prefLabel xml:lang="en">Employment (jobs) in financial and insurance activities (NACE Rev. 2, K)</skos:prefLabel><skos:prefLabel xml:lang="fr">Emploi (postes de travail) dans les activités financières et d&apos;assurance (NACE Rév.2, K)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EC2035V"><skos:prefLabel xml:lang="de">Erwerbstätige (Arbeitsplätze) im Grundstücks- und Wohnungswesen (NACE Rev. 2, L)</skos:prefLabel><skos:prefLabel xml:lang="en">Employment (jobs) in real estate activities (NACE Rev. 2, L)</skos:prefLabel><skos:prefLabel xml:lang="fr">Emploi (postes de travail) dans les activités immobilières (NACE Rév.2, L)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EC2036V"><skos:prefLabel xml:lang="de">Erwerbstätige (Arbeitsplätze) in der Erbringung von freiberuflichen, wissenschaftlichen und technischen Dienstleistungen sowie sonstigen wirtschaftlichen Dienstleistungen (NACE Rev. 2, M und N)</skos:prefLabel><skos:prefLabel xml:lang="en">Employment (jobs) in professional, scientific and technical activities; administrative and support service activities (NACE Rev. 2, M and N)</skos:prefLabel><skos:prefLabel xml:lang="fr">Emplois (postes de travail) dans les activités spécialisées, scientifiques et techniques; activités de services administratifs et de soutien (NACE Rév. 2., M et N)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EC2037V"><skos:prefLabel xml:lang="de">Erwerbstätige (Arbeitsplätze) in öffentlicher Verwaltung und Verteidigung, in Erziehung und Unterricht und im Gesundheits- und Sozialwesen (NACE Rev. 2, O bis Q)</skos:prefLabel><skos:prefLabel xml:lang="en">Employment (jobs) in public administration, defence, education, human health and social work activities (NACE Rev. 2, O to Q)</skos:prefLabel><skos:prefLabel xml:lang="fr">Emplois (postes de travail) dans l&apos;administration publique, la défense, l&apos;enseignement, la santé humaine et l&apos;action sociale (NACE Rév. 2., O à Q)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=EC2038V"><skos:prefLab