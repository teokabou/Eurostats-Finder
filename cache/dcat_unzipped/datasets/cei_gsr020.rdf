uthority/access-right/PUBLIC"/><dcat:byteSize>1654</dcat:byteSize><spdx:checksum> <spdx:Checksum> <spdx:algorithm rdf:resource="http://spdx.org/rdf/terms#checksumAlgorithm_sha256"/><spdx:checksumValue>7e4dd90e44b0d76ae15827a3667b151b623f4ad481812a8ce7a9b1668619df27</spdx:checksumValue> </spdx:Checksum> </spdx:checksum></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/cei_gsr020?format=sdmx_2.1_structured&amp;compressed=true"><dct:title xml:lang="en">Download dataset in SDMX 2.1 format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/cei_gsr020?format=sdmx_2.1_structured&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/cei_gsr020?format=sdmx_2.1_structured&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/XML"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dcat:byteSize>1568</dcat:byteSize><spdx:checksum> <spdx:Checksum> <spdx:algorithm rdf:resource="http://spdx.org/rdf/terms#checksumAlgorithm_sha256"/><spdx:checksumValue>bf22d2b2017599cc54cdc6e4e63a522c83b9e354809c21231eb7dff75b899718</spdx:checksumValue> </spdx:Checksum> </spdx:checksum></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/