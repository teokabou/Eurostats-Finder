<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/cei_gsr020"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-04</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Umweltindikator</dcat:keyword><dcat:keyword  xml:lang="en">Environment indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur de l&apos;environnement</dcat:keyword><dcat:keyword  xml:lang="de">Rohstoffe</dcat:keyword><dcat:keyword  xml:lang="en">Raw materials</dcat:keyword><dcat:keyword  xml:lang="fr">Matières premières</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">EU self-sufficiency for raw materials</dct:title><dct:description xml:lang="en">&lt;p&gt;The Self-sufficiency (SS) indicator measures how much the EU is independent from the rest of the world for several raw materials. The indicator has been calculated based on actual yearly quantity data for domestic production, exports and imports, using the formula:&lt;/p&gt;&lt;p&gt;Self-sufficiency = 1 - (net) Import Reliance, where Import Reliance (IR) is defined in the EU Critical Raw Materials methodology as Net imports / (Net imports +Domestic Production).&lt;/p&gt;&lt;p&gt;&amp;nbsp;The values of Self-sufficiency indicator could range from 0 to 100%.&lt;/p&gt;&lt;p&gt;Due to increasing demand for certain materials (such as silicon, copper, tellurium and indium), even if 100% were recycled, the EU would still not be self-sufficient. The indicator should be considered in a broader context considering potential disruption of supply in the context of economically sensitive key areas. &lt;/p&gt;</dct:description><dct:title xml:lang="fr">Autosuffisance de l&apos;UE pour les matières premières</dct:title><dct:description xml:lang="fr">&lt;p&gt;L&apos;indicateur d&apos;autosuffisance (SS) mesure à quel point l&apos;UE est indépendante du reste du monde pour plusieurs matières premières. L&apos;indicateur a été calculé sur la base des données quantitatives annuelles réelles pour la production nationale, les exportations et les importations, en utilisant la formule&amp;nbsp;:&lt;/p&gt;&lt;p&gt;Autosuffisance = 1 - Dépendance (nette) aux importations, où la dépendance aux importations (IR) est définie dans la méthodologie EU Critical Raw Materials comme étant les importations nettes / (importations nettes + production nationale).&lt;/p&gt;&lt;p&gt;Les valeurs de l&apos;indicateur d&apos;autosuffisance peuvent varier de 0 à 100 %.&lt;/p&gt;&lt;p&gt;En raison de la demande croissante de certains matériaux (tels que le silicium, le cuivre, le tellure et l&apos;indium), même si 100 % étaient recyclés, l&apos;UE ne serait toujours pas autosuffisante. L&apos;indicateur doit être considéré dans un contexte plus large en tenant compte des perturbations potentielles de l&apos;approvisionnement dans le contexte des domaines clés économiquement sensibles.&lt;/p&gt;</dct:description><dct:title xml:lang="de">EU-Selbstversorgung mit Rohstoffen</dct:title><dct:description xml:lang="de">&lt;p&gt;Der Indikator Selbstversorgung misst, wie sehr die EU bei mehreren Rohstoffen vom Rest der Welt unabhängig ist. Der Indikator wurde auf der Grundlage der tatsächlichen jährlichen Mengendaten für die inländische Produktion, Exporte und Importe nach folgender Formel berechnet:&lt;/p&gt;&lt;p&gt;Selbstversorgung = 1 - (Netto-) Importvertrauen, wobei Importvertrauen (IR) in der EU-Methodik für kritische Rohstoffe als Nettoimporte / (Nettoimporte + Inlandsproduktion) definiert ist.&lt;/p&gt;&lt;p&gt;Die Werte des Selbstversorgungsindikators können zwischen 0 und 100 % liegen.&lt;/p&gt;&lt;p&gt;Aufgrund der steigenden Nachfrage nach bestimmten Materialien (wie Silizium, Kupfer, Tellur und Indium) wäre die EU selbst bei einer 100-prozentigen Wiederverwertung immer noch nicht autark. Der Indikator sollte in einem breiteren Kontext betrachtet werden, der potenzielle Versorgungsunterbrechungen im Zusammenhang mit wirtschaftlich sensiblen Schlüsselbereichen berücksichtigt.&lt;/p&gt;</dct:description><dct:identifier>cei_gsr020</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/cei_gsr020"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ENV" > <skos:prefLabel xml:lang="de">Umweltindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Environment indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur de l&apos;environnement</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/RAWMAT" > <skos:prefLabel xml:lang="de">Rohstoffe</skos:prefLabel><skos:prefLabel xml:lang="en">Raw materials</skos:prefLabel><skos:prefLabel xml:lang="fr">Matières premières</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ENV?code=EXR"><skos:prefLabel xml:lang="de">Gewinnung</skos:prefLabel><skos:prefLabel xml:lang="en">Extraction</skos:prefLabel><skos:prefLabel xml:lang="fr">Extraction</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC"><skos:prefLabel xml:lang="de">Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ENV?code=PCS"><skos:prefLabel xml:lang="de">Verarbeitung</skos:prefLabel><skos:prefLabel xml:lang="en">Processing</skos:prefLabel><skos:prefLabel xml:lang="fr">Transformation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-12</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/r