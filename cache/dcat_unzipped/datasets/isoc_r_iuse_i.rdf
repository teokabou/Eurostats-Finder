/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IDAY"><skos:prefLabel xml:lang="de">Internet-Nutzung: täglich</skos:prefLabel><skos:prefLabel xml:lang="en">Frequency of internet access: daily</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence d&apos;accès à l&apos;internet: tous les jours</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_ILT12"><skos:prefLabel xml:lang="de">Letzte Internet-Nutzung: in den letzten 12 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">Last internet use: in the last 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière utilisation d&apos;internet: au cours des 12 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IU3"><skos:prefLabel xml:lang="de">Letzte Internet-Nutzung: in den letzten 3 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">Last internet use: in last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière utilisation d&apos;internet: au cours des 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUBK"><skos:prefLabel xml:lang="de">Internet-Nutzung: Internet-Banking</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: Internet banking</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour des services bancaires sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUCPP"><skos:prefLabel xml:lang="de">Internet-Nutzung: Teilnahme an gesellschaftspolitischen Themen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: civic or political participation</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour participation civile et/ou politique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSE"><skos:prefLabel xml:lang="de">Internet-Nutzung: einmal pro Woche (auch täglich)</skos:prefLabel><skos:prefLabel xml:lang="en">Frequency of internet access: once a week (including every day)</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence d&apos;accès à l&apos;internet: une fois par semaine (tous les jours inclus)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSELL"><skos:prefLabel xml:lang="de">Internet-Nutzung: Verkauf von Waren und Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: selling goods or services</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour vendre des biens et des services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSNET"><skos:prefLabel xml:lang="de">Internet-Nutzung: Nutzen von sozialen Netzwerken (Erstellen eines Personenprofils, Posten von Nachrichten oder sonstigen Beiträgen zu Facebook, Twitter, etc.)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: participating in social networks (creating user profile, posting messages or other contributions to facebook, twitter, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour communiquer sur des réseaux sociaux (créer un profil d&apos;utilisateur, envoyer des messages à ou intervenir sur un ou plusieurs réseaux sociaux p.ex. Facebook, Twitter, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUX"><skos:prefLabel xml:lang="de">Internet-Nutzung: niemals</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: never</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: jamais</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5659</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="ht