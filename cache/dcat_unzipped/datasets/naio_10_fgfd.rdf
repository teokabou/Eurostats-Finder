<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/naio_10_fgfd"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-02</dct:issued><dcat:keyword  xml:lang="de">Herkunftsland</dcat:keyword><dcat:keyword  xml:lang="en">Country of origin</dcat:keyword><dcat:keyword  xml:lang="fr">Pays d&apos;origine</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Foreign value added in domestic final use (FIGARO application)</dct:title><dct:description xml:lang="en">&lt;p&gt; The gross value added generated abroad by the domestic final use of EU economies. This indicator reflects the foreign value added incorporated into the domestic final use of products of EU economies, highligthing how industries abroad are connected to EU final consumers. At the partner country and industry level, this measure reveals trading relationships that otherwise are not aparent when looking at bilateral trade statistics in gross terms. It is measured in thousand euros.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Valeur ajoutée étrangère dans la demande finale domestique (Application FIGARO)</dct:title><dct:description xml:lang="fr">&lt;p&gt; La valeur ajoutée brute générée à l’étranger par les utilisations finales intérieures des économies de l’UE. Cet indicateur reflète la valeur ajoutée étrangère incorporée dans la demande finale domestique des produits des économies de l&apos;UE, mettant en évidence la manière dont les industries étrangères sont connectées aux consommateurs finaux de l&apos;UE. Au niveau des pays partenaires et des industries, cette mesure révèle des relations commerciales qui ne sont autrement pas apparentes lorsqu&apos;on examine les statistiques commerciales bilatérales en termes bruts. Elle est mesurée en milliers d&apos;euros.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Ausländische Wertschöpfung in der inländischen Endverwendung (FIGARO-Anwendung)</dct:title><dct:description xml:lang="de">&lt;p&gt; Bruttowertschöpfung, die im Ausland (EU- und Nicht-EU-Länder) durch inländische Endverwendung generiert wird. Der Indikator erfasst die Bruttowertschöpfung, welche im Ausland (EU- und Nicht-EU-Länder) durch die Endverwendung in den einzelnen EU-Ländern generiert wird. Damit werden die Verflechtungen von Wirtschaftszweigen im Ausland mit den Endverbrauchern in der EU dargestellt. Auf der Ebene der Partnerländer und -industrien macht dieser Indikator Handelsbeziehungen transparent, die andernfalls in den bilateralen Handelsstatistiken nicht sichtbar wären. Die Werte sind in Tausend Euro angegeben.&lt;/p&gt;</dct:description><dct:identifier>naio_10_fgfd</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/naio_10_fgfd"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:L