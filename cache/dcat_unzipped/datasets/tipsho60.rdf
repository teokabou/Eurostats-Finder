<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tipsho60"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-10-22</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Standardised house price-to-income ratio - annual data</dct:title><dct:description xml:lang="en">&lt;p&gt;The standardised house price-to-income ratio is defined as the ratio of the current price to income ratio relative to the long-term average price-to-income ratio, calculated over the period 2000 to the most recent data available. If the ratio equals 100, it means the current price-to-income ratio is equal to its long term average. House prices are provided by Eurostat, and income is calculated as adjusted household gross disposable income (B7G) per head of population based on Eurostat data.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Ratio standardisé prix des logements-revenu - données annuelles</dct:title><dct:description xml:lang="fr">&lt;p&gt;Le ratio standardisé prix des logements-revenu est défini comme le rapport entre le ratio prix/revenu actuel et la moyenne à long terme du ratio prix/revenu, calculé sur la période allant de 2000 aux données disponibles les plus récentes. Si le ratio est égal à 100, cela signifie que le rapport prix/revenu actuel est égal à sa moyenne à long terme. Les prix des logements sont fournis par Eurostat, et le revenu est calculé comme le revenu disponible brut ajusté des ménages (B7G) par habitant sur la base des données d&apos;Eurostat.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Standardisiertes Hauspreis-Einkommens-Verhältnis - jährliche Daten</dct:title><dct:description xml:lang="de">&lt;p&gt;Das standardisierte Hauspreis-Einkommens-Verhältnis ist definiert als das Verhältnis des aktuellen Preis-Einkommens-Verhältnisses zum langfristigen durchschnittlichen Preis-Einkommens-Verhältnis, das über dem Zeitraum seit 2000 mit den neuesten verfügbaren Daten berechnet. Wenn das Verhältnis 100 beträgt, bedeutet dies, dass das aktuelle Kurs-Einkommens-Verhältnis seinem langfristigen Durchschnitt entspricht. Die Hauspreise werden von Eurostat bereitgestellt, und das Einkommen wird als bereinigtes verfügbares Haushaltsbruttoeinkommen (B7G) pro Kopf der Bevölkerung auf der Grundlage von Eurostat-Daten berechnet.&lt;/p&gt;</dct:description><dct:identifier>tipsho60</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tipsho60"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PTIR_I15"><skos:prefLabel xml:lang="de">Preis/Ertrag Verhältnis, Index 2015=100</skos:prefLabel><skos:prefLabel xml:lang="en">Price-to-income ratio, index 2015=100</skos:prefLabel><skos:prefLabel xml:lang="fr">Ratio prix/revenu, indice 2015=100</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PTIR_LT_AVG"><skos:prefLabel xml:lang="de">Preis/Ertrag Verhältnis zu langfristigem Durchschnitt</skos:prefLabel><skos:prefLabel xml:lang="en">Price-to-income ratio relative to long-term average</skos:prefLabel><skos:prefLabel xml:lang="fr">Ratio prix/revenu par rapport à la moyenne à long terme</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=RCH_A_AVG"><skos:prefLabel xml:lang="de">Jährliche Veränderungsrate des Jahresdurchschnitts</skos:prefLabel><skos:prefLabel xml:lang="en">Annual average rate of change</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de variation moyen annuel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2000-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/tipsho60"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/tipsho60</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/tipsho20_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tipsho60"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cac