thority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12FM"><skos:prefLabel xml:lang="de">Internet-Nutzung: Herunterladen amtlicher Formulare (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: downloading official forms (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour télécharger des formulaires officiels (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12FM2"><skos:prefLabel xml:lang="de">Internetnutzung: Herunterladen oder Drucken amtlicher Formulare (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: downloading or printing official forms (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour télécharger ou imprimer des formulaires officiels (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12IF"><skos:prefLabel xml:lang="de">Internet-Nutzung: Informationsbeschaffung auf Websites öffentlicher Stellen (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: obtaining information from public authorities web sites (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour obtenir des informations à partir de sites Web des pouvoirs publics (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12IF2"><skos:prefLabel xml:lang="de">Internetnutzung: Informationsbeschaffung  über Services, Leistungen, Ansprüche, Gesetze, Öffnungszeiten (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: obtaining information about services, benefits, entitlements, laws, opening hours (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour obtenir des informations sur les services, les prestations, les droits, la législation, les heures d&apos;ouverture (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV12RT"><skos:prefLabel xml:lang="de">Internet-Nutzung: Übermittlung ausgefüllter Formulare (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: submitting completed forms (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour remplir et transmettre des formulaires (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVANYS"><skos:prefLabel xml:lang="de">Internetnutzung: Website oder App von öffentlichen Behörden (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: website or app of public authorities (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: Utilisation du site web ou d&apos;une application des pouvoirs publics (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVAPR"><skos:prefLabel xml:lang="de">Internetnutzung: Terminvereinbarung oder Reservierung (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: making an appointment or a reservation (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: Prendre un rendez-vous ou faire une réservation (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVBE"><skos:prefLabel xml:lang="de">Internetnutzung: Beantragung von Leistungen oder Ansprüchen (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: request benefits or entitlements (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: demande de prestations ou de droits (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVDOC"><skos:prefLabel xml:lang="de">Nutzung von Websites öffentlicher Stellen: Beantragen von Dokumenten oder Urkunden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals requesting personal documents or certificates via websites of public authorities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant demandé des documents officiels ou des certificats via le site Web des pouvoirs publics</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVED"><skos:prefLabel xml:lang="de">Nutzung von Websites öffentlicher Stellen: Einschreiben an (Fach-)Hochschulen oder Universitäten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals enroling in higher education or university via websites of public authorities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers s&apos;étant inscrits dans un établissement d&apos;enseignement supérieur ou une université via le site Web des pouvoirs publics</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVIDB"><skos:prefLabel xml:lang="de">Internetnutzung: Zugriff auf öffentliche Datenbanken oder Register (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: accessing public databases or registers (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: Accéder à des bases de données ou à des registres publics (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVIP"><skos:prefLabel xml:lang="de">Internetnutzung: Zugriff auf persönliche Informationen (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: accessing personal information (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: Accéder à ses données personnelles (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVIX"><skos:prefLabel xml:lang="de">Internetnutzung: hat das Internet genutzt, aber nicht um persönliche Informationen einzuholen, auf öffentliche Datenbanken zuzugreifen, oder Informationen von Websites oder Apps abzurufen (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: used internet, but not for obtaining personal information, accessing public databases or getting information from websites or apps (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: Utiliser internet mais sans intention d&apos;obtenir des informations personnelles, d&apos;accéder aux bases de données ni d&apos;obtenir d&apos;informations de sites Web des pouvoirs publics (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVLIB"><skos:prefLabel xml:lang="de">Nutzung von Websites öffentlicher Stellen: Suche in Katalogen von öffentlichen Bibliotheken</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals using public libraries (availability of catalogues, search tools) via websites of public authorities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé des bibliothèques publiques (disponibilité de catalogues, outils de recherche) via le site Web des pouvoirs publics</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVMV"><skos:prefLabel xml:lang="de">Nutzung von Websites öffentlicher Stellen: An-/Ummeldung des Wohnsitzes</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals notifying change of address via websites of public authorities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant notifié un changement d&apos;adresse via le site Web des pouvoirs publics</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVODC"><skos:prefLabel xml:lang="de">Internetnutzung: Anforderung amtlicher Dokumente oder Zertifikate (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: request official documents or certificates (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: demande de documents ou de certificats officiels (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVPOST"><skos:prefLabel xml:lang="de">Internetnutzung: Empfang von offiziellen Mitteilungen oder Dokumenten (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: receiving official communication or documents (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: recevoir une communication ou des documents officiels (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVRCC"><skos:prefLabel xml:lang="de">Internetnutzung: Einbringen von anderen Anfragen, Ansprüchen oder Beschwerden (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: making other requests, claims or complaints (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: introduction d&apos;autres types de demande ou de réclamation (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVRX"><skos:prefLabel xml:lang="de">Internetnutzung: hat keine amtlichen Dokumente, Zertifikate, Leistungen oder Ansprüche angefordert, oder sonstige Anfragen, Ansprüche oder Beschwerden vorgebracht (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: did not request official documents, certificates, benefits or entitlements, or make other requests, claims or complaints (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pas de demande de documents officiels, ni de certificats, ni de droits ou de prestations, ni aucune autre demande ou réclamation (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVSS"><skos:prefLabel xml:lang="de">Nutzung von Websites öffentlicher Stellen: Beantragen von Sozialleistungen (z.B. Arbeitslosengeld, Rente, Kindergeld)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals claiming social security benefits (e.g. unemployment benefits, retirement, child allowance) via websites of public authorities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant fait leurs demandes de prestations sociales (par exemple le chômage, la retraite, les allocations familiales) via le site Web des pouvoirs publics</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVTAX"><skos:prefLabel xml:lang="de">Nutzung von Websites öffentlicher Stellen: Einkommensteuererklärung</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals submitting income tax declaration via websites of public authorities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant fait leurs Déclaration de revenus sur le site Web des pouvoirs publics</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVTAX1_SLF"><skos:prefLabel xml:lang="de">Internetnutzung: Online-Steuererklärung abgeben (in den letzten 12 Monaten)(bis 2023)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: submit online tax declaration (last 12 months)(until 2023)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : dépôt d&apos;une déclaration de taxe en ligne (12 derniers mois)(jusqu&apos;en 2023)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVTAX2"><skos:prefLabel xml:lang="de">Internet-Nutzung: Abgabe der Steuererklärung (letzte 12 Monate) (ab 2024)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: submitting my tax declaration (in the last 12 months) (as of 2024)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: soumettre la taxe (dans les 12 derniers mois) (à partir de 2024)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOV_ANY"><skos:prefLabel xml:lang="de">Personen, die Websites öffentlicher Stellen für mindestens eine der Aktivitäten (igovtax, igovss, igovdoc, igovlib, igoved, igovmv) genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals using websites of public authorities for any of igovtax, igovss, igovdoc, igovlib, igoved or igovmv</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé les sites Web des pouvoirs publics (pour au moins une de: igovtax, igovss, igovdoc, igovlib, igoved, igovmv)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUGOV1"><skos:prefLabel xml:lang="de">Internetnutzung: Interaktion mit öffentlichen Behörden (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: interaction with public authorities (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: interagir avec les pouvoirs publics (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUGOV12"><skos:prefLabel xml:lang="de">Internet-Nutzung: Interaktion mit staatlichen Behörden (in den letzten 12 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: interaction with public authorities (last 12 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour leurs contacts avec les pouvoirs publics (12 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IUGOV12"><skos:prefLabel xml:lang="de">Prozent der Nutzer von e-Government</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of e-government users</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des usagers de l&apos;administration en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">225557</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified r