e/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUTV_APP"><skos:prefLabel xml:lang="de">Personen, die ein Smart-TV verwenden, um andere Apps zu nutzen (z.B. Spiele, Online-Einkäufe)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a smart TV for using other apps (e.g. games, online shopping)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une Smart TV pour utiliser d&apos;autres applications (p. ex. jeux, boutiques en ligne)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUTV_OVC"><skos:prefLabel xml:lang="de">Personen, die ein Smart-TV verwenden, um andere Video-Inhalte (von kommerziellen Anbietern oder von Video-Sharing-Diensten) anzusehen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a smart TV for watching other video content (on demand or from sharing services)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une Smart TV pour regarder d&apos;autres contenus vidéo (à la demande ou depuis un service de partage)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUTV_STV"><skos:prefLabel xml:lang="de">Personen, die ein Smart-TV verwenden, um Streaming-Fernsehsendungen im Internet (live oder zeitversetzt) anzusehen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a smart TV for watching internet streamed TV (live or catch-up)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une Smart TV pour regarder la télévision en streaming sur l&apos;internet (en direct ou en replay)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUTV_V"><skos:prefLabel xml:lang="de">Personen, die ein Smart-TV verwenden, um Streaming-Fernsehsendungen oder andere Video-Inhalte anzusehen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a smart TV for watching internet streamed TV or other video content</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une Smart TV pour regarder la télévision en streaming sur l&apos;internet ou d&apos;autres contenus vidéo</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUTV_WEB"><skos:prefLabel xml:lang="de">Personen, die ein Smart-TV verwenden, um mittels Browser App im Internet zu surfen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a smart TV for Internet browsing through a browser app</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé une Smart TV pour naviguer sur l&apos;internet grâce à un navigateur web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IUG_TV"><skos:prefLabel xml:lang="de">Prozent der Personen mit Internet-Nutzung über ein Smart-TV (mit direkter Internetverbindung)</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used the internet on a smart TV (directly connected to the internet)</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisé l&apos;internet sur une smart TV (directement connecté à l&apos;internet)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38520</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-them