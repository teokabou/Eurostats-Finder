/resource/authority/country/LIE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED" > <skos:prefLabel xml:lang="de">Bildungsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Education indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;éducation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN01_1"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Schüler/Studierenden in KKS, alle Bildungsbereiche zusammen, basierend auf Vollzeitäquivalenten</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per pupil/student in PPS, for all levels of education combined, based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par élève/étudiant en SPA au titre des établissements d&apos;enseignement publics, tous niveaux confondus, calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN01_2"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Schüler in KKS, im Primarbereich (ISCED 1), basierend auf Vollzeitäquivalenten</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per pupil in PPS, at primary level of education (ISCED 1), based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par élève en SPA au titre des établissements d&apos;enseignement publics au niveau de l&apos;enseignement primaire (CITE 1), calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN01_3"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Schüler in KKS, im Sekundarbereich (ISCED 2-4), basierend auf Vollzeitäquivalenten</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per pupil in PPS, at secondary level of education (ISCED 2-4), based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par élève en SPA au titre des établissements d&apos;enseignement publics au niveau de l&apos;enseignement secondaire (CITE 2-4), calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN01_4"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Studierenden in KKS, im Tertiärbereich (ISCED 56), basierend auf Vollzeitäquivalenten</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per student in PPS, at tertiary level of education (ISCED 56), based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par élève en SPA au titre des établissements d&apos;enseignement publics au niveau de l&apos;enseignement tertiaire (CITE 56), calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN02_1"><skos:prefLabel xml:lang="de">Verhältnis der jährlichen Ausgaben für Bildungseinrichtungen pro Studierenden im Tertiärbereich im Vergleich mit den jährlichen Ausgaben für Bildungseinrichtungen pro Schüler im Primarbereich, basierend auf Vollzeitäquivalente</skos:prefLabel><skos:prefLabel xml:lang="en">Ratio of annual expenditure per student at the tertiary level of education to the annual expenditure per pupil at primary level, in public educational institutions, based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Rapport entre les dépenses annuelles d&apos;éducation par étudiant au niveau de l&apos;enseignement tertiaire et les dépenses annuelles d&apos;éducation par élève au niveau de l&apos;enseignement primaire, au titre des établissements d&apos;enseignement publics, calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN03_1"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Schüler/Studierenden im Vergleich zum BIP pro Kopf der Bevölkerung für alle Bildungsbereiche zusammen, basierend auf Vollzeitäquivalente</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per pupil/student compared to GDP per capita, for all levels of education combined, based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par élève/étudiant dans les établissements d&apos;enseignement publics en comparaison du PIB par habitant, tous niveaux confondus, calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN03_2"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Schüler im Vergleich zum BIP pro Kopf der Bevölkerung im Primarbereich (ISCED 1), basierend auf Vollzeitäquivalente</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per pupil compared to GDP per capita, at primary level of education (ISCED 1), based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par élève dans les établissements d&apos;enseignement publics en comparaison du PIB par habitant au niveau de l&apos;enseignement primaire (CITE 1), calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN03_3"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Schüler im Vergleich zum BIP pro Kopf der Bevölkerung im Sekundarbereich (ISCED 2-4), basierend auf Vollzeitäquivalente</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per pupil compared to GDP per capita, at secondary level of education (ISCED 2-4), based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par élève dans les établissements d&apos;enseignement publics en comparaison du PIB par habitant au niveau de l&apos;enseignement secondaire (CITE 2-4), calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN03_4"><skos:prefLabel xml:lang="de">Jährliche Ausgaben für öffentliche Bildungseinrichtungen pro Studierenden im Vergleich zum BIP pro Kopf der Bevölkerung im Tertiärbereich (ISCED 56), basierend auf Vollzeitäquivalente</skos:prefLabel><skos:prefLabel xml:lang="en">Annual expenditure on public educational institutions per student compared to GDP per capita, at tertiary level of education (ISCED 56), based on full-time equivalents</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses annuelles d&apos;éducation par étudiant dans les établissements d&apos;enseignement publics en comparaison du PIB par habitant au niveau de l&apos;enseignement tertiaire (CITE 56), calculs fondés sur des équivalents temps plein</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN04_1"><skos:prefLabel xml:lang="de">Laufende Ausgaben in % der Gesamtausgaben für öffentliche Bildungseinrichtungen für alle Bildungsbereiche zusammen</skos:prefLabel><skos:prefLabel xml:lang="en">Current expenditure as % of total expenditure in public educational institutions, for all levels of education combined</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses courantes en % des dépenses totales dans les établissements d&apos;enseignement publics, tous niveaux confondus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN04_2"><skos:prefLabel xml:lang="de">Investitionsausgaben in % der Gesamtausgaben für öffentliche Bildungseinrichtungen für alle Bildungsbereiche zusammen</skos:prefLabel><skos:prefLabel xml:lang="en">Capital expenditure as % of total expenditure in public educational institutions, for all levels of education combined</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses en capital en % des dépenses totales dans les établissements d&apos;enseignement publics, tous niveaux confondus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FN04_3"><skos:prefLabel xml:lang="de">Personalausgaben in % der Gesamtausgaben für öffentliche Bildungseinrichtungen für alle Bildungsbereiche zusammen</skos:prefLabel><skos:prefLabel xml:lang="en">Personnel expenditure as % of current expenditure in public educational institutions, for all levels of education combined</skos:prefLabel><skos:prefLabel xml:lang="fr">Dépenses de personnel en % des dépenses totales dans les établissements d&apos;enseignement publics, tous niveaux confondus</skos:prefLabel></skos:Conce