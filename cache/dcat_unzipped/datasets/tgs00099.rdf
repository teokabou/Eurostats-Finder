.org/spar/datacite/doi">10.2908/TGS00099</skos:notation><dct:creator rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/ESTAT"/><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-01-23</dct:issued></adms:Identifier></adms:identifier></dcat:Dataset></rdf:RDF>