<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/naio_10_fcp_s2"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-07-06</dct:issued><dcat:keyword  xml:lang="de">Statistische Güterklassifikation in Verbindung mit den Wirtschaftszweigen (CPA 2.1)</dcat:keyword><dcat:keyword  xml:lang="en">Statistical Classification of Products by Activity (CPA 2.1)</dcat:keyword><dcat:keyword  xml:lang="fr">Classification statistique des produits associée aux activités (CPA 2.1)</dcat:keyword><dcat:keyword  xml:lang="de">Zielland</dcat:keyword><dcat:keyword  xml:lang="en">Country of destination</dcat:keyword><dcat:keyword  xml:lang="fr">Pays de destination</dcat:keyword><dcat:keyword  xml:lang="de">Herkunftsland</dcat:keyword><dcat:keyword  xml:lang="en">Country of origin</dcat:keyword><dcat:keyword  xml:lang="fr">Pays d&apos;origine</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">EU inter-country supply table at basic prices (2015-2019)</dct:title><dct:description xml:lang="en">&lt;p&gt;This table presents the global supply of goods and services at basic prices across 64 products (CPA) and industries (NACE); the data cover the period 2015-2019 and distinguish 27 EU Member States, 18 main EU trading partners and a ‘Rest of the world’ region.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Tableau interpays des ressources de l’UE aux prix de base (2015-2019)</dct:title><dct:description xml:lang="fr">&lt;p&gt;Ce tableau présente la production mondiale de biens et de services aux prix de base pour 64 produits (CPA) et branches d’activité (NACE); les données couvrent la période 2015-2019 et distinguent 27 États membres de l’UE, 18 principaux partenaires commerciaux de l’UE et une région « Reste du monde ».&lt;/p&gt;</dct:description><dct:title xml:lang="de">Länderübergreifende Aufkommenstabelle der EU zu Herstellungspreisen (2015-2019)</dct:title><dct:description xml:lang="de">&lt;p&gt;&lt;span style=&quot;color: rgb(153, 51, 0);&quot;&gt;In dieser Tabelle wird das weltweite Aufkommen an Waren und Dienstleistungen zu Herstellungspreisen für 64 Gütergruppen (CPA) und Wirtschaftszweige (NACE) dargestellt; die Daten beziehen sich auf den Zeitraum 2015-2019 und unterscheiden 27 EU-Mitgliedstaaten, 18 wichtige Handelspartner der EU und eine „Restliche Welt“ Region.&lt;/span&gt;&lt;/p&gt;</dct:description><dct:identifier>naio_10_fcp_s2</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/naio_10_fcp_s2"/><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CPA2_1" > <skos:prefLabel xml:lang="de">Statistische Güterklassifikation in Verbindung mit den Wirtschaftszweigen (CPA 2.1)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical Classification of Products by Activity (CPA 2.1)</skos:prefLabel><skos:prefLabel xml:lang="fr">Classification statistique des produits associée aux activités (CPA 2.1)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/C_DEST" > <skos:prefLabel xml:lang="de">Zielland</skos:prefLabel><skos:prefLabel xml:lang="en">Country of destination</skos:prefLabel><skos:prefLabel xml:lang="fr">Pays de destination</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/C_ORIG" > <skos:prefLabel xml:lang="de">Herkunftsland</skos:prefLabel><skos:prefLabel xml:lang="en">Country of origin</skos:prefLabel><skos:prefLabel xml:lang="fr">Pays d&apos;origine</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=MIO_EUR"><skos:prefLabel xml:lang="de">Millionen Euro</skos:prefLabel><skos:prefLabel xml:lang="en">Million euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Millions d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8667136</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/naio_10_fcp_s2"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/naio_10_fcp_s2</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/naio_10_fcp_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/naio_10_fcp_s2"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/naio_10_fcp_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos