ient balance per hectare UAA (kg of nutrient per ha)</skos:prefLabel><skos:prefLabel xml:lang="fr">Bilan nutritif brut par hectare de SAU (kg de nutriment par ha)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=INP_NT"><skos:prefLabel xml:lang="de">Nährstoff-Einträgen (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient inputs (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Apports nutritifs (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=INP_UAA"><skos:prefLabel xml:lang="de">Nährstoff-Einträgen pro Hektar der LF (kg Nährstoff pro Hektar)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient inputs per hectare UAA (kg of nutrient per ha)</skos:prefLabel><skos:prefLabel xml:lang="fr">Apports nutritifs par hectare de SAU (kg de nutriment par ha)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=I_FRT"><skos:prefLabel xml:lang="de">Gesamtverbrauch Düngemitteln (außer Dünge tierischer Herkunft) (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Total consumption of fertilisers (except manure) (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Consommation totale d&apos;engrais (sauf fumiers) (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=I_FRT_MIN"><skos:prefLabel xml:lang="de">Verbrauch Mineraldünger (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Consumption of mineral fertilisers (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Consommation d&apos;engrais minéraux (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=I_FRT_ORG"><skos:prefLabel xml:lang="de">Verbrauch Organische Düngestoffe (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Consumption of organic fertilisers (except manure) (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Consommation d&apos;engrais organiques (sauf fumiers) (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=I_MNR"><skos:prefLabel xml:lang="de">Dünge tierischer Herkunft (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Manure input (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Apports de fumiers (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=I_MNR_IMP"><skos:prefLabel xml:lang="de">Import Dünge tierischer Herkunft (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Manure imports (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Importations de fumiers (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=I_MNR_PCT"><skos:prefLabel xml:lang="de">Dünge Produktion Rinder (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Manure production from cattle (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Fumiers produits par le cheptel bovin (tonnes de nutriment)</s