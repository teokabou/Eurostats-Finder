Measure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_BRN"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch verbrannte Ernterückstände (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by crop residues burned on the field (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec les résidus de culture brûlés sur les champs (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Kulturpflanzen (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of crops (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des cultures (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_CER"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Getreide (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of cereals (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des céréales (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_FRU"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Obst (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of fruits (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des fruits (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_IND"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Handelsgewächse (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of industrial crops (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des plantes industrielles (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_ORN"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Zierpflanzen (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of ornamental crops (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des plantes ornementales (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_OTH"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von sonstige Pflanzen (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of other crops (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des autres cultures (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_PUL"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Hülsenfrüchte (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of dried pulses (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des légumes secs (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_ROO"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Hackfrüchte (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of root crops (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des plantes sarclées (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_CRP_VEG"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Frischgemüse (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of vegetables (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte des légumes frais (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_FOD"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Futterpflanzen und Beweidung (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest and grazing of fodder (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte et le broutage des surfaces fourragères (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_FOD_PGA"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte von Pflanzen zur Grünernte vom Ackerland  (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest of plants harvested green from arable land (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte les plantes récoltées en vert sur les terres arables  (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_FOD_PGR"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch die Ernte und Beweidung Dauergrünland (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by harvest and grazing of permanent grasslands (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec la récolte et le broutage des prairies permanentes (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=O_RES"><skos:prefLabel xml:lang="de">Entzug Nährstoff durch Entfernung Ernterückstände vom Feld (Tonnen Nährstoff)</skos:prefLabel><skos:prefLabel xml:lang="en">Nutrient removal by crop residues removed from the field (tonnes of nutrient)</skos:prefLabel><skos:prefLabel xml:lang="fr">Prélèvements de nutriment avec les résidus de culture retirés des champs (tonnes de nutriment)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_AG?code=TOT_N_EMIS"><skos:prefLabel xml:lang="de">Bruttostickstoffemissionen (Tonnen)</skos:prefLabel><skos:prefLabel xml:lang="en">Total nitrogen emissions (tonnes)</sko