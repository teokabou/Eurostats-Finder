<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/rail_go_total"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-14</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Goods transported</dct:title><dct:description xml:lang="en">&lt;p&gt;The rail data collection on goods transport is based on&amp;nbsp;Regulation (EU) 2018/643 (recast) of the European Parliament and of the Council of 18 April&amp;nbsp;2018 on rail transport statistics. Data on freight transport are collected from the railway undertakings operating at national territory in each reporting country. The data on freight are most commonly based on the totality of consignment notes extracted from the railway undertakings&apos; databases. Excluded are railway undertakings which operate entirely or mainly within industrial and similar installations, including harbors.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Marchandises transportées</dct:title><dct:description xml:lang="fr">&lt;p&gt;La collecte de données ferroviaires sur le transport de marchandises est basée sur le règlement (UE) 2018/643 (refonte) du Parlement européen et du Conseil du 18 avril 2018 relatif aux statistiques du transport ferroviaire. Les données sur le transport de marchandises sont collectées auprès des entreprises ferroviaires opérant sur le territoire national dans chaque pays déclarant. Les données sur le fret reposent le plus souvent sur l&apos;ensemble des lettres de voiture extraites des bases de données des entreprises ferroviaires. Sont exclues les entreprises ferroviaires qui opèrent entièrement ou principalement dans des installations industrielles et similaires, y compris les ports.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Beförderte Güter</dct:title><dct:description xml:lang="de">&lt;p&gt;Die Erhebung von Eisenbahndaten zum Güterverkehr basiert auf der Verordnung (EU) 2018/643 (Neufassung) des Europäischen Parlaments und des Rates vom 18. April 2018 über Eisenbahnverkehrsstatistiken. Daten zum Güterverkehr werden von den Eisenbahnunternehmen erhoben, die in jedem Meldeland auf nationalem Hoheitsgebiet tätig sind. Die Frachtdaten basieren hauptsächlich auf der Gesamtheit der Frachtbriefe, die in den Datenbanken der Eisenbahnunternehmen registriert sind. Ausgenommen sind Eisenbahnunternehmen, die ganz oder überwiegend innerhalb von Industrie- und ähnlichen Anlagen, einschließlich Häfen, tätig sind.&lt;/p&gt;</dct:description><dct:identifier>rail_go_total</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/rail_go_total"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LIE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=MIO_TKM"><skos:prefLabel xml:lang="de">Millionen Tonnenkilometer (TKM)</skos:prefLabel><skos:prefLabel xml:lang="en">Million