che Statistiken: Online Hilfe</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/teiet010"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/web/user-guides/data-browser</schema:url><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/></dct:type></foaf:Document></foaf:page><dct:publisher><foaf:Agent rdf:about="http://publications.europa.eu/resource/authority/corporate-body/ESTAT"/></dct:publisher><dcat:contactPoint><v:Kind rdf:about="http://www.w3.org/2006/vcard/ns#Kind/9b4bd10b-2989-4f9e-9679-d871d5a6927f"><v:hasAddress><v:Address rdf:about="http://www.w3.org/2006/vcard/ns#Address/447b21f5-3d1a-4cf4-a1b8-55520754099b"><v:street-address>Joseph Bech building, 5 Rue Alphonse Weicker, L-2721 Luxembourg</v:street-address></v:Address></v:hasAddress><v:hasTelephone><v:Voice rdf:about="http://data.europa.eu/88u/voice/+352430136789"><v:hasValue rdf:resource="tel:+352430136789"/></v:Voice></v:hasTelephone><v:organisation-name>Eurostat, the statistical office of the European Union</v:organisation-name><v:hasURL><foaf:Document rdf:about="http://ec.europa.eu/eurostat/help/support"><foaf:topic rdf:resource="file:///usr/verticles/"/><schema:url>http://ec.europa.eu/eurostat/help/support</schema:url></foaf:Document></v:hasURL></v:Kind></dcat:contactPoint><adms:identifier xmlns:adms="http://www.w3.org/ns/adms#" xmlns:skos="http://www.w3.org/2004/02/skos/core.html" xmlns:dct="http://purl.org/dc/terms/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><adms:Identifier rdf:about="https://doi.org/10.2908/TEIET010"><skos:notation rdf:datatype="http://purl.org/spar/datacite/doi">10.2908/TEIET010</skos:notation><dct:creator rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/ESTAT"/><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-01-19</dct:issued></adms:Identifier></adms:identifier></dcat:Dataset></rdf:RDF>