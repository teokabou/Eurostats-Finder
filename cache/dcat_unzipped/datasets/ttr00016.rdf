<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/ttr00016"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-06-15</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Typ des Fahrplans</dcat:keyword><dcat:keyword  xml:lang="en">Type of schedule</dcat:keyword><dcat:keyword  xml:lang="fr">Type d&apos;horaire</dcat:keyword><dcat:keyword  xml:lang="de">Verkehrsumfang</dcat:keyword><dcat:keyword  xml:lang="en">Transport coverage</dcat:keyword><dcat:keyword  xml:lang="fr">Couverture de transport</dcat:keyword><dcat:keyword  xml:lang="de">Verkehrsleistung</dcat:keyword><dcat:keyword  xml:lang="en">Traffic and transport measurement</dcat:keyword><dcat:keyword  xml:lang="fr">Mesures du trafic et du transport</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Air transport of passengers by country and type of transport (monthly data)</dct:title><dct:description xml:lang="en">&lt;p&gt;Monthly number of passengers carried (arrivals plus departures), by type of transport (national, international, intra- and extra-EU). Passengers carried are (1) all passengers on a particular flight (with one flight number) counted once only and not repeatedly on each individual stage of that flight, (2) all revenue and non-revenue passengers whose journey begins or terminates at the reporting airport and transfer passengers joining or leaving the flight at the reporting airport. Excludes direct transit passengers. National aggregates, total intra-EU aggregates and total EU aggregates exclude any double counting.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Transport aérien de passagers par pays et type de transport (données mensuelles)</dct:title><dct:description xml:lang="fr">&lt;p&gt;Nombre mensuel de passagers (départs et arrivées), par type de transport (national, international, intra- et extra-UE). Les passagers transportés sont (1) tous les passagers d’un vol particulier (identifié par un numéro de vol) comptés une seule fois et non pour chacune des étapes de ce vol, (2) tous les passagers payants et non payants dont le voyage commence ou se termine à l&apos;aéroport déclarant et les passagers en correspondance embarquant ou quittant le vol à l&apos;aéroport déclarant. Les passagers en transit direct ne sont pas pris en compte. Les agrégats nationaux, les agrégats totaux intra-UE et les agrégats totaux UE excluent tout double comptage.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Passagieraufkommen in der Luftfahrt, pro Land und nach Verkehrsart (monatliche Daten)</dct:title><dct:description xml:lang="de">&lt;p&gt;Anzahl der monatlich beförderten Passagiere (Ankünfte plus Abflüge), nach Art des Verkehrs (innerstaatlich, grenzüberschreitend, grenzüberschreitend intra-EU, grenzüberschreitend extra-EU). Beförderte Passagiere sind (1) alle Fluggäste auf einem bestimmten Flug (mit derselben Flugnummer), die nur einmal gezählt werden und nicht noch einmal für jede Teilstrecke des Fluges, (2) alle Zahlgäste und nicht zahlenden Fluggäste (Freigäste), deren Reise am Meldeflughafen beginnt oder endet, sowie umsteigende Fluggäste, die am Meldeflughafen zusteigen oder aussteigen. Ausgenommen sind Fluggäste im ungebrochenen Durchgangsverkehr. Bei den nationalen Aggregaten, den gesamten Intra-EU-Aggregaten und den gesamten EU-Aggregaten ist jede Doppelzählung ausgeschlossen.&lt;/p&gt;</dct:description><dct:identifier>ttr00016</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/ttr00016"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.euro