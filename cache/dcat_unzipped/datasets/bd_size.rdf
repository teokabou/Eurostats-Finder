xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS" > <skos:prefLabel xml:lang="de">Wirtschaftlicher Indikator für strukturelle Unternehmensstatistik</skos:prefLabel><skos:prefLabel xml:lang="en">Economical indicator for structural business statistics</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur économique des statistiques structurelles sur les entreprises</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZECLAS" > <skos:prefLabel xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre de salariés</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_BRTHR_PC"><skos:prefLabel xml:lang="de">Beschäftigungsanteil von Unternehmensgründungen - Beschäftigte in neu gegründeten Unternehmen dividiert durch Beschäftigte in aktiven Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employment share of enterprise births - persons employed in newly born enterprises divided by persons employed in active enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part d&apos;emploi des créations d&apos;entreprises - personnes occupées dans les entreprises nouvellement créées divisées personnes occupées dans les entreprises actives - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_BRTH_NR"><skos:prefLabel xml:lang="de">Beschäftigten in neu gegründeten Unternehmen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in newly born enterprises - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les entreprises nouvellement créées - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_DTHR_PC"><skos:prefLabel xml:lang="de">Beschäftigungsanteil der Unternehmensschließungen - Beschäftigte in Schließungen von Unternehmen dividiert durch Beschäftigte in aktiven Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employment share of enterprise deaths - persons employed in enterprise deaths divided by persons employed in active enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part de l&apos;emploi dans les cessations d&apos;entreprises - personnes occupées dans les cessations d&apos;entreprises divisées par les personnes occupées dans les entreprises actives - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_DTH_NR"><skos:prefLabel xml:lang="de">Beschäftigte bei Unternehmensschließungen - Zahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in enterprise deaths - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les entreprises ayant cessé leur activité - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_NR"><skos:prefLabel xml:lang="de">Beschäftigten - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SRVLR_PC"><skos:prefLabel xml:lang="de">Beschäftigungsanteil der überlebenden Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employment share of survived enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part de l&apos;emploi des entreprises ayant survécu - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SRVL_CHB_NR"><skos:prefLabel xml:lang="de">Überlebende Beschäftigte in Unternehmen, nach Überlebensalter in der Kohorte der im Bezugsjahr neu gegründeten Unternehmen, die die entsprechende Anzahl von Jahren in der Zukunft überlebt haben - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in enterprise survivals, by survival age among cohort of enterprises newly born in reference year having survived respective number of years in future - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les entreprises ayant survécu, par âge de survie parmi la population d&apos;entreprises nouvellement créée durant l&apos;année de référence ayant survécu au nombre respectif d&apos;années futures - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SRVL_NR"><skos:prefLabel xml:lang="de">Beschäftigte bei Fortbestand von Unternehmen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in enterprise survivals - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les entreprises ayant survécu - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SRVL_YBRTH_CHB_NR"><skos:prefLabel xml:lang="de">Im Geburtsjahr beschäftigte Personen in der Kohorte der im Bezugsjahr neu gegründeten Unternehmen, die überlebt haben, die überlebt haben, entsprechende Anzahl von Jahren in der Zukunft - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in the year of birth in the cohort of population of enterprises newly born in reference year having survived respective number of years in future - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées durant l&apos;année de création dans la population des entreprises nouvellement créées durant l&apos;année de référence et ayant survécu au nombre respectif d&apos;années futures - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=EMP_SRVL_YBRTH_NR"><skos:prefLabel xml:lang="de">Beschäftigte bei Fortbestand von Unternehmen, im Jahr der Gründung - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed in enterprise survivals, in the year of birth - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées dans les entreprises ayant survécu, au cours de l’année de création - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_BRTHR_DTHR_PC"><skos:prefLabel xml:lang="de">Unternehmensfluktuation - Gründungs- und Schließungsrate - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Business churn - birth and death rate - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Renouvellement des entreprises - taux de création et de cessation - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_BRTHR_PC"><skos:prefLabel xml:lang="de">Gründungsrate - Unternehmensgründungen dividiert durch aktive Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Birth rate - enterprise births divided by active enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de création - créations d&apos;entreprises divisées par les entreprises actives - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_BRTH_EMPSIZE_NR"><skos:prefLabel xml:lang="de">Größe neu gegründeten Unternehmen - Beschäftigte in neu gegründeten Unternehmen dividiert durch Unternehmensgründungen - durchschnittliche Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Size of newly born enterprises - persons employed in newly born enterprises divided by enterprise births - average number</skos:prefLabel><skos:prefLabel xml:lang="fr">Taille des entreprises nouvellement créées - personnes occupées dans les entreprises nouvellement créées divisées par les créations d&apos;entreprises - nombre moyen</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_BRTH_NR"><skos:prefLabel xml:lang="de">Unternehmensgründungen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprise births - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Créations d&apos;entreprises - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_BRTH_PP_PC"><skos:prefLabel xml:lang="de">Anteil der Unternehmensgründungen nach Größenklassen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of enterprise births by size class - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de créations d&apos;entreprises par classe de taille - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_DTHR_PC"><skos:prefLabel xml:lang="de">Schließungsrate - Unternehmensschließungen geteilt durch aktive Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Death rate - enterprise deaths divided by active enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de cessation - cessations d&apos;entreprises divisées par les entreprises actives - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_DTH_EMPSIZE_NR"><skos:prefLabel xml:lang="de">Beschäftigung in Unternehmensschließungen - Beschäftigte in Unternehmensschließungen geteilt durch Unternehmensschließungen - durchschnittliche Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Employment in enterprise deaths - persons employed in enterprise deaths divided by enterprise deaths - average number</skos:prefLabel><skos:prefLabel xml:lang="fr">Emploi dans les entreprises ayant cessé leur activité - personnes occupées dans les entreprises ayant cessé leur activité divisées par cessations d&apos;entreprises - nombre moyen</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_DTH_NR"><skos:prefLabel xml:lang="de">Unternehmensschließungen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprise deaths - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Cessations d&apos;entreprises - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_DTH_PP_PC"><skos:prefLabel xml:lang="de">Anteil der Unternehmensschließungen nach Größenklassen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Proportion of enterprise deaths by size class - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Proportion de cessations d&apos;entreprises par classe de taille - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_NR"><skos:prefLabel xml:lang="de">Unternehmen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SRVLR_BRTH_CHB_PC"><skos:prefLabel xml:lang="de">Überlebensrate - Kohorte der im Berichtsjahr neu gegründeten Unternehmen, die die entsprechende Anzahl von Jahren in der Zukunft überlebt haben, geteilt durch die Unternehmensgründungen im Berichtsjahr - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survival rate - cohort of newly born enterprises in the reference year having survived respective number of years in future divided by enterprise births in the reference year - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de survie - population d&apos;entreprises nouvellement créées durant l&apos;année de référence ayant survécu au nombre respectif d&apos;années futures divisé par les créations d&apos;entreprises au cours de l&apos;année de référence - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SRVLR_BRTH_PC"><skos:prefLabel xml:lang="de">Überlebensrate - überlebende Unternehmen des jeweiligen Alters, geteilt durch Unternehmensgründungen im jeweiligen Geburtsjahr - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survival rate - enterprise survivals of respective age, divided by enterprise births in respective birth year - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de survie - survie d&apos;entreprises selon l&apos;âge respectif, divisée par les créations d&apos;entreprises durant l&apos;année de création respective - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SRVLR_PC"><skos:prefLabel xml:lang="de">Anteil der überlebenden Unternehmen an der Unternehmenspopulation - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survived enterprises’ share of the business population - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des entreprises ayant survécu dans la population des entreprises - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SRVL_EMPSIZE_NR"><skos:prefLabel xml:lang="de">Größe der überlebenden Unternehmen - Beschäftigte in überlebenden Unternehmen geteilt durch dieselben Unternehmen - durchschnittliche Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Size of survived enterprises - persons employed in enterprise survivals divided by the same enterprises - average number</skos:prefLabel><skos:prefLabel xml:lang="fr">Taille des entreprises ayant survécu - personnes occupées dans les entreprises ayant survécu divisées par les mêmes entreprises - nombre moyen</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=ENT_SRVL_NR"><skos:prefLabel xml:lang="de">Fortbestand von Unternehmen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprise survivals - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Survies d’entreprises - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=GRW_EMP_SRVL_CHB_PC"><skos:prefLabel xml:lang="de">Wachstumsrate der Beschäftigung in überlebenden Unternehmen nach Alter - Beschäftigte in überlebenden Unternehmen im jeweiligen Jahr unter der Kohorte der im Berichtsjahr neu gegründeten Unternehmen, die bis zum jeweiligen Jahr überlebt haben, geteilt durch die Beschäftigten im Jahr der Gründung in denselben Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survived enterprises employment growth rate by age - persons employed  in enterprise survivals, in the respective year in future among the cohort of enterprises newly born in the reference year having survived to respective year divided by persons employed in the year of birth by the same enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de croissance de l&apos;emploi des entreprises ayant survécu par âge - personnes occupées dans les entreprises ayant survécu, au cours de l&apos;année future respective, parmi la population d&apos;entreprises nouvellement créées au cours de l&apos;année de référence ayant survécu jusqu&apos;à l&apos;année respective divisée par les personnes occupées au cours de l&apos;année de création dans les mêmes entreprises - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=GRW_EMP_SRVL_PC"><skos:prefLabel xml:lang="de">Wachstumsrate der Beschäftigung in überlebenden Unternehmen - Beschäftigte in überlebenden Unternehmen geteilt durch Beschäftigte in denselben Unternehmen im Jahr der Gründung - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Survived enterprises employment growth rate - persons employed in enterprise survivals divided by persons employed in the same enterprises in the year of birth - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de croissance de l&apos;emploi des entreprises ayant survécu - personnes occupées dans les entreprises ayant survécu divisées par les personnes occupées dans les mêmes entreprises au cours de l&apos;année de création - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=GRW_ENT_PC"><skos:prefLabel xml:lang="de">Nettoveränderung der Unternehmenspopulation - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Net business population growth - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Croissance nette de la population des entreprises - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_BRTH_NR"><skos:prefLabel xml:lang="de">Lohn- und Gehaltsempfänger in neu gegründeten Unternehmen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Employees in newly born enterprises - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Salariés dans les entreprises nouvellement créées - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_DTH_NR"><skos:prefLabel xml:lang="de">Lohn- und Gehaltsempfänger bei Unternehmensschließungen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Employees in enterprise deaths - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Salariés dans les cessations d’entreprises - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_EMP_BRTHR_PC"><skos:prefLabel xml:lang="de">Lohn- und Gehaltsempfängerquote in neuen Unternehmen - Beschäftigte in neu gegründeten Unternehmen geteilt durch die Beschäftigten in neu gegründeten Unternehmen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">New enterprise paid employment rate - employees in newly born enterprises divided by persons employed in newly born enterprises - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux d&apos;emploi rémunéré dans les nouvelles entreprises - salariés dans les entreprises nouvellement créées divisés par personnes occupées dans les entreprises nouvellement créées - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SBS?code=SAL_NR"><skos:prefLabel xml:lang="de">Lohn- und Gehaltsempfänger - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Employees - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Salariés - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1456333</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-11</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/bd_size"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/bd_siz