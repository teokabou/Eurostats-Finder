<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tipslc30"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-11-12</dct:issued><dcat:keyword  xml:lang="de">Altersklasse</dcat:keyword><dcat:keyword  xml:lang="en">Age class</dcat:keyword><dcat:keyword  xml:lang="fr">Classe d&apos;âge</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Geschlecht</dcat:keyword><dcat:keyword  xml:lang="en">Sex</dcat:keyword><dcat:keyword  xml:lang="fr">Sexe</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Severely materially and socially deprived people</dct:title><dct:description xml:lang="en">&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;People experiencing severe material and social deprivation live under significantly constrained conditions due to a lack of resources. They are forced to go without at least 7 of the following 13 deprivation items:&lt;/span&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;ability to cover unexpected expenses,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;ability to afford a one-week annual holiday away from home,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;not being in arrears on mortgage or rent payments, utility bills, hire purchase instalments, or other loan repayments,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;ability to afford a meal with meat, poultry, fish or a vegetarian equivalent every other day,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;ability to keep their home adequately warm,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;access to a car or van for personal use,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;ability to replace worn-out furniture,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;access to an internet connection,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;ability to replace worn-out clothes with new ones,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;possession of two pairs of properly fitting shoes (including a pair suitable for all weather conditions),&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt; ability to spend a small amount of money each week on oneself,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;regular participation in leisure activities,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;meeting with friends or family for a drink or meal at least once a month.&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;The auxiliary indicator of the Macroeconomic Imbalance Procedure (MIP) is expressed as a percentage of the total population. In the table, the values are also presented as changes over a three-year period (in percentage points). &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;The data source is the EU Statistics on Income and Living Conditions (EU-SILC).&lt;/span&gt;&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Personnes en situation de privation matérielle et sociale sévère</dct:title><dct:description xml:lang="fr">&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Les personnes en situation de privation matérielle et sociale sévère ont des conditions de vie gravement restreintes par un manque de ressources, de sorte qu’elles souffrent d’un manque contraint d’au moins 7 des 13 éléments de privation suivants :&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;capacité à faire face à des dépenses imprévues,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;capacité à s&apos;offrir une semaine de vacances par an en dehors du domicile,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;ne pas être confronté à des retards de paiement (remboursements de prêts immobiliers ou de loyers, factures de services publics, paiements échelonnés ou autres remboursements de prêts),&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;capacité à s&apos;offrir un repas avec viande, volaille, poisson ou équivalent végétarien tous les deux jours,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;capacité à maintenir son logement à une température adéquate,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;accès à une voiture ou une camionnette à usage personnel,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;possibilité de remplacer les meubles usés,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;disposer d’une connexion internet,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;possibilité de remplacer les vêtements usés par des neufs,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;disposer de deux paires de chaussures bien ajustées (dont une paire adaptée à toutes les saisons),&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;possibilité de dépenser une petite somme d’argent chaque semaine pour soi-même,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;avoir des activités de loisirs régulières,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;rencontrer des amis ou la famille pour boire un verre ou partager un repas au moins une fois par mois.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;L’indicateur auxiliaire du déséquilibre macroéconomique (MIP) est exprimé en pourcentage de la population totale. Dans le tableau, les valeurs sont également présentées sous forme de variations sur une période de trois ans (en points de pourcentage). &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;La source des données est l’enquête européenne sur les revenus et les conditions de vie (EU-SILC).&lt;/span&gt;&lt;/p&gt;</dct:description><dct:title xml:lang="de">Unter erheblicher materieller und sozialer Deprivation leidende Personen</dct:title><dct:description xml:lang="de">&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Personen in erheblicher materieller und sozialer Entbehrung leben unter stark eingeschränkten Bedingungen aufgrund fehlender Ressourcen. Sie sind gezwungen, auf mindestens 7 von 13 Entbehrungsindikatoren zu verzichten:&lt;/span&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Fähigkeit, unerwartete Ausgaben zu bestreiten,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Möglichkeit, sich eine einwöchige Urlaubsreise außerhalb des eigenen Zuhauses pro Jahr leisten zu können,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;keine Zahlungsrückstände bei Hypotheken- oder Mietzahlungen, Strom-, Wasser- oder Heizkostenrechnungen, Ratenkäufen oder anderen Krediten zu haben,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Möglichkeit, jeden zweiten Tag eine Mahlzeit mit Fleisch, Geflügel, Fisch oder eine vegetarische Alternative zu sich zu nehmen,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Fähigkeit, die Wohnung angemessen warm zu halten,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Zugang zu einem Auto oder Kleintransporter zur persönlichen Nutzung,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Möglichkeit, abgenutzte Möbel zu ersetzen,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Zugang zu einer Internetverbindung,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Möglichkeit, abgetragene Kleidung durch neue zu ersetzen,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Besitz von zwei Paar gut sitzenden Schuhen (einschließlich eines wetterfesten Paares),&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Möglichkeit, jede Woche einen kleinen Geldbetrag für sich selbst auszugeben,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;regelmäßige Freizeitaktivitäten,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;sich mindestens einmal im Monat mit Freunden oder Familie auf ein Getränk oder eine Mahlzeit treffen zu können.&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Der Hilfsindikator des makroökonomischen Ungleichgewichtsverfahrens (MIP) wird als Prozentsatz der Gesamtbevölkerung ausgedrückt. In der Tabelle werden die Werte auch als Veränderungen über einen Zeitraum von drei Jahren (in Prozentpunkten) dargestellt. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(85, 142, 213);&quot;&gt;Datenquelle ist die Erhebung über Einkommen und Lebensbedingungen in der EU (EU-SILC).&lt;/span&gt;&lt;/p&gt;</dct:description><dct:identifier>tipslc30</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tipslc30"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/AGE" > <skos:prefLabel xml:lang="de">Altersklasse</skos:prefLabel><skos:prefLabel xml:lang="en">Age class</skos:prefLabel><skos:prefLabel xml:lang="fr">Classe d&apos;âge</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SEX" > <skos:prefLabel xml:lang="de">Geschlecht</skos:prefLabel><skos:prefLabel xml:lang="en">Sex</skos:prefLabel><skos:prefLabel xml:lang="fr">Sexe</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC"><skos:prefLabel xml:lang="de">Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PPCH_3Y"><skos:prefLabel xml:lang="de">Veränderung in Prozentpunkten (t-(t-3))</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage point change (t-(t-3))</skos:prefLabel><skos:prefLabel xml:lang="fr">Variation en points de pourcentage (t-(t-3))</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-30</dct:modified><dct:accrualPeriodicity><dct:Freq