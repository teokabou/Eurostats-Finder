<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/sdg_15_60"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-06-19</dct:issued><dcat:keyword  xml:lang="de">Vogelarten</dcat:keyword><dcat:keyword  xml:lang="en">Bird species</dcat:keyword><dcat:keyword  xml:lang="fr">Espèces d&apos;oiseaux</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Information</dcat:keyword><dcat:keyword  xml:lang="en">Statistical information</dcat:keyword><dcat:keyword  xml:lang="fr">Information statistique</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Common bird index by type of species - EU aggregate</dct:title><dct:description xml:lang="en">&lt;p&gt;TThe indicator is a multi-species composite index, which integrates the abundance and the diversity of a selection of common bird species associated with specific habitats. Rare species are excluded. Three groups of bird species are represented: common farmland species (39 species), common forest species (34 species) and all common bird species (168 species; including farmland and forest species). The indices are presented for EU-aggregates only and with smoothed values. The European Bird Census Council and its Pan-European Common Bird Monitoring Scheme programme delivers data from 26 Member States. MT is not covered.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Indice des oiseaux communs par espèce - UE agrégat</dct:title><dct:description xml:lang="fr">&lt;p&gt;L’indicateur est un indice composite multiespèces, qui intègre l’abondance et la diversité d’une sélection d’espèces d’oiseaux communs associées à des habitats spécifiques. Les espèces rares sont exclues. Trois groupes d’espèces d’oiseaux sont représentés: espèces de terres agricoles communes (39 espèces), espèces forestières communes (34 espèces) et toutes les espèces d’oiseaux communs (168 espèces; y compris les terres agricoles et les espèces forestières). Les indices sont présentés uniquement pour les agrégats de l’UE et avec des valeurs lissées. Le Conseil européen de recensement des oiseaux et son programme paneuropéen de surveillance commune des oiseaux fournissent des données provenant de 26 États membres. MT n’est pas couvert.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Index weit verbreiteter Vogelarten nach Spezies - EU Aggregat</dct:title><dct:description xml:lang="de">&lt;p&gt;Der Indikator ist ein Multi-Art-Composite-Index, der die Fülle und Vielfalt einer Auswahl gängiger Vogelarten, die mit bestimmten Lebensräumen verbunden sind, integriert. Seltene Arten sind ausgeschlossen. Drei Gruppen von Vogelarten sind vertreten: verbreitete Ackerlandarten (39 Arten), verbreitete Waldarten (34 Arten) und alle gängigen Vogelarten (168 Arten; einschließlich Ackerland und Waldarten). Die Indizes werden nur für EU-Aggregate mit geglätteten Werten dargestellt. Der Europäische Vogelzählungsrat und sein gesamteuropäisches gemeinsames Vogelbeobachtungsprogramm liefern Daten aus 26 Mitgliedstaaten. MT ist nicht abgedeckt.&lt;/p&gt;</dct:description><dct:identifier>sdg_15_60</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_15_60"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/COMSPEC" > <skos:prefLabel xml:lang="de">Vogelarten</skos:prefLabel><skos:prefLabel xml:lang="en">Bird species</skos:prefLabel><skos:prefLabel xml:lang="fr">Espèces d&apos;oiseaux</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/STATINFO" > <skos:prefLabel xml:lang="de">Statistische Information</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical information</skos:prefLabel><skos:prefLabel xml:lang="fr">Information statistique</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=I00"><skos:prefLabel xml:lang="de">Index, 2000=100</skos:prefLabel><skos:prefLabel xml:lang="en">Index, 2000=100</skos:prefLabel><skos:prefLabel xml:lang="fr">Indice, 2000=100</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=I90"><skos:prefLabel xml:lang="de">Index, 1990=100</skos:prefLabel><skos:prefLabel xml:lang="en">Index, 1990=100</skos:prefLabel><skos:prefLabel xml:lang="fr">Indice, 1990=100</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ENER" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ENVI" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-28</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1990-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_15_60"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/sdg_15_60</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/sdg_15_60_esmsip2.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_15_60"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/e