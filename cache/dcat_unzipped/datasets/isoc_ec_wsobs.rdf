efLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DANY"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: mindestens eine (Kosten, Beschwerden/Streitigkeiten, Produktkennzeichnung, Fremdsprachen, Beschränkungen)</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties for web sales to other EU countries - any (of high costs, complaints, labelling, languages, business partners restrictions)</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE: au moins une (coûts, réclamation/litiges, étiquetage, langues étrangères, restrictions par partenaires commerciaux)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DAPL"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: Anpassung der Produktkennzeichnung</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties for web sales to other EU countries - adapting product labelling</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE: adaptation de l&apos;étiquetage des produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DBP"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: Beschränkungen durch Ihre Geschäftspartner</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties for web sales to other EU countries - restrictions from business partners</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE: restrictions imposées par les partenaires commerciaux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DFL"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: mangelnde Fremdsprachenkenntnisse</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties for web sales to other EU countries - lack of knowledge of foreign languages</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE: connaissances insuffisantes en langues étrangères</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DHCD"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: hohe Kosten beim Versand und Rückversand von Produkten</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties for web sales to other EU countries - high costs of delivering or returning products</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE: coûts élevés de livraison ou de renvoi de produits</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DNONE"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: keine (Kosten, Beschwerden/Streitigkeiten, Produktkennzeichnung, Fremdsprachen, Beschränkungen)</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties for web sales to other EU countries - none (of high costs, complaints, labelling, languages, business partners restrictions)</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE: aucune (coûts, réclamation/litiges, étiquetage, langues étrangères, restrictions par partenaires commerciaux)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DRCD"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: Beschwerden und Streitigkeiten im Zusammenhang mit dem Verkauf</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties for web sales to other EU countries - related to resolving complaints and disputes</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE: difficultés liées au règlement des réclamations et litiges</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSEU_DVAT"><skos:prefLabel xml:lang="de">Schwierigkeiten bei Web-Verkäufen an andere EU-Staaten: Schwierigkeiten im Zusammenhang mit dem Umsatzsteuersystem in EU-Ländern</skos:prefLabel><skos:prefLabel xml:lang="en">Difficulties when selling to other EU countries - related to the VAT system in EU countries</skos:prefLabel><skos:prefLabel xml:lang="fr">Difficultés rencontrées lors des ventes web à d&apos;autres pays de l&apos;UE : difficultés liées au système de taxe sur la valeur ajoutée (TVA) dans les pays de l’UE</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSX_OCOST"><skos:prefLabel xml:lang="de">Einführungskosten für Web-Verkäufe zu hoch im Vergleich zu den Vorteilen - Unternehmen ohne Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">The costs of introducing web sales too high compared to the benefits - enterprises not selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Le coût de la mise en place des ventes web est trop élevé par rapport aux avantages - entreprises ne vendant pas via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSX_OLF"><skos:prefLabel xml:lang="de">Probleme bezüglich der rechtlichen Rahmenbedingungen - Unternehmen ohne Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to the legal framework - enterprises not selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes liés au cadre juridique - entreprises ne vendant pas via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSX_OLOG"><skos:prefLabel xml:lang="de">Probleme im Logistikbereich - Unternehmen ohne Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to logistics (shipping of goods or delivery of services) - enterprises not selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes de logistique (transport ou livraison de biens ou de services) - entreprises ne vendant pas via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSX_OPAY"><skos:prefLabel xml:lang="de">Probleme im Zusammenhang mit Zahlungen - Unternehmen ohne Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to payments - enterprises not selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes liés aux paiements - entreprises ne vendant pas via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSX_OSEC"><skos:prefLabel xml:lang="de">Probleme mit IT-Sicherheit oder Datenschutz - Unternehmen ohne Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to ICT security or data protection - enterprises not selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes liés à la sécurité des TIC ou à la protection des données - entreprises ne vendant pas via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSX_OSUIT"><skos:prefLabel xml:lang="de">Waren oder Dienstleistungen des Unternehmens sind nicht geeignet - Unternehmen ohne Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise&apos;s goods or services are not suitable - enterprises not selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Les biens / services de l&apos;entreprise ne sont pas adaptés - entreprises ne vendant pas via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWS_OCOST"><skos:prefLabel xml:lang="de">Einführungskosten für Web-Verkäufe zu hoch im Vergleich zu den Vorteilen - Unternehmen mit Web-Verkäufen</skos:prefLabel><skos:prefLabel xml:lang="en">The costs of introducing web sales too high compared to the benefits - enterprises selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Le coût de la mise en place des ventes web est trop élevé par rapport aux avantages - entreprises vendant via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWS_OLF"><skos:prefLabel xml:lang="de">Probleme bezüglich der rechtlichen Rahmenbedingungen - Unternehmen mit Web-Verkäufen</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to the legal framework - enterprises selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes liés au cadre juridique - entreprises vendant via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWS_OLOG"><skos:prefLabel xml:lang="de">Probleme im Logistikbereich - Unternehmen mit Web-Verkäufen</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to logistics (shipping of goods or delivery of services) - enterprises selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes de logistique (transport ou livraison de biens ou de services) - entreprises vendant via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWS_OPAY"><skos:prefLabel xml:lang="de">Probleme im Zusammenhang mit Zahlungen - Unternehmen mit Web-Verkäufen</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to payments - enterprises selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes liés aux paiements - entreprises vendant via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWS_OSEC"><skos:prefLabel xml:lang="de">Probleme mit IT-Sicherheit oder Datenschutz - Unternehmen mit Web-Verkäufen</skos:prefLabel><skos:prefLabel xml:lang="en">Problems related to ICT security or data protection - enterprises selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Problèmes liés à la sécurité des TIC ou à la protection des données - entreprises vendant via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWS_OSUIT"><skos:prefLabel xml:lang="de">Waren oder Dienstleistungen des Unternehmens sind nicht geeignet - Unternehmen mit Web-Verkäufen</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise&apos;s goods or services are not suitable - enterprises selling via website</skos:prefLabel><skos:prefLabel xml:lang="fr">Les biens / services de l&apos;entreprise ne sont pas adaptés - entreprises vendant via site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_AWSELL"><skos:prefLabel xml:lang="de">Prozent der Unternehmen mit Verkäufen über die Website</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises with web sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant reçu des commandes sur un site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_AWSELLX"><skos:prefLabel xml:lang="de">Prozent der Unternehmen ohne Verkäufe über die Website</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises without web sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises n&apos;ayant pas reçu de commandes sur un site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_AWSEU"><skos:prefLabel xml:lang="de">Prozent der Unternehmen mit Web-Verkäufen an andere EU-Staaten</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises with web sales to other EU countries</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec ventes web à d&apos;autres pays de l&apos;UE</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10881</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:th