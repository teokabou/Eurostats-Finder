1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IHIF"><skos:prefLabel xml:lang="de">Internet-Nutzung: Beschaffung von gesundheitsrelevanten Informationen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: seeking health information</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: rechercher des informations relatives à la santé</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUAPR"><skos:prefLabel xml:lang="de">Internet-Nutzung: Online-Zugriff auf persönliche Patientenakten</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: accessing personal health records online</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: accéder à un dossier médical en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUBK"><skos:prefLabel xml:lang="de">Internet-Nutzung: Internet-Banking</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: Internet banking</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour des services bancaires sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUCHAT1"><skos:prefLabel xml:lang="de">&quot;Internet-Nutzung: Sofortnachrichtendienste (Instant Messaging; z. B. über Skype, Messenger, WhatsApp, Viber)&quot;</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: instant messaging, i.e. exchanging messages, for example, via Skype, Messenger, WhatsApp, Viber</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: services de messagerie instantanée (échange de messages), par exemple via Skype, Messenger, WhatsApp, Viber</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUCPP"><skos:prefLabel xml:lang="de">Internet-Nutzung: Teilnahme an gesellschaftspolitischen Themen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: civic or political participation</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour participation civile et/ou politique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUCWEB"><skos:prefLabel xml:lang="de">Internet-Nutzung: Erstellung von Webseiten oder Blogs</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: creating websites or blogs</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: créer un site web ou un blog</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUEDUIF"><skos:prefLabel xml:lang="de">Internet-Nutzung: Suchen von Informationen über Ausbildung, Weiterbildung oder Kursangebote</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: looking for information about education, training or course offers</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet, au cours des trois derniers mois, pour la recherche d&apos;informations sur de l&apos;éducation, de la formation ou des offres de cours</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUEM"><skos:prefLabel xml:lang="de">Internet-Nutzung: Senden/Empfangen von E-Mails</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: sending/receiving e-mails</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: envoyer/recevoir des messages électroniques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUENT"><skos:prefLabel xml:lang="de">Internet-Nutzung: Abspielen/Herunterladen von Spielen, Musik hören, Filme oder Videos anschauen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: playing/downloading games, listening to music or watching internet streamed TV or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour lire/télécharger des jeux, écouter de la musique ou regarder des films ou des vidéos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUFORIM"><skos:prefLabel xml:lang="de">Internet-Nutzung: Versenden von Nachrichten an soziale Medien-Webseiten oder Instant Messaging</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: posting messages to social media sites or instant messaging</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour envoyer des messages à des sites de réseaux sociaux ou communiquer à l&apos;aide d&apos;une messagerie instantanée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUGM"><skos:prefLabel xml:lang="de">Internet-Nutzung: Abspielen/Herunterladen von Spielen, Bildern, Filmen oder Musik</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: playing/downloading games, images, films or music</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour lire/télécharger des jeux, des images, des films ou de la musique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUGMNET"><skos:prefLabel xml:lang="de">Internet-Nutzung: Spielen von Netzwerkspielen mit anderen Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: playing networked games with other persons</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: jouer à des jeux en réseau avec d&apos;autres personnes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUGMV"><skos:prefLabel xml:lang="de">Internet-Nutzung: Abspielen/Herunterladen von Spielen, Musik hören oder Filme anschauen (exklusive VOD)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: playing/downloading games, listening to music or watching videos (excluding VOD)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour lire/télécharger des jeux, écouter de la musique ou regarder des films (hors vidéos à la demande)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUHOLS"><skos:prefLabel xml:lang="de">Internet-Nutzung: Dienstleistungen im Zusammenhang mit Reisen und Beherbergung</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: travel and accommodation services</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour accéder à des services relatifs aux voyages et à l&apos;hébergement</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUIF"><skos:prefLabel xml:lang="de">Internet-Nutzung: Suche nach Informationen über Waren und Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: finding information about goods and services</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;Internet: rechercher des informations sur des biens et services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUJOB"><skos:prefLabel xml:lang="de">Internet-Nutzung: Arbeitssuche oder zur Übermittlung einer Stellenbewerbung</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: job search or sending an application</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: rechercher un emploi ou envoyer un acte de candidature</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUMAPP"><skos:prefLabel xml:lang="de">Internet-Nutzung: Vereinbarung eines Termins mit einem Arzt/Ärztin über eine Webseite</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: making an appointment with a practitioner via a website</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: prendre un rendez-vous auprès d&apos;un médecin</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUMUSS"><skos:prefLabel xml:lang="de">Internet-Nutzung: Musik hören (z.B. Internetradio oder über Online-Streaming-Dienste)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: listening to music (e.g. w eb radio, music streaming)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: écouter de la musique (p.ex. radio en ligne, musique en streaming)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUMUSS1"><skos:prefLabel xml:lang="de">Internet-Nutzung: Musik hören (z.B. Internetradio oder über Online-Streaming-Dienste) oder via Download</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: listening to music  (e.g. web radio, music streaming) or downloading music</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: écouter de la musique (p.ex. radio en ligne, musique en streaming) ou télécharger de la musique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUNET"><skos:prefLabel xml:lang="de">Internet-Nutzung: Nutzen von sozialen oder professionellen Netzwerken</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: participating in social or professional networks</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour communiquer sur des réseaux sociaux ou professionnels</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUNW"><skos:prefLabel xml:lang="de">Internet-Nutzung: Lektüre/das Herunterladen von Online-Zeitungen/Nachrichtenmagazinen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: reading/downloading online newspapers/news</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: lire/télécharger des journaux/magazines d&apos;information en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUNW1"><skos:prefLabel xml:lang="de">Internet-Nutzung: Lektüre von Online-Nachrichten, -Zeitungen oder -Zeitschriften</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: reading online news sites/newspapers/news magazines</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pour lire des sites d&apos;actualités en ligne/journaux/magazines d&apos;information</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOANY"><skos:prefLabel xml:lang="de">Internet-Nutzung: eine oder mehrere der folgenden Lernaktivitäten i_iuolc, i_iuolm, i_iuocis</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: any of the learning activities i_iuolc, i_iuolm, i_iuocis</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour au moins une des activités de formation suivantes: i_iuolc, i_iuolm, i_iuocis</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOCIS"><skos:prefLabel xml:lang="de">Internet-Nutzung: Kommunikation mit Vortragenden oder Lernenden über Lernplattformen oder Lernportale</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: communicating with instructors or students using educational websites/portals</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour communiquer avec des formateurs ou des étudiants via des sites ou des portails de formation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOCIS1"><skos:prefLabel xml:lang="de">Internetnutzung: Kommunikation mit Vortragenden oder Lernenden über Online-Audio- oder Videoprogramme (z.B. Zoom, MS Teams, Google Classroom) (in den letzten 3 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: communicating with instructors or learners using audio or video online tools (e.g. Zoom, MS Teams, Google Classroom) (last 3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: communiquer avec des enseignants ou des apprenants par des outils audio ou vidéo en ligne (comme Zoom, MS Teams, Google Classroom) (3 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOFE"><skos:prefLabel xml:lang="de">Internetnutzung: Teilnahme an Lernaktivitäten zum Zweck der formalen Bildung (z.B. Schule oder Universität) (in den letzten 3 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: participation in learning activities for the purpose of formal education (e.g. school or university) (last 3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: participer à des activités d&apos;apprentissage dans le cadre d&apos;une éducation formelle (telle que l&apos;école ou l&apos;université) (3 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOHC"><skos:prefLabel xml:lang="de">Internet-Nutzung: für andere Gesundheitsdienste über eine Webseite oder App, anstatt ins Krankenhaus oder zum Arzt zu gehen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: for other health services via a website or app instead of having to go to the hospital or visit a doctor</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: bénéficier d’autres services liés à la santé par l’internet ou une application au lieu de devoir se rendre à l’hôpital ou consulter un médecin</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOLANY"><skos:prefLabel xml:lang="de">Internet-Nutzung: für einen Online-Kurs (jeglicher Fachrichtung) oder Online-Lernmaterial-Nutzung</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: doing an online course (of any subject) or using online learning material</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: suivre un cours en ligne (sur toute matière) ou utiliser du matériel d&apos;apprentissage en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOLC"><skos:prefLabel xml:lang="de">Internet-Nutzung: für einen Online-Kurs (jeglicher Fachrichtung)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: doing an online course (of any subject)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé l&apos;internet, au cours des trois derniers mois, pour suivre un cours en ligne (sur toute matière)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOLM"><skos:prefLabel xml:lang="de">Internet-Nutzung: Online-Lernmaterial</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: online learning material</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour utiliser du matériel d&apos;apprentissage en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOPP"><skos:prefLabel xml:lang="de">Internetnutzung: Teilnahme an Lernaktivitäten zu privaten Zwecken (in den letzten 3 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: participation in learning activities for private purposes (last 3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: participer à des activités d&apos;apprentissage pour des motifs privés (3 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUOW"><skos:prefLabel xml:lang="de">Internetnutzung: Teilnahme an Lernaktivitäten zu beruflichen Zwecken (in den letzten 3 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: participation in learning activites for professional/work related purposes (last 3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: participer à des activités d&apos;apprentissage à des fins professionnelles/liées au monde du travail (3 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPAYAC"><skos:prefLabel xml:lang="de">Internet-Nutzung: Verwaltung von Online-Zahlungskonten, um (potentiell) Online Käufe zu bezahlen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: managing a payment account to (potentially) pay for goods or services purchased over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: utiliser un compte bancaire pour (potentiellement) payer des produits ou services achetés sur Internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPCAST"><skos:prefLabel xml:lang="de">Internetnutzung: Hören oder Herunterladen von Podcasts (in den letzten 3 Monaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: listening to or downloading podcasts (last 3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: écouter ou télécharger des podcasts (3 derniers mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPDG"><skos:prefLabel xml:lang="de">Internet-Nutzung: Online-Spielen oder Herunterladen von Spielen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: playing or downloading games</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: jouer ou télécharger des jeux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPH1"><skos:prefLabel xml:lang="de">Internet-Nutzung: Telefonieren oder Videoanrufe</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: telephoning or video calls</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour des appels téléphoniques ou vidéo</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPHCHAT1"><skos:prefLabel xml:lang="de">&quot;Internet-Nutzung: Telefonieren oder Videoanrufe, oder Sofortnachrichtendienste (Instant Messaging; z. B. über Skype, Messenger, WhatsApp, Viber)&quot;</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: Telephoning or video calls, or instant messaging (i.e. exchanging messages, for example, via Skype, Messenger, WhatsApp, Viber)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour des appels téléphoniques ou vidéo, ou services de messagerie instantanée (échange de messages, par exemple via Skype, Messenger, WhatsApp, Viber)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPNET"><skos:prefLabel xml:lang="de">Internet-Nutzung: Nutzung von beruflichen Netzwerken im Internet (Erstellen von Personenprofilen, Posten von Nachrichten oder Beiträgen bei Linkedln, Xing, etc.)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: participating in professional networks (creating user profile, posting messages or other contributions to LinkedIn, Xing, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour communiquer sur des réseaux professionnels (créer un profil d&apos;utilisateur, envoyer des messages ou en intervenir sur Linkedln ou Xing, par exemple)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPOL"><skos:prefLabel xml:lang="de">Internet-Nutzung: Lesen oder Verfassen von Meinungsäußerungen über Bürgerangelegenheiten oder politische Themen auf Internetseiten</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: reading and posting opinions on civic or political issues via websites</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour lire et envoyer des opinions sur les questions civiques ou politiques par l&apos;intermédiaire de sites Web (p.ex. blogs, réseaux sociaux)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPOL1"><skos:prefLabel xml:lang="de">Internet-Nutzung: Verfassen von Meinungsäußerungen zu politischen oder sozialen Themen auf Internetseiten ( z. B. in Blogs oder sozialen Netzwerk ) (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: posting opinions on civic or political issues via websites (e.g. blogs, social networks, etc.) (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pour envoyer des opinions sur des sujets civiques ou politiques (par exemple blogs ou réseaux sociaux, etc.) (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUPOL2"><skos:prefLabel xml:lang="de">Internet-Nutzung: Meinungsäußerungen zu politischen oder sozialen Themen auf Internetseiten oder sozialen Netzwerken (e.g. Facebook, Twitter, Instagram, YouTube)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: expressing opinions on civic or political issues on websites or in social media (e.g. Facebook, Twitter, Instagram, YouTube)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pour exprimer des opinions sur des sujets civiques ou politiques sur les sites internet ou les réseaux sociaux (ex.. Facebook, Twitter, Instagram, YouTube)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSELL"><skos:prefLabel xml:lang="de">Internet-Nutzung: Verkauf von Waren und Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: selling goods or services</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour vendre des biens et des services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSNET"><skos:prefLabel xml:lang="de">Internet-Nutzung: Nutzen von sozialen Netzwerken (Erstellen eines Personenprofils, Posten von Nachrichten oder sonstigen Beiträgen zu Facebook, Twitter, etc.)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: participating in social networks (creating user profile, posting messages or other contributions to facebook, twitter, etc.)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour communiquer sur des réseaux sociaux (créer un profil d&apos;utilisateur, envoyer des messages à ou intervenir sur un ou plusieurs réseaux sociaux p.ex. Facebook, Twitter, etc.)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSOFT"><skos:prefLabel xml:lang="de">Internet-Nutzung: Herunterladen vom Software</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: downloading software</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour télécharger des logiciels</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSTV"><skos:prefLabel xml:lang="de">Internet-Nutzung: Streaming-Fernsehsendungen anschauen (live oder zeitversetzt)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: watching internet streamed TV (live or catch-up) from TV broadcasters</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: regarder la télévision sur Internet (en direct ou en replay) sur les chaînes des groupes de télédiffusion</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUSTVV"><skos:prefLabel xml:lang="de">Internet-Nutzung: Streaming-Fernsehsendungen (live oder zeitversetzt) oder Videos anschauen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: watching internet streamed TV or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: regarder des vidéo ou la télévision sur internet sur les chaînes des groupes de télédiffusion</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUUPL"><skos:prefLabel xml:lang="de">Internet-Nutzung: selbst geschaffenen Inhalt auf eine für andere zugängliche Website hochladen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: uploading self-created content to any website to be shared</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour publier un contenu créé par soi-même sur un site web en vue de le partager</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUUPL1"><skos:prefLabel xml:lang="de">Internet-Nutzung: hochladen oder teilen eigener, selbst erstellter Inhalte (Videos, Fotos, Musik, Texte,…) auf Websites oder mit einer App</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: sharing or publishing self-created videos, photos, music, texts, etc on a website or via an app</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet : pour partager ou publier un contenu créé par soi-même comme des vidéos, des photos, de la musique, du texte, etc… sur un site web ou une application</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUV"><skos:prefLabel xml:lang="de">Internet-Nutzung: Videos von kommerziellen Anbietern oder von Video-Sharing-Diensten anschauen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: watching video content from commercial or sharing services</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: regarder des vidéos de services commerciaux ou de services de partage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUVOD"><skos:prefLabel xml:lang="de">Internet-Nutzung: Videos von kommerziellen Anbietern anschauen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: watching video on demand from commercial services</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: regarder des vidéos à la demande à partir de services commerciaux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUVOTE"><skos:prefLabel xml:lang="de">Internet-Nutzung: Teilnahme an Beratungen oder Abstimmungen im Internet über Bürgerangelegenheiten oder politische Themen (z.B. Stadtplanung, Unterschreiben einer Petition)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: taking part in on-line consultations or voting to define civic or political issues (e.g. urban planning, signing a petition)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour participer à des consultations en ligne ou pour voter sur des sujets civiques ou politiques (urbanisme, signature de pétitions, par exemple)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUVSS"><skos:prefLabel xml:lang="de">Internet-Nutzung: Videos von Video-Sharing-Diensten anschauen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: watching video content from sharing services</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: regarder des vidéos depuis des services de partage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUWEB"><skos:prefLabel xml:lang="de">Internet-Nutzung: Web-Radio / Web-Fernsehen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: listening to web radios and/or watching web TV</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: écouter des radios en ligne et/ou regarder la télévision sur le web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUWEB2"><skos:prefLabel xml:lang="de">Internet-Nutzung: Web-Radio</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: listening to web radio</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: écouter des radios en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUWIKI"><skos:prefLabel xml:lang="de">Internet-Nutzung: Verwendung von Wikis/Online-Lexika (um sich Wissen jeglichen Themas anzueignen)</skos:prefLabel><skos:prefLabel xml:lang="en">Internet use: consulting wikis (to obtain knowledge on any subject)</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;internet: pour consulter des wikis (afin d&apos;obtenir des informations sur n&apos;importe quel sujet)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">559339</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2002-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ci_ac_i"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ci_ac_i</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ci_