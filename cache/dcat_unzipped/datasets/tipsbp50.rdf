://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=MIO_NAC"><skos:prefLabel xml:lang="de">Millionen Einheiten Landeswährung</skos:prefLabel><skos:prefLabel xml:lang="en">Million units of national currency</skos:prefLabel><skos:prefLabel xml:lang="fr">Millions d&apos;unités de monnaie nationale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_GDP"><skos:prefLabel xml:lang="de">Prozent des Bruttoinlandsprodukts (BIP)</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of gross domestic product (GDP)</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage du produit intérieur brut (PIB)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">54</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-11</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/QUARTERLY"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1995-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/tipsbp50"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/tipsbp50</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/tipsbp_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tipsbp50"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/tipsbp_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/tipsbp_esms.sdmx.zip"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) SDMX</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tipsbp50"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/tipsbp_esms.sdmx.zip]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/XML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUM