<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_iw_imp"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-12-20</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Impact of ICT on tasks and skills (2018)</dct:title><dct:description xml:lang="en">Impact of ICT on tasks and skills (2018)</dct:description><dct:title xml:lang="fr">Effets des TIC aux activités et compétences (2018)</dct:title><dct:description xml:lang="fr">Effets des TIC aux activités et compétences (2018)</dct:description><dct:title xml:lang="de">Auswirkungen von IKT auf Aktivitäten und Kenntnisse (2018)</dct:title><dct:description xml:lang="de">Auswirkungen von IKT auf Aktivitäten und Kenntnisse (2018)</dct:description><dct:identifier>isoc_iw_imp</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_iw_imp"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_ANSD"><skos:prefLabel xml:lang="de">Der Zeitaufwand für den Erwerb neuer beruflicher Kompetenzen ist gesunken durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Time spent on acquiring new skills needed for work has decreased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le temps consacré à l&apos;acquisition de nouvelles compétences nécessaires pour le travail a diminué suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_ANSI"><skos:prefLabel xml:lang="de">Der Zeitaufwand für den Erwerb neuer beruflicher Kompetenzen ist gestiegen durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Time spent on acquiring new skills needed for work has increased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le temps consacré à l&apos;acquisition de nouvelles compétences nécessaires pour le travail a augmenté suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_ANSNC"><skos:prefLabel xml:lang="de">Der Zeitaufwand für den Erwerb neuer beruflicher Kompetenzen hat sich nicht relevant geändert durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Time spent on acquiring new skills needed for work has not changed because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le temps consacré à l&apos;acquisition de nouvelles compétences nécessaires pour le travail n&apos;a pas changé suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_ECD"><skos:prefLabel xml:lang="de">Die Zusammenarbeit mit Kollegen oder Geschäftspartnern ist erschwert durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Ease of collaboration with colleagues or business partners has decreased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">La facilité de collaboration avec les collègues et les partenaires commerciaux s&apos;est dégradée suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_ECI"><skos:prefLabel xml:lang="de">Die Zusammenarbeit mit Kollegen oder Geschäftspartnern ist vereinfacht durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Ease of collaboration with colleagues or business partners has increased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">La facilité de collaboration avec les collègues et les partenaires commerciaux s&apos;est améliorée suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_ECNC"><skos:prefLabel xml:lang="de">Die Zusammenarbeit mit Kollegen oder Geschäftspartnern hat sich nicht relevant geändert durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Ease of collaboration with colleagues or business partners has not changed because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">La facilité de collaboration avec les collègues et les partenaires commerciaux n&apos;a pas changé suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_INDD"><skos:prefLabel xml:lang="de">Die Eigenständigkeit, Aufgaben zu organisieren, ist gesunken wegen der beruflichen Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Independence in organising the tasks has decreased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le degré d&apos;indépendance pour organiser ses tâches au travail a diminué suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_INDI"><skos:prefLabel xml:lang="de">Die Eigenständigkeit, Aufgaben zu organisieren, ist gestiegen dank der beruflichen Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Independence in organising the tasks has increased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le degré d&apos;indépendance pour organiser ses tâches au travail a augmenté suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_INDNC"><skos:prefLabel xml:lang="de">Die Eigenständigkeit, Aufgaben zu organisieren, hat sich nicht relevant geändert durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Independence in organising the tasks has not changed because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le degré d&apos;indépendance pour organiser ses tâches au travail n&apos;a pas changé suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_INV"><skos:prefLabel xml:lang="de">Personen, die beruflich in die Auswahl, Änderung oder Prüfung der Software oder der computergesteuerten Geräte einbezogen wurden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals were involved in choosing, modifying or testing the software or computerised equipment used at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant été impliqué pour choisir, modifier ou tester des logiciels ou équipements informatisés utilisés au travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_IWHD"><skos:prefLabel xml:lang="de">Der Umfang der ungeregelten Arbeitszeit ist gesunken durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">The amount of irregular working hours has decreased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le volume d&apos;heures de travail irrégulières a diminué suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_IWHI"><skos:prefLabel xml:lang="de">Der Umfang der ungeregelten Arbeitszeit ist gestiegen durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">The amount of irregular working hours has increased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le volume d&apos;heures de travail irrégulières a augmenté suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_IWHNC"><skos:prefLabel xml:lang="de">Der Umfang der ungeregelten Arbeitszeit hat sich nicht relevant geändert durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">The amount of irregular working hours has not changed because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le volume d&apos;heures de travail irrégulières n&apos;a pas changé suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_JTC"><skos:prefLabel xml:lang="de">Personen, deren wesentliche Aufgaben sich in der Arbeit aufgrund der Einführung neuer Software oder computergesteuerter Geräte verändert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individual&apos;s main job tasks changed as a result of the introduction of new software or computerised equipment</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers dont les tâches principales au travail ont changé en raison de l&apos;introduction de nouveaux logiciels ou équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_LRN"><skos:prefLabel xml:lang="de">Personen, die für die Arbeit die Nutzung neuer Software oder computergesteuerter Geräte erlernen mussten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals had to learn how to use new software or computerised equipment for the job</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant dû apprendre à se servir de nouveaux logiciels ou équipements informatisés pour le travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_MPD"><skos:prefLabel xml:lang="de">Die Überwachung meiner Arbeitsleistung ist gesunken durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Monitoring of my performance at work has decreased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le suivi de ses propres performances au travail a diminué suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_MPI"><skos:prefLabel xml:lang="de">Die Überwachung meiner Arbeitsleistung ist gestiegen durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Monitoring of my performance at work has increased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le suivi de ses propres performances au travail a augmenté suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_MPNC"><skos:prefLabel xml:lang="de">Die Überwachung meiner Arbeitsleistung hat sich nicht relevant geändert durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Monitoring of my performance at work has not changed because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le suivi de ses propres performances au travail n&apos;a pas changé suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_RTD"><skos:prefLabel xml:lang="de">Der Zeitaufwand für sich wiederholende Aufgaben ist gesunken dank der beruflichen Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Time spent on repetitive tasks has decreased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le temps consacré à des tâches répétitives au travail a diminué suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_RTI"><skos:prefLabel xml:lang="de">Der Zeitaufwand für sich wiederholende Aufgaben ist gestiegen wegen der beruflichen Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Time spent on repetitive tasks has increased because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le temps consacré à des tâches répétitives au travail a augmenté suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_RTNC"><skos:prefLabel xml:lang="de">Der Zeitaufwand für sich wiederholende Aufgaben hat sich nicht relevant geändert durch die berufliche Nutzung von Computern, Laptops, Smartphones oder anderer computergesteuerter Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Time spent on repetitive tasks has not changed because of the use of computers, laptops, smartphones or other computerised equipment at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Le temps consacré à des tâches répétitives au travail n&apos;a pas changé suite à l&apos;usage des ordinateurs fixes et portables, des smartphones ou d&apos;autres équipements informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_SKLHI"><skos:prefLabel xml:lang="de">Personen, deren Kompetenzen ausreichen würden, um in der Arbeit auch mit anspruchsvolleren Aufgaben in der Nutzung von Computern, Software und Apps zurechtzukommen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals had the skills to cope with more demanding duties related to the use of computers, software or applications at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences plus exigeantes que celles actuellement demandées au travail pour réaliser des tâches relatives à l&apos;usage des ordinateurs, logiciels et autres applications</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_SKLLO"><skos:prefLabel xml:lang="de">Personen, die weitere Schulungsmaßnahmen benötigten, um in der Arbeit gut mit der Nutzung von Computern, Software und Apps zurechtzukommen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals needed further training to cope well with the duties relating to the use of computers, software or applications at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant besoin de formation complémentaire pour réaliser les tâches relatives à l&apos;usage des ordinateurs, logiciels et autres applications au travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW_SKLME"><skos:prefLabel xml:lang="de">Personen, deren Kompetenzen den Aufgaben entsprechen, um in der Arbeit gut mit der Nutzung von Computern, Software und Apps zurechtzukommen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals&apos; skills correspond well to the duties related to the use of computers, software or applications at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant des compétences correspondant bien aux tâches relatives à l&apos;usage des ordinateurs, logiciels et autres applications au travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12_SSF"><skos:prefLabel xml:lang="de">Prozent der Beschäftigten und Selbständigen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of employees and self-employed who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des salariés et travailleurs indépendants ayant utilisés internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_MDW"><skos:prefLabel xml:lang="de">Prozent der Personen, die beruflich jegliche Art von Computern, tragbare Geräte oder andere computergesteuerte Geräte oder Maschinen verwendeten</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who, at work, use any type of computers, portable devices or computerised equipment or machinery</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant au travail utilisé des ordinateurs fixes ou portables, d&apos;autres appareils électroniques portables ou des équipements ou machines informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">170432</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:D