<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/sdg_02_20"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-11</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Liste der Produkte - LGR</dcat:keyword><dcat:keyword  xml:lang="en">List of products - EAA</dcat:keyword><dcat:keyword  xml:lang="fr">Liste de produits - EAA</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Agricultural real factor income per annual work unit (AWU)</dct:title><dct:description xml:lang="en">&lt;p&gt;&lt;span style=&quot;color: black;&quot;&gt;Agricultural real factor income measures the income generated by farming, which is used to remunerate borrowed or rented factors of production (capital, wages and land rents) as well as own production factors (own labour, capital and land). Annual work units (AWUs) are defined as full-time equivalent employment (corresponding to the number of full-time equivalent jobs), which is calculated by dividing total hours worked by the average annual number of hours worked in full-time jobs within the economic territory. This can be interpreted as a measure of labour productivity in agriculture. The data stem from the Economic Accounts for Agriculture (EAA), which provide detailed information on agricultural sector income.&lt;/span&gt;&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Revenu agricole réel des facteurs par unités de travail annuel  (UTA)</dct:title><dct:description xml:lang="fr">&lt;p&gt;&lt;span style=&quot;color: black;&quot;&gt;Le revenu des facteurs réels agricoles mesure le revenu généré par l’agriculture, qui sert à rémunérer les facteurs de production empruntés ou loués (capital, salaires et loyers fonciers) ainsi que les facteurs de production propres (travail propre, capital et terre). Les unités de travail annuel (UTA) sont définies comme occupation équivalents temps plein (correspondant au nombre d’emplois équivalents en temps plein), qui est calculée en divisant le nombre total d’heures travaillées par le nombre annuel moyen d’heures travaillées dans des emplois à temps plein sur le territoire économique. Cela peut être interprété comme une mesure de la productivité du travail dans l’agriculture. Les données proviennent des Comptes économiques de l’agriculture (CEA), qui fournissent des informations détaillées sur le revenu du secteur agricole.&lt;/span&gt;&lt;/p&gt;</dct:description><dct:title xml:lang="de">Landwirtschaftliches reales Faktoreinkommen in Jahresarbeitseinheiten  (JAE)</dct:title><dct:description xml:lang="de">&lt;p&gt;&lt;span style=&quot;color: black;&quot;&gt;Das landwirtschaftliche Realfaktoreinkommen misst das Einkommen aus der Landwirtschaft, das zur Vergütung von geliehenen oder gemieteten Produktionsfaktoren (Kapital, Löhne und Grundrenten) sowie Eigenproduktionsfaktoren (Eigenarbeit, Kapital und Land) verwendet wird. Die Jahresarbeitseinheiten (JAE) sind definiert als Vollzeitäquivalent-Beschäftigung (entspricht der Zahl der Arbeitsplätze in Vollzeitäquivalenten), die berechnet wird, indem die Gesamtarbeitsstunden durch die durchschnittliche jährliche Zahl der in Vollzeitjobs geleisteten Arbeitsstunden im Wirtschaftsgebiet geteilt werden. Dies kann als Maß für die Arbeitsproduktivität in der Landwirtschaft interpretiert werden. Die Daten stammen aus der landwirtschaftlichen Gesamtrechnung für die Landwirtschaft, die detaillierte Informationen über die Einkommen des Agrarsektors enthält.&lt;/span&gt;&lt;/p&gt;</dct:description><dct:identifier>sdg_02_20</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_02_20"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/ITM_NEWA" > <skos:prefLabel xml:lang="de">Liste der Produkte - LGR</skos:prefLabel><skos:prefLabel xml:lang="en">List of products - EAA</skos:prefLabel><skos:prefLabel xml:lang="fr">Liste de produits - EAA</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=CLV15_EUR_AWU"><skos:prefLabel xml:lang="de">Verkettete Volumen (2015), Euro pro jährliche Arbeitseinheit (JAE)</skos:prefLabel><skos:prefLabel xml:lang="en">Chain linked volumes (2015), euro per annual work unit (AWU)</skos:prefLabel><skos:prefLabel xml:lang="fr">Volumes chaînés (2015), euro par unité de travail annuel (UTA)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=CLV_I15"><skos:prefLabel xml:lang="de">Verkettete Volumen, Index 2015=100</skos:prefLabel><skos:prefLabel xml:lang="en">Chain linked volumes, index 2015=100</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesures de volume chaînées, indice 2015=100</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">66</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSch