<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_eb_iotn2"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-12-08</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</dcat:keyword><dcat:keyword  xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</dcat:keyword><dcat:keyword  xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</dcat:keyword><dcat:keyword  xml:lang="en">Size classes in number of persons employed</dcat:keyword><dcat:keyword  xml:lang="fr">Classes de taille en nombre des personnes occupées</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Internet of Things by NACE Rev. 2 activity</dct:title><dct:description xml:lang="en">Internet of Things by NACE Rev. 2 activity</dct:description><dct:title xml:lang="fr">Internet des objets , par activité de la NACE Rév. 2</dct:title><dct:description xml:lang="fr">Internet des objets , par activité de la NACE Rév. 2</dct:description><dct:title xml:lang="de">Internet der Dinge, nach Aktivitäten der NACE Rev.2</dct:title><dct:description xml:lang="de">Internet der Dinge, nach Aktivitäten der NACE Rev.2</dct:description><dct:identifier>isoc_eb_iotn2</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_iotn2"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_BDA_IOT"><skos:prefLabel xml:lang="de">Unternehmen analysieren Big Data intern (aus beliebigen Datenquellen) oder extern und verwenden IoT (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises analysing big data internally (from any data source) or externally and using IoT (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises analysant des données massives en interne (issues de toutes sources) ou en recourant à une autre entreprise externe et utilisant l&apos;IdO (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_BDA_IOTX"><skos:prefLabel xml:lang="de">Unternehmen analysieren Big Data intern (aus beliebigen Datenquellen) oder extern aber verwenden kein IoT (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises analysing big data internally (from any data source) or externally but not using IoT (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises analysant des données massives en interne (issues de toutes sources) ou en recourant à une autre entreprise externe mais n&apos;utilisant pas l&apos;IdO (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CC_IOT"><skos:prefLabel xml:lang="de">Unternehmen beziehen kostenpflichtige CC-Dienste und verwenden IoT (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises buying CC services and using IoT (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises achetant des services CC et utilisant l&apos;IdO (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_CC_IOTX"><skos:prefLabel xml:lang="de">Unternehmen beziehen kostenpflichtige CC-Dienste aber verwenden kein IoT (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises buying CC services but not using IoT (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises achetant des services CC mais n&apos;utilisant pas l&apos;IdO (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOT"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT (vernetzte Geräte oder Systeme, deren Überwachung oder Steuerung über Internet erfolgen kann) (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT (interconnected devices or systems that can be monitored or remotely controlled via the internet) (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IdO (dispositifs / systèmes interconnectés qui peuvent être suivis ou contrôlés à distance par internet (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOT1"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT (vernetzte Geräte oder Systeme, deren Überwachung oder Steuerung über Internet erfolgen kann) (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT (interconnected devices or systems that can be monitored or remotely controlled via the internet) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IdO (dispositifs / systèmes interconnectés qui peuvent être suivis ou contrôlés à distance par internet (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOT1X"><skos:prefLabel xml:lang="de">Unternehmen verwenden kein IoT (vernetzte Geräte oder Systeme, deren Überwachung oder Steuerung über Internet erfolgen kann) (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises do not use IoT (interconnected devices or systems that can be monitored or remotely controlled via the internet) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;utilisant pas d&apos;IdO (dispositifs / systèmes interconnectés qui peuvent être suivis ou contrôlés à distance par internet (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTD1_GE1"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für einen oder mehrere der folgenden Verwendungszwecke: IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1, IOTDOTH1</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for one or more purposes of: IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1, IOTDOTH1</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IdO à au moins une fin, parmi IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1 et IOTDOTH1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTD1_GE2"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für zwei oder mehrere der folgenden Verwendungszwecke: IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1, IOTDOTH1</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for two or more purposes of: IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1, IOTDOTH1</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IdO à au moins deux fins, parmi IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1 et IOTDOTH1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTD1_GE3"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für drei oder mehrere der folgenden Verwendungszwecke: IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1, IOTDOTH1</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for three or more purposes of: IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1, IOTDOTH1</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IdO à au moins trois fins, parmi IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1 et IOTDOTH1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDCUS"><skos:prefLabel xml:lang="de">Unternehmen verwenden Sensoren, RFID-Tags oder internetgesteuerte Kameras zur Verbesserung des Kundenservices, um Kundenaktivitäten zu beobachten oder den Kunden personalisierte Kauferfahrung zu bieten (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use sensors, RFID or IP tags or internet-controlled cameras to improve customer service, monitor customers&apos; activities or offer them a personalised shopping experience (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des capteurs, étiquettes RFID ou caméras pilotées par internet pour améliorer le service client, suivre les activités des clients ou leur offrir une expérience d&apos;achat personnalisée (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDCUS1"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für Kundenservice (z.B. intelligente Kameras oder Sensoren, um den Kunden ein personalisiertes Einkaufserlebnis zu bieten) (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for customer service (e.g. smart cameras or sensors to offer customers a personalised shopping experience) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IdO pour le service clientèle (par exemple, des caméras intelligentes ou des capteurs pour offrir aux clients une expérience de vente personnalisée) (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDEC"><skos:prefLabel xml:lang="de">Unternehmen verwenden intelligente Stromzähler, Lampen oder Thermostate zur Optimierung des Energieverbrauchs in Unternehmensgebäuden (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use smart meters, smart lamps, smart thermostats to optimise energy consumption in the enterprise&apos;s premises (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des compteurs, lampes ou thermostats intelligents pour optimiser la consommation d&apos;énergie dans leurs locaux (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDEC1"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT zur Steuerung des Energieverbrauchs (z.B. intelligente Stromzähler, Thermostate oder Lampen)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for energy consumption management (e.g. smart-meters, -thermostats, -lights) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IoT pour optimiser la consommation d&apos;énergie (par exemple, des compteurs, lampes ou thermostats intelligents) (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDLOG"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für das Logistikmanagement (z.B. Sensoren zur Verfolgung von Produkten oder Fahrzeugen in der Lagerverwaltung) (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for logistics management (e.g. sensors for tracking products or vehicles in warehouse management) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IoT pour la gestion logistique (par exemple, des capteurs pour suivre les produits ou les véhicules dans la gestion des entrepôts) (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDMTN"><skos:prefLabel xml:lang="de">Unternehmen verwenden Bewegungssensoren zur Aufzeichnung der Bewegung von Fahrzeugen oder Produkten bzw. Wartungssensoren zur bedarfsbedingten Wartung von Fahrzeugen (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use movement or maintenance sensors to track the movement of vehicles or products, to offer condition-based maintenance of vehicles (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des capteurs de mouvements ou de maintenance pour suivre le déplacement des véhicules ou des produits pour proposer un service d&apos;entretien des véhicules en fonction de leur état (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDMTN1"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für zustandsabhängige Wartung (z.B. Sensoren zur Überwachung des Wartungsbedarfs von Maschinen oder Fahrzeugen) (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for condition-based maintenance (e.g. sensors to monitor maintenance needs of machines or vehicles) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IoT pour la maintenance conditionnelle (par exemple, des capteurs pour surveiller les besoins de maintenance des machines ou des véhicules) (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDOTH"><skos:prefLabel xml:lang="de">Unternehmen verwenden andere IoT-Geräte oder -Systeme (als IOTDEC, IOTDCUS, IOTDMTN, IOTDPRD) (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use other IoT devices or systems (than IOTDEC, IOTDCUS, IOTDMTN, IOTDPRD) (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant d&apos;autres dispositifs / systèmes d&apos;IdO (que IOTDEC, IOTDCUS, IOTDMTN, IOTDPRD) (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDOTH1"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für sonstige Zwecke (als IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for other purposes (than IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IdO à d&apos;autres fins (que IOTDEC1, IOTDSEC, IOTDPP, IOTDLOG, IOTDMTN1, IOTDCUS1)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDPP"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für Produktionsprozesse (z.B. Sensoren oder RFID-Tags zur Überwachung oder Automatisierung von Produktionsprozessen) (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for production processes (e.g. sensors or RFID tags to monitor or automate the production processes) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IoT pour les processus de production (par exemple, des capteurs ou des étiquettes RFID pour surveiller ou automatiser le processus de production) (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDPRD"><skos:prefLabel xml:lang="de">Unternehmen verwenden Sensoren oder RFID-Tags zur Überwachung oder Automatisierung von Produktionsprozessen oder dem Logistikmanagement, um die Bewegung von Produkten zu verfolgen (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use sensors or RFID tags to monitor or automate production processes, to manage logistics, to track the movement of products (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des capteurs ou étiquettes RFID pour surveiller ou automatiser les processus de production, gérer la logistique, suivre le mouvement des produits (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDPRD1"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für Produktionsprozesse oder für das Logistikmanagement (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for production processes or logistics management (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IoT pour les processus de production ou la gestion logistique (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTDSEC"><skos:prefLabel xml:lang="de">Unternehmen verwenden IoT für Gebäudesicherheit (z.B. Alarmsysteme, Rauchmelder, Türschlösser, Überwachungskameras ) (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use IoT for premises&apos; security (e.g. smart-alarm systems, -smoke detectors, -door locks, -security cameras) (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant l&apos;IoT pour la sécurité des locaux (par exemple, les systèmes d&apos;alarme intelligents, les détecteurs de fumée, les serrures de porte, les caméras de sécurité) (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IOTD_GE2"><skos:prefLabel xml:lang="de">Unternehmen verwenden zwei oder mehr IoT-Geräte oder-Systeme (bis 2020)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises use two or more IoT devices or systems (until 2020)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant au moins deux dispositifs ou systèmes d&apos;IdO (jusqu&apos;en 2020)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IOT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die IOT verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using Internet of Things</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant IOT</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IOT1"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die IOT verwenden (ab 2021)</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using Internet of Things (as of 2021)</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant IOT (à partir de 2021)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87796</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-12</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_iotn2"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_iotn2</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_iotn2"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_e_esms.sdmx.zip"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) SDMX</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eb_iotn2"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_e_esms.sdmx.zip]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/XML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/databrowser/view/isoc_eb_iotn2/default/table"><dct:title xml:lang="en">Table, graphs and map visualizations are also available.</dct:title><dct:title xml:lang="fr">Des visualisations sous forme de tableau, graphique et carte géographique sont aussi disponibles.</dct:title><dct:title xml:lang="de">Tabellen, Grafiken und geografische Darstellungen sind ebenfalls verfügbar.</dct:title><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/isoc_eb_iotn2/default/table"/><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/VISUALIZATION"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dct:rights rdf:resource="http://publica