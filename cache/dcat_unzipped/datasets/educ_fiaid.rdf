ocation rdf:about="http://publications.europa.eu/resource/authority/country/LIE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED" > <skos:prefLabel xml:lang="de">Bildungsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Education indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;éducation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FD01_1"><skos:prefLabel xml:lang="de">Finanzhilfen für Schüler und Studierende in % der gesamten öffentlichen Bildungsausgaben, für alle Bildungsbereiche zusammen</skos:prefLabel><skos:prefLabel xml:lang="en">Financial aid to pupils and students as % of total public expenditure on education, for all levels of education combined</skos:prefLabel><skos:prefLabel xml:lang="fr">Aides financières aux élèves et étudiants en % des dépenses publiques totales d&apos;éducation, tous niveaux confondus</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FD01_2"><skos:prefLabel xml:lang="de">Finanzhilfen für Schüler in % der gesamten öffentlichen Bildungsausgaben, im Primar- und im Sekundarbereich (ISCED 1-4)</skos:prefLabel><skos:prefLabel xml:lang="en">Financial aid to pupils as % of total public expenditure on education, at primary and secondary level of education (ISCED 1-4)</skos:prefLabel><skos:prefLabel xml:lang="fr">Aides financières aux élèves en % des dépenses publiques totales d&apos;éducation aux niveaux d&apos;enseignement primaire et secondaire (CITE 1-4)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=FD01_3"><skos:prefLabel xml:lang="de">Finanzhilfen für Studierende in % der gesamten öffentlichen Bildungsausgaben im Tertiärbereich (ISCED 56)</skos:prefLabel><skos:prefLabel xml:lang="en">Financial aid to students as % of total public expenditure on education, at tertiary level of education (ISCED 56)</skos:prefLabel><skos:prefLabel xml:lang="fr">Aides financières aux étudiants en % des dépenses publiques totales d&apos;éducation, au niveau de l&apos;enseignement tertiaire (CITE 56)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC"><skos:prefLabel xml:lang="de">Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">105</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/HEAL" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/JUST" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-03-15</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1995-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.