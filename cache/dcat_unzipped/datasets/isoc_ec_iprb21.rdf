abel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BARR2X"><skos:prefLabel xml:lang="de">Personen, die keine Probleme bei Käufen für private Zwecke über eine Webseite oder App feststellten (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who did not encounter problems when buying via a website or an app (3 months) for private use</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas rencontré de problème lors de leurs achats sur un site internet ou une app (3 mois) à des fins privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BARR2Y"><skos:prefLabel xml:lang="de">Personen, die Probleme bei Käufen für private Zwecke über eine Webseite oder App feststellten (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who encountered problems when buying via a website or an app (3 months) for private use</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant rencontré des problèmes lors de leurs achats sur un site internet ou une app (3 mois) à des fins privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCPR1"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Endkosten höher als angegeben</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Final costs higher than indicated</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Coûts finaux supérieurs à ceux indiqués</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCR1"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Schwierigkeiten bei Reklamationen und Mängelbehebung oder keine zufriedenstellende Antwort auf Reklamation erhalten</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Complaints and redress were difficult or no satisfactory response after complaint</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Plaintes et réclamations difficiles et absence de réponse satisfaisante après une réclamation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BDGL1"><skos:prefLabel xml:lang="de">Problem, das  Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Schwierigkeiten beim Finden von Information bzgl. Garantien und anderer Rechte</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): difficulties finding information concerning guarantees, other legal rights</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Problèmes pour trouver des informations sur la garantie et autres dispositions légales</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BDNS1"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Ausländische Händler verkaufen nicht in das Land des Käufers</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Foreign retailer did not sell in my country</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois) : Le vendeur étranger ne vendait pas dans le pays de l&apos;acheteur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFRA1"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Betrug</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Problems with fraud</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Problèmes de fraude</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BOTH2"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Anderes Problem</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Other</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Autre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BSPD1"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Längere Lieferzeit als angegeben</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Speed of delivery slower than indicated</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Délai de livraison plus long que celui indiqué</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BTFW1"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): Website schwer zu nutzen oder funktionierte nicht zufriedenstellend</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Website too difficult to use or worked unsatisfactorily</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Site internet trop compliqué à utiliser ou ne fonctionnant pas de manière satisfaisante</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BWDN1"><skos:prefLabel xml:lang="de">Problem, das Personen bei Käufen über eine Webseite oder App feststellten (3 Monate): falsche oder beschädigte Güter/Dienstleistungen geliefert</skos:prefLabel><skos:prefLabel xml:lang="en">Problem encountered by individuals when buying via a website or an app (3 months): Wrong or damaged good/services delivered</skos:prefLabel><skos:prefLabel xml:lang="fr">Problème rencontré par les particuliers lors de leurs achats sur un site internet ou une app (3 mois): Livraison de biens ou de services non commandés ou endommagés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_BUY3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten 3 Monaten online Käufe getätigt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who purchased online in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant commandé en ligne au cours des 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">129727</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-t