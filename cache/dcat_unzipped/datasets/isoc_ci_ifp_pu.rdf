office, town hall, government agency</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet depuis une administration publique, communale ou gouvernementale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IGOVQ"><skos:prefLabel xml:lang="de">Internetzugang nur in einem öffentlichen Amt, im Rathaus oder in einer staatlichen Behörde</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at public office, town hall, government agency</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement depuis une administration publique, communale ou gouvernementale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IHM"><skos:prefLabel xml:lang="de">Internetzugang zuhause</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access at home</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet à domicile</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IHMQ"><skos:prefLabel xml:lang="de">Internetzugang nur zuhause</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at home</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement à domicile</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IHOT"><skos:prefLabel xml:lang="de">Personen, die in den letzten 3 Monaten an einem Hotspot auf das Internet zugegriffen haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who accessed internet in a hotspot (at hotels, airports, public places etc) in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant accédé à l&apos;internet dans un point d&apos;accès (hôtel, aéroport, place publique, etc.) au cours des 3 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_ILIB"><skos:prefLabel xml:lang="de">Internetzugang in der öffentlichen Bücherei</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access at public library</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet depuis la bibliothèque publique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_ILIBQ"><skos:prefLabel xml:lang="de">Internetzugang nur in der öffentlichen Bücherei</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at public library</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement depuis la bibliothèque publique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOH"><skos:prefLabel xml:lang="de">Internetzugang in Häusern anderer Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access at other people&apos;s houses</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet au domicile d&apos;une autre personne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOHQ"><skos:prefLabel xml:lang="de">Internetzugang nur in Häusern anderer Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at other people&apos;s houses</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement au domicile d&apos;une autre personne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOTH"><skos:prefLabel xml:lang="de">Internetzugang an anderen Orten</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access at other places</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet dans d&apos;autres lieux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IOTHQ"><skos:prefLabel xml:lang="de">Internetzugang nur an anderen Orten</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at other places</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement dans d&apos;autres lieux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IPO"><skos:prefLabel xml:lang="de">Internetzugang in einem Postamt</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access at postal office</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet depuis le bureau de poste</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IPOQ"><skos:prefLabel xml:lang="de">Internetzugang nur in einem Postamt</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at postal office</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement depuis le bureau de poste</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUMC"><skos:prefLabel xml:lang="de">Personen, die einen Laptop, Notebook, Netbook oder Tablet-Computer für den Internetzugang außerhalb der Wohnung oder des Arbeitsplatzes verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a laptop, notebook, netbook or tablet computer to access the internet away from home or work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers accédant à l&apos;internet à l&apos;aide d&apos;un ordinateur portable, notebook, netbook ou tablette électronique en dehors du domicile ou du travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IUMD"><skos:prefLabel xml:lang="de">Personen, die einen tragbaren Computer oder ein Handheld-Gerät zum Internetzugang außerhalb der Wohnung oder des Arbeitsplatzes verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used a portable computer or a handheld device to access the internet away from home or work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers utilisant un ordinateur portable ou un appareil de poche ou téléphonie mobile pour accéder à l&apos;internet en dehors du domicile ou du travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IVOL"><skos:prefLabel xml:lang="de">Internetzugang bei einer öffentlichen oder freiwilligen Organisation</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access at community or voluntary organisation</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet depuis une organisation collective ou bénévole</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IVOLQ"><skos:prefLabel xml:lang="de">Internetzugang nur bei einer öffentlichen oder freiwilligen Organisation</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at community or voluntary organisation</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement depuis une organisation collective ou bénévole</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IWRK"><skos:prefLabel xml:lang="de">Internetzugang am Arbeitsplatz</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access at place of work</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet sur le lieu de travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IWRKQ"><skos:prefLabel xml:lang="de">Internetzugang nur am Arbeitsplatz</skos:prefLabel><skos:prefLabel xml:lang="en">Internet access only at place of work</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès à l&apos;internet seulement sur le lieu de travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">136347</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2002-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ci_ifp_pu"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ci_ifp_pu</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:la