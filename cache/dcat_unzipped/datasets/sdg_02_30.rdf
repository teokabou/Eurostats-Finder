<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/sdg_02_30"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-11-06</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Systematik für die Analyse und den Vergleich wissenschaftlicher Programme und Haushalte (NABS 2007)</dcat:keyword><dcat:keyword  xml:lang="en">Nomenclature for the analysis and comparison of scientific programmes and budgets (NABS 2007)</dcat:keyword><dcat:keyword  xml:lang="fr">Nomenclature pour l&apos;analyse et la comparaison des programmes et des budgets scientifiques (NABS 2007)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Government support to agricultural research and development</dct:title><dct:description xml:lang="en">&lt;p&gt;The indicator refers to government budget allocations&amp;nbsp;for research and development (GBARD) for agriculture. GBARD data measure government support for research and development (R&amp;amp;D) activities, or, in other words, how much priority governments place on the public funding of R&amp;amp;D.&lt;/p&gt;&lt;p&gt;GBARD data are compiled using the guidelines laid out in the OECD’s Frascati Manual from 2015 and the European Business Statistics Methodological Manual for R&amp;amp;D statistics of 2023.&amp;nbsp;&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Support gouvernemental en faveur de la recherche et du développement agricole</dct:title><dct:description xml:lang="fr">&lt;p&gt;L’indicateur fait référence aux crédits budgétaires alloués par le gouvernement aux activités de recherche et développement (CBPRD) pour l’agriculture. Les données du CBPRD mesurent le soutien du gouvernement aux activités de recherche et développement (R&amp;amp;D), c’est-à-dire la mesure dans laquelle les gouvernements accordent la priorité au financement public de la R&amp;amp;D.&lt;/p&gt;&lt;p&gt;Les données CBPRD sont compilées à partir des lignes directrices énoncées dans le Manuel Frascati de l’OCDE de 2015 et le manuel méthodologique des statistiques européennes d’entreprises pour les statistiques de R&amp;amp;D de 2023.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Staatliche Unterstützung der Forschung und Entwicklung im Bereich Landwirtschaft</dct:title><dct:description xml:lang="de">&lt;p&gt;Der Indikator bezieht sich auf die Mittelzuweisungen des Staates für Forschungs- und Entwicklungstätigkeiten (GBARD) für die Landwirtschaft. GBARD-Daten messen staatliche Unterstützung für Forschungs- und Entwicklungstätigkeiten (FuE), bzw. wieviel Priorität Regierungen der öffentlichen Finanzierung von FuE einräumen.&lt;/p&gt;&lt;p&gt;GBARD-Daten werden anhand der Leitlinien des Frascati-Handbuchs der OECD aus dem Jahr 2015 und des Methodikhandbuchs für europäische Unternehmensstatistiken für FuE-Statistiken aus dem Jahr 2023 erstellt.&lt;/p&gt;</dct:description><dct:identifier>sdg_02_30</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/sdg_02_30"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><