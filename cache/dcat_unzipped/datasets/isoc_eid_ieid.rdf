<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_eid_ieid"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-08</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Use of electronic identification (eID)</dct:title><dct:description xml:lang="en">Use of electronic identification (eID)</dct:description><dct:title xml:lang="fr">Utilisation de l&apos;identification électronique (eID)</dct:title><dct:description xml:lang="fr">Utilisation de l&apos;identification électronique (eID)</dct:description><dct:title xml:lang="de">Nutzung von elektronischer Identifikation (eID)</dct:title><dct:description xml:lang="de">Nutzung von elektronischer Identifikation (eID)</dct:description><dct:identifier>isoc_eid_ieid</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eid_ieid"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IEID"><skos:prefLabel xml:lang="de">Einzelpersonen, die ihre elektronische Identifikation (eID) in den letzten 12 Monaten für den Zugriff auf Online-Dienste für private Zwecke genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have used their eID to access online services for private purpose in the last 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé leur identification électronique (eID) au cours des 12 derniers mois pour accéder à des services en ligne à des fins privées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IEIDBS"><skos:prefLabel xml:lang="de">Einzelpersonen, die eine eID in den letzten 12 Monaten für den Zugriff auf Dienstleistungen des Unternehmenssektors genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have used their eID to access services provided by business sector in the last 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé leur identification électronique (eID) au cours des 12 derniers mois pour accéder à des services en ligne fournis par le secteur des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IEIDBSNE"><skos:prefLabel xml:lang="de">Zugang via eID zu Dienstleistungen des Unternehmenssektors besteht in dem Mitgliedsstaat nicht</skos:prefLabel><skos:prefLabel xml:lang="en">Access via eID to services provided by business sector does not exist in the Member State</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès par une identification électronique aux services fournis par le secteur des entreprises n&apos;est pas possible dans le pays de résidence</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IEIDEC"><skos:prefLabel xml:lang="de">Einzelpersonen, die ihre eID(s) in den letzten 12 Monaten nicht für den Zugriff auf Dienste von Behörden oder öffentlichen Diensten anderer europäischer Länder genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have used their eID to access services provided by public authorities or public services of other European countries in the last 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé leur identification électronique (eID) au cours des 12 derniers mois pour accéder à des services en ligne fournis par les autorités publiques ou par des services publics d&apos;autres pays européens</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IEIDECNE"><skos:prefLabel xml:lang="de">Zugang via eID zu Diensten von Behörden oder öffentlichen Diensten anderer europäischer Länder besteht in dem Mitgliedsstaat nicht</skos:prefLabel><skos:prefLabel xml:lang="en">Access via eID to services provided by public authorities or public services of other European countries does not exist in the Member State</skos:prefLabel><skos:prefLabel xml:lang="fr">Accès par une identification électronique aux services fournis par les autorités publiques ou aux services publics d&apos;autres pays européens n&apos;est pas possible dans le pays de résidence</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IEIDOC"><skos:prefLabel xml:lang="de">Einzelpersonen, die ihre eID(s) in den letzten 12 Monaten nicht für den Zugriff auf Dienste von Behörden oder öffentlichen Diensten ihres Landes genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have used their eID to access services provided by public authorities or public services of their country in the last 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé leur identification électronique (eID) au cours des 12 derniers mois pour accéder à des services en ligne fournis par les autorités publiques ou par des services publics de leur pays</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IREIDDEV"><skos:prefLabel xml:lang="de">Einzelpersonen nutzten keine eID in den letzten 12 Monaten, da sie damit nicht über ein Smartphone oder Tablet auf den Dienst zugreifen konnten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using their eID in the last 12 months because they could not use it to access the service via a smartphone or tablet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé leur identification électronique (eID) parce que l&apos;accès n&apos;était pas possible au départ d&apos;un portable ou d&apos;une tablette</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IREIDNA"><skos:prefLabel xml:lang="de">Einzelpersonen nutzten keine eID in den letzten 12 Monaten, weil sie sich ihrer Existenz nicht bewusst waren</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using their eID in the last 12 months because they were not aware of its existence</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé leur identification électronique (eID), parce qu&apos;ils ignoraient son existence</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IREIDNN"><skos:prefLabel xml:lang="de">Einzelpersonen nutzten keine eID in den letzten 12 Monaten, da sie keinen Zugriff auf Online-Dienste benötigten, die eine eID erforderten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using their eID in the last 12 months because they didn’t need to access any online services requiring it</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé leur identification électronique (eID) parce qu&apos;ils n&apos;ont pas accédé à des sites le requérant</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IREIDNO"><skos:prefLabel xml:lang="de">Einzelpersonen nutzten keine eID in den letzten 12 Monaten, weil sie keine besaßen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using their eID in the last 12 months because they didn’t have one</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé leur identification électronique (eID), parce qu&apos;ils n&apos;en possédaient pas</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IREIDOTH"><skos:prefLabel xml:lang="de">Einzelpersonen nutzten keine eID in den letzten 12 Monaten aus anderen Gründen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using their eID in the last 12 months because of other reasons</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé leur identification électronique (eID) pour d&apos;autres raisons</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IREIDSEC"><skos:prefLabel xml:lang="de">Einzelpersonen nutzten keine eID in den letzten 12 Monaten, weil sie sich bei der Nutzung nicht sicher fühlten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using their eID in the last 12 months because they didn’t feel safe using it</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé leur identification électronique (eID) pour des raisons de sécurité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IREIDTEC"><skos:prefLabel xml:lang="de">Einzelpersonen nutzten keine eID in den letzten 12 Monaten, da sie diese aufgrund von Benutzerfreundlichkeits-/technischen Problemen nicht verwenden konnten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals not using their eID in the last 12 months because they could not use it due to usability/technical issues</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas utilisé leur identification électronique (eID) en raison de difficultés d&apos;utilisation ou techniques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IEID"><skos:prefLabel xml:lang="de">Prozent der Personen, die ihre elektronische Identifikation (eID) in den letzten 12 Monaten für den Zugriff auf Online-Dienste zu privaten Zwecken genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have used their electronic identification to access online services for private purpose in the last 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisé leur identification électronique (eID) pour accéder à des services en ligne à des fins privées au cours des 12 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">77897</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eid_ieid"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_eid_ieid</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></