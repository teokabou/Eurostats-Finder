:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SRC_CRF" > <skos:prefLabel xml:lang="de">Quellsektoren für Treibhausgasemissionen (Gemeinsames Berichtsformat, UNFCCC)</skos:prefLabel><skos:prefLabel xml:lang="en">Source sectors for greenhouse gas emissions (Common reporting format, UNFCCC)</skos:prefLabel><skos:prefLabel xml:lang="fr">Secteurs source des émissions de gaz à effet de serre atmosphériques (Cadre uniformisé de présentation des rapports, UNFCCC)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=THS_T"><skos:prefLabel xml:lang="de">Tausend Tonnen</skos:prefLabel><skos:prefLabel xml:lang="en">Thousand tonnes</skos:prefLabel><skos:prefLabel xml:lang="fr">Mille tonnes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=T_HAB"><skos:prefLabel xml:lang="de">Tonnen pro Kopf</skos:prefLabel><skos:prefLabel xml:lang="en">Tonnes per capita</skos:prefLabel><skos:prefLabel xml:lang="fr">Tonnes par personne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:abou