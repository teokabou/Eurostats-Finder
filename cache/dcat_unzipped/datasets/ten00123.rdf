<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/ten00123"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-04-08</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Energiebilanz</dcat:keyword><dcat:keyword  xml:lang="en">Energy balance</dcat:keyword><dcat:keyword  xml:lang="fr">Bilan énergétique</dcat:keyword><dcat:keyword  xml:lang="de">Standardisierte internationale Klassifikation der Energieprodukte (SIEC)</dcat:keyword><dcat:keyword  xml:lang="en">Standard international energy product classification (SIEC)</dcat:keyword><dcat:keyword  xml:lang="fr">Classification internationale standard des produits de l&apos;énergie (SIEC)</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Final energy consumption by product</dct:title><dct:description xml:lang="en">&lt;p&gt;Energy consumption of end-users, such as industry, transport, households, services and agriculture, by energy product (according to the Standard International Energy product Classification - SIEC). Expressed in thousand tonnes of oil equivalent. Excludes (1) consumption of the energy sector itself and losses occurring during transformation and distribution of energy, (2) all non-energy use of energy carriers (e.g. natural gas used for producing chemicals, oil based lubricants, bitumen used for road surface), (3) quantities delivered to international aviation and international marine bunkers.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Consommation finale d&apos;énergie par produit</dct:title><dct:description xml:lang="fr">&lt;p&gt;Consommation d&apos;énergie des utilisateurs finaux, tels que l&apos;industrie, les transports, les ménages, les services et l&apos;agriculture, par produit énergétique (selon la Classification internationale standard des produits de l&apos;énergie - SIEC). Exprimée en milliers de tonnes équivalent pétrole. Exclut (1) la consommation du secteur énergétique lui-même et les pertes survenant lors de la transformation et de la distribution de l&apos;énergie, (2) toute utilisation non énergétique des vecteurs énergétiques (par exemple, le gaz naturel utilisé pour la production de produits chimiques, les lubrifiants à base de pétrole, le bitume utilisé pour le revêtement des routes), (3) les quantités livrées à l&apos;aviation internationale et aux soutes maritimes internationales.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Energieendverbrauch nach Produkt</dct:title><dct:description xml:lang="de">&lt;p&gt;Energetischer Verbrauch der Endverbraucher wie Industrie, Verkehr, Haushalte, Dienstleistungen und Landwirtschaft nach Energieprodukten (gemäß der Standardisierten internationalen Klassifikation der Energieprodukte -SIEC). Ausgedrückt in Tausend Tonnen Rohöleinheiten. Ausgeschlossen sind (1) der Verbrauch des Energiesektors selbst und Verluste bei der Umwandlung und Verteilung von Energie, (2) die gesamte nicht-energetische Nutzung von Energieträgern (z. B. Erdgas zur Herstellung von Chemikalien, Schmierstoffe auf Ölbasis, Bitumen für Straßenbeläge) und (3) die an den internationalen Flug- und Schiffsverkehr gelieferten Mengen.&lt;/p&gt;</dct:description><dct:identifier>ten00123</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/ten00123"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.e