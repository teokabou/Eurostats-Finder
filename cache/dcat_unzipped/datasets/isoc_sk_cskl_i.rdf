<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_sk_cskl_i"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-03-27</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Individuals&apos; level of computer skills (2003-2019)</dct:title><dct:description xml:lang="en">Individuals&apos; level of computer skills (2003-2019)</dct:description><dct:title xml:lang="fr">Compétences en informatique des particuliers (2003-2019)</dct:title><dct:description xml:lang="fr">Compétences en informatique des particuliers (2003-2019)</dct:description><dct:title xml:lang="de">Niveau der Computerkenntnisse von Einzelpersonen (2003-2019)</dct:title><dct:description xml:lang="de">Niveau der Computerkenntnisse von Einzelpersonen (2003-2019)</dct:description><dct:identifier>isoc_sk_cskl_i</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_sk_cskl_i"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_C0"><skos:prefLabel xml:lang="de">Personen, die keine der aufgelisteten computerbezogenen Aktivitäten ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have not done any of the mentioned computer activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui n&apos;ont effectué aucune des activités mentionnées liées à l&apos;informatique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CANY"><skos:prefLabel xml:lang="de">Personen, die mindestens eine Computer Tätigkeit ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have done at least one computer activity</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont effectué au moins une des activités informatiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCONF"><skos:prefLabel xml:lang="de">Personen, die Softwareeinstellungen, einschließlich Betriebssystem oder Sicherheitssoftware geändert haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who changed the settings of any software, including operational system or security programs (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont modifié des paramètres de logiciels, y compris des systèmes d&apos;exploitation et des logiciels de sécurité (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCPPS"><skos:prefLabel xml:lang="de">Personen, die kopieren, ausschneiden oder einfügen verwendet haben, um Informationen am Bildschirm zu vervielfachen oder zu verschieben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have used copy or cut and paste tools to duplicate or move information on screen</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont utilisé copier ou couper-coller pour reproduire ou pour Déplacer des informations sur l&apos;écran</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCPY"><skos:prefLabel xml:lang="de">Personen, die eine Datei oder einen Ordner kopiert oder verschoben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have copied or moved a file or folder</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont copié ou Déplacé un fichier ou un répertoire</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CEPVA"><skos:prefLabel xml:lang="de">Personen, die Software verwendet haben, um Fotos, Videos oder Audio-Dateien zu bearbeiten (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who used software to edit photos, video or audio files (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont utilisé un logiciel pour modifier des photos, des fichiers vidéo ou audio (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CGCONF"><skos:prefLabel xml:lang="de">Personen, die Einstellungen von Softwareanwendungen (mit Ausnahme von Internet-Browsern) geändert oder überprüft haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have modified or verified the configuration parameters of software applications (except internet browsers) (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont modifié ou vérifié les paramètres de configuration d&apos;un logiciel (hors navigation Internet) (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CINS"><skos:prefLabel xml:lang="de">Personen, die neue Geräte (z. B. einen Drucker oder ein Modem) angeschlossen und installiert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have connected and installed new devices, eg a printer or a modem</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont raccordé et installé de nouveaux appareils, par exemple une imprimante ou un modem</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CINSAPP"><skos:prefLabel xml:lang="de">Personen, die Software oder Apps installiert haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who installed software or applications (apps) (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont installé des logiciels ou des applications (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CINSOS"><skos:prefLabel xml:lang="de">Personen, die ein neues Betriebssystem installiert oder ein altes ersetzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have installed a new or replaced an old operating system</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont installé un nouveau système d&apos;exploitation ou remplacé un ancien</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFCOM"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend für die Kommunikation über das Internet mit Verwandten, Freunden oder Kollegen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient to communicate with relatives, friends, colleagues over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes pour communiquer via l&apos;internet avec la famille, les amis ou les collègues</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFCOMNA"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend für die Kommunikation über das Internet mit Verwandten, Freunden oder Kollegen: nicht zutreffend</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient to communicate with relatives, friends, colleagues over the internet: not applicable</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes pour communiquer via l&apos;internet avec la famille, les amis ou les collègues: non concernés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFCOMX"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind nicht ausreichend für die Kommunikation über das Internet mit Verwandten, Freunden oder Kollegen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills not to be sufficient to communicate with relatives, friends, colleagues over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet insuffisantes pour communiquer via l&apos;internet avec la famille, les amis ou les collègues</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFJOB"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend um im nächsten Jahr auf Arbeitssuche zu gehen / einen Jobwechsel anzustreben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient if they were to look for a job or change job within a year</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes s&apos;ils devraient chercher du travail ou changer de travail dans l&apos;année qui suit</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFJOBNA"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend um im nächsten Jahr auf Arbeitssuche zu gehen / einen Jobwechsel anzustreben: nicht zutreffend</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient if they were to look for a job or change job within a year: not applicable</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes s&apos;ils devraient chercher du travail ou changer de travail dans l&apos;année qui suit: non concernés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFJOBX"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind nicht ausreichend um im nächsten Jahr auf Arbeitssuche zu gehen / einen Jobwechsel anzustreben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills not to be sufficient if they were to look for a job or change job within a year</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet insuffisantes s&apos;ils devraient chercher du travail ou changer de travail dans l&apos;année qui suit</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFPRI"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend für den Schutz persönlicher Daten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient to protect their personal data</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes pour protéger leurs données personnelles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFPRINA"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend für den Schutz persönlicher Daten: nicht zutreffend</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient to protect their personal data: not applicable</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes pour protéger leurs données personnelles: non concernés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFPRIX"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind nicht ausreichend für den Schutz persönlicher Daten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills not to be sufficient to protect their personal data</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet insuffisantes pour protéger leurs données personnelles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFVIR"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend um den privaten Computer vor Viren oder anderen Computerinfektionen zu schützen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient to protect their private computer from virus or other computer infection</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes pour protéger leur ordinateur des virus ou autres infections</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFVIRNA"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind ausreichend um den privaten Computer vor Viren oder anderen Computerinfektionen zu schützen: nicht zutreffend</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills to be sufficient to protect their private computer from virus or other computer infection: not applicable</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet suffisantes pour protéger leur ordinateur des virus ou autres infections: non concernés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CISK_SFVIRX"><skos:prefLabel xml:lang="de">Derzeitige Computer- oder Internetkenntnisse sind nicht ausreichend um den privaten Computer vor Viren oder anderen Computerinfektionen zu schützen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their current computer or internet skills not to be sufficient to protect their private computer from virus or other computer infection</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques ou sur l&apos;internet insuffisantes pour protéger leur ordinateur des virus ou autres infections</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CLAN"><skos:prefLabel xml:lang="de">Personen, die einen Computer an ein lokales Netzwerk (LAN) angeschlossen haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have connected computers to a local area network</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont connecté des ordinateurs à un réseau</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CLAN_HI"><skos:prefLabel xml:lang="de">Personen, die einen Computer an ein lokales Netzwerk angeschlossen sowie 5 oder 6 der computerbezogenen Aktivitäten ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have connected computers to a local area network and carried out 5 or 6 of the computer related activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont connecté des ordinateurs à un réseau et qui ont effectué 5 ou 6 des activités liées à l&apos;informatique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CMS"><skos:prefLabel xml:lang="de">Personen, die eine Maus verwendet haben, um Programme wie z.B. einen Internet-Browser oder eine Textverarbeitung zu starten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have used a mouse to launch programs such as an internet browser or word processor</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont utilisé une souris pour lancer des programmes tels qu&apos;un navigateur Internet ou un traitement de texte</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CNO"><skos:prefLabel xml:lang="de">Personen, die nie einen Computer benutzt haben oder die keine der aufgeführten Tätigkeiten durchgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have never used a computer or have not done any of the listed computer activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui n&apos;ont jamais utilisé un ordinateur ou n&apos;ont fait aucune des activités informatiques listées</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CPRES"><skos:prefLabel xml:lang="de">Personen, die Präsentationen (z.B. Slides) mit einer Präsentationssoftware erstellt haben, die z.B. Fotos, Klang- und Videodateien oder Diagramme enthalten (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have created electronic presentations with presentation software (e.g. slides), including e.g. images, sound, video or charts (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont créé des présentations sur PowerPoint ou sur un autre logiciel équivalent, en incluant par exemple des images, du sons, des vidéo ou des graphiques (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CPRES1"><skos:prefLabel xml:lang="de">Personen, die Präsentationen oder Dokumente mit Text, Bildern, Tabellen oder Diagrammen erstellt haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have created presentations or documents integrating text, pictures, tables or charts (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont créé des présentations ou des documents contenant du texte, des images, des tableaux ou des graphiques (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CPRG"><skos:prefLabel xml:lang="de">Personen, die unter Verwendung einer Programmiersprache ein Computerprogramm erstellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have written a computer program using a specialised programming language</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont écrit un programme informatique utilisant un langage de programmation spécialisé</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CPRG1"><skos:prefLabel xml:lang="de">Personen, die ein Programms in einer Programmiersprache geschrieben haben (2015-2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have written code in a programming language (2015-2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont écrit un programme en langage informatique (2015-2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSKSF"><skos:prefLabel xml:lang="de">Personen, die ihre Computerkenntnisse als ausreichend einschätzen, falls sie innerhalb eines Jahres eine neue Arbeitsstelle suchen oder eine andere antreten würden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their computer skills to be sufficient if they were to look for a job or change jobs within a year</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques suffisantes s&apos;ils devaient commencer à travailler ou changer de travail dans un Délai d&apos;un an</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSKSFX"><skos:prefLabel xml:lang="de">Personen, die ihre Computerkenntnisse als unzureichend einschätzen, falls sie innerhalb eines Jahres eine neue Arbeitsstelle suchen oder eine andere antreten würden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who judge their computer skills to be insufficient if they were to look for a job or change jobs within a year</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui jugent leur connaissances informatiques insuffisantes s&apos;ils devaient commencer à travailler ou changer de travail dans un Délai d&apos;un an</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSK_HI"><skos:prefLabel xml:lang="de">Personen, die 5 oder 6 der 6 computerbezogenen Aktivitäten ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have carried out 5 or 6 of the 6 computer related activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont effectué 5 ou 6 des 6 activités liées à l&apos;informatique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSK_LO"><skos:prefLabel xml:lang="de">Personen, die 1 oder 2 der 6 computerbezogenen Aktivitäten ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have carried out 1 or 2 of the 6 computer related activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont effectué 1 ou 2 des 6 activités liées à l&apos;informatique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSK_ME"><skos:prefLabel xml:lang="de">Personen, die 3 oder 4 der 6 computerbezogenen Aktivitäten ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have carried out 3 or 4 of the 6 computer related activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont effectué 3 ou 4 des 6 activités liées à l&apos;informatique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSOLV"><skos:prefLabel xml:lang="de">Personen, die Computerprobleme entdeckt und gelöst haben (z.B. wenn ein Computer zu langsam läuft)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have detected and solved computer problems (e.g. computer runs slowly)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont Détecté et résolu des problèmes informatiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSOLV_HI"><skos:prefLabel xml:lang="de">Personen, die Computerprobleme entdeckt und gelöst sowie 5 oder 6 der computerbezogenen Aktivitäten ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have detected and solved computer problems and carried out 5 or 6 of the computer related activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont détecté et résolu des problèmes informatiques et qui ont effectué 5 ou 6 des activités liées à l&apos;informatique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CSUM"><skos:prefLabel xml:lang="de">Personen, die einfache arithmetische Formeln verwendet haben, um Zahlen in einer Exceldatei zu addieren, zu subtrahieren, zu multiplizieren oder zu dividieren</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have used basic arithmetic formulae to add, subtract, multiply or divide figures in a spreadsheet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont utilisé des formules arithmétiques de base pour ajouter, soustraire, multiplier ou diviser des chiffres dans un tableur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CWRD"><skos:prefLabel xml:lang="de">Personen, die Textverarbeitungssoftware genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who used word processing software</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont utilisé un logiciel de traitement de texte</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CXFER"><skos:prefLabel xml:lang="de">Personen, die Dateien zwischen dem Computer und anderen Geräten übertragen haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have transferred files between computer and other devices (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont transféré des fichiers entre l&apos;ordinateur et d&apos;autres périphériques (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CXLS"><skos:prefLabel xml:lang="de">Personen, die Tabellenkalkulationssoftware genutzt haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who used spreadsheet software (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont utilisé un tableur (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CXLSADV"><skos:prefLabel xml:lang="de">Personen, die erweiterte Funktionen zum Aufbereiten und Auswerten von Daten genutzt haben, wie z.B. Sortieren, Filtern, Verwendung von Formeln, Erstellen von Grafiken (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who used spreadsheet&apos;s advanced functions to organise and analyse data, such as sorting, filtering, using formulas, creating charts (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont utilisé des fonctions avancées d&apos;un tableur comme le tri, les filtres, les formules ou la création de graphiques pour organiser et analyser des données (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CZIP"><skos:prefLabel xml:lang="de">Personen, die Dateien komprimiert haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have compressed files</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont comprimé des fichiers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_CEVR"><skos:prefLabel xml:lang="de">Prozent der Personen, die jemals einen Computer benutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used a computer, ever</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant déjà utilisé un ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_CIANY"><skos:prefLabel xml:lang="de">Prozent der Personen, die mindestens eine der angeführten Computer- oder Internetaktivitäten ausgeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who have done at least one of the listed computer or internet activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant fait au moins une des activités informatiques ou l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">279506</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2003-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_sk_cskl_i"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_sk_cskl_i</schema: