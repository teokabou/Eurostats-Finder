<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/dsb_ictiu06"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-04</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Persons using the internet for finding information about goods and services by level of disability (activity limitation)</dct:title><dct:description xml:lang="en">&lt;p&gt;Using the internet to seek information about any household good or service. Examples of goods: books, films, clothes, music, video games, e-learning material, electronic equipment and computer software. Examples of services: banking, financial and health services. This item should not include transactions, e.g. purchases of any goods or services (whether on or offline), although people usually look up information on goods or services before actually buying them. Data refer to the last 3 months before the survey, for private purposes. The data source is the EU survey on the use of ICT in households and by individuals.&lt;/p&gt;</dct:description><dct:title xml:lang="fr">Personnes ayant utilisé internet pour rechercher des informations sur des biens et services par niveau de handicap (restriction d&apos;activité)</dct:title><dct:description xml:lang="fr">&lt;p&gt;Utiliser Internet pour obtenir des informations sur tout bien ou service du ménage. Exemples de produits: livres, films, vêtements, musique, jeux vidéo, matériel d’apprentissage en ligne, matériel électronique et logiciels. Exemples de services: services bancaires, financiers et de santé. Cet élément ne devrait pas inclure les transactions, par exemple les achats de biens ou de services (en ou hors ligne), bien que les gens recherchent généralement des informations sur des biens ou des services avant de les acheter réellement. Les données se réfèrent aux 3 derniers mois avant l&apos;enquête à des fins privées. La source des données est l&apos;enquête de l&apos;UE sur l&apos;utilisation des TIC par les ménages et les personnes.&lt;/p&gt;</dct:description><dct:title xml:lang="de">Personen, die das Internet genutzt haben um Informationen über Waren und Dienstleistungen zu suchen, nach Grad der Behinderung (Aktivitätseinschränkungen)</dct:title><dct:description xml:lang="de">&lt;p&gt;Nutzung des Internets, um Informationen über Haushaltsgegenstände oder -dienstleistungen zu erhalten. Beispiele für Waren: Bücher, Filme, Kleidung, Musik, Videospiele, E-Learning-Material, elektronische Ausrüstung und Computersoftware. Beispiele für Dienstleistungen: Bank-, Finanz- und Gesundheitsdienstleistungen. Diese Position sollte keine Transaktionen umfassen, z.&amp;nbsp;B. Käufe von Waren oder Dienstleistungen (ob online oder offline), obwohl Personen in der Regel vor dem tatsächlichen Kauf Informationen über Waren oder Dienstleistungen suchen. Daten beziehen sich auf die letzten 3 Monaten vor der Erhebung, zu Privatzwecken. Als Datenquelle dient die EU-Erhebung über die Nutzung von IKT in Haushalten und durch Einzelpersonen.&lt;/p&gt;</dct:description><dct:identifier>dsb_ictiu06</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/dsb_ictiu06"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/c