u/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN" > <skos:prefLabel xml:lang="de">Innovationsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Innovation indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;innovation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZECLAS" > <skos:prefLabel xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre de salariés</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/TYPE_INN" > <skos:prefLabel xml:lang="de">Gliederung nach Innovationsart</skos:prefLabel><skos:prefLabel xml:lang="en">Breakdown by type of innovator</skos:prefLabel><skos:prefLabel xml:lang="fr">Ventilation par type d&apos;innovateur</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFCOS_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch zu hohe Innovationskosten wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the innovation costs too high is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles les coûts excessifs liés à l&apos;innovation est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFDEM_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch die Unsicherheit über die Nachfrage nach innovativen Waren oder Dienstleistungen wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which uncertain demand for innovative goods or services is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles l&apos;incertitude de la demande en biens ou services innovants est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFDOM_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch die Marktbeherrschung durch gefestigte Unternehmen wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which markets dominated by established enterprises is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles un marché dominé par des entreprises établies est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFENT_HIGH10"><skos:prefLabel xml:lang="de">Unternehmen, bei denen das Fehlen von finanziellen Mitteln im Unternehmen oder der Gruppe ein sehr wichtiger Hinderungsfaktor für Innovationstätigkeiten ist</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the lack of funds within the enterprise or group is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles un manque de moyens financiers au sein de l&apos;entreprise ou du groupe est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFINFO_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch einen Mangel an Informationen über Märkte wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the lack of information on markets is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles un manque d&apos;informations sur les marchés est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFIT_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch einen Mangel an Informationen über Technik wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the lack of information on technology is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles un manque d&apos;informations sur la technologie est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFOUT_HIGH10"><skos:prefLabel xml:lang="de">Unternehmen, bei denen das Fehlen von finanziellen Mitteln aus Quellen außerhalb des Unternehmens ein sehr wichtiger Hinderungsfaktor für Innovationstätigkeiten ist</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the lack of finance from sources outside the enterprise is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles un manque de moyens financiers en-dehors de l&apos;entreprise ou du groupe est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFPAR_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch Schwierigkeiten, Partner für Innovationszusammenarbeit zu finden, wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the difficulty in finding cooperation partners for innovation is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles une difficulté à trouver des partenaires pour coopérer est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=HFPER_HIGH"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch einen Mangel an qualifizierten Mitarbeitern wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the lack of qualified personnel is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles un manque de personnel qualifié est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=NODEM_YES"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch die fehlende Nachfrage nach Innovationen wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which no need to innovate due to no demand for innovations is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles la dispense d&apos;innover en raison de l&apos;absence de demande pour des innovations est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=NR"><skos:prefLabel xml:lang="de">Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Number</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=PRIOR_YES"><skos:prefLabel xml:lang="de">Unternehmen, deren Innovationstätigkeit durch die Deckung des Innovationsbedarfs durch frühere Innovationen wesentlich behindert wird</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which no need to innovate due to prior innovations is a highly important factor of hampering innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises pour lesquelles la dispense d&apos;innover en raison d&apos;innovations précédentes est un obstacle important aux activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=RT"><skos:prefLabel xml:lang="de">Quote</skos:prefLabel><skos:prefLabel xml:lang="en">Rate</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">173198</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-03-12</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/inn_cis7_ham"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/docume