cept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S01_3"><skos:prefLabel xml:lang="de">Weibliche Direktoren der ISCED-Stufen 2-3 - in % der Gesamtzahl der Direktoren der ISCED-Stufen 2-3</skos:prefLabel><skos:prefLabel xml:lang="en">Women headteachers in ISCED levels 2-3 - as % of total headteachers in ISCED levels 2-3</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes recteurs aux niveaux CITE 2-3 - en % du total des recteurs (CITE 2-3)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S01_4"><skos:prefLabel xml:lang="de">Weibliche Direktoren der ISCED-Stufe 2 - in % der Gesamtzahl der Direktoren der ISCED-Stufe 2</skos:prefLabel><skos:prefLabel xml:lang="en">Women headteachers in ISCED level 2 - as % of total headteachers in ISCED level 2</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes recteurs au niveau CITE 2 - en % du total des recteurs du niveau CITE 2</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S01_5"><skos:prefLabel xml:lang="de">Weibliche Direktoren der ISCED-Stufe 3 - in % der Gesamtzahl der Direktoren der ISCED-Stufe 3</skos:prefLabel><skos:prefLabel xml:lang="en">Women headteachers in ISCED level 3 - as % of total headteachers in ISCED level 3</skos:prefLabel><skos:prefLabel xml:lang="fr">Femmes recteurs au niveau CITE 3 - en % du total des recteurs du niveau CITE 3</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S02_1"><skos:prefLabel xml:lang="de">Lehrer der ISCED-Stufen 1-3, die Voll- und Teilzeit arbeiten - in % der Gesamterwerbsbevölkerung</skos:prefLabel><skos:prefLabel xml:lang="en">Teachers working full time and part time at ISCED level 1-3 - as % of total active population</skos:prefLabel><skos:prefLabel xml:lang="fr">Enseignants travaillant à temps plein et à temps partiel aux niveaux CITE 1-3 - en % de la population active totale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S03_1"><skos:prefLabel xml:lang="de">Lehrer der Primarstufe (ISCED 1), die Teilzeit arbeiten - in % aller Lehrer der ISCED-Stufe 1, die Voll- und Teilzeit arbeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Teachers working part time in primary (ISCED 1) - as % of total full time and part time teachers in ISCED 1</skos:prefLabel><skos:prefLabel xml:lang="fr">Enseignants travaillant à temps partiel au niveau primaire (CITE 1) - en % de l&apos;ensemble des enseignants à temps plein et à temps partiel du niveau CITE 1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S03_2"><skos:prefLabel xml:lang="de">Lehrer der Sekundarstufe I (ISCED 2), die Teilzeit arbeiten - in % aller Lehrer der ISCED-Stufe 2, die Voll- und Teilzeit arbeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Teachers working part time in lower secondary (ISCED 2) - as % of total full time and part time teachers in ISCED 2</skos:prefLabel><skos:prefLabel xml:lang="fr">Enseignants travaillant à temps partiel au niveau secondaire inférieur (CITE 2) - en % de l&apos;ensemble des enseignants à temps plein et à temps partiel du niveau CITE 2</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S03_3"><skos:prefLabel xml:lang="de">Lehrer der Sekundarstufe II (ISCED 3), die Teilzeit arbeiten - in % aller Lehrer der ISCED-Stufe 3, die Voll- und Teilzeit arbeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Teachers working part time in upper secondary (ISCED 3) - as % of total full time and part time teachers at ISCED 3</skos:prefLabel><skos:prefLabel xml:lang="fr">Enseignants travaillant à temps partiel au niveau secondaire supérieur (CITE 3) - en % de l&apos;ensemble des enseignants à temps plein et à temps partiel du niveau CITE 3</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S04_1"><skos:prefLabel xml:lang="de">Lehrer unter 30 Jahren im öffentlichen und privaten Schuldienst der ISCED-Stufe 1 - in % aller Lehrer der ISCED-Stufe 1</skos:prefLabel><skos:prefLabel xml:lang="en">Teachers aged &lt; 30 teaching in public and private at ISCED level 1 - as % of total teachers teaching in ISCED level 1</skos:prefLabel><skos:prefLabel xml:lang="fr">Enseignants âgés de moins de 30 ans dans l&apos;enseignement public et privé du niveau CITE 1 - en % de l&apos;ensemble des enseignants du niveau CITE 1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=S04_2"><skos:prefLabel xml:lang="de">Lehrer im Alter von 30-39 Jahren im öffentlichen und privaten Schuldienst der ISCED-Stufe 1 - in % aller Lehrer der ISCED-Stufe 1</skos:prefLabel><skos:prefLabel xml:lang="en">Teachers aged 30-39 teaching in public and private at ISCED level 1 - as % of total teachers teaching in ISCED level 1</skos:prefLabel><skos:prefLabel xml:lang="fr">Enseignants âgés de 30-39 ans dans l&apos;enseignement public et privé du niveau CITE 1 - en % de l&apos;ensemble des enseignants du niveau CITE 1</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/