imension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires réalisé par des ventes web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_B2BG"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe der Unternehmen an Unternehmen / staatliche Stellen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales - B2B and B2G</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires réalisé par des ventes web - d&apos;entreprise à entreprise et aux autorités publiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_B2C"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe der Unternehmen an Endkunden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales - B2C</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires réalisé par des ventes web - d&apos;entreprise à consommateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_CMP"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe der Unternehmen über Online-Marktplätze</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales via e-commerce marketplaces</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires réalisé par des ventes web - via des places de marché (marketplaces)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_CMPQ"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe der Unternehmen die ausschließlich über Online-Marktplätze verkaufen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales of enterprises which only sell through e-commerce marketplaces</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires des entreprises provenant des ventes sur le Web des entreprises qui vendent uniquement via des places de marché de commerce électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_COWN"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe der Unternehmen über eigene Websites oder Apps</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales via own websites or apps</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires réalisé par des ventes web - via sites web ou appli de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_EU"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe des Unternehmens an Kunden in andere EU-Staaten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales to customers located in other EU countries</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires des entreprises provenant des ventes sur internet à des clients situés dans d&apos;autres pays de l&apos;UE</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_GT1_B2C_GT10WS"><skos:prefLabel xml:lang="de">Web-Verkäufe von Unternehmen, wo diese &gt; 1 % des gesamten Umsatzes und die Web-Verkäufe an Endkunden &gt; 10 % der Web-Verkäufe ausmachen</skos:prefLabel><skos:prefLabel xml:lang="en">B2C web sales of enterprises where web sales &gt; 1% of total turnover and B2C web sales &gt; 10% of the web sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Ventes web des entreprises pour qui les ventes web font &gt; 1 % du chiffre d&apos;affaires total et où les ventes web à des consommateurs finaux font &gt; 10 % des ventes web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_HM"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe des Unternehmens an Kunden im Inland</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales to customers located in the own country</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires des entreprises provenant des ventes sur internet aux clients situés dans leur propre pays</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AWSVAL_WW"><skos:prefLabel xml:lang="de">Umsatz der Web-Verkäufe des Unternehmens an Kunden in Staaten außerhalb der EU</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from web sales to customers located in the rest of the world</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires des entreprises provenant de la vente sur le web à des clients situés dans le reste du monde</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_AXSVAL"><skos:prefLabel xml:lang="de">Umsatz der Verkäufe der Unternehmen über EDI-basierte Systeme</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; turnover from EDI-type sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires réalisé par des ventes de type EDI</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ETURN"><skos:prefLabel xml:lang="de">Umsatz der E-Commerce-Verkäufe der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises&apos; total turnover from e-commerce sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires total des entreprises réalisé par le commerce électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_AWSVAL"><skos:prefLabel xml:lang="de">Prozent des Umsatzes über eine Website</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of web sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage du chiffre d&apos;affaires réalisé via un site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ETURN"><skos:prefLabel xml:lang="de">Prozent des elektronischen Umsatzes</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of turnover from e-commerce</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage du chiffre d&apos;affaires électroniques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_TURN"><skos:prefLabel xml:lang="de">Prozent des Gesamtumsatzes</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of turnover</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage du chiffre d&apos;affaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=T_AWS_CMP_GE20"><skos:prefLabel xml:lang="de">Umsatz von Unternehmen mit Web-Verkäufen über Online-Marktplätze von mindestens 20% ihrer Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover of enterprises where web sales via e-commerce marketplaces are at least 20% of the web sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires des entreprises pour qui les ventes web via places de marché font au moins 20% des ventes web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=T_AWS_GT1_B2C_GT10WS"><skos:prefLabel xml:lang="de">Umsatz von Unternehmen mit Web-Verkäufen &gt; 1 % des gesamten Umsatzes und Web-Verkäufen an Endkunden &gt; 10 % der Web-Verkäufe</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover of enterprises where web sales &gt; 1% of total turnover and B2C web sales &gt; 10% of the web sales</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires des entreprises pour qui les ventes web font &gt; 1 % du chiffre d&apos;affaires total et où les ventes web à des consommateurs finaux font &gt; 10 % des ventes web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7041</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_evals"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_evals</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><fo