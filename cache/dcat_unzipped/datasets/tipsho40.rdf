it of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=I15_Q"><skos:prefLabel xml:lang="de">Vierteljährlicher Index, 2015=100</skos:prefLabel><skos:prefLabel xml:lang="en">Quarterly index, 2015=100</skos:prefLabel><skos:prefLabel xml:lang="fr">Indice trimestriel, 2015=100</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=RCH_A"><skos:prefLabel xml:lang="de">Jährliche Veränderungsrate</skos:prefLabel><skos:prefLabel xml:lang="en">Annual rate of change</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de variation annuel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=RCH_Q"><skos:prefLabel xml:lang="de">Vierteljährliche Veränderungsrate</skos:prefLabel><skos:prefLabel xml:lang="en">Quarterly rate of change</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de variation trimestriel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">78</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/QUARTERLY"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about=