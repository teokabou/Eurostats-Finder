kos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=COUS_YES"><skos:prefLabel xml:lang="de">Unternehmen, die Innovationszusammenarbeit mit einem Partner in den USA betreiben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises engaged in any type of innovation co-operation with a partner in United States</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises coopérant avec un partenaire aux Etas-Unis</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=CO_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=CO_NO"><skos:prefLabel xml:lang="de">Keine Formen der Zusammenarbeit bei Innovationstätigkeiten</skos:prefLabel><skos:prefLabel xml:lang="en">No cooperation arrangements on innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucun accord de coopération portant sur des activités d&apos;innovation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=CO_YES"><skos:prefLabel xml:lang="de">Formen der Zusammenarbeit bei Innovationstätigkeiten</skos:prefLabel><skos:prefLabel xml:lang="en">Cooperation arrangements on innovation activities</skos:prefLabel><skos:prefLabel xml:lang="fr">Accords de coopération portant sur des activités d&apos;innovation</skos:prefLabel></skos:Concept