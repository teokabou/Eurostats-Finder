<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_ec_inb"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-03-27</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Perceived barriers to buying/ordering over the internet (2002-2019)</dct:title><dct:description xml:lang="en">Perceived barriers to buying/ordering over the internet (2002-2019)</dct:description><dct:title xml:lang="fr">Obstacles perçus à l&apos;achat/commande sur l&apos;internet (2002-2019)</dct:title><dct:description xml:lang="fr">Obstacles perçus à l&apos;achat/commande sur l&apos;internet (2002-2019)</dct:description><dct:title xml:lang="de">Subjektive Wahrnehmung von Hindernissen, die einem Kauf oder einer Bestellung über das Internet im Wege stehen (2002-2019)</dct:title><dct:description xml:lang="de">Subjektive Wahrnehmung von Hindernissen, die einem Kauf oder einer Bestellung über das Internet im Wege stehen (2002-2019)</dct:description><dct:identifier>isoc_ec_inb</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_inb"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBCARD"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten keine Waren oder Dienstleistungen über das Internet bestellt haben, weil sie keine Zahlungskarte besitzen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because they don&apos;t have a payment card</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet parce qu&apos;ils ne possèdent pas de carte de crédit</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBDNS"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten keine Waren oder Dienstleistungen über das Internet bestellt haben, weil ausländische Händler nicht in ihr Land verkaufen (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because the foreign retailer did not sell in my country (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet, du fait que des vendeurs étrangers ne vendent pas à destination de leurs pays (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBEXP"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten keine Waren oder Dienstleistungen über das Internet bestellt haben, weil sie diese zu teuer fanden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because it&apos;s too expensive</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison des prix trop élevés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBIDF"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen der Schwierigkeiten wichtige Informationen auf der Webseite über Waren und Dienstleistungen zu finden, keine Waren oder Dienstleistungen über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t bought / ordered goods or services over the internet for their own private use, because: Relevant information about goods and services difficult to find on website</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de difficultés à trouver des informations relatives aux biens et aux services sur le site web</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBNEC"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten keine Waren oder Dienstleistungen über das Internet bestellt haben, weil sie dies nicht nötig fanden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because they have no need</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet parce qu&apos;ils n&apos;en avaient pas besoin</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBOTH"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten aus anderen Gründen keine Waren oder Dienstleistungen über das Internet bestellt haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because of other reasons (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet pour d&apos;autres raisons (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBPRC"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen Datenschutzbedenken (Besorgnissen hinsichtlich der Weitergabe persönlicher Daten über das Internet) keine Waren oder Dienstleistungen über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t bought / ordered goods or services over the internet for their own private use, because: Privacy concerns</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de préoccupations liées au respect de la vie privée (crainte de communiquer des données à caractère personnel sur internet)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBPRV"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen Datenschutzbedenken (Besorgnissen hinsichtlich der Weitergabe persönlicher Daten über das Internet) keine Waren oder Dienstleistungen über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because of privacy concerns, they are worried about giving personal details over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de préoccupations liées au respect de la vie privée (crainte de communiquer des données à caractère personnel sur internet)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBPSC"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen Sicherheitsbedenken bei der Bezahlung keine Waren oder Dienstleistungen über das Internet bestellt haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t bought / ordered goods or services over the internet for their own private use, because: Payment security concerns (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de préoccupations liées à la sécurité des paiements (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBREC"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen Problemen mit der Hauszustellung der bestellten Waren keine Waren oder Dienstleistungen über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because of problems receiving the ordered goods at home</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de problèmes liés à la réception de la commande à domicile</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSEC"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen Sicherheitsbedenken (Besorgnissen hinsichtlich der Weitergabe ihrer Kreditkartendaten über das Internet) keine Waren oder Dienstleistungen über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because of security concerns, they are worried about giving credit card details over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de préoccupations liées à la sécurité (crainte de communiquer les informations relatives à leur carte de crédit sur internet)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSEPR"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen Besorgnissen hinsichtlich der Weitergabe ihrer Kreditkartendaten oder persönlichen Daten über das Internet keine Waren oder Dienstleistungen über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because I&apos;m worried about giving credit card or personal details over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet par crainte de communiquer les informations relatives à leur carte de crédit ou des données à caractère personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSHAB"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten keine Waren oder Dienstleistungen über das Internet bestellt haben, weil sie lieber persönlich im Geschäft einkaufen bzw. die Ware sehen möchten, aus Treue zum Geschäft oder aus Macht der Gewohnheit (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because they prefer to shop in person, they like to see product, loyalty to shops or force of habit (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet parce qu&apos;ils préfèrent acheter en personne et voir le produit, par habitude ou par fidélité à des magasins (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSKL"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen mangelnder Kenntnisse keine Waren oder Dienstleistungen über das Internet bestellt haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because they lack the necessary skills (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet parce qu&apos;ils ne possèdent pas les compétences requises à cette fin  (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSLOW"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten keine Waren oder Dienstleistungen über das Internet bestellt haben, weil ihre Internetverbindung zu langsam ist</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because the speed of the internet connection is too low</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet parce que leur connexion à l&apos;internet est trop lente</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSPD"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen zu langer Lieferzeiten keine Waren oder Dienstleistungen über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because of too long delivery times</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de la longueur des délais de livraison</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBSR"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen zu langer Lieferzeiten oder Problemen mit der Hauszustellung der bestellten Waren keine Waren oder Dienstleistungen über das Internet bestellt haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because of too long delivery times or because of the problematic to receive the ordered goods at home (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet en raison de la longueur des délais de livraison ou de problèmes liés à la réception de la commande à domicile (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_NBTRCM"><skos:prefLabel xml:lang="de">Personen, die in den letzten 12 Monaten wegen mangelnden Vertrauens im Zusammenhang mit der Zustellung oder Rücksendung der Waren oder Bedenken wegen Beschwerden/Rechtsmitteln keine Waren oder Dienstleistungen über das Internet bestellt haben (bis 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who, in the last 12 months, haven&apos;t ordered goods or services over the internet, because of trust concerns about receiving or returning goods, complaint / redress concerns (until 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui, au cours des 12 derniers mois, n&apos;ont pas commandé de biens ou de services sur l&apos;internet par manque de confiance quant à la réception ou au retour des marchandises et en raison de préoccupations liées aux réclamations/recours (jusqu&apos;en 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_BMT12X"><skos:prefLabel xml:lang="de">Prozent der Personen, die vor mehr als einem Jahr oder noch nie Waren oder Dienstleistungen für den privaten Gebrauch über das Internet bestellt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who ordered goods or services, over the internet, for private use, more than a year ago or who never did</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant commandé des biens ou des services sur l&apos;internet pour leur usage privé il y a plus d&apos;un an ou n&apos;ayant jamais commandé</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">122674</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2002-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_inb"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_inb</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_inb"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_i_esms.sdmx.zip"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) SDMX</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_inb"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_i_esms.sdmx.zip]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/XML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/databrowser/view/isoc_ec_inb/default/table"><dct:title xml:lang="en">Table, graphs and map visualizations are also available.</dct:title><dct:title xml:lang="fr">Des visualisations sous forme de tableau, graphique et carte géographique sont aussi disponibles.</dct:title><dct:title xml:lang="de">Tabellen, Grafiken und geografische Darstellungen sind ebenfalls verfügbar.</dct:title><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/isoc_ec_inb/default/table"/><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/VISUALIZATION"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/></dcat:Distribution></dcat:distribution><dcat: