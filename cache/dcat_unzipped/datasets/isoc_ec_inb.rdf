aType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dcat:byteSize>1652098</dcat:byteSize><spdx:checksum> <spdx:Checksum> <spdx:algorithm rdf:resource="http://spdx.org/rdf/terms#checksumAlgorithm_sha256"/><spdx:checksumValue>1612bf197e2c4393c189d3aecbcbcf6b2f38bdee8bf53539ba41b10691b3447f</spdx:checksumValue> </spdx:Checksum> </spdx:checksum></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/isoc_ec_inb?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"><dct:title xml:lang="en">Download metadata in SDMX 2.1 format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/isoc_ec_inb?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/dataflow/ESTAT/isoc_ec_inb?references=descendants&amp;detail=referencepartial&amp;format=sdmx_2.1_generic&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/XML"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dcat:byteSize>13447</dcat:byteSize><spdx:checksum> <spdx:Checksum> <spdx:algorithm rdf:resource="http://spdx.org/rdf/terms#checksumAlgorithm_sha256"/><spdx:checksumValue>a8515a217dfb5922742e8679b47348d13870fee1902dc5d09e3f38bc10adb72d</spdx:checksumValue> </spdx:Checksum> </spdx:checksum></dcat:Distribution></dcat:distribution><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/web/user-guides/data-browser"><dct:title xml:lang="en">Eurostat - European statistics : online help</dct:title><dct:title xml:lang="fr">Eurostat - Statistiques européennes: aide en ligne</dct:title><dct:title xml:lang="de">Eurostat - Europäische Statistiken: Online Hilfe</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_ec_inb"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/web/user-guides/data-browser</schema:url><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/></dct:type></foaf:Document></foaf:page><dct:publisher><foaf:Agent rdf:about="http://publications.europa.eu/resource/authority/corporate-body/ESTAT"/></dct:publisher><dcat:contactPoint><v:Kind rdf:about="http://www.w3.org/2006/vcard/ns#Kind/9b4bd10b-2989-4f9e-9679-d871d5a6927f"><v:hasAddress><v:Address rdf:about="http://www.w3.org/2006/vcard/ns#Address/447b21f5-3d1a-4cf4-a1b8-55520754099b"><v:street-address>Joseph Bech building, 5 Rue Alphonse Weicker, L-2721 Luxembourg</v:street-address></v:Address></v:hasAddress><v:hasTelephone><v:Voice rdf:about="http://data.europa.eu/88u/voice/+352430136789"><v:hasValue rdf:resource="tel:+352430136789"/></v:Voice></v:hasTelephone><v:organisation-name>Eurostat, the statistical office of the European Union</v:organisation-name><v:hasURL><foaf:Document rdf:about="http://ec.europa.eu/eurostat/help/support"><foaf:topic rdf:resource="file:///usr/verticles/"/><schema:url>http://ec.europa.eu/eurostat/help/support</schema:url></foaf:Document></v:hasURL></v:Kind></dcat:contactPoint><adms:identifier xmlns:adms="http://www.w3.org/ns/adms#" xmlns:skos="http://www.w3.org/2004/02/skos/core.html" xmlns:dct="http://purl.org/dc/terms/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><adms:Identifier rdf:about="https://doi.org/10.2908/ISOC_EC_INB"><skos:notation rdf:datatype="http://purl.org/spar/datacite/doi">10.2908/ISOC_EC_INB</skos:notation><dct:creator rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/ESTAT"/><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-01-19</dct:issued></adms:Identifier></adms:identifier></dcat:Dataset></rdf:RDF>