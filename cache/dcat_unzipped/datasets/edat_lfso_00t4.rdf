on> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED" > <skos:prefLabel xml:lang="de">Bildungsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Education indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;éducation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR1_1"><skos:prefLabel xml:lang="de">Odds-ratio der Absolventen im Tertiärunterricht/Jugendliche deren Eltern die ISCED-Stufe 5-6 erreicht haben/ Jugendliche deren Eltern die ISCED-Stufe 1-2 erreicht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Odds ratios of graduating from tertiary education/Young people with parent with ISCED 5-6/Young people with parents with ISCED 1-2</skos:prefLabel><skos:prefLabel xml:lang="fr">Rapport des cotes des diplômés de l&apos;enseignement post-secondaire/Jeunes gens dont les parents ont atteint le niveau CITE 5-6/Jeunes gens dont les parents ont atteint le niveau CITE 1-2</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR1_2"><skos:prefLabel xml:lang="de">Odds-ratio der Absolventen im Tertiärunterricht/Jugendliche deren Eltern die ISCED-Stufe 3-4 erreicht haben/ Jugendliche deren Eltern die ISCED-Stufe 1-2 erreicht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Odds ratios of graduating from tertiary education/Young people with parent with ISCED 3-4/Young people with parents with ISCED 1-2</skos:prefLabel><skos:prefLabel xml:lang="fr">Rapport des cotes des diplômés de l&apos;enseignement post-secondaire/Jeunes gens dont les parents ont atteint le niveau CITE 3-4/Jeunes gens dont les parents ont atteint le niveau CITE 1-2</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR2_1"><skos:prefLabel xml:lang="de">Durchschnittlicher Zeitraum vor Annahme einer bedeutenden Arbeitsstelle nach Bildungsstufe ISCED 1-2 der Eltern</skos:prefLabel><skos:prefLabel xml:lang="en">Average time to enter first significant job by parent&apos;s education ISCED1-2</skos:prefLabel><skos:prefLabel xml:lang="fr">Délai moyen d&apos;obtention d&apos;un premier emploi significatif par niveau d&apos;éducation parentale de CITE 1-2</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR2_2"><skos:prefLabel xml:lang="de">Durchschnittlicher Zeitraum vor Annahme einer bedeutenden Arbeitsstelle nach Bildungsstufe ISCED 3-4 der Eltern</skos:prefLabel><skos:prefLabel xml:lang="en">Average time to enter first significant job by parent&apos;s education ISCED3-4</skos:prefLabel><skos:prefLabel xml:lang="fr">Délai moyen d&apos;obtention d&apos;un premier emploi significatif par niveau d&apos;éducation parentale de CITE 3-4</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR2_3"><skos:prefLabel xml:lang="de">Durchschnittlicher Zeitraum vor Annahme einer bedeutenden Arbeitsstelle nach Bildungsstufe ISCED 5-6 der Eltern</skos:prefLabel><skos:prefLabel xml:lang="en">Average time to enter first significant job by parent&apos;s education ISCED5-6</skos:prefLabel><skos:prefLabel xml:lang="fr">Délai moyen d&apos;obtention d&apos;un premier emploi significatif par niveau d&apos;éducation parentale de CITE 5-6</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR3_1"><skos:prefLabel xml:lang="de">Durchschnittliche Berufsstellung von Jugendlichen deren Eltern unterschiedliche Bildungsabschlüsse der ISCED-Stufe 1-2 erreicht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Average occupational status of young people with parents with different educational attainment ISCED 1-2</skos:prefLabel><skos:prefLabel xml:lang="fr">Statut professionnel moyen des jeunes gens dont les parents ont atteint différents niveaux d&apos;éducation de CITE 1-2</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR3_2"><skos:prefLabel xml:lang="de">Durchschnittliche Berufsstellung von Jugendlichen deren Eltern unterschiedliche Bildungsabschlüsse der ISCED-Stufe 3-4 erreicht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Average occupational status of young people with parents with different educational attainment ISCED 3-4</skos:prefLabel><skos:prefLabel xml:lang="fr">Statut professionnel moyen des jeunes gens dont les parents ont atteint différents niveaux d&apos;éducation de CITE 3-4</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR3_3"><skos:prefLabel xml:lang="de">Durschnittliche Berufsstellung von Jugendlichen deren Eltern unterschiedliche Bildungsabschlüsse der ISCED-Stufe 5-6 erreicht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Average occupational status of young people with parents with different educational attainment ISCED 5-6</skos:prefLabel><skos:prefLabel xml:lang="fr">Statut professionnel moyen des jeunes gens dont les parents ont atteint différents niveaux d&apos;éducation de CITE 5-6</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_ED?code=PR3_4"><skos:prefLabel xml:lang="de">Durschnittliche Berufsstellung insgesamt von Jugendlichen deren Eltern unterschiedliche Bildungsabschlüsse erreicht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Total average occupational status of young people with parents with different educational attainment</skos:prefLabel><skos:prefLabel xml:lang="fr">Statut professionnel moyen total des jeunes gens dont les parents ont atteint différents niveaux d&apos;éducation</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">108</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/JUST" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/HEAL" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications