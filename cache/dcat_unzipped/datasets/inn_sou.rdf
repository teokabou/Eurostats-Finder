out="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SSUP_LOW"><skos:prefLabel xml:lang="de">Geringe Nutzung von Innovationsquellen der Lieferanten von Ausrüstung, Rohstoffen, Bauteilen oder Software</skos:prefLabel><skos:prefLabel xml:lang="en">Low use of Sources for innovation from Suppliers of equipment, materials, etc.</skos:prefLabel><skos:prefLabel xml:lang="fr">Faible utilisation des sources d&apos;information pour des projets d&apos;innovation provenant des fournisseurs d&apos;équipements, de matériel, etc.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SSUP_MED"><skos:prefLabel xml:lang="de">Mittelintensive Nutzung von Innovationsquellen der Lieferanten von Ausrüstung, Rohstoffen, Bauteilen usw.</skos:prefLabel><skos:prefLabel xml:lang="en">Medium use of Sources for innovation from Suppliers of equipment, materials, etc.</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation modérée des sources d&apos;information pour des projets d&apos;innovation provenant des fournisseurs d&apos;équipements, de matériel, etc.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SSUP_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SSUP_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen der Lieferanten von Ausrüstung, Rohstoffen, Bauteilen usw.</skos:prefLabel><skos