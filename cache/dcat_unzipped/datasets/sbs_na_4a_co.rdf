a.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91230"><skos:prefLabel xml:lang="de">Arbeitskosten pro gearbeiteter Stunde der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Labour cost per hour worked by employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Coût de la main d&apos;oeuvre par heure travaillée par les salariés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91275"><skos:prefLabel xml:lang="de">Anteil der Lohn- und Gehaltsempfänger an den Beschäftigten - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Share of employees in persons employed - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des salariés dans le nombre de personnes occupées - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91290"><skos:prefLabel xml:lang="de">Wachstumsrate der Beschäftigung - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Growth rate of employment - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Taux de croissance de l&apos;emploi - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91310"><skos:prefLabel xml:lang="de">Anteil des Arbeitgebers an den Sozialabgaben als Prozentanteil an Personalaufwendungen - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Employer&apos;s social charges as a percentage of personnel costs - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des charges sociales des employeurs en pourcentage des dépenses de personnel - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept r