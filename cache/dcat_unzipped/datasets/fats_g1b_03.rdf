kos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91121"><skos:prefLabel xml:lang="de">Einfach lohnbereinigte Arbeitsproduktivität (bruttowertschöpfung geteilt durch Personalkosten) - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Simple wage adjusted labour productivity (gross value added by personnel costs) - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">productivité simple du travail ajustée par les salaires (valeur ajoutée brute par coût de personnel) - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V91210"><skos:prefLabel xml:lang="de">Durchschnittliche Personalkosten (Personalkosten je Beschäftigten) - Tausend euro</skos:prefLabel><skos:prefLabel xml:lang="en">Average personnel costs (personnel costs per employee) - thousand euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Coûts moyens de personnel (coûts de personnel par salarié - milliers d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V92100"><skos:prefLabel xml:lang="de">Beschäftigten pro Unternehmen - Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Persons employed per enterprise - number</skos:prefLabel><skos:prefLabel xml:lang="fr">Personnes occupées par entreprise - nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V92102"><skos:prefLabel xml:lang="de">Bruttowertschöpfung zu Faktorkosten pro Unternehmen - Tausend euro</skos:prefLabel><skos:prefLabel xml:lang="en">Value added at factor cost per enterprise - thousand euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Valeur ajoutée au coût des facteurs par entreprise - milliers d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V92110"><skos:prefLabel xml:lang="de">Brutto-betrieblicher Überschuß/Umsatz (Brutto-Betriebsrate) - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Gross operating surplus/turnover (gross operating rate) - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Excédent brut d&apos;exploitation/Chiffre d&apos;affaires (taux brut d&apos;exploitation) - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V94414"><skos:prefLabel xml:lang="de">Investitionen pro beschäftigter Person - Tausend euro</skos:prefLabel><skos:prefLabel xml:lang="en">Investment per person employed - thousands euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Investissements par personne occupée - milliers d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V95110"><skos:prefLabel xml:lang="de">Anteil der Ausgaben für Forschung und Entwicklung an Bruttowertschöpfung - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Share of R&amp;D expenditure in value added - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part des dépenses de R&amp;D dans la valeur ajoutée - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_SB?code=V95120"><skos:prefLabel xml:lang="de">Anteil der Beschäftigung in Forschung und Entwicklung an der Gesamtbeschäftigtenzahl - Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Share of R&amp;D employment in the number of persons employed - percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Part de l&apos;emploi de R&amp;D dans le nombre de personnes occupées - pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">101060</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-07-08</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2003-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2007-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/fats_g1b_03"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/fats_g1b_03</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/fats_sims.htm"><dct:title xml:lang="en">ESMS metadata 