semination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=DEPRATIO1"><skos:prefLabel xml:lang="de">Altersabhängigkeitsquotient, 1. Variante (Bevölkerung von 0 bis 14 Jahren und von 65 Jahren und mehr bezogen auf die Bevölkerung von 15 bis 64 Jahren)</skos:prefLabel><skos:prefLabel xml:lang="en">Age dependency ratio, 1st variant (population 0 to 14 years and 65 years or over to population 15 to 64 years)</skos:prefLabel><skos:prefLabel xml:lang="fr">Rapport de dépendance selon l&apos;âge, 1ère variante (population de 0 à 14 ans et 65 ans ou plus relativement à la population de 15 à 64 ans)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=DEPRATIO2"><skos:prefLabel xml:lang="de">Altersabhängigkeitsquotient, 2. Variante (Bevölkerung von 0 bis 19 Jahren und von 60 Jahren und mehr bezogen auf die Bevölkerung von 20 bis 59 Jahren)</skos:prefLabel><skos:prefLabel xml:lang="en">Age dependency ratio, 2nd variant (population 0 to 19 years and 60 years or over to population 20 to 59 years)</skos:prefLabel><skos:prefLabel xml:lang="fr">Rapport de dépendance selon l&apos;âge, 2ème variante (population de 0 à 19 ans et 60 ans ou plus relativement à la population de 20 à 59 ans)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_DE?code=DEPRATIO3"><skos:prefLabel xml:lang="de">Altersabhängigkeitsquotient, 3. Variante (Bevölkerung von 0 bis 19 Jahren und von 65 Jahren und mehr bezogen auf die Bevölkerung von 20 bis 64 Jahren)</skos:prefLabel><skos:prefLabel xml:lang="en">Age dependency ratio, 3rd variant (population 0 to 19 years and 65 years or over to population 20 to 64 years)<