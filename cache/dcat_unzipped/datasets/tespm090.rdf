<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/tespm090"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-05-02</dct:issued><dcat:keyword  xml:lang="de">Altersklasse</dcat:keyword><dcat:keyword  xml:lang="en">Age class</dcat:keyword><dcat:keyword  xml:lang="fr">Classe d&apos;âge</dcat:keyword><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Geschlecht</dcat:keyword><dcat:keyword  xml:lang="en">Sex</dcat:keyword><dcat:keyword  xml:lang="fr">Sexe</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">At risk of poverty or social exclusion rate for elderly (65+)</dct:title><dct:description xml:lang="en">The sum of elderly (65+) who are: at-risk-of-poverty or severely materially deprived or living in (quasi-)jobless households (i.e. with very low work intensity) as a share of the total population in the same age group.</dct:description><dct:title xml:lang="fr">Personnes agées (65+) en risque de pauvreté ou d&apos;exclusion sociale</dct:title><dct:description xml:lang="fr">Cet indicateur mesure la proportion (comme part de la population totale dans le même âge groupe) de personnes âgées (65 ans et plus) qui sont: ou à risque de pauvreté, ou en situation de privation matérielle grave, ou qui vivent dans des ménages à très faible intensité de travail.</dct:description><dct:title xml:lang="de">Quote der von Armut oder sozialer Ausgrenzung bedrohten älteren Menschen (65 +)</dct:title><dct:description xml:lang="de">Anzahl der älteren Menschen (65 +), für die zutrifft: Armutsgefährdung oder erhebliche materielle Deprivation oder Leben in (Quasi-) Erwerbslosenhaushalten (d. h. mit sehr geringer Erwerbsintensität), als Anteil an der Gesamtbevölkerung in derselben Altersgruppe.</dct:description><dct:identifier>tespm090</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/tespm090"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><