skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCEW"><skos:prefLabel xml:lang="de">Personen, die beruflich andere computergesteuerte Geräte oder Maschinen (wie in Produktions-, in Beförderungsanlagen oder in Fahrzeugen) verwendeten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used other computerized equipment or machinery such as those used in production lines, transportation or other services at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail utilisé d&apos;autres équipements ou machines informatisés, tels que ceux utilisés dans les chaînes de production, dans le transport ou d&apos;autres services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCW"><skos:prefLabel xml:lang="de">Personen, die beruflich Computer, Laptops, Smartphones, Tablets oder andere tragbare Geräte verwendeten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used computers, laptops, smartphones, tablets or other portable devices at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail utilisé des ordinateurs fixes ou portables, des smartphones, des tablettes ou d&apos;autres appareils électroniques portables</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCWA_ATI"><skos:prefLabel xml:lang="de">Personen, die beruflich Apps für die Entgegennahme von Aufgaben oder Anweisungen nutzten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used applications to receive tasks or instructions in their work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail utilisé des applications pour recevoir des instructions ou des tâches à réaliser</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCWA_ED"><skos:prefLabel xml:lang="de">Personen, die beruflich elektronische Dokumente erstellten oder bearbeiteten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals created or edited electronic documents in their work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail créé ou édité des documents électroniques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCWA_EMDB"><skos:prefLabel xml:lang="de">Personen, die beruflich E-Mails austauschten oder Daten in Datenbanken eingaben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals exchanged emails or entered data in databases in their work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail échangé des e-mails ou saisi des données dans des bases de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCWA_IT"><skos:prefLabel xml:lang="de">Personen, die beruflich IT Systeme oder Software entwickelten oder warteten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals developped or maintained IT systems or software in their work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail développé ou maintenu des logiciels ou systèmes informatiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCWA_OSS"><skos:prefLabel xml:lang="de">Personen, die berufsspezifische Software nutzten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used occupational specific software in their work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail utilisé des logiciels professionnels spécifiques à l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MCWA_SMW"><skos:prefLabel xml:lang="de">Personen, die beruflich soziale Medien nutzten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used social media for their work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant utilisé les médias sociaux pour leur travail</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_MDW"><skos:prefLabel xml:lang="de">Personen, die beruflich Computer, Laptops, Smartphones, Tablets, andere computergesteuerte Geräte oder Maschinen (wie in Produktions-, in Beförderungsanlagen oder in Fahrzeugen) verwendeten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals used computers, laptops, smartphones, tablets, other portable devices or other computerized equipment or machinery such as those used in production lines, transportation or other services at work</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant au travail utilisé des ordinateurs fixes ou portables, des smartphones, des tablettes, d&apos;autres appareils électroniques portables ou des équipements ou machines informatisés, tels que ceux utilisés dans les chaînes de production, dans le transport ou d&apos;autres services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12_SSF"><skos:prefLabel xml:lang="de">Prozent der Beschäftigten und Selbständigen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of employees and self-employed who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des salariés et travailleurs indépendants ayant utilisés internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_MDW"><skos:prefLabel xml:lang="de">Prozent der Personen, die beruflich jegliche Art von Computern, tragbare Geräte oder andere computergesteuerte Geräte oder Maschinen verwendeten</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who, at work, use any type of computers, portable devices or computerised equipment or machinery</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant au travail utilisé des ordinateurs fixes ou portables, d&apos;autres appareils électroniques portables ou des équipements ou machines informatisés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">91206</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-01-01</dcat:startDate><dcat: