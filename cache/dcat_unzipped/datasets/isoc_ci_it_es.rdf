bout="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_MOB2"><skos:prefLabel xml:lang="de">Unternehmen, die über einen mobilen Internetzugang (Breitband oder anderer mobiler Zugang) verfügen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises connecting to the internet via mobile connection (broadband or other mobile connection)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises accédant à l&apos;internet par une connexion mobile (à large bande ou autre connexion mobile)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_MOBBB"><skos:prefLabel xml:lang="de">Unternehmen, die über einen mobilen Breitbandzugang (3G-Modem oder 3G-Mobiltelefon) auf das Internet zugreifen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises connecting to the internet via a mobile broadband connection (3G modem or 3G handset)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises accédant à l&apos;internet par une connexion mobile à large bande (modem 3G ou téléphone mobile 3G)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_FIXBB"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, die einen festen Breitbandzugang verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises using a fixed broadband connection</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentrage d&apos;entreprises utilisant une connexion fixe à large bande</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IACC"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises with internet access</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26425</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:ab