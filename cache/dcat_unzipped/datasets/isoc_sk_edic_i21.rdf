dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TIC"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalten auf Internetnachrichtenseiten oder in sozialen Medien überprüft haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have checked the truthfulness of the information or content they found on the internet news sites or social media (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant vérifié la véracité de l&apos;information ou du contenu qu&apos;ils ont trouvé sur des sites d’information ou des médias sociaux (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TIC2"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalten (3 Monate) mit einer der folgenden Methoden überprüft haben: I_TICCSFOI, I_TICIDIS oder I_TICNIDIS</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have checked the truthfulness of the information or content found on the internet (3 months) by using the following methods: I_TICCSFOI, I_TICIDIS or I_TICNIDIS</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant vérifié la véracité de l&apos;information ou du contenu trouvés sur internet (3 mois) en utilisant une des méthodes suivantes : I_TICCSFOI, I_TICIDIS ou I_TICNIDIS</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TICCSFOI"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalten überprüft haben, indem sie die Quellen geprüft oder andere Quellen herangezogen haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have checked the truthfulness of the information or content found on the internet by checking the sources or finding other information on the internet (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant vérifié la véracité de l&apos;information ou du contenu trouvés sur internet en contrôlant les sources et trouvant d&apos;autres informations sur internet (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TICIDIS"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalten überprüft haben, indem sie Diskussionen im Internet über diese Informationen verfolgt oder an ihnen teilgenommen haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have checked the truthfulness of the information or content found on the internet by following or taking part in discussion on internet  regarding the information (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant vérifié la véracité de l&apos;information ou du contenu trouvés sur internet en suivant ou participant à des discussions à ce sujet sur internet (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TICNIDIS"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalten überprüft haben, indem sie außerhalb des Internets mit anderen Personen darüber gesprochen oder Quellen außerhalb des Internets konsultiert haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have checked the truthfulness of the information or content found on the internet by discussing the information offline with other persons or using sources not on internet (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant vérifié la véracité de l&apos;information ou du contenu trouvés sur internet en échangeant sur ces informations hors ligne avec d’autres   personnes ou en utilisant des sources ne se trouvant pas sur internet (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TICXND"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalten nicht überprüft haben, weil sie wussten, dass die Informationen, Inhalte oder Quellen nicht zuverlässig waren  (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have not checked the truthfulness of the information or content found on the internet because the individuals already knew that information, content or source was not reliable (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas vérifié la véracité de l&apos;information ou du contenu trouvés sur internet car les individus savaient déjà que les informations, les contenus ou la source n’étaient pas fiables (3 mois).</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TICXOTH"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalten aus anderen Gründen nicht überprüft haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have not checked the truthfulness of the information or content found on the internet because of other reasons (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas vérifié la véracité de l&apos;information ou du contenu trouvés sur internet pour d&apos;autres raisons (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TICXSKL"><skos:prefLabel xml:lang="de">Personen, die den Wahrheitsgehalt von im Internet gefundenen Informationen oder Inhalte nicht überprüft haben, weil ihnen die entsprechenden Fähigkeiten oder Kenntnisse fehlten (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have not checked the truthfulness of the information or content found on the internet because the individuals lacked skills or knowledge (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas vérifié la véracité de l&apos;information ou du contenu trouvés sur internet car les individus n&apos;avaient pas de compétences ou de connaissances (3 mois).</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_UDI"><skos:prefLabel xml:lang="de">Personen, die Informationen oder Inhalte auf Internetnachrichtenseiten oder in sozialen Medien als unwahr oder fragwürdig angesehen haben (3 Monate)</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have seen untrue or doubtful information or content on the internet news sites or social media (3 months)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant vu des informations ou des contenus considérés comme faux ou douteux sur des sites d’information ou des médias sociaux (3 mois)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">63378</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-17</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_sk_edic_i21"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schem