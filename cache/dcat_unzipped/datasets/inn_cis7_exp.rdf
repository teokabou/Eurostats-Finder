_IN" > <skos:prefLabel xml:lang="de">Innovationsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Innovation indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;innovation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZECLAS" > <skos:prefLabel xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre de salariés</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/TYPE_INN" > <skos:prefLabel xml:lang="de">Gliederung nach Innovationsart</skos:prefLabel><skos:prefLabel xml:lang="en">Breakdown by type of innovator</skos:prefLabel><skos:prefLabel xml:lang="fr">Ventilation par type d&apos;innovateur</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</sko