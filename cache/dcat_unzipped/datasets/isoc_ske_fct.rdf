fLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_BMSDE"><skos:prefLabel xml:lang="de">Die Entwicklung betriebswirtschaftlicher Software / Systeme wurde überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The development of business management software/systems is mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Le Développement de logiciels/systèmes de gestion d&apos;entreprise est principalement effectué par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_BMSDO"><skos:prefLabel xml:lang="de">Die Entwicklung betriebswirtschaftlicher Software / Systeme wurde überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The development of business management software/systems is mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Le Développement de logiciels/systèmes de gestion d&apos;entreprise est principalement effectuée par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_BMSDO_WEBDO_ITSP2"><skos:prefLabel xml:lang="de">Unternehmen, die IKT/IT-Fachleute beschäftigen, und die Entwicklung betriebswirtschaftlicher Software / Systeme oder webbasierter Lösungen wurden überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Employ ICT specialists and the development of business management software/systems or web solutions are mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui emploient des spécialistes TIC et dont le Développement de logiciels/systèmes de gestion d&apos;entreprise ou de solutions web est principalement effectué par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_BMSSE"><skos:prefLabel xml:lang="de">Die Betreuung betriebswirtschaftlicher Software / Systeme wurde überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The support for business management software/systems is mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions de support pour les logiciels/systèmes de gestion d&apos;entreprise sont principalement exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_BMSSO"><skos:prefLabel xml:lang="de">Die Betreuung betriebswirtschaftlicher Software / Systeme wurde überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The support for business management software/systems is mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions de support pour les logiciels/systèmes de gestion d&apos;entreprise sont principalement exercées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_EXT"><skos:prefLabel xml:lang="de">IT-Tätigkeiten wurden von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">ICT functions are performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions TIC sont exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_EXTQ"><skos:prefLabel xml:lang="de">IT-Tätigkeiten wurden ausschließlich von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">ICT functions are only performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions TIC sont exercées seulement par les prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_EXT_ITSP2"><skos:prefLabel xml:lang="de">Unternehmen, die IKT/IT-Fachleute beschäftigen, und die IT-Tätigkeiten wurden von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Employ ICT specialists and ICT functions are performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui emploient des spécialistes TIC et dont les fonctions TIC sont exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_EXT_ITT2"><skos:prefLabel xml:lang="de">Unternehmen, die für ihr Personal Fortbildungsmaßnahmen zur Erweiterung von IKT-Fertigkeiten durchführten, und die IT-Tätigkeiten wurden von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Provide training to develop ICT skills of personnel and ICT functions are performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui organisent des formations pour leur personnel afin de développer leurs compétences TIC et dont les fonctions TIC sont exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_INFRE"><skos:prefLabel xml:lang="de">Die Instandhaltung der IT-Infrastruktur wurde überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The maintenance of ICT infrastructure is mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">La maintenance des infrastructures des TIC est principalement effectuée par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_INFRO"><skos:prefLabel xml:lang="de">Die Instandhaltung der IT-Infrastruktur wurde überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The maintenance of ICT infrastructure is mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">La maintenance des infrastructures TIC est principalement effectuée par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_MEXT"><skos:prefLabel xml:lang="de">IT-Tätigkeiten wurden überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">ICT functions are mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions TIC sont principalement exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_MEXT_ITSP2"><skos:prefLabel xml:lang="de">Unternehmen, die IKT/IT-Fachleute beschäftigen, und die IT-Tätigkeiten wurden überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Employ ICT specialists and ICT functions are mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui emploient des spécialistes TIC et dont les fonctions TIC sont principalement exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_MEXT_ITT2"><skos:prefLabel xml:lang="de">Unternehmen, die für ihr Personal Fortbildungsmaßnahmen zur Erweiterung / Vertiefung von IKT-Fertigkeiten durchführten, und die IT-Tätigkeiten wurden überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Provide training to develop ICT skills of personnel and ICT functions are mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui organisent des formations pour leur personnel afin de Développer leurs compétences TIC et dont les fonctions TIC sont principalement exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_MIX"><skos:prefLabel xml:lang="de">IT-Tätigkeiten wurden überwiegend von eigenen Beschäftigten und externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">ICT functions are mainly performed by a mix of own employees and external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions TIC sont principalement exercées par les deux, les employés de l&apos;entreprise et des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_MIX_ITSP2"><skos:prefLabel xml:lang="de">Unternehmen, die IKT/IT-Fachleute beschäftigen, und die IT-Tätigkeiten wurden überwiegend von eigenen Beschäftigten und externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Employ ICT specialists and ICT functions are mainly performed by a mix of own employees and external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui emploient des spécialistes en TIC et dont les fonctions TIC sont principalement exercées par les deux, les employés de l&apos;entreprise et des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_MOWN"><skos:prefLabel xml:lang="de">IT-Tätigkeiten wurden überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">ICT functions are mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions TIC sont principalement exercées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_MOWN_ITSP2"><skos:prefLabel xml:lang="de">Unternehmen, die IKT/IT-Fachleute beschäftigen, und die IT-Tätigkeiten wurden überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Employ ICT specialists and ICT functions are mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui emploient des spécialistes TIC et dont les fonctions TIC sont principalement exercées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_OSSE"><skos:prefLabel xml:lang="de">Die Betreuung von Bürosoftware wurde überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The support for office software is mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions de support pour les logiciels bureautiques sont principalement exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_OSSO"><skos:prefLabel xml:lang="de">Die Betreuung von Bürosoftware wurde überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The support for office software is mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions de support pour les logiciels bureautiques sont principalement exercées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_OWN"><skos:prefLabel xml:lang="de">IT-Tätigkeiten wurden von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">ICT functions are performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions TIC sont exercées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_OWNQ"><skos:prefLabel xml:lang="de">IT-Tätigkeiten wurden ausschließlich von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">ICT functions are only performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions TIC sont exercées seulement par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_OWN_ITSP2"><skos:prefLabel xml:lang="de">Unternehmen, die IKT/IT-Fachleute beschäftigen, und die IT-Tätigkeiten wurden von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">Employ ICT specialists and ICT functions are performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui emploient des spécialistes TIC et dont les fonctions TIC sont exercées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_SEC2E"><skos:prefLabel xml:lang="de">IT-Sicherheit und Datenschutz wurden überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security and data protection are mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">La sécurité informatique et la protection des données sont principalement effectuées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_SEC2O"><skos:prefLabel xml:lang="de">IT-Sicherheit und Datenschutz wurden überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security and data protection are mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">La sécurité informatique et la protection des données sont principalement effectuées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_SECE"><skos:prefLabel xml:lang="de">Sicherheit und Datenschutz wurden überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The security and data protection are mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">La sécurité et la protection des données sont principalement effectuées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_SECO"><skos:prefLabel xml:lang="de">Sicherheit und Datenschutz wurden überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The security and data protection are mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">La sécurité et la protection des données sont principalement effectuées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_WEBDE"><skos:prefLabel xml:lang="de">Die Entwicklung webbasierter Lösungen wurde überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The development of web solutions is mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Le Développement de solutions web est principalement effectué par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_WEBDO"><skos:prefLabel xml:lang="de">Die Entwicklung webbasierter Lösungen wurde überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The development of web solutions is mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Le Développement de solutions web est principalement effectué par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_WEBSE"><skos:prefLabel xml:lang="de">Die Betreuung webbasierter Lösungen wurde überwiegend von externen Anbietern ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The support for web solutions is mainly performed by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions de support pour les solutions web sont principalement exercées par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_IT_WEBSO"><skos:prefLabel xml:lang="de">Die Betreuung webbasierter Lösungen wurde überwiegend von eigenen Beschäftigten ausgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The support for web solutions is mainly performed by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les fonctions de support pour les solutions web sont principalement exercées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12620</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-10</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="htt