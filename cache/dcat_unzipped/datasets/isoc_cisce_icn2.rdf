/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IANY"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Nichtverfügbarkeit von IKT-Diensten, Vernichtung oder Verfälschung von Daten, Offenlegung vertraulicher Daten (aus irgendeinem Grund)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced any ICT security related incidents leading to: unavailability of ICT services, destruction or corruption of data, disclosure of confidential data (for any reason)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique entraînant : l&apos;indisponibilité des services informatiques, la destruction ou l&apos;altération de données, la divulgation de données confidentielles (pour une raison quelconque)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2ICNF"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Offenlegung vertraulicher Daten ( z.B. aufgrund durch unerlaubtes Eindringen, Pharming, Phishing-Angriffe, Handlungen der eigenen Lohn- und Gehaltsempfänger (absichtlich oder unabsichtlich))</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: disclosure of confidential data (e.g. due to intrusion, pharming, phishing attack, actions by own employees (intentionally or unintentionally))</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique qui ont conduit à : la divulgation de données confidentielles (par exemple: en raison d&apos;une intrusion, d&apos;un pharming, d&apos;un phishing, d&apos;actions de leur personnel (intentionnelles ou non))</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2ICNFA"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Offenlegung vertraulicher Daten durch unerlaubtes Eindringen, Pharming, Phishing-Angriffe, absichtliche Handlungen der eigenen Lohn- und Gehaltsempfänger</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: disclosure of confidential data due to intrusion, pharming, phishing attack, intentional actions by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique qui ont conduit à : la divulgation de données confidentielles en raison d&apos;une intrusion, d&apos;un pharming, d&apos;un phishing, d&apos;actions intentionnelles de la part de leur propre personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2ICNFF"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Offenlegung vertraulicher Daten aufgrund unabsichtlicher Handlungen der eigenen Lohn- und Gehaltsempfänger</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: disclosure of confidential data due to unintentional actions by own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique entraînant : la divulgation de données confidentielles en raison d&apos;actions involontaires de leur personnel</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IDCD"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Vernichtung oder Verfälschung von Daten (z.B. durch eine Infektion mit Schadsoftware oder unbefugtes Eindringen, aufgrund von Hard- oder Softwarefehlern)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: destruction or corruption of data (e.g. due to infection of malicious software or unauthorised intrusion, hardware or software failures)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique entraînant : la destruction ou l&apos;altération de données (par exemple: en raison de l&apos;infection de logiciels malveillants ou d&apos;une intrusion non autorisée, de défaillances matérielles ou logicielles)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IDCDA"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Vernichtung oder Verfälschung von Daten durch eine Infektion mit Schadsoftware oder unbefugtes Eindringen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: destruction or corruption of data due to infection of malicious software or unauthorised intrusion</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique entraînant : la destruction ou l&apos;altération de données en raison de l&apos;infection de logiciels malveillants ou d&apos;une intrusion non autorisée</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IDCDF"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Vernichtung oder Verfälschung von Daten aufgrund von Hard- oder Softwarefehlern</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: destruction or corruption of data due to hardware or software failures</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique entraînant : la destruction ou l&apos;altération de données en raison de pannes matérielles ou logicielles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IGE3"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu mindestens 3 Folgen führten: E_SEC2IUSVF, E_SEC2IUSVA, E_SEC2IDCDF, E_SEC2IDCDA, E_SEC2ICNFA, E_SEC2ICNFF</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced any ICT security related incident leading to at least 3 consequences: of E_SEC2IUSVF, E_SEC2IUSVA, E_SEC2IDCDF, E_SEC2IDCDA, E_SEC2ICNFA, E_SEC2ICNFF</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu un incident lié à la sécurité informatique entraînant au moins 3 conséquences : parmi E_SEC2IUSVF, E_SEC2IUSVA, E_SEC2IDCDF, E_SEC2IDCDA, E_SEC2ICNFA, E_SEC2ICNFF</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IUSV"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Nichtverfügbarkeit von IKT-Diensten aufgrund von Angriffen von außen (z. B. Denial-of-Service-Angriffe, Ransomware-Angriffe, Hard- oder Softwarefehlern - ausgenommen mechanischer Ausfall, Diebstahl)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: unavailability of ICT services (e.g. Denial of Service attacks, ransomware attacks, hardware or software failures)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique qui ont entraîné : l&apos;indisponibilité des services informatiques (par exemple: des attaques par déni de service, des attaques par ransomware, des pannes matérielles ou logicielles)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IUSVA"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Nichtverfügbarkeit von IKT-Diensten aufgrund von Angriffen von außen (z. B. Ransomware-Angriffe, Denial-of-Service-Angriffe)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: unavailability of ICT services due to attack from outside (e.g. Ransomware attacks, Denial of Service attacks)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique entraînant : l&apos;indisponibilité des services informatiques en raison d&apos;attaques extérieures (par exemple: attaques de ransomwares, attaques par déni de service)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SEC2IUSVF"><skos:prefLabel xml:lang="de">Unternehmen hatten IKT-Sicherheitsvorfälle, die zu dem Folgenden führten: Nichtverfügbarkeit von IKT-Diensten aufgrund von Hard- oder Softwarestörungen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT security related incidents leading to: unavailability of ICT services due to hardware or software failures</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ont connu des incidents liés à la sécurité informatique entraînant : l&apos;indisponibilité des services informatiques en raison de pannes matérielles ou logicielles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECI2ANY"><skos:prefLabel xml:lang="de">Unternehmen hatten mindestens einmal einen IKT-Sicherheitsvorfall (Ausfall von IKT-Diensten, Zerstörung oder Verfälschung von Daten, Offenlegung vertraulicher Daten)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced at least once problems due to an ICT related security incident (unavailability of ICT services, destruction or corruption of data, disclosure of confidential data)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu au moins une fois des problèmes à cause d&apos;incidents de sécurité des TIC (l&apos;indisponibilité des services des TIC, la destruction ou la corruption de données, la divulgation de données confidentielles)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECI2CNF"><skos:prefLabel xml:lang="de">Unternehmen hatten mindestens einmal folgenden IKT-Sicherheitsvorfall: Offenlegung vertraulicher Daten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced at least once problems due to ICT security incident: disclosure of confidential data</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu au moins une fois des problèmes à cause d&apos;incidents de sécurité des TIC: la divulgation de données confidentielles</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECI2DCD"><skos:prefLabel xml:lang="de">Unternehmen hatten mindestens einmal folgenden IKT-Sicherheitsvorfall: Zerstörung oder Verfälschung von Daten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced at least once problems due to ICT security incident: destruction or corruption of data</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu au moins une fois des problèmes à cause d&apos;incidents de sécurité des TIC: la destruction ou la corruption de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECI2NONE"><skos:prefLabel xml:lang="de">Unternehmen hatte keinen der folgenden IKT-Sicherheitsvorfälle: Ausfall von IKT-Diensten, Zerstörung oder Verfälschung von Daten, Offenlegung vertraulicher Daten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises did not experience any problem due to ICT related security incidents (unavailability of ICT services, destruction or corruption of data, disclosure of confidential data)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;ayant pas eu de problèmes à cause d&apos;incidents de sécurité des TIC (l&apos;indisponibilité des services des TIC, la destruction ou la corruption de données, la divulgation de données confidentielles)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECI2USV"><skos:prefLabel xml:lang="de">Unternehmen hatten mindestens einmal folgenden IKT-Sicherheitsvorfall: Ausfall von IKT-Diensten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced at least once problems due to ICT security incident: unavailability of ICT services</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu au moins une fois des problèmes à cause d&apos;incidents de sécurité des TIC: l&apos;indisponibilité des services TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECIANY"><skos:prefLabel xml:lang="de">Das Unternehmen hatte Sicherheitsprobleme, aber nicht solche die zur Offenlegung vertraulicher elektronischer Daten durch Mitarbeiter führten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced any ICT related security incidents excluding disclosure of confidential data in electronic form by employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu de tels incidents avec pour conséquence l&apos;indisponibilité des services, destruction/altération ou divulgation de données, mais excluant la divulgation par des employés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECICNFA"><skos:prefLabel xml:lang="de">Das Unternehmen hatte Sicherheitsprobleme, die zur Offenlegung vertraulicher Daten aufgrund von unbefugtem Eindringen in das System, Pharming- oder Phishing-Angriffen führten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT related security incidents that resulted in disclosure of confidential data due to intrusion, pharming, phishing attacks</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu de ces incidents avec pour conséquence la divulgation de données confidentielles par intrusion, pharming ou hameçonnage (phishing)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECICNFE"><skos:prefLabel xml:lang="de">Das Unternehmen hatte Sicherheitsprobleme, die zur Offenlegung vertraulicher Daten in elektronischer Form durch Beschäftigte, absichtlich oder unabsichtlich, führte</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT related security incidents resulting in disclosure of confidential data in electronic form by employees whether on intention or unintentionally</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu de ces incidents avec pour conséquence la divulgation de données confidentielles en format électronique par des employés, intentionnellement ou pas</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECIDD"><skos:prefLabel xml:lang="de">Das Unternehmen hatte Sicherheitsprobleme die zur Zerstörung oder Veränderung von Daten durch Schadsoftware führten oder durch nicht autorisierten Zugriff verursacht wurden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT related security incidents that resulted in destruction or corruption of data due to infection or malicious software or unauthorised access</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu de ces incidents avec pour conséquence la destruction ou l&apos;altération de données suite à une infection par un logiciel malveillant ou un accès non autorisé</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECINONE"><skos:prefLabel xml:lang="de">Das Unternehmen hatte keine Sicherheitsprobleme ausgenommen solcher die zur Offenlegung vertraulicher elektronischer Daten durch Mitarbeiter führten</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises did not experience any ICT related security incidents excluding disclosure of confidential data in electronic form by employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;ayant pas eu d&apos;incidents liés à la sécurité, sauf la divulgation de données confidentiels sous forme électronique par des employés</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECINS"><skos:prefLabel xml:lang="de">Unternehmen haben eine Versicherung gegen IKT-Sicherheitsvorfälle</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises having insurance against ICT security incidents</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises étant assurées contre les incidents de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECIUSA"><skos:prefLabel xml:lang="de">Das Unternehmen hatte Sicherheitsprobleme mit Nichtverfügbarkeit von IKT-Leistungen aufgrund von Angriffen von außen (DoS-Angriffen)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT related security incidents that resulted in unavailability of ICT services due to attacks from outside, e.g. Denial of Service attack</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu de ces incidents avec pour conséquence l&apos;indisponibilité des services TIC suite à une attaque venue de l&apos;extérieur, p. ex. une attaque en Déni de service</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECIUSF"><skos:prefLabel xml:lang="de">Das Unternehmen hatte Sicherheitsprobleme mit Nichtverfügbarkeit von IKT-Leistungen, Zerstörung oder Verfälschung von Daten aufgrund von Hard- oder Softwarestörungen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises experienced ICT related security incidents that resulted in unavailability of ICT services, destruction or corruption of data due to hardware or software failures</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant eu de ces incidents avec pour conséquence l&apos;indisponibilité des services TIC, la destruction ou l&apos;altération de données suite à des Défaillances de hardware ou de software</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">72802</stat:numSeries><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-10</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisce_icn2"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisce_icn2</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisce_icn2"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/isoc_e_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_e_esms.sdmx.zip"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) SDMX</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisce_icn2"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_e_esms.sdmx.zip]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/XML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/databrowser/view/isoc_cisce_icn2/default/table"><dct:title xml:lang="en">Table, graphs and map visualizations are also available.</dct:title><dct:title xml:lang="fr">Des visualisations sous forme de tableau, graphique et carte géographique sont aussi disponibles.</dct:title><dct:title xml:lang="de">Tabellen, Grafiken und geografische Darstellungen sind ebenfalls verfügbar.</dct:title><dcat:accessURL rdf:resource="https://ec.europa.eu/euro