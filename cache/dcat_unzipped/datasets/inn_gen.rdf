/2.1/codelist/ESTAT/INDIC_IN?code=SIGMAR_INT"><skos:prefLabel xml:lang="de">Zahl der Unternehmen für die der Weltmarkt der wichtigste ist</skos:prefLabel><skos:prefLabel xml:lang="en">Number of enterprises where international market most significant market</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre d&apos;entreprises pour lesquelles le marché international est le marché le plus important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SIGMAR_LN"><skos:prefLabel xml:lang="de">Zahl der Unternehmen, für die der örtliche/benachbarte Markt der wichtigste ist</skos:prefLabel><skos:prefLabel xml:lang="en">Number of enterprises where local/neighb. market most significant market</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre d&apos;entreprises pour lesquelles le marché local/régional est le marché le plus important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SIGMAR_LOC"><skos:prefLabel xml:lang="de">Zahl der Unternehmen, für die der örtliche Markt der wichtigste ist</skos:prefLabel><skos:prefLabel xml:lang="en">Number of enterprises where local market most significant market</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre d&apos;entreprises pour lesquelles le marché local est le marché le plus important</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SIGMAR_MISS"><skos:prefLabel xml:lang="de">Keine Angabe zu diesem Merkmal</skos:prefLabel><skos:prefLabel xml:lang="en">Missing information for given variable</skos:prefLabel><skos:prefLabel xml:lang="fr">Information manquante pour la variable considérée</skos:prefLabel></skos:Concept></stat:sta