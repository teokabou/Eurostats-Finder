tat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BUMT12"><skos:prefLabel xml:lang="de">Letzter online Kauf: vor mehr als einem Jahr</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: more than a year ago</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: il y a plus d&apos;un an</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BUMT12X"><skos:prefLabel xml:lang="de">Letzter online Kauf: vor mehr als einem Jahr oder noch nie</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: more than a year ago or never</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: il y a plus d&apos;un an ou jamais</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BUX"><skos:prefLabel xml:lang="de">Letzter online Kauf: noch nie</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: never</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: jamais</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BUY3"><skos:prefLabel xml:lang="de">Letzter online Kauf: in den letzten 3 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_IBV_100-499"><s