sion> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_B3_12"><skos:prefLabel xml:lang="de">Letzter online Kauf: zwischen 3 und 12 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">Last online purchase: between 3 and 12 months ago</skos:prefLabel><skos:prefLabel xml:lang="fr">Dernière commande en ligne: au cours d&apos;une période remontant de 3 à 12 mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOK"><skos:prefLabel xml:lang="de">Online Käufe: Bücher/Zeitschriften/Zeitungen/Materialien für das elektronische Lernen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: books/magazines/newspapers/e-learning material</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des livres/magazines/journaux/matériel d&apos;apprentissage en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOK1O"><skos:prefLabel xml:lang="de">Online Käufe, über Websites oder Apps bezogen oder heruntergeladen: E-Books, E-Magazine, E-Zeitungen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases, downloaded or accessed from websites or apps: e-books, e-magazines/e-newspapers</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne, téléchargées ou utilisées directement sur le site web ou l&apos;appli: d&apos;e-books, d&apos;e-magazines ou de journaux en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOKNL"><skos:prefLabel xml:lang="de">Online Käufe: Bücher/Magazine/Zeitungen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: books/magazines/newspapers</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne: des livres/magazines/journaux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BBOOKO"><skos:prefLabel xml:lang="de">Online Käufe: Bücher, Zeitschriften oder Materialien für das elektronische Lernen, online zugestellt oder aktualisiert</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: books/magazines/e-learning material, delivered or upgraded online</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des livres, magazines ou matériel d&apos;apprentissage, livrés ou mis à jour en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BCLOT"><skos:prefLabel xml:lang="de">Online Käufe: Bekleidung oder Sportartikel</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: clothes, sports goods</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des vêtements ou des articles de sport</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BEBOOKO"><skos:prefLabel xml:lang="de">Online Käufe, über Websites oder Apps bezogen oder heruntergeladen: E-Books</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases, downloaded or accessed from websites or apps: e-books</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne, téléchargées ou utilisées directement sur le site web ou l&apos;appli: d&apos;e-books (livres électroniques)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BEEQU"><skos:prefLabel xml:lang="de">Online Käufe: elektronische Geräte</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: electronic equipment</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des appareils électroniques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BELRN"><skos:prefLabel xml:lang="de">Online Käufe: Materialien für das elektronische Lernen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: e-learning material</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne: matériel d&apos;apprentissage en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFDOM"><skos:prefLabel xml:lang="de">Online Käufe: von nationalen Anbietern</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: from national sellers</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne des biens ou services auprès des vendeurs nationaux</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFEU"><skos:prefLabel xml:lang="de">Online Käufe: von Anbietern aus anderen EU-Staaten</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: from sellers from other EU countries</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne des biens ou services auprès des vendeurs d&apos;autres pays de l&apos;UE</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFFOR"><skos:prefLabel xml:lang="de">Online Käufe: von Anbietern aus dem Ausland (EU- oder nicht EU-Staaten)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: from sellers abroad (other EU or non EU countries)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne des biens ou services auprès des vendeurs d&apos;autres pays (UE ou hors l&apos;UE)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFFOR_DWL"><skos:prefLabel xml:lang="de">Online Käufe von Anbietern aus dem Ausland: digitale Inhalte von Websites oder Apps (z.B. Filme, Musik, E-Books, E-Zeitungen, Spiele oder bezahlte Applikationen)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases from sellers abroad: products downloaded or accessed from websites or apps (e.g. films, music, e-books, e-newspapers, games, paid applications)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne auprès de vendeurs d&apos;autres pays (UE ou hors l&apos;UE): de produits téléchargés ou accessibles directement depuis des sites web (ex : films, musique, e-books, e-magazines, jeux ou applications prépayés)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFFOR_OSV"><skos:prefLabel xml:lang="de">Online Käufe von Anbietern aus dem Ausland: andere Dienstleistungen (z.B. Tickets für Veranstaltungen per Mail erhalten oder Dienstleistungen aus dem Telekommunikationsbereich)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases from sellers abroad: other services (e.g. tickets for events received by mail, telecom subscriptions)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne auprès de vendeurs d&apos;autres pays (UE ou hors l&apos;UE): d&apos;autres services (ex: billets électroniques pour un spectacle, abonnements téléphoniques)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFFOR_PGD"><skos:prefLabel xml:lang="de">Online Käufe von Anbietern aus dem Ausland: physische Waren (z.B. elektronische Geräte, Kleidung, Spielsachen, Bücher, Lebensmittel, CDs/DVDs)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases from sellers abroad: physical goods (e.g. electronics, clothes, toys, food, groceries, books, CDs/DVDs)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne auprès de vendeurs d&apos;autres pays (UE ou hors l&apos;UE): de biens matériels (ex : équipement électronique, vêtements, jouets, nourriture, livres, CD ou DVD)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFFOR_TRH"><skos:prefLabel xml:lang="de">Online Käufe von Anbietern aus dem Ausland: Reisen, Unterkünfte oder Urlaubsarrangements (z.B. Tickets oder Reiseunterlagen per Mail erhalten oder selbst ausgedruckt)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases from sellers abroad: travel, accommodation or holiday arrangements (e.g. tickets and documents by mail or printed by oneself)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne auprès de vendeurs d&apos;autres pays (UE ou hors l&apos;UE): de voyages ou d&apos;hébergements touristiques (p.ex. tickets ou documents de réservation par mail ou à imprimer soi-même)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFFOR_TRHOSV"><skos:prefLabel xml:lang="de">Online Käufe von Anbietern aus dem Ausland: Reisen, Unterkünfte oder Urlaubsarrangements oder andere Dienstleistungen (z.B. Tickets für Veranstaltungen per Mail erhalten oder Dienstleistungen aus dem Telekommunikationsbereich)</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases from sellers abroad: travel, accommodation or holiday arrangements or other services (e.g. tickets for events received by mail, telecom subscriptions)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commandes en ligne auprès de vendeurs d&apos;autres pays (UE ou hors l&apos;UE): de voyages, d&apos;hébergements touristiques ou d&apos;autres services</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFILM"><skos:prefLabel xml:lang="de">Online Käufe: Filme/Musik</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: films/music</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des films/de la musique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFILMO"><skos:prefLabel xml:lang="de">Online Käufe: Filme oder Musik, online zugestellt oder aktualisiert</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: films/music, delivered or upgraded online</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des films ou de la musique, livrés ou mis à jour en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFIN"><skos:prefLabel xml:lang="de">Online Käufe: Aktien/Versicherungen/Andere Finanzdienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: shares/insurance/other financial services</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des actions/assurance/autres services financiers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFOOD"><skos:prefLabel xml:lang="de">Online Käufe: Nahrungs- bzw. Lebensmittel</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: Food/groceries</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des denrées alimentaires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFUNK"><skos:prefLabel xml:lang="de">Online Käufe: von Anbietern unbekannten Ursprungs</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: from sellers with unknown country of origin</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne des biens ou services auprès des vendeurs d&apos;origine inconnu</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFURN"><skos:prefLabel xml:lang="de">Online Käufe: Haushaltswaren</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: household goods</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne: des articles domestiques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BFWRLD"><skos:prefLabel xml:lang="de">Online Käufe: von Anbietern außerhalb der EU</skos:prefLabel><skos:prefLabel xml:lang="en">Online purchases: from sellers from the rest of the world (non-EU)</skos:prefLabel><skos:prefLabel xml:lang="fr">Commande en ligne des biens ou services auprès des vendeurs du reste du monde (hors l&apos;UE)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_BF_1_2"><skos:prefLabel xml:lang="de">Häufigkeit von online Käufen in den letzten 3 Monaten: 1 bis 2 Mal</skos:prefLabel><skos:prefLabel xml:lang="en">Frequency of online purchases in the last 3 months: 