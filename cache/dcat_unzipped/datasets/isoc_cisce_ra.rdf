urce/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZE_EMP" > <skos:prefLabel xml:lang="de">Größenklassen (Anzahl) der Beschäftigten</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of persons employed</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre des personnes occupées</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ITSEC3"><skos:prefLabel xml:lang="de">IKT-sicherheitsrelevante Tätigkeiten werden von eigenen Beschäftigten oder externen Anbietern durchgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security related activities are carried out by own employees or external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les activités liées à la sécurité des TIC sont réalisées par les employées de l&apos;entreprise ou par des prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ITSEC3EXT"><skos:prefLabel xml:lang="de">IKT-sicherheitsrelevante Tätigkeiten werden von externen Anbietern durchgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security related activities are carried out by external suppliers</skos:prefLabel><skos:prefLabel xml:lang="fr">Les activités liées à la sécurité des TIC sont réalisées par les prestataires externes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_ITSEC3OWN"><skos:prefLabel xml:lang="de">IKT-sicherheitsrelevante Tätigkeiten werden von eigenen Beschäftigten durchgeführt</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security related activities are carried out by the own employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Les activités liées à la sécurité des TIC sont réalisées par les employés de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECANY"><skos:prefLabel xml:lang="de">Das Unternehmen hat seine Mitarbeiter auf ihre Verpflichtungen in Bezug auf IKT-Sicherheit hingewiesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have made staff aware of their obligations in ICT security related issues</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant sensibilisé le personnel à ses obligations en matière de sécurité TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECAWANY"><skos:prefLabel xml:lang="de">Unternehmen weisen ihre Beschäftigten auf deren Verpflichtungen bzgl. IKT-Sicherheit hin</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises make persons employed aware of their obligations in ICT security related issues</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises sensibilisant les personnes occupées à leurs obligations en matière de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECAWANY_POL2"><skos:prefLabel xml:lang="de">Unternehmen weisen ihre Beschäftigten auf deren Verpflichtungen bzgl. IKT-Sicherheit hin und verfügen über Dokumente zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises make persons employed aware of their obligations in ICT security related issues and have document(s) on measures, practices or procedures on ICT security</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises sensibilisant les personnes occupées à leurs obligations en matière de sécurité des TIC et disposant de documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECAWCONT"><skos:prefLabel xml:lang="de">Unternehmen weisen ihre Beschäftigten auf deren Verpflichtungen bzgl. IKT-Sicherheit hin, durch vertragliche Vereinbarungen (z.B. im Arbeitsvertrag)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises make persons employed aware of their obligations in ICT security related issues by contract (e.g. contract of employment)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises sensibilisant les personnes occupées à leurs obligations en matière de sécurité des TIC par contrat (par exemple, contrat de travail)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECAWCTP"><skos:prefLabel xml:lang="de">Unternehmen weisen ihre Beschäftigten auf deren Verpflichtungen bzgl. IKT-Sicherheit hin, durch verpflichtende Schulungen oder Aushändigen von verpflichtendem Schulungsmaterial</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises make persons employed aware of their obligations in ICT security related issues by compulsory training courses or viewing compulsory material</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises sensibilisant les personnes occupées à leurs obligations en matière de sécurité des TIC par des formations obligatoires ou du visionnage obligatoire de supports</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECAWNONE"><skos:prefLabel xml:lang="de">Unternehmen weisen ihre Beschäftigten nicht auf deren Verpflichtungen bzgl. IKT-Sicherheit hin</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises don&apos;t make persons employed aware of their obligations in ICT security related issues</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ne sensibilisant pas les personnes occupées à leurs obligations en matière de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECAWVTGI"><skos:prefLabel xml:lang="de">Unternehmen weisen ihre Beschäftigten auf deren Verpflichtungen bzgl. IKT-Sicherheit hin, durch freiwillige Schulungen oder intern zugängliche Informationen (z.B. Informationen im Intranet)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises make persons employed aware of their obligations in ICT security related issues by voluntary training or internally available information (e.g. information on the intranet)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises sensibilisant les personnes occupées à leurs obligations en matière de sécurité des TIC par des formations volontaires ou des informations disponibles en interne (par exemple, sur l&apos;intranet)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECCONT"><skos:prefLabel xml:lang="de">Das Unternehmen hat seine Mitarbeiter auf ihre Verpflichtungen in Bezug auf IKT-Sicherheit durch Vereinbarungen in Verträgen (z.B. im Dienstvertrag) hingewiesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have made staff aware of their obligations in ICT security related issues through contract, e.g. contract of employment</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant sensibilisé le personnel à ses obligations en matière de sécurité TIC par contrat, p.ex. le contrat d&apos;emploi</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECCTP"><skos:prefLabel xml:lang="de">Das Unternehmen hat seine Mitarbeiter auf ihre Verpflichtungen in Bezug auf IKT-Sicherheit durch verpflichtende Schulungen oder Vorträge hingewiesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have made staff aware of their obligations in ICT security related issues through compulsory training or presentations</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant sensibilisé le personnel à ses obligations en matière de sécurité TIC par des formations ou des présentations obligatoires</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMALL"><skos:prefLabel xml:lang="de">Unternehmen, die alle IKT-Sicherheitsmaßnahmen durchführen (ab 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using all ICT security measures (as of 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant toutes les mesures de sécurité informatique (à partir de 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMANY"><skos:prefLabel xml:lang="de">Unternehmen, die IKT-Sicherheitsmaßnahmen durchführen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using any ICT security measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant des mesures de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMDENC"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Verschlüßelungstechniken von Daten, Dokumenten oder E-Mails</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: encryption techniques for data, documents or e-mails</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: techniques de cryptage pour les données, les documents ou les courriels</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMDUO"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: mindestens zwei Authentifizierungsmechanismen (d. h. Kombination aus z. B. benutzerdefiniertem Passwort, Einmalpasswort (OTP), Code, der über ein Sicherheitstoken generiert oder über ein Smartphone empfangen wird, biometrische Verfahren)</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: combination of at least two authentication mechanisms (e.g. user-defined password, one-time password (OTP), code generated via a security token or received via a smartphone, biometric methods)</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure de sécurité informatique utilisée : combinaison d&apos;au moins deux mécanismes d&apos;authentification (par exemple: mot de passe défini par l&apos;utilisateur, mot de passe à usage unique (OTP), code généré par un jeton de sécurité ou reçu sur un smartphone, méthodes biométriques)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMGE1"><skos:prefLabel xml:lang="de">Unternehmen, die IKT-Sicherheitsmaßnahmen durchführen (ab 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using any ICT security measure (as of 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant n&apos;importe quelle mesure de sécurité informatique (à partir de 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMGE3"><skos:prefLabel xml:lang="de">Unternehmen, die mindestens 3 IKT-Sicherheitsmaßnahmen durchführen (ab 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using at least 3 ICT security measures (as of 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant au moins 3 mesures de sécurité informatique (à partir de 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMGE5"><skos:prefLabel xml:lang="de">Unternehmen, die mindestens 5 IKT-Sicherheitsmaßnahmen durchführen (ab 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using at least 5 ICT security measures (as of 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant au moins 5 mesures de sécurité informatique (à partir de 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMGE7"><skos:prefLabel xml:lang="de">Unternehmen, die mindestens 7 IKT-Sicherheitsmaßnahmen durchführen (ab 2022)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises using at least 7 ICT security measures (as of 2022)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant au moins 7 mesures de sécurité informatique (à partir de 2022)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMKSUD"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: regelmäßige Softwareupdates (inkl. der Betriebssysteme)</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: keeping the software (including operating systems) up-to-date</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: mise à jour régulière des logiciels (y compris des systèmes d&apos;exploitation)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMLOG"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Aufbewahrung von Log-Dateien zur Analyse sicherheitsrelevanter Vorfälle</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: maintaining log files for analysis after security incidents</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: conservation des logs (fichiers journaux) pour analyse après la survenue d&apos;incidents de sécurité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMNAC"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Netzwerkzugangskontrolle für Geräte und User (Network Access Control)</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: network access control (management of access by devices and users to the enterprise&apos;s network)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: contrôle d&apos;accès au réseau (gestion de l&apos;accès des appareils et des utilisateurs au réseau de l&apos;entreprise)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMOSBU"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Datensicherung an einem getrennten Speicherort (inkl. Sicherung in der Cloud)</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: data backup to a separate location (including backup to the cloud)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: sauvegarde des données dans un endroit distinct (y compris la sauvegarde sur le cloud)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMRASS"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: IKT-Risikoanalyse, z.B. regelmäßige Bewertung der Eintrittswahrscheinlichkeiten und Konsequenzen von sicherheitsrelevanten Vorfällen im IKT-Bereich</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: ICT risk assessment, i.e. periodically assessment of probability and consequences of ICT security incidents</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: évaluation des risques liés aux TIC, c&apos;est-à-dire évaluation régulière de la probabilité et des conséquences d&apos;incidents de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMSMS"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Überwachungssystem, das es ermöglicht, verdächtige Aktivitäten in den IKT-Systemen zu erkennen und die Unternehmen darüber zu warnen, mit Ausnahme von eigenständiger Antivirensoftware</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: monitoring system that allows detecting suspicious activity in the ICT systems and alerts the enterprises about it, other than standalone anti-virus software</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure de sécurité informatique utilisée : système de surveillance qui permet de détecter des activités suspectes dans les systèmes informatiques et d&apos;en avertir les entreprises, autre qu&apos;un logiciel antivirus autonome</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMSMS1"><skos:prefLabel xml:lang="de">Eingesetzte IKT-Sicherheitsmaßnahme: Überwachungssystem zur Erkennung verdächtiger Aktivitäten in den IKT-Systemen (z. B. Systeme zur Erkennung oder Verhinderung von Eindringlingen, die das Verhalten von Benutzern oder Geräten sowie den Netzwerkverkehr überwachen), ausgenommen eigenständige Antivirensoftware und Standard-Firewall-Lösungen</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: monitoring system used to detect suspicious activity in the ICT systems (e.g. intrusion detection or prevention systems that monitors users’ or devices’ behaviour, network traffic) excluding standalone anti-virus software and default firewall solutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Mesure de sécurité des TIC utilisée : système de surveillance utilisé pour détecter toute activité suspecte dans les systèmes TIC (par exemple les systèmes de détection ou de prévention des intrusions qui surveillent le comportement des utilisateurs ou des appareils ou le trafic réseau), à l&apos;exclusion des logiciels antivirus autonomes et des solutions de pare-feu par défaut</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMSPSW"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Authentifizierung über sichere Passwörter</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: strong password authentication</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: authentification par mot de passe sûr</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMTST"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: IKT-Sicherheitstests</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: ICT security tests</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: tests de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMUIBM"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: Authentifizierung durch biometrische Erkennungsverfahren</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: authentication via biometric methods implemented by the enterprise</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: authentification à l&apos;aide de méthodes biométriques mises en œuvre par l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECMVPN"><skos:prefLabel xml:lang="de">Unternehmen mit IKT-Sicherheitsmaßnahme: VPN - Virtuelles Privates Netzwerk (verschlüsselte Erweiterung des firmeninternen Netzwerks über ein öffentliches Netzwerk, um einen sicheren Datenaustausch zu ermöglichen)</skos:prefLabel><skos:prefLabel xml:lang="en">ICT security measure used: VPN (Virtual Private Network extends a private network across a public network to enable secure exchange of data over public network)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises utilisant la mesure de sécurité des TIC: VPN (un Virtual Private Network étend un réseau privé à travers un réseau public pour permettre un échange de données sécurisé)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECNONE"><skos:prefLabel xml:lang="de">Das Unternehmen hat seine Mitarbeiter nicht auf ihre Verpflichtungen in Bezug auf IKT-Sicherheit hingewiesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have not made staff aware of their obligations in ICT security related issues</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises n&apos;ayant pas sensibilisé le personnel à ses obligations en matière de sécurité TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPALL"><skos:prefLabel xml:lang="de">Die Sicherheitspolitik berücksichtigt die Zerstörung oder Verfälschung von Daten, Offenlegung vertraulicher Daten sowie die Nichtverfügbarkeit von IKT-Leistungen infolge von Attacken oder aus Versehen</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security policy addressed the risks of destruction or corruption of data, disclosure of confidential data and unavailability of ICT services due to an attack or an accident</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité aborde le risque de destruction/altération de données, de divulgation de données confidentielles et d&apos;indisponibilité de services TIC suite à une attaque ou accident inattendu</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPAR"><skos:prefLabel xml:lang="de">Dokumente zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren umfassen: Verwaltung von Zugriffsrechten für die IKT-Nutzung</skos:prefLabel><skos:prefLabel xml:lang="en">The document(s) on measures, practices or procedures on ICT security address: management of access rights for the usage of ICT</skos:prefLabel><skos:prefLabel xml:lang="fr">Les documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC abordent: la gestion des droits d&apos;accès pour l&apos;utilisation des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPCNF"><skos:prefLabel xml:lang="de">Die Sicherheitspolitik berücksichtigt die Offenlegung vertraulicher Daten aufgrund von unbefugtem Eindringen in das System, Pharming- oder Phisching-Angriffen oder aus Versehen</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security policy addressed the risks of disclosure of confidential data due to intrusion, pharming, phishing attacks or by accident</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité aborde le risque de divulgation de données confidentielles suite à une intrusion, du pharming, de l&apos;hameçonnage (phishing) ou par accident</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPDD"><skos:prefLabel xml:lang="de">Die Sicherheitspolitik berücksichtigt die Zerstörung oder Verfälschung von Daten infolge von Attacken oder durch unerwartete Störungen</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security policy addressed the risks of destruction or corruption of data due to an attack or by unexpected incident</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité aborde le risque de destruction ou d&apos;altération de données suite à une attaque ou incident inattendu</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPDS"><skos:prefLabel xml:lang="de">Die Sicherheitspolitik berücksichtigt die Nichtverfügbarkeit von IKT-Leistungen aufgrund von Angriffen von außen (z.B. Denial of Service-Angriffe)</skos:prefLabel><skos:prefLabel xml:lang="en">The ICT security policy addressed the risks of unavailability of ICT services due to an attack from outside (e.g. Denial of Service attack)</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité aborde le risque d&apos;indisponibilité des services TIC suite à une attaque venue de l&apos;extérieur (ex. attaque en Déni de service)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPOL"><skos:prefLabel xml:lang="de">Das Unternehmen hatte eine formell festgelegte Sicherheitspolitik einschließlich eines Konzeptes mit regelmäßiger Überprüfung</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises had a formally defined ICT security policy with a plan of regular review</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant défini une politique de sécurité TIC incluant un plan de mises à jour régulières</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPOL1"><skos:prefLabel xml:lang="de">Das Unternehmen hatte eine formell festgelegte IT-Sicherheitspolitik (ab 2015)</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises had a formally defined ICT security policy (as of 2015)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant une politique de sécurité des TIC formellement définie (à partir de 2015)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPOL2"><skos:prefLabel xml:lang="de">Unternehmen verfügen über Dokumente zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have document(s) on measures, practices or procedures on ICT security</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises disposant de documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPPR"><skos:prefLabel xml:lang="de">Dokumente zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren umfassen: Vorgehensweisen oder Regeln, um IKT-Vorfälle zu verhindern oder auf diese zu reagieren</skos:prefLabel><skos:prefLabel xml:lang="en">The document(s) on measures, practices or procedures on ICT security address: procedures or rules to prevent or respond to security incidents</skos:prefLabel><skos:prefLabel xml:lang="fr">Les documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC abordent: les procédures ou règles pour prévenir ou faire face aux incidents de sécurité</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPREV_1_2"><skos:prefLabel xml:lang="de">Die IT-Sicherheitspolitik des Unternehmens wurde festgelegt oder zuletzt überarbeitet: vor 12 bis 24 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise&apos;s ICT security policy was defined or most recently reviewed more than 12 months and up to 24 months ago</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité des TIC a été définie ou revue le plus récemment entre les 12 à 24 mois qui précèdent</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPREV_CY"><skos:prefLabel xml:lang="de">Die IT-Sicherheitspolitik des Unternehmens wurde festgelegt oder zuletzt überarbeitet: innerhalb der letzten 12 Monate</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise&apos;s ICT security policy was defined or most recently reviewed within the last 12 months</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité des TIC a été définie ou revue le plus récemment au cours des 12 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPREV_LE2"><skos:prefLabel xml:lang="de">Die IT-Sicherheitspolitik des Unternehmens wurde festgelegt oder zuletzt überarbeitet: innerhalb der letzten 24 Monate</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise&apos;s ICT security policy was defined or most recently reviewed within the last 24 months</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité des TIC a été définie ou revue le plus récemment au cours des 24 derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPREV_MT2"><skos:prefLabel xml:lang="de">Die IT-Sicherheitspolitik des Unternehmens wurde festgelegt oder zuletzt überarbeitet: vor mehr als 24 Monaten</skos:prefLabel><skos:prefLabel xml:lang="en">The enterprise&apos;s ICT security policy was defined or most recently reviewed more than 24 months ago</skos:prefLabel><skos:prefLabel xml:lang="fr">La politique de sécurité des TIC a été définie ou revue le plus récemment il y a plus de 24 mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPRRD"><skos:prefLabel xml:lang="de">Dokumente zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren umfassen: Zuständigkeiten, Rechte und Pflichten von Beschäftigten in Bezug auf IKT</skos:prefLabel><skos:prefLabel xml:lang="en">The document(s) on measures, practices or procedures on ICT security address: responsibility, rights and duties of persons employed in the field of ICT</skos:prefLabel><skos:prefLabel xml:lang="fr">Les documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC abordent: la responsabilité, les droits et devoirs des personnes occupées dans le domaine des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPSPAP"><skos:prefLabel xml:lang="de">Dokumente zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren umfassen: Speicherung, Sicherung, Zugriff oder Verarbeitung von Daten</skos:prefLabel><skos:prefLabel xml:lang="en">The document(s) on measures, practices or procedures on ICT security address: storage, protection, access or processing of data</skos:prefLabel><skos:prefLabel xml:lang="fr">Les documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC abordent: le stockage, la protection, l&apos;accès ou le traitement des données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECPTRA"><skos:prefLabel xml:lang="de">Dokumente zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren umfassen: Schulung von Beschäftigten im sicheren Umgang mit IKT</skos:prefLabel><skos:prefLabel xml:lang="en">The document(s) on measures, practices or procedures on ICT security address: training of persons employed in the safe usage of ICT</skos:prefLabel><skos:prefLabel xml:lang="fr">Les documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC abordent: la formation des personnes occupées à l&apos;utilisation sécurisée des TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=E_SECVTGI"><skos:prefLabel xml:lang="de">Das Unternehmen hat seine Mitarbeiter auf ihre Verpflichtungen in Bezug auf IKT-Sicherheit durch freiwillige Schulungen oder Bereitstellung allgemein zugänglicher Informationen (im Intranet, in Rundschreiben oder gedruckten Dokumenten) hingewiesen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises have made staff aware of their obligations in ICT security related issues through voluntary training or generally available information (on the Intranet, news letters or paper documents)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant sensibilisé le personnel à ses obligations en matière de sécurité TIC par des formations sur base volontaire ou des informations accessibles à tous (p.ex. sur l&apos;intranet, dans une newsletter ou des documents papiers)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT"><skos:prefLabel xml:lang="de">Prozent der Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_CUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen die Computer verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of the enterprises which use a computer</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises utilisant l&apos;ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_IUSE"><skos:prefLabel xml:lang="de">Prozent der Unternehmen, in denen Beschäftigte Zugang zum Internet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises where persons employed have access to the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises avec personnes occupées ayant accès à l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_SECPOL"><skos:prefLabel xml:lang="de">Prozent der Unternehmen mit IKT Sicherheitspolitik</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises with an ICT security policy</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant une politique de sécurité TIC</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_SECPOL1"><skos:prefLabel xml:lang="de">Prozent der Unternehmen mit IKT Sicherheitspolitik (ab 2015)</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises with an ICT security policy (as of 2015)</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises ayant une politique de sécurité TIC (à partir de 2015)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_ENT_SECPOL2"><skos:prefLabel xml:lang="de">Prozent der Unternehmen mit Dokumenten zu IKT-Sicherheitsmaßnahmen, -vorgehensweisen oder -verfahren (ab 2019)</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of enterprises with  document(s) on measures, practices or procedures on ICT security (as of 2019)</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des entreprises disposant de documents sur les mesures, pratiques ou procédures en matière de sécurité des TIC (à partir de 2019)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26337</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-10</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">