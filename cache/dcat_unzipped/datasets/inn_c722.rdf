pt></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=NR"><skos:prefLabel xml:lang="de">Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Number</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=REL2"><skos:prefLabel xml:lang="de">Relativer Wert für innovative Unternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Relative value, relating to innovating enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Valeur relative par rapport aux entreprises innovantes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SCLI_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen der Kundschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Sources for innovation from Clients or customers, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant des clients</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SCOM_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen der Wettbewerber oder anderer Unternehmen desselben Wirtschaftszweigs</skos:prefLabel><skos:prefLabel xml:lang="en">Sources from Competitors for innovation and other enterprises of same industry, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant des concurrents ou d&apos;autres entreprises du même secteur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SCON_NO"><skos:prefLabel xml:lang="de">Beratungsunternehmen</skos:prefLabel><skos:prefLabel xml:lang="en">Consultancy enterprises</skos:prefLabel><skos:prefLabel xml:lang="fr">Sociétés de conseil</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SENT_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Informationsquellen innerhalb des Unternehmens</skos:prefLabel><skos:prefLabel xml:lang="en">Sources from within the enterprise, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information au sein de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SEXB_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen bei Messen und Ausstellungen</skos:prefLabel><skos:prefLabel xml:lang="en">Sources for innovation from Fairs, exhibitions, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant de foires et expositions</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SGMT_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen staatlicher oder privater, gemeinnütziger Forschungseinrichtungen</skos:prefLabel><skos:prefLabel xml:lang="en">Sources from Government for innovation or private non-profit research institutes, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant des instituts publics de recherche</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SGRP_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen anderer Unternehmen der Unternehmensgruppe</skos:prefLabel><skos:prefLabel xml:lang="en">Sources for innovation from Other enterprises within the enterprise group, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant d&apos;autres entreprises au sein du groupe</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SNET_NO"><skos:prefLabel xml:lang="de">Rechnergestützte Informationsnetze</skos:prefLabel><skos:prefLabel xml:lang="en">Computer based information networks</skos:prefLabel><skos:prefLabel xml:lang="fr">Réseaux informatiques d&apos;information</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SPAT_NO"><skos:prefLabel xml:lang="de">Offenlegung von Patenten</skos:prefLabel><skos:prefLabel xml:lang="en">Patent disclosures</skos:prefLabel><skos:prefLabel xml:lang="fr">Publication de brevets</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SPRO_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen bei Fachkonferenzen und -kongressen sowie in Fachzeitschriften</skos:prefLabel><skos:prefLabel xml:lang="en">Sources for innovation from Professional conferences, meetings, journals, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant de conférences professionnelles, de réunions, de la presse</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SSUP_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen der Lieferanten von Ausrüstung, Rohstoffen, Bauteilen usw.</skos:prefLabel><skos:prefLabel xml:lang="en">Sources for innovation from Suppliers of equipment, materials, etc., not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant des fournisseurs d&apos;équipements, de matériel, etc.</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=SUNI_NO"><skos:prefLabel xml:lang="de">Keine Nutzung von Innovationsquellen der Universitäten oder anderer Hochschulen</skos:prefLabel><skos:prefLabel xml:lang="en">Sources for innovation from Universities or other higher education institutes, not used</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucune utilisation des sources d&apos;information pour des projets d&apos;innovation provenant des universités ou d&apos;établissements d&apos;enseignement supérieur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6208</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XML