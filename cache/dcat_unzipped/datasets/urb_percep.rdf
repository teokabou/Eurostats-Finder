1/codelist/ESTAT/INDIC_UR?code=PS3353V"><skos:prefLabel xml:lang="de">Das Leben, das Sie führen: Überhaupt nicht zufrieden</skos:prefLabel><skos:prefLabel xml:lang="en">The life you lead: not at all satisfied</skos:prefLabel><skos:prefLabel xml:lang="fr">La vie que vous menez: pas satisfait du tout</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3354V"><skos:prefLabel xml:lang="de">Das Leben, das Sie führen: weiß nicht/keine Antwort</skos:prefLabel><skos:prefLabel xml:lang="en">The life you lead: don&apos;t know / no answer</skos:prefLabel><skos:prefLabel xml:lang="fr">La vie que vous menez: ne sait pas/sans réponse</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3360V"><skos:prefLabel xml:lang="de">Sie sind mit dem Leben in dieser Stadt zufrieden: stimme sehr zu</skos:prefLabel><skos:prefLabel xml:lang="en">I&apos;m satisfied to live in this city: strongly agree</skos:prefLabel><skos:prefLabel xml:lang="fr">Je suis satisfait(e) de vivre dans cette ville: tout à fait d&apos;accord</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3361V"><skos:prefLabel xml:lang="de">Sie sind mit dem Leben in dieser Stadt zufrieden: stimme eher zu</skos:prefLabel><skos:prefLabel xml:lang="en">I&apos;m satisfied to live in this city: somewhat agree</skos:prefLabel><skos:prefLabel xml:lang="fr">Je suis satisfait(e) de vivre dans cette ville: plutôt d&apos;accord</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3362V"><skos:prefLabel xml:lang="de">Sie sind mit dem Leben in dieser Stadt zufrieden: stimme eher nicht zu</skos:prefLabel><skos:prefLabel xml:lang="en">I&apos;m satisfied to live in this city: somewhat disagree</skos:prefLabel><skos:prefLabel xml:lang="fr">Je suis satisfait(e) de vivre dans cette ville: plutôt pas satisfait</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3363V"><skos:prefLabel xml:lang="de">Sie sind mit dem Leben in dieser Stadt zufrieden: stimme überhaupt nicht zu</skos:prefLabel><skos:prefLabel xml:lang="en">I&apos;m satisfied to live in this city: strongly disagree</skos:prefLabel><skos:prefLabel xml:lang="fr">Je suis satisfait(e) de vivre dans cette ville: pas d&apos;accord du tout</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3364V"><skos:prefLabel xml:lang="de">Sie sind mit dem Leben in dieser Stadt zufrieden: weiß nicht/keine Antwort</skos:prefLabel><skos:prefLabel xml:lang="en">I&apos;m satisfied to live in this city: don&apos;t know / no answer</skos:prefLabel><skos:prefLabel xml:lang="fr">Je suis satisfait(e) de vivre dans cette ville: ne sait pas/sans réponse</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3501V"><skos:prefLabel xml:lang="de">Würden Sie sagen, dass Sie in den letzten 12 Monaten Schwierigkeiten hatten, Ihre Rechnungen am Monatsende zu begleichen? Meistens</skos:prefLabel><skos:prefLabel xml:lang="en">Within the last 12 months, would you say you had difficulties to pay your bills at the end of the month: most of the time</skos:prefLabel><skos:prefLabel xml:lang="fr">Diriez-vous que vous avez eu des difficultés à payer vos factures à la fin du mois au cours des 12 derniers mois: la plupart du temps</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3502V"><skos:prefLabel xml:lang="de">Würden Sie sagen, dass Sie in den letzten 12 Monaten Schwierigkeiten hatten, Ihre Rechnungen am Monatsende zu begleichen? Gelegentlich</skos:prefLabel><skos:prefLabel xml:lang="en">Within the last 12 months, would you say you had difficulties to pay your bills at the end of the month: from time to time</skos:prefLabel><skos:prefLabel xml:lang="fr">Diriez-vous que vous avez eu des difficultés à payer vos factures à la fin du mois au cours des 12 derniers mois: parfois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3503V"><skos:prefLabel xml:lang="de">Würden Sie sagen, dass Sie in den letzten 12 Monaten Schwierigkeiten hatten, Ihre Rechnungen am Monatsende zu begleichen? So gut wie nie/nie</skos:prefLabel><skos:prefLabel xml:lang="en">Within the last 12 months, would you say you had difficulties to pay your bills at the end of the month: almost never/never</skos:prefLabel><skos:prefLabel xml:lang="fr">Diriez-vous que vous avez eu des difficultés à payer vos factures à la fin du mois au cours des 12 derniers mois: presque jamais/jamais</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3504V"><skos:prefLabel xml:lang="de">Würden Sie sagen, dass Sie in den letzten 12 Monaten Schwierigkeiten hatten, Ihre Rechnungen am Monatsende zu begleichen? Weiß nicht/keine Angaben/möchte keine Angaben machen</skos:prefLabel><skos:prefLabel xml:lang="en">Within the last 12 months, would you say you had difficulties to pay your bills at the end of the month: don&apos;t know/no answer/refuses</skos:prefLabel><skos:prefLabel xml:lang="fr">Diriez-vous que vous avez eu des difficultés à payer vos factures à la fin du mois au cours des 12 derniers mois : je ne sais pas/n&apos;ai pas d&apos;avis/refuse de répondre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3505V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: Auto</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: car</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: voiture</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3506V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: Motorrad</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: motorcycle</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: moto</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3507V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: Fahrrad</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: bicycle</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: vélo</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3508V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: Ich gehe zu Fuß</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: foot</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: à pied</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3509V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: Zug</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: train</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: train</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3510V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: städtische Nahverkehrsmittel</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: urban public transport</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: transport publics urbains</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3511V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: sonstige</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: other</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: autre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3512V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: Ich pendle nicht</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: do not commute</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: ne me déplace pas</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3513V"><skos:prefLabel xml:lang="de">Transportmittel, das Sie am häufigsten nutzen: weiß nicht/keine Angaben/möchte keine Angaben machen</skos:prefLabel><skos:prefLabel xml:lang="en">Means of transport most often used: don&apos;t know / no answer / refuses</skos:prefLabel><skos:prefLabel xml:lang="fr">Moyen de transport le plus souvent utilisé: je ne sais pas/n&apos;ai pas d&apos;avis/refuse de répondre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3514V"><skos:prefLabel xml:lang="de">Ich fühle mich sicher, nachts alleine durch meine Stadt zu laufen: stimme voll und ganz zu</skos:prefLabel><skos:prefLabel xml:lang="en">I feel safe walking alone at night in my city: strongly agree</skos:prefLabel><skos:prefLabel xml:lang="fr">Je me sens en sécurité lorsque je marche dans ma ville la nuit: tout à fait d&apos;accord</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_UR?code=PS3515V"><skos:prefLabel xml:lang="de">Ich fühle mich sicher, nachts alleine durch meine Stadt zu laufen: stimme einigermaßen zu</skos:prefLabel><skos:prefLabel xml:lang="en">I feel safe walking alone at night in my city: somewhat agree</skos:prefLabel><skos:prefLabel xml:lang="fr">Je me sens en sécurité lorsque je marche dans ma ville la nuit: plutôt d&apos;accord</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC