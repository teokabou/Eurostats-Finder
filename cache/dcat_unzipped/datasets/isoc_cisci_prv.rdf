<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_cisci_prv"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-12-11</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Privacy and protection of personal information (2015-2016)</dct:title><dct:description xml:lang="en">Privacy and protection of personal information (2015-2016)</dct:description><dct:title xml:lang="fr">Respect de la vie privée et protection des informations personnelles (2015-2016)</dct:title><dct:description xml:lang="fr">Respect de la vie privée et protection des informations personnelles (2015-2016)</dct:description><dct:title xml:lang="de">Schutz personenbezogener Daten (2015-2016)</dct:title><dct:description xml:lang="de">Schutz personenbezogener Daten (2015-2016)</dct:description><dct:identifier>isoc_cisci_prv</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_prv"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_ATSW"><skos:prefLabel xml:lang="de">Personen, die eine Software verwenden, die das Aufzeichnen ihrer Online-Aktivitäten steuert bzw. einschränkt</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals use anti-tracking software (software that limits the ability to track their activities on the internet)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant pas modifié les paramètres de leur navigateur internet afin d&apos;empêcher ou de limiter la création de cookies sur leur ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_ATSWX"><skos:prefLabel xml:lang="de">Personen, die keine Software verwenden, die das Aufzeichnen ihrer Online-Aktivitäten steuert bzw. einschränkt</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals don&apos;t use anti-tracking software (software that limits the ability to track their activities on the internet)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant modifié les paramètres de leur navigateur internet afin d&apos;empêcher ou de limiter la création de cookies sur leur ordinateur</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_COOK"><skos:prefLabel xml:lang="de">Personen, denen bekannt ist, dass Cookies verwendet werden können, um das Internetverhalten von Personen zu beobachten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who know that cookies can be used to trace movements of people on the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui savent que les cookies peuvent être utilisés pour tracer les activités d&apos;un internaute sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_COOKX"><skos:prefLabel xml:lang="de">Personen, denen nicht bekannt ist, dass Cookies verwendet werden können, um das Internetverhalten von Personen zu beobachten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who don&apos;t know that cookies can be used to trace movements of people on the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ne savent pas que les cookies peuvent être utilisés pour tracer les activités d&apos;un internaute sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_COOK_PCOOK"><skos:prefLabel xml:lang="de">Personen, denen bekannt ist, dass Cookies verwendet werden können, um das Internetverhalten von Personen zu beobachten, und die die Einstellungen ihres Internetbrowsers verändert haben, um die Anzahl der gespeicherten Cookies einzuschränken oder zu verhindern</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who know that cookies can be used to trace movements of people on the internet and who have ever changed the settings in their internet browser to prevent or limit them</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui savent que des cookies peuvent être utilisés pour tracer les manipulations et activités d&apos;un internaute sur l&apos;internet et qui ont Déjà modifié les paramètres de leur navigateur internet afin d&apos;empêcher ou de limiter la création de cookies</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_COOK_PCOOKX"><skos:prefLabel xml:lang="de">Personen, denen bekannt ist, dass Cookies verwendet werden können, um das Internetverhalten von Personen zu beobachten, die aber nie die Einstellungen ihres Internetbrowsers verändert haben, um die Anzahl der gespeicherten Cookies einzuschränken oder zu verhindern</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who know that cookies can be used to trace movements of people on the internet and who have never changed the settings in their internet browser to prevent or limit them</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui savent que des cookies peuvent être utilisés pour tracer les manipulations et activités d&apos;un internaute sur l&apos;internet et qui n&apos;ont jamais modifié les paramètres de leur navigateur internet afin d&apos;empêcher ou de limiter la création de cookies</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PCOOK"><skos:prefLabel xml:lang="de">Personen, die die Einstellungen Ihres Internetbrowsers verändert haben, um die Anzahl der gespeicherten Cookies einzuschränken oder zu verhindern</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals have ever changed the settings in their internet browser to prevent or limit the amount of cookies</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui ont Déjà modifié les paramètres de leur navigateur internet afin d&apos;empêcher ou de limiter la création de cookies</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PCOOKX"><skos:prefLabel xml:lang="de">Personen, die nie die Einstellungen ihres Internetbrowsers verändert haben, um die Anzahl der gespeicherten Cookies einzuschränken oder zu verhindern</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals who have never changed the settings in their internet browser to prevent or limit the amount of cookies</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers qui n&apos;ont jamais modifié les paramètres de leur navigateur internet afin d&apos;empêcher ou de limiter la création de cookies</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PI"><skos:prefLabel xml:lang="de">Personen, die persönlichen Informationen über das Internet weitergegeben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals provided personal information over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant renseigné les informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIAC"><skos:prefLabel xml:lang="de">Personen, die den Zugriff auf ihre persönlichen Informationen im Internet kontrollieren, indem sie wenigstens eine der Aktivitäten (i_piacpp, i_piacgeo, i_piacsn, i_piacadv, i_piacsweb, i_piacud) durchführten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals managed access to their personal information on the internet by doing at least one of the selected activities (i_piacpp, i_piacgeo, i_piacsn, i_piacadv, i_piacsweb, i_piacud)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant effectué au moins une des actions (i_piacpp, i_piacgeo, i_piacsn, i_piacadv, i_piacsweb, i_piacud) pour protéger leurs informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIACADV"><skos:prefLabel xml:lang="de">Personen, die keine Zustimmung erteilt haben, um ihre personenbezogenen Daten zu Werbezwecken zu verwenden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals managed access to their personal information on the internet by not allowing the use of personal information for advertising purposes</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant refusé l&apos;utilisation de leur données personnelles à des fins publicitaires pour protéger leurs informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIACGEO"><skos:prefLabel xml:lang="de">Personen, die die Zugriffsmöglichkeit auf ihre geographischen Standortdaten beschränkt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals managed access to their personal information on the internet by restricting access to their geograpical location</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant limité l&apos;accès à leur localisation géographique pour protéger leurs informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIACPP"><skos:prefLabel xml:lang="de">Personen, die die Datenschutzerklärung gelesen haben, bevor sie personenbezogene Daten im Internet weitergegeben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals managed access to their personal information on the internet by reading privacy policy statements before providing personal information</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant lu les informations sur la politique de respect de la vie privée avant de transmettre des informations personnelles pour protéger leurs informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIACSN"><skos:prefLabel xml:lang="de">Personen, die die Zugangsmöglichkeiten zu ihrem Profil oder Inhalten auf Websites sozialer Netzwerke begrenzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals managed access to their personal information on the internet by limiting access to their profile or content on social networking sites</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant limité l&apos;accès à leur profil ou à leurs données sur les sites de médias sociaux pour protéger leurs informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIACSWEB"><skos:prefLabel xml:lang="de">Personen, die den Sicherheitsstatus der Website geprüft haben, auf der sie persönliche Informationen angeben mussten</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals managed access to their personal information on the internet by checking that the website where they needed to provide personal information was secure (e.g. https sites, safety logo or certificate)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant contrôlé la sécurité d&apos;un site sur lequel ils devaient transmettre des données personnelles (p.ex. sites https, logo ou certificat de sécurité) pour protéger leurs informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIACUD"><skos:prefLabel xml:lang="de">Personen, die Zugang zu den persönlichen Informationen beantragt haben, die Websites oder Suchmaschinen über sie gespeichert haben und verwalten, um diese zu aktualisieren oder zu löschen</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals managed access to their personal information on the internet by asking websites or search engines to access the information hold about them to be updated or deleted</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant demandé à des sites internet ou à des moteurs de recherche d&apos;adapter ou de supprimer leurs données personnelles pour protéger leurs informations personnelles sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PICON"><skos:prefLabel xml:lang="de">Personen, die persönliche Kontaktdaten über das Internet weitergegeben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals provided contact details over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant renseigné leurs coordonnées sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIOTH"><skos:prefLabel xml:lang="de">Personen, die andere persönliche Informationen ( z. B. Fotos, aktuelle Standortangaben, gesundheits-, beschäftigungs- oder einkommensbezogene Informationen ) über das Internet weitergegeben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals provided other personal information over the internet (e.g. photos, current location, information related to health, employment, income)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant renseigné d&apos;autres informations sur l&apos;internet (p.ex. photos, lieu où ils se trouvent, informations relatives à la santé, l&apos;emploi, le revenu)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIPAY"><skos:prefLabel xml:lang="de">Personen, die persönliche Zahlungsdetails über das Internet weitergegeben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals provided payment details over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant renseigné les informations bancaires sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIPER"><skos:prefLabel xml:lang="de">Personen, die persönliche Angaben über das Internet weitergegeben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals provided personal details over the internet (name, date of birth, identity card number)</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers ayant renseigné leurs données personnelles sur l&apos;internet (nom, date de naissance, numéro de carte d&apos;identité)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_PIX"><skos:prefLabel xml:lang="de">Personen, die keine persönlichen Informationen über das Internet weitergegeben haben</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals did not provide any personal information over the internet</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers n&apos;ayant renseigné aucune information ou donnée personnelle sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TADVS"><skos:prefLabel xml:lang="de">Personen sind etwas besorgt, dass ihre Online-Aktivitäten aufgezeichnet und für gezielte Werbung an sie genutzt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals are somewhat concerned with their online activities being recorded to provide them with tailored advertising</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers étant un peu préoccupés par le fait que leurs activités en ligne soient enregistrées afin de leur présenter des publicités sur mesure</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TADVV"><skos:prefLabel xml:lang="de">Personen sind sehr besorgt, dass ihre Online-Aktivitäten aufgezeichnet und für gezielte Werbung an sie genutzt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals are very concerned with their online activities being recorded to provide them with tailored advertising</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers étant très préoccupés par le fait que leurs activités en ligne soient enregistrées afin de leur présenter des publicités sur mesure</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TADVVS"><skos:prefLabel xml:lang="de">Personen sind besorgt, dass ihre Online-Aktivitäten aufgezeichnet und für gezielte Werbung an sie genutzt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals are concerned (to any degree) with their online activities being recorded to provide them with tailored advertising</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers étant préoccupés par le fait que leurs activités en ligne soient enregistrées afin de leur présenter des publicités sur mesure</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_TADVX"><skos:prefLabel xml:lang="de">Personen sind gar nicht besorgt, dass ihre Online-Aktivitäten aufgezeichnet und für gezielte Werbung an sie genutzt werden</skos:prefLabel><skos:prefLabel xml:lang="en">Individuals are not concerned at all with their online activities being recorded to provide them with tailored advertising</skos:prefLabel><skos:prefLabel xml:lang="fr">Particuliers étant pas du tout préoccupés par le fait que leurs activités en ligne soient enregistrées afin de leur présenter des publicités sur mesure</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_ILT12"><skos:prefLabel xml:lang="de">Prozent der Personen, die im letzten Jahr das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet within the last year</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours de l&apos;année dernière</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">127716</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_prv"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_prv</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_prv"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_i_esms.sdmx.zip"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) SDMX</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cisci_prv"/><schema:url xml:lang="en"><![CDATA[https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/isoc_i_esms.sdmx.zip]]></schema:url><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/XML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/application/xml"/><dct:type><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/documentation-type/DOCUMENTATION_MAIN"/></dct:type></foaf:Document></foaf:page><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/databrowser/view/isoc_cisci_prv/default/table"><dct:title xml:lang="en">Table, graphs and map visualizations are also available.</dct:title><dct:title xml:lang="fr">Des visualisations sous forme de tableau, graphique et carte géographique sont aussi disponibles.</dct:title><dct:title xml:lang="de">Tabellen, Grafiken und geografische Darstellungen sind ebenfalls verfügbar.</dct:title><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/isoc_cisci_prv/default/table"/><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/VISUALIZATION"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dct:rights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/HTML"/><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/html"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/isoc_cisci_prv?format=tsv&amp;compressed=true"><dct:title xml:lang="en">Download dataset in TSV format</dct:title><dct:type rdf:resource="http://publications.europa.eu/resource/authority/distribution-type/DOWNLOADABLE_FILE"/><dcat:accessURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/isoc_cisci_prv?format=tsv&amp;compressed=true"/><dcat:downloadURL rdf:resource="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/data/isoc_cisci_prv?format=tsv&amp;compressed=true"/><dct:compressformat><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/GZIP"/></dct:compressformat><dct:format><dct:MediaTypeOrExtent rdf:about="http://publications.europa.eu/resource/authority/file-type/TSV"/></dct:format><dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/tab-separated-values"/><dct:license><dct:LicenseDocument rdf:about="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dct:license><dct:rights rdf:resour