dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN" > <skos:prefLabel xml:lang="de">Innovationsindikator</skos:prefLabel><skos:prefLabel xml:lang="en">Innovation indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur l&apos;innovation</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/NACE_R2" > <skos:prefLabel xml:lang="de">Statistische Systematik der Wirtschaftszweige in der Europäischen Gemeinschaft (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="en">Statistical classification of economic activities in the European Community (NACE Rev. 2)</skos:prefLabel><skos:prefLabel xml:lang="fr">Nomenclature statistique des activités économiques dans la Communauté européenne (NACE Rév. 2)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/SIZECLAS" > <skos:prefLabel xml:lang="de">Größenklassen nach Anzahl der Arbeitnehmer</skos:prefLabel><skos:prefLabel xml:lang="en">Size classes in number of employees</skos:prefLabel><skos:prefLabel xml:lang="fr">Classes de taille en nombre de salariés</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/TYPE_INN" > <skos:prefLabel xml:lang="de">Gliederung nach Innovationsart</skos:prefLabel><skos:prefLabel xml:lang="en">Breakdown by type of innovator</skos:prefLabel><skos:prefLabel xml:lang="fr">Ventilation par type d&apos;innovateur</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=ENT_POPU14"><skos:prefLabel xml:lang="de">Anzahl der Unternehmen in der Grundgesamtheit des Jahres 2014</skos:prefLabel><skos:prefLabel xml:lang="en">Total number of enterprises in the population in 2014</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre total d&apos;entreprises dans la population en 2014</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=FWTURN1"><skos:prefLabel xml:lang="de">Unternehmen, bei denen 2012 der Anteil weltweit erstmals auf den Markt gebrachter Produktinnovationen am Gesamtumsatz &gt;0 % und &lt;1 % beträgt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the percent of the total turnover in 2012 from world first product innovation is &gt;0% and &lt;1%</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le pourcentage du chiffre d&apos;affaires dû aux innovations de produit en première mondiale se situe entre &gt;0% et &lt;1%</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=FWTURN2"><skos:prefLabel xml:lang="de">Unternehmen, bei denen 2012 der Anteil weltweit erstmals auf den Markt gebrachter Produktinnovationen am Gesamtumsatz ?1 % und &lt;5 % beträgt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the percent of the total turnover in 2012 from world first product innovation is ?1% and &lt;5%</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le pourcentage du chiffre d&apos;affaires dû aux innovations de produit en première mondiale se situe entre ?1% et &lt;5%</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=FWTURN3"><skos:prefLabel xml:lang="de">Unternehmen, bei denen 2012 der Anteil weltweit erstmals auf den Markt gebrachter Produktinnovationen am Gesamtumsatz ?5 % und &lt;10 % beträgt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the percent of the total turnover in 2012 from world first product innovation is ?5% and &lt;10%</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le pourcentage du chiffre d&apos;affaires dû aux innovations de produit en première mondiale se situe entre ?5% et &lt;10%</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=FWTURN4"><skos:prefLabel xml:lang="de">Unternehmen, bei denen 2012 der Anteil weltweit erstmals auf den Markt gebrachter Produktinnovationen am Gesamtumsatz ?10 % und &lt;25 % beträgt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the percent of the total turnover in 2012 from world first product innovation is ?10% and &lt;25%</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le pourcentage du chiffre d&apos;affaires dû aux innovations de produit en première mondiale se situe entre ?10% et &lt;25%</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=FWTURN5"><skos:prefLabel xml:lang="de">Unternehmen, bei denen 2012 der Anteil weltweit erstmals auf den Markt gebrachter Produktinnovationen am Gesamtumsatz ?25 % beträgt</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises for which the percent of the total turnover in 2012 from world first product innovation is ?25%</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises dont le pourcentage du chiffre d&apos;affaires dû aux innovations de produit en première mondiale s&apos;élève à plus de 25%</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=FWTURN6"><skos:prefLabel xml:lang="de">Unternehmen, denen der Anteil weltweit erstmals auf den Markt gebrachter Produktinnovationen am Gesamtumsatz für 2012 nicht bekannt ist</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that don&apos;t know which percent of the total turnover in 2012 is from world first product innovation</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises qui ne connaissent pas le pourcentage de leur chiffre d&apos;affaires total 2012 dû aux innovations de produit en première mondiale</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDFW_YES"><skos:prefLabel xml:lang="de">Unternehmen, die mindestens eine Produktinnovation &quot;weltweit erstmals&quot; auf den Markt gebracht haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced at least one &quot;world first&quot; product innovation&quot;</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant au moins introduit une innovation de produit en &quot;première mondiale&quot;</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_ADP_NRD"><skos:prefLabel xml:lang="de">Unternehmen, die Produkt- und/oder Verfahrensinnovationen entwickelt haben, indem sie Waren, Dienstleistungen oder Verfahren angepasst oder verändert haben, die ursprünglich von anderen Unternehmen oder Einrichtungen entwickelt worden waren / Nicht-FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed product and/or process innovation by adapting or modifying goods, services or process originally developed by other enterprises or institutions / non R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé une innovation de produit et/ou de procédé en adaptant ou en modifiant des biens, des services ou des procédés développés initialement par d&apos;autres entreprises ou organisations / non R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_ADP_RD"><skos:prefLabel xml:lang="de">Unternehmen, die Produkt- und/oder Verfahrensinnovationen entwickelt haben, indem sie Waren, Dienstleistungen oder Verfahren angepasst oder verändert haben, die ursprünglich von anderen Unternehmen oder Einrichtungen entwickelt worden waren / FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed product and/or process innovation by adapting or modifying goods, services or process originally developed by other enterprises or institutions / R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé une innovation de produit et/ou de procédé en adaptant ou en modifiant des biens, des services ou des procédés développés initialement par d&apos;autres entreprises ou organisations / R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_COP_NRD"><skos:prefLabel xml:lang="de">Unternehmen, die Produkt- und/oder Verfahrensinnovationen zusammen mit anderen Unternehmen oder Einrichtungen entwickelt haben / Nicht-FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed product and/or process innovation together with other enterprises or institutions / non R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé une innovation de produit et/ou de procédé en coopération avec d&apos;autres entreprises ou organisations / non R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_COP_RD"><skos:prefLabel xml:lang="de">Unternehmen, die Produkt- und/oder Verfahrensinnovationen zusammen mit anderen Unternehmen oder Einrichtungen entwickelt haben / FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed product and/or process innovation together with other enterprises or institutions / R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé une innovation de produit et/ou de procédé en coopération avec d&apos;autres entreprises ou organisations / R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_ENT_NRD"><skos:prefLabel xml:lang="de">Unternehmen, die Produkt- und/oder Verfahrensinnovationen selbst entwickelt haben / Nicht-FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed product and/or process innovation by itself / non R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé une innovation de produit et/ou de procédé en interne / non R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_ENT_RD"><skos:prefLabel xml:lang="de">Unternehmen, die Produkt- und/oder Verfahrensinnovationen selbst entwickelt haben / FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed product and/or process innovation by itself / R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé une innovation de produit et/ou de procédé en interne / R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_OTH_NRD"><skos:prefLabel xml:lang="de">Unternehmen, die von anderen Unternehmen oder Einrichtungen entwickelte Produkt- und/oder Verfahrensinnovationen eingeführt haben / Nicht-FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced product and/or process innovation developed by other enterprises or institutions / non R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation de produit et/ou de procédé développée par d&apos;autres entreprises ou organisations / non R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDPC_OTH_RD"><skos:prefLabel xml:lang="de">Unternehmen, die von anderen Unternehmen oder Einrichtungen entwickelte Produkt- und/oder Verfahrensinnovationen eingeführt haben / FuE-Akteure</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced product and/or process innovation developed by other enterprises or institutions / R&amp;D performers</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation de produit et/ou de procédé développée par d&apos;autres entreprises ou organisations / R&amp;D</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTG1"><skos:prefLabel xml:lang="de">Unternehmen mit selbst entwickelten Innovationen von Waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed goods innovation by themselves</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de biens par elles-mêmes ou par le groupe d&apos;entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTG2"><skos:prefLabel xml:lang="de">Unternehmen mit Innovationen von Waren, die zusammen mit anderen Unternehmen oder Einrichtungen entwickelt wurden</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed goods innovation in cooperation with other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de biens en collaboration avec d&apos;autres entreprises ou institutions</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTG3"><skos:prefLabel xml:lang="de">Unternehmen mit Produktinnovationen von Waren, die sie durch Anpassung oder Veränderung von Waren entwickelt haben, die ursprünglich andere Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed goods innovation by adapting or modifying goods originally developed by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de biens en adaptant ou en modifiant des biens developpés à l&apos;origine par d&apos;autres entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTG4"><skos:prefLabel xml:lang="de">Unternehmen, die Innovationen von Waren eingeführt haben, die andere Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced goods innovation developed by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit des innovations de biens développées par d&apos;autres entreprises ou institutions</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTS1"><skos:prefLabel xml:lang="de">Unternehmen mit selbst entwickelten Innovationen von Dienstleistungen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed service innovation by themselves</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de services par elles-mêmes ou par le groupe d&apos;entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTS2"><skos:prefLabel xml:lang="de">Unternehmen mit Innovationen von Dienstleistungen, die sie zusammen mit anderen Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed service innovation in cooperation with other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de services en collaboration avec d&apos;autres entreprises ou institutions</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTS3"><skos:prefLabel xml:lang="de">Unternehmen mit Innovationen von Dienstleistungen, die sie durch Anpassung oder Veränderung von Dienstleistungen entwickelt haben, die ursprünglich andere Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed service innovation by adapting or modifying services originally developed by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de services en adaptant ou en modifiant des services developpés à l&apos;origine par d&apos;autres entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPDTS4"><skos:prefLabel xml:lang="de">Unternehmen, die Innovationen von Dienstleistungen eingeführt haben, die andere Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced service innovation developed by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit des innovations de services développées par d&apos;autres entreprises ou institutions</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPSDV1"><skos:prefLabel xml:lang="de">Unternehmen mit selbst entwickelten Prozessinnovationen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed process innovation by themselves</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de procédés par elles-mêmes ou par le groupe d&apos;entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPSDV2"><skos:prefLabel xml:lang="de">Unternehmen mit Prozessinnovationen, die sie zusammen mit anderen Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed process innovation in cooperation with other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de procédés en collaboration avec d&apos;autres entreprises ou institutions</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPSDV3"><skos:prefLabel xml:lang="de">Unternehmen mit Prozessinnovationen, die sie durch Anpassung oder Veränderung von Prozessen entwickelt haben, die ursprünglich andere Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that developed process innovation by adapting or modifying processs originally developed by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant développé des innovations de procédés en adaptant ou en modifiant des procédés developpés à l&apos;origine par d&apos;autres entreprises</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPSDV4"><skos:prefLabel xml:lang="de">Unternehmen, die Prozessinnovationen eingeführt haben, die andere Unternehmen oder Einrichtungen entwickelt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that introduced process innovation developed by other enterprises or institutions</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit des innovations de procédés développées par d&apos;autres entreprises ou institutions</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPSNM0"><skos:prefLabel xml:lang="de">Unternehmen mit Prozessinnovationen, die keine Marktneuheit waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that have introduced process innovation not new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation de procédé qui n&apos;était pas nouvelle sur le marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPSNM1"><skos:prefLabel xml:lang="de">Unternehmen mit Prozessinnovationen, die sie als Marktneuheit eingeführt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that have introduced process innovation new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation de procédé qui était nouvelle sur le marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=INPSNM2"><skos:prefLabel xml:lang="de">Unternehmen, die Prozessinnovationen eingeführt haben, ohne zu wissen, ob sie Marktneuheiten waren</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that have introduced process innovation without knowing if it was new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit une innovation de procédé sans savoir si elle était nouvelle sur le marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=NEWFRM_TURN"><skos:prefLabel xml:lang="de">Umsatz mit neuen oder erheblich verbesserten Produkten, die nur für das Unternehmen neu sind</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover from new or significantly improved products only new to the firm</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux nouveaux produits ou aux produits améliorés de manière significative dont la nouveauté est située à l&apos;échelle de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=NEWFRM_YES"><skos:prefLabel xml:lang="de">Unternehmen mit neuen oder erheblich verbesserten Produkten, die nur für die Unternehmen neu sind</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that have introduced new or significantly improved products that were only new to the firm</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit de nouveaux produits ou des produits améliorés de manière significative dont la nouveauté est située à l&apos;échelle de l&apos;entreprise</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=NEWMAR_TURN"><skos:prefLabel xml:lang="de">Umsatz mit neuen oder erheblich verbesserten Produkten, die Marktneuheiten darstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover from new or significantly improved products that were new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux nouveaux produits ou aux produits améliorés de manière significative dont la nouveauté est située à l&apos;échelle du marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=NEWMAR_YES"><skos:prefLabel xml:lang="de">Unternehmen mit neuen oder erheblich verbesserten Produkten, die Marktneuheiten darstellen</skos:prefLabel><skos:prefLabel xml:lang="en">Enterprises that have introduced new or significantly improved products that were new to the market</skos:prefLabel><skos:prefLabel xml:lang="fr">Entreprises ayant introduit de nouveaux produits ou des produits améliorés de manière significative dont la nouveauté est située à l&apos;échelle du marché</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=NR"><skos:prefLabel xml:lang="de">Anzahl</skos:prefLabel><skos:prefLabel xml:lang="en">Number</skos:prefLabel><skos:prefLabel xml:lang="fr">Nombre</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC"><skos:prefLabel xml:lang="de">Prozent</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=THS_EUR"><skos:prefLabel xml:lang="de">Tausend Euro</skos:prefLabel><skos:prefLabel xml:lang="en">Thousand euro</skos:prefLabel><skos:prefLabel xml:lang="fr">Milliers d&apos;euros</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IN?code=UNGETURN"><skos:prefLabel xml:lang="de">Umsatz mit nicht oder nur geringfügig veränderten Produkten (von Produktinnovatoren ohne Berücksichtigung von Prozessinnovationen)</skos:prefLabel><skos:prefLabel xml:lang="en">Turnover from unchanged or marginally modified products (of product innovators)</skos:prefLabel><skos:prefLabel xml:lang="fr">Chiffre d&apos;affaires lié aux produits inchangés ou modifiés de manière marginale (des entreprises innovantes en matère de produits)</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">244937</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-04-23</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-12-31</dcat