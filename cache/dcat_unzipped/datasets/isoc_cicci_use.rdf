<?xml version="1.0" encoding="UTF-8"?><rdf:RDF xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/" xmlns:adms="http://www.w3.org/ns/adms#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:lcon="http://www.w3.org/ns/locn#" xmlns:sioc="http://rdfs.org/sioc/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="http://schema.org/" xmlns:v="http://www.w3.org/2006/vcard/ns#" xmlns:vann="http://purl.org/vocab/vann/" xmlns:voaf="http://purl.org/vocommons/voaf#" xmlns:wdrs="http://www.w3.org/2007/05/powder-s#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:spdx="http://spdx.org/rdf/terms#" xmlns:time="http://www.w3.org/2006/time#" xmlns:dcatap="http://data.europa.eu/r5r/" xmlns:stat="http://data.europa.eu/s1n/statdcat-ap/" xmlns:qb="http://purl.org/linked-data/cube#" ><dcat:Dataset rdf:about="http://ec.europa.eu/eurostat/web/products-datasets/-/isoc_cicci_use"><dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-12-16</dct:issued><dcat:keyword  xml:lang="de">Zeitliche Frequenz</dcat:keyword><dcat:keyword  xml:lang="en">Time frequency</dcat:keyword><dcat:keyword  xml:lang="fr">Fréquence (relative au temps)</dcat:keyword><dcat:keyword  xml:lang="de">Geopolitische Meldeeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Geopolitical entity (reporting)</dcat:keyword><dcat:keyword  xml:lang="fr">Entité géopolitique (déclarante)</dcat:keyword><dcat:keyword  xml:lang="de">Indikator zur Informationsgesellschaft</dcat:keyword><dcat:keyword  xml:lang="en">Information society indicator</dcat:keyword><dcat:keyword  xml:lang="fr">Indicateur sur la société de l&apos;information</dcat:keyword><dcat:keyword  xml:lang="de">Art der Einzelpersonen</dcat:keyword><dcat:keyword  xml:lang="en">Individual type</dcat:keyword><dcat:keyword  xml:lang="fr">Type de particulier</dcat:keyword><dcat:keyword  xml:lang="de">Maßeinheit</dcat:keyword><dcat:keyword  xml:lang="en">Unit of measure</dcat:keyword><dcat:keyword  xml:lang="fr">Unité de mesure</dcat:keyword><dct:type><skos:Concept  rdf:about="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/></dct:type><dct:title xml:lang="en">Individuals - use of cloud services (2014-2020)</dct:title><dct:description xml:lang="en">Individuals - use of cloud services (2014-2020)</dct:description><dct:title xml:lang="fr">Particuliers - utilisation des services de cloud (2014-2020)</dct:title><dct:description xml:lang="fr">Particuliers - utilisation des services de cloud (2014-2020)</dct:description><dct:title xml:lang="de">Einzelpersonen - Nutzung von Cloud Diensten (2014-2020)</dct:title><dct:description xml:lang="de">Einzelpersonen - Nutzung von Cloud Diensten (2014-2020)</dct:description><dct:identifier>isoc_cicci_use</dct:identifier><foaf:page rdf:resource="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cicci_use"/><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BEL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BGR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CZE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DNK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/DEU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/EST"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/IRL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GRC"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ESP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FRA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HRV"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ITA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CYP"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LVA"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LTU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/LUX"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/HUN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MLT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NLD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/AUT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/POL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/PRT"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ROU"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SVK"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/FIN"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SWE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ISL"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/NOR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/CHE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/GBR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/BIH"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MNE"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/MKD"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/ALB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/SRB"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/TUR"/></dct:spatial><dct:spatial><dct:Location rdf:about="http://publications.europa.eu/resource/authority/country/1A0"/></dct:spatial><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/FREQ" > <skos:prefLabel xml:lang="de">Zeitliche Frequenz</skos:prefLabel><skos:prefLabel xml:lang="en">Time frequency</skos:prefLabel><skos:prefLabel xml:lang="fr">Fréquence (relative au temps)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/GEO" > <skos:prefLabel xml:lang="de">Geopolitische Meldeeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Geopolitical entity (reporting)</skos:prefLabel><skos:prefLabel xml:lang="fr">Entité géopolitique (déclarante)</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS" > <skos:prefLabel xml:lang="de">Indikator zur Informationsgesellschaft</skos:prefLabel><skos:prefLabel xml:lang="en">Information society indicator</skos:prefLabel><skos:prefLabel xml:lang="fr">Indicateur sur la société de l&apos;information</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/IND_TYPE" > <skos:prefLabel xml:lang="de">Art der Einzelpersonen</skos:prefLabel><skos:prefLabel xml:lang="en">Individual type</skos:prefLabel><skos:prefLabel xml:lang="fr">Type de particulier</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:dimension> <qb:DimensionProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT" > <skos:prefLabel xml:lang="de">Maßeinheit</skos:prefLabel><skos:prefLabel xml:lang="en">Unit of measure</skos:prefLabel><skos:prefLabel xml:lang="fr">Unité de mesure</skos:prefLabel> </qb:DimensionProperty> </stat:dimension><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/OBS_FLAG" /> </stat:attribute><stat:attribute> <qb:AttributeProperty rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/CONF_STATUS" /> </stat:attribute><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern von Dokumenten, Fotos, Musik, Videos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used internet storage space to save documents, pictures, music, video or other files</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des espaces de stockage sur l&apos;internet pour sauvegarder des documents, photos, musique, vidéo et autres fichiers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCSX"><skos:prefLabel xml:lang="de">Kein elektronisches Teilen von Dateien mit anderen Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Did not share files</skos:prefLabel><skos:prefLabel xml:lang="fr">Aucun partage de fichiers par voie électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCS_CC"><skos:prefLabel xml:lang="de">Verwendung von Speicherplatz im Internet zum elektronischen Teilen von Dokumenten, Fotos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used internet storage space when sharing documents, pictures or other files electronically</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des espaces de stockage sur l&apos;internet pour partager des documents, des photos ou d&apos;autres fichiers par voie électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCS_EM"><skos:prefLabel xml:lang="de">Verwendung von E-Mails mit Anhang zum elektronischen Teilen von Dokumenten, Fotos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used e-mails with attached files when sharing documents, pictures or other files electronically</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des courriels avec fichiers joints pour partager des documents, des photos ou d&apos;autres fichiers par voie électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCS_OTH"><skos:prefLabel xml:lang="de">Verwendung von anderen Möglichkeiten als Internet zum elektronischen Teilen von Dokumenten, Fotos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used other means not using internet when sharing documents, pictures or other files electronically</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé d&apos;autres moyens que l&apos;internet pour partager des documents, des photos ou d&apos;autres fichiers par voie électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCS_PWS"><skos:prefLabel xml:lang="de">Verwendung von persönlichen Websites oder sozialen Netzwerken zum elektronischen Teilen von Dokumenten, Fotos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used personal websites or social networking sites when sharing documents, pictures or other files electronically</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des sites internet privés ou des sites de réseaux sociaux pour partager des documents, des photos ou d&apos;autres fichiers par voie électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCS_PWS_CC"><skos:prefLabel xml:lang="de">Verwendung von persönlichen Websites oder sozialen Netzwerken und Speicherplatz im Internet zum elektronischen Teilen von Dokumenten, Fotos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used personal websites or social networking sites and internet storage space when sharing documents, pictures or other files electronically</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des sites internet privés ou des sites de réseaux sociaux et des espaces de stockage sur internet pour partager des fichiers par voie électronique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CCX"><skos:prefLabel xml:lang="de">Keine Nutzung von Speicherplatz im Internet zum Speichern von Dokumenten, Fotos, Musik, Videos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Did not use internet storage space to save documents, pictures, music, video or other files</skos:prefLabel><skos:prefLabel xml:lang="fr">N&apos;ayant pas utilisé des espaces de stockage sur l&apos;internet pour sauvegarder des documents, photos, musique, vidéo et autres fichiers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_CCS"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Dokumenten, Fotos, Musik, Videos oder anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share documents, pictures, music, video or other files</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager des documents, des photos, de la musique, des vidéos ou d&apos;autres fichiers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_CCS_EPV"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Dateien oder zum Bearbeiten von Fotos, Videos</skos:prefLabel><skos:prefLabel xml:lang="en">Used internet storage space to save or share files or edit pictures or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des espaces de stockage sur l&apos;internet pour sauvegarder ou partager des fichiers ou pour éditer des photos ou des vidéos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_CCS_PMV"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Dateien oder zum Abspielen von Musik, Videos</skos:prefLabel><skos:prefLabel xml:lang="en">Used internet storage space to save or share files or play music or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé l&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager des fichiers, de la musique ou des vidéos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_CCS_SOFT"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz oder Software über Internet: zum Bearbeiten von Text, Tabellen, Präsentationen</skos:prefLabel><skos:prefLabel xml:lang="en">Used internet storage space or used software run over the internet to edit text documents, spreadsheets or presentations</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des espaces de stockage sur l&apos;internet ou des logiciels fonctionnant sur l&apos;internet pour éditer des documents textuels, des tableurs ou des présentations</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_CCS_SOFT_EPV_PMV"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Text, Tabellen, Präsentationen oder zum Bearbeiten von Fotos, Videos oder zum Abspielen von Musik, Videos verwendet haben</skos:prefLabel><skos:prefLabel xml:lang="en">Used internet storage space to save or share files or edit text documents, spreadsheets or presentations or edit pictures or videos, or play music or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé l&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager des fichiers, de la musique ou des vidéos ou pour éditer des documents textuels, des tableurs, des présentations, des photos ou des vidéos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_CCS_SOFT_PMV"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Text, Tabellen, Präsentationen oder zum Abspielen von Musik, Videos</skos:prefLabel><skos:prefLabel xml:lang="en">Used internet storage space to save or share files or edit text documents, spreadsheets or presentations, or play music or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé l&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager des fichiers, de la musique ou des vidéos ou pour éditer des documents textuels, des tableurs ou des présentations</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_EBO"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von E-Books oder E-Zeitschriften</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share e-books or e-magazines</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager des livres électronique ou des magazines en ligne</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_EPV"><skos:prefLabel xml:lang="de">Verwendung von Software über Internet zum Bearbeiten von Fotos, Videos</skos:prefLabel><skos:prefLabel xml:lang="en">Used software run over the internet for editing pictures or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des logiciels fonctionnant sur l&apos;internet pour éditer des photos ou des vidéos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_EPVX"><skos:prefLabel xml:lang="de">Nutzung von Internet aber keine Verwendung von Software über Internet zum Bearbeiten von Fotos, Videos</skos:prefLabel><skos:prefLabel xml:lang="en">Used the internet but did not use software run over the internet for editing pictures or videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé l&apos;internet mais pas de logiciels fonctionnant sur l&apos;internet pour éditer des photos ou des vidéos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_MUS"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Musik</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share music</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager de la musique</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_MV"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Musik und Videos inklusive Filme, Fernsehprogramme</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share music and videos</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet: pour sauvegarder ou partager de la musique ou des vidéos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_OFF"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Texten, Tabellen und Präsentationen</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share texts, spreadsheets or electronic presentations</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager des textes, des tableurs ou des présentations électroniques</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_OTH"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von anderen Dateien</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share other things</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet: pour sauvegarder ou partager autre chose</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_PAY"><skos:prefLabel xml:lang="de">Personen, die für die Nutzung von Speicherplatz oder für Teilen von Dateien im Internet bezahlt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Paid for internet storage space or file sharing services</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant payé pour des espaces de stockage sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_PAYX"><skos:prefLabel xml:lang="de">Personen, die nicht für die Nutzung von Speicherplatz oder für Teilen von Dateien im Internet bezahlt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Did not pay for internet storage space or file sharing services</skos:prefLabel><skos:prefLabel xml:lang="fr">N&apos;ayant pas payé pour des espaces de stockage sur l&apos;internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_PHO"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Fotos</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share photos</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet pour sauvegarder ou partager des photos</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_PMV"><skos:prefLabel xml:lang="de">Nutzung von Diensten über Internet: zum Abspielen von Musik oder auf Speicherplätzen verfügbaren Videodateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used services over the internet for playing music or video files uploaded or saved in internet storage space</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des services fonctionnant sur l&apos;internet pour écouter de la musique ou pour regarder une vidéo téléchargées sur un espace de stockage internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_PMVX"><skos:prefLabel xml:lang="de">Nutzung von Internet aber keine Verwendung von Diensten über Internet zum Abspielen von Musik oder auf Speicherplätzen verfügbaren Videodateien</skos:prefLabel><skos:prefLabel xml:lang="en">Used the internet but did not use services over the internet for playing music or video files uploaded or saved in internet storage space</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé l&apos;internet mais pas de services fonctionnant sur l&apos;internet pour écouter de la musique ou pour regarder une vidéo téléchargées sur un espace de stockage internet</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_RBAK"><skos:prefLabel xml:lang="de">Grund für die Nutzung von Speicherplatz im Internet: Schutz vor Datenverlust</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for using internet storage space: protecting against data loss</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour utiliser des espaces de stockage sur l&apos;internet: protection contre la perte de données</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_RDEV"><skos:prefLabel xml:lang="de">Grund für die Nutzung von Speicherplatz im Internet: Möglichkeit, die Daten von verschiedenen elektronischen Geräten oder Standorten aus zu nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for using internet storage space: possibility to use files from several devices or locations</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour utiliser des espaces de stockage sur l&apos;internet: possibilité d&apos;utiliser des fichiers provenant d&apos;appareils ou de lieux différents</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_RLIB"><skos:prefLabel xml:lang="de">Grund für die Nutzung von Speicherplatz im Internet: Zugang zu umfangreichen Beständen von Musik, Fernsehprogrammen oder Filmen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for using internet storage space: access to large libraries of music, TV programs or films</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour utiliser des espaces de stockage sur l&apos;internet: l&apos;accès aux grandes bibliothèques d&apos;enregistrements musicaux, de programmes télévisés ou de films</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_RSHA"><skos:prefLabel xml:lang="de">Grund für die Nutzung von Speicherplatz im Internet: Möglichkeit, Dateien bequem gemeinsam mit anderen Personen zu nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for using internet storage space: possibility to share files with other persons easily</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour utiliser des espaces de stockage sur l&apos;internet: possibilité de partager facilement des fichiers avec d&apos;autres personnes</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_RSPA"><skos:prefLabel xml:lang="de">Grund für die Nutzung von Speicherplatz im Internet: Möglichkeit, größere Speicherkapazität zu nutzen</skos:prefLabel><skos:prefLabel xml:lang="en">Reason for using internet storage space: possibility to use larger memory space</skos:prefLabel><skos:prefLabel xml:lang="fr">Raison pour utiliser des espaces de stockage sur l&apos;internet: possibilité d&apos;utiliser un plus grand espace mémoire</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_SOFT"><skos:prefLabel xml:lang="de">Verwendung von Software über Internet zum Bearbeiten von Text, Tabellen, Präsentationen</skos:prefLabel><skos:prefLabel xml:lang="en">Used software run over the internet for editing text documents, spreadsheets or presentations</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé des logiciels fonctionnant sur l&apos;internet pour éditer des documents textuels, des tableurs ou des présentations</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_SOFTX"><skos:prefLabel xml:lang="de">Nutzung von Internet aber keine Verwendung von Software über Internet zum Bearbeiten von Text, Tabellen, Präsentationen</skos:prefLabel><skos:prefLabel xml:lang="en">Used the internet but did not use software run over the internet for editing text documents, spreadsheets or presentations</skos:prefLabel><skos:prefLabel xml:lang="fr">Ayant utilisé l&apos;internet mais pas de logiciels fonctionnant sur l&apos;internet pour éditer des documents textuels, des tableurs ou des présentations</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/INDIC_IS?code=I_CC_VID"><skos:prefLabel xml:lang="de">Nutzung von Speicherplatz im Internet zum Speichern / Teilen von Videos inklusive Filme, Fernsehprogramme</skos:prefLabel><skos:prefLabel xml:lang="en">Internet storage space use: to save or share videos including films, TV programmes</skos:prefLabel><skos:prefLabel xml:lang="fr">Utilisation d&apos;espace de stockage sur l&apos;internet: pour sauvegarder ou partager des vidéos, des programmes TV</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND"><skos:prefLabel xml:lang="de">Prozent der Personen</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_CC_CCS"><skos:prefLabel xml:lang="de">Prozent der Personen, die Internet und Cloud Dienste zum Speichern oder Teilen von Dateien nutzten</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet and cloud services for file saving or sharing</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage de particuliers ayant utilisé l&apos;internet et des services de Cloud Computing pour sauvegarder ou partager des fichiers</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:statUnitMeasure><skos:Concept rdf:about="https://ec.europa.eu/eurostat/api/dissemination/sdmx/2.1/codelist/ESTAT/UNIT?code=PC_IND_IU3"><skos:prefLabel xml:lang="de">Prozent der Personen, die in den letzten drei Monaten das Internet genutzt haben</skos:prefLabel><skos:prefLabel xml:lang="en">Percentage of individuals who used internet in the last 3 months</skos:prefLabel><skos:prefLabel xml:lang="fr">Pourcentage des particuliers ayant utilisés l&apos;internet au cours des trois derniers mois</skos:prefLabel></skos:Concept></stat:statUnitMeasure><stat:numSeries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">204320</stat:numSeries><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/REGI" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/GOVE" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/TECH" /></dcat:theme><dcat:theme><skos:Concept rdf:about="http://publications.europa.eu/resource/authority/data-theme/SOCI" /></dcat:theme><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-16</dct:modified><dct:accrualPeriodicity><dct:Frequency rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL"/></dct:accrualPeriodicity><dct:temporal><dct:PeriodOfTime rdf:about="http://purl.org/dc/terms/PeriodOfTime/3169a64b-f3b3-4920-b709-b32c20b97678"><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-01-01</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-31</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:accessRights><dct:RightsStatement rdf:about="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/></dct:accessRights><dcat:landingPage><foaf:Document rdf:about="https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cicci_use"><dct:type rdf:resource="http://publications.europa.eu/resource/authority/documentation-type/WEBPAGE_RELATED"/><schema:url xml:lang="en">https://ec.europa.eu/eurostat/databrowser/product/page/isoc_cicci_use</schema:url><dct:title xml:lang="en">More information on Eurostat Website</dct:title><dct:title xml:lang="fr">Plus d&apos;information sur le site web d&apos;Eurostat</dct:title><dct:title xml:lang="de">Mehr Informationen auf der Eurostat Website</dct:title></foaf:Document></dcat:landingPage><foaf:page><foaf:Document rdf:about="https://ec.europa.eu/eurostat/cache/metadata/en/isoc_i_esms.htm"><dct:title xml:lang="en">ESMS metadata (Euro-SDMX Metadata structure) HTML</dct:title><foaf:topic rdf:resource="https://ec.europa.eu/eurosta